@model List<Cafe.Models.Purchase>
@{
    ViewData["Title"] = "Purchase Orders";
    var branches = ViewBag.Branches as List<Cafe.Models.Branch> ?? new();
    var selectedStatus = ViewBag.SelectedStatus as string;

    string StatusBadge(string s) => s switch {
        "Received"  => "badge badge-success",
        "Approved"  => "badge badge-info",
        "Pending"   => "badge badge-warning",
        "Cancelled" => "badge badge-danger",
        _ => "badge badge-neutral"
    };
    string StatusIcon(string s) => s switch {
        "Received"  => "fa-check-circle",
        "Approved"  => "fa-thumbs-up",
        "Pending"   => "fa-clock",
        "Cancelled" => "fa-times-circle",
        _ => "fa-question-circle"
    };
}

<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:2rem;flex-wrap:wrap;gap:1rem;">
    <div>
        <h1 class="page-title" style="margin:0;">Purchase Orders</h1>
        <p class="body-text" style="margin-top:0.25rem;">Track and manage inventory purchase workflow</p>
    </div>
    <a asp-action="Create" class="btn btn-primary"><i class="fas fa-plus" style="margin-right:0.5rem;"></i> New Purchase</a>
</div>

<!-- KPI Cards -->
<div class="mb-6" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:1rem;">
    @foreach (var (label, count, color, icon, s) in new[] {
        ("Pending",   (int)(ViewBag.PendingCount ?? 0),   "var(--warning)", "fa-clock",        "Pending"),
        ("Approved",  (int)(ViewBag.ApprovedCount ?? 0),  "var(--info)", "fa-thumbs-up",    "Approved"),
        ("Received",  (int)(ViewBag.ReceivedCount ?? 0),  "var(--success)", "fa-check-circle", "Received"),
        ("Cancelled", (int)(ViewBag.CancelledCount ?? 0), "var(--danger)", "fa-times-circle", "Cancelled")
    })
    {
        <a asp-action="Index" asp-route-status="@s" style="text-decoration:none;">
            <div class="card @(selectedStatus == s ? "card-accent" : "")" style="padding:1rem;cursor:pointer;">
                <i class="fas @icon" style="color:@color;font-size:1.25rem;"></i>
                <p style="font-size:1.5rem;font-weight:700;margin:0.5rem 0 0;color:@color;">@count</p>
                <p class="caption" style="margin:0;">@label</p>
            </div>
        </a>
    }
</div>

<!-- Filter -->
<div class="card mb-4">
    <div class="card-body" style="display:flex;gap:1rem;flex-wrap:wrap;align-items:flex-end;">
        <form method="get" style="display:flex;gap:0.75rem;flex-wrap:wrap;align-items:flex-end;">
            <div class="form-group" style="margin:0;">
                <label class="form-label">Branch</label>
                <select name="branchId" class="form-select" style="min-width:160px;">
                    <option value="">All Branches</option>
                    @foreach (var b in branches) {
                        <option value="@b.Id" selected="@(ViewBag.SelectedBranchId?.ToString() == b.Id.ToString() ? "selected" : null)">@b.Name</option>
                    }
                </select>
            </div>
            <div class="form-group" style="margin:0;">
                <label class="form-label">Status</label>
                <select name="status" class="form-select">
                    <option value="">All Statuses</option>
                    @foreach (var st in new[]{"Pending","Approved","Received","Cancelled"}) {
                        <option value="@st" selected="@(selectedStatus == st ? "selected" : null)">@st</option>
                    }
                </select>
            </div>
            <button type="submit" class="btn btn-secondary"><i class="fas fa-filter" style="margin-right:0.4rem;"></i>Filter</button>
            @if (!string.IsNullOrEmpty(selectedStatus) || ViewBag.SelectedBranchId != null)
            {
                <a asp-action="Index" class="btn btn-ghost btn-sm">Clear</a>
            }
        </form>
    </div>
</div>

<!-- Table -->
<div class="card">
    <div class="card-body card-body-flush">
        <div style="overflow-x:auto;">
            <table class="premium-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Item</th>
                        <th>Supplier</th>
                        <th>Qty</th>
                        <th>Cost</th>
                        <th>Branch</th>
                        <th>Date</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="9">
                                <div class="empty-state">
                                    <i class="fas fa-shopping-cart"></i>
                                    <h3>No purchase orders found</h3>
                                    <p>Create your first purchase order to start tracking.</p>
                                    <a asp-action="Create" class="btn btn-primary btn-sm"><i class="fas fa-plus" style="margin-right:0.4rem;"></i>New Purchase</a>
                                </div>
                            </td>
                        </tr>
                    }
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td class="caption">#@p.Id</td>
                            <td style="font-weight:500;">@(p.Item?.Name ?? "—")</td>
                            <td>@(p.Supplier?.Name ?? p.SupplierName)</td>
                            <td>@p.QuantityPurchased</td>
                            <td>Rs. @p.TotalCost.ToString("N0")</td>
                            <td class="caption">@(p.Branch?.Name ?? p.Item?.Branch?.Name ?? "—")</td>
                            <td class="caption">@p.DatePurchased.ToString("dd MMM yyyy")</td>
                            <td><span class="@StatusBadge(p.Status)"><i class="fas @StatusIcon(p.Status)" style="margin-right:0.25rem;"></i>@p.Status</span></td>
                            <td>
                                <div style="display:flex;gap:0.4rem;flex-wrap:wrap;">
                                    @if (p.Status == "Pending")
                                    {
                                        <form asp-action="UpdateStatus" method="post" style="display:inline;" data-confirm="Approve this purchase order?">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@p.Id" />
                                            <input type="hidden" name="newStatus" value="Approved" />
                                            <button type="submit" class="btn btn-sm btn-primary">Approve</button>
                                        </form>
                                        <form asp-action="UpdateStatus" method="post" style="display:inline;" data-confirm="Cancel this purchase order?">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@p.Id" />
                                            <input type="hidden" name="newStatus" value="Cancelled" />
                                            <button type="submit" class="btn btn-sm btn-danger">Cancel</button>
                                        </form>
                                    }
                                    @if (p.Status == "Approved")
                                    {
                                        <form asp-action="UpdateStatus" method="post" style="display:inline;" data-confirm="Mark as Received? This will update inventory quantity.">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@p.Id" />
                                            <input type="hidden" name="newStatus" value="Received" />
                                            <button type="submit" class="btn btn-sm btn-primary">Mark Received</button>
                                        </form>
                                        <form asp-action="UpdateStatus" method="post" style="display:inline;" data-confirm="Cancel this approved purchase?">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@p.Id" />
                                            <input type="hidden" name="newStatus" value="Cancelled" />
                                            <button type="submit" class="btn btn-sm btn-danger">Cancel</button>
                                        </form>
                                    }
                                    @if (p.Status == "Received")
                                    {
                                        <span class="caption" style="color:var(--success);"><i class="fas fa-check"></i> Done</span>
                                    }
                                    @if (p.Status == "Cancelled")
                                    {
                                        <span class="caption" style="color:var(--danger);"><i class="fas fa-times"></i> Cancelled</span>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
