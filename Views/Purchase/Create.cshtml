@model Cafe.Models.Purchase
@{
    ViewData["Title"] = "New Purchase Order";
    var branches = ViewBag.Branches as List<Cafe.Models.Branch> ?? new();
    var suppliers = ViewBag.Suppliers as List<Cafe.Models.Supplier> ?? new();
    var items = ViewBag.Items as List<Cafe.Models.InventoryItem> ?? new();
}

<div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:1rem;margin-bottom:2rem;">
    <div>
        <h1 class="page-title" style="margin:0;">New Purchase Order</h1>
        <p class="body-text" style="margin-top:0.25rem;">Record a new inventory purchase</p>
    </div>
    <a asp-action="Index" class="btn btn-secondary btn-sm"><i class="fas fa-arrow-left"></i> Back</a>
</div>

<div class="card" style="max-width:680px;">
    <div class="card-header">Purchase Details</div>
    <div class="card-body">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div class="form-row">
                <div class="form-group">
                    <label class="form-label">Inventory Item *</label>
                    <select name="ItemId" class="form-select" required>
                        <option value="">-- Select Item --</option>
                        @foreach (var i in items) {
                            <option value="@i.Id">@i.Name (@i.Branch?.Name)</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">Supplier</label>
                    <select name="SupplierId" class="form-select">
                        <option value="">-- None / Manual --</option>
                        @foreach (var s in suppliers) {
                            <option value="@s.Id">@s.Name</option>
                        }
                    </select>
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label class="form-label">Quantity *</label>
                    <input type="number" name="QuantityPurchased" class="form-control" min="1" required value="@Model.QuantityPurchased" />
                </div>
                <div class="form-group">
                    <label class="form-label">Total Cost *</label>
                    <input type="number" name="TotalCost" class="form-control" step="0.01" min="0.01" required value="@Model.TotalCost" />
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label class="form-label">Purchase Date *</label>
                    <input type="date" name="DatePurchased" class="form-control" required value="@Model.DatePurchased.ToString("yyyy-MM-dd")" />
                </div>
                <div class="form-group">
                    <label class="form-label">Initial Status</label>
                    <select name="Status" class="form-select">
                        <option value="Pending"  selected="@(Model.Status == "Pending"  ? "selected" : null)">Pending</option>
                        <option value="Approved" selected="@(Model.Status == "Approved" ? "selected" : null)">Approved</option>
                        <option value="Received" selected="@(Model.Status == "Received" ? "selected" : null)">Received (updates inventory immediately)</option>
                    </select>
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">Notes</label>
                <textarea name="Notes" class="form-control" rows="2" placeholder="Invoice number, delivery notes, etc.">@Model.Notes</textarea>
            </div>

            <div class="divider"></div>
            <div style="display:flex;justify-content:flex-end;gap:0.75rem;">
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary"><i class="fas fa-save" style="margin-right:0.5rem;"></i>Create Purchase</button>
            </div>
        </form>
    </div>
</div>
