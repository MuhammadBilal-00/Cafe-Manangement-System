@inject Cafe.Services.ITenantBrandingService Branding
@inject Cafe.Services.IFeatureGate FeatureGate
@inject Cafe.Services.ITenantContext TenantCtx
@{
    var brand = await Branding.GetCurrentAsync();
    var sessRole = Context.Session.GetString("UserRole");
    var isPlatform = sessRole == "PlatformAdmin";
    var impersonatingId = Context.Session.GetInt32("ImpersonatingTenantId");
    var impersonatingName = Context.Session.GetString("ImpersonatingTenantName");
    var sessAuthed = Context.Session.GetString("UserId") != null;
    HashSet<string>? planFeatures = (sessAuthed && !isPlatform) ? await FeatureGate.GetEnabledFeaturesAsync() : null;
    Func<string, bool> canFeature = key =>
        isPlatform
        || Cafe.Services.FeatureCatalog.Core.Contains(key)
        || (planFeatures != null && (planFeatures.Contains("*") || planFeatures.Contains(key)));

    // Phase 10 (i18n): drive the page language + direction from the active culture (Urdu/Arabic = RTL).
    var uiCulture = System.Globalization.CultureInfo.CurrentUICulture;
    var isRtl = uiCulture.TextInfo.IsRightToLeft;
    var pageDir = isRtl ? "rtl" : "ltr";
}
<!DOCTYPE html>
<html lang="@uiCulture.TwoLetterISOLanguageName" dir="@pageDir">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Cafe Management</title>

    <!-- Design System (tokens first: themes + variables, then components) -->
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/design-system.css" asp-append-version="true" />

    <!-- Tailwind CSS (utility support) -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        accent: { DEFAULT: 'var(--accent)', hover: 'var(--accent-hover)', light: 'var(--accent-light)' },
                        surface: { DEFAULT: 'var(--bg-surface)', alt: 'var(--bg-surface-alt)', hover: 'var(--bg-surface-hover)' },
                        body: 'var(--bg-body)',
                        sidebar: 'var(--sidebar-bg)',
                    },
                    fontFamily: { sans: ['Inter', 'system-ui', 'sans-serif'] },
                    borderRadius: { card: '16px', 'card-lg': '20px' },
                    boxShadow: {
                        'card': '0 1px 3px rgba(0,0,0,0.04), 0 4px 14px rgba(0,0,0,0.03)',
                        'card-hover': '0 4px 12px rgba(0,0,0,0.07), 0 12px 32px rgba(0,0,0,0.06)',
                        'card-elevated': '0 8px 30px rgba(0,0,0,0.08), 0 2px 8px rgba(0,0,0,0.04)',
                        'card-premium': '0 20px 60px rgba(0,0,0,0.08), 0 4px 16px rgba(0,0,0,0.04)',
                    },
                    transitionDuration: {
                        '350': '350ms',
                    },
                    transitionTimingFunction: {
                        'premium': 'cubic-bezier(0.4, 0, 0.2, 1)',
                    },
                }
            }
        }
    </script>

    <!-- Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <!-- Chart.js + theme-aware runtime -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script src="~/js/charts.js" asp-append-version="true"></script>

    <style>
/* Skeleton loader lives in design-system.css (.skeleton-pulse) */

/* ── Status Badges for all 10 attendance statuses ── */
.badge-paid-leave   { background:var(--accent-light); color:#92400e; border:1px solid rgba(212,175,55,0.3); }
.badge-sick-leave   { background:var(--danger-light);   color:#991b1b; border:1px solid rgba(239,68,68,0.2); }
.badge-casual-leave { background:rgba(249,115,22,0.1);  color:#9a3412; border:1px solid rgba(249,115,22,0.2); }
.badge-wfh          { background:var(--info-light); color:#3730a3; border:1px solid rgba(99,102,241,0.2); }
.badge-holiday      { background:rgba(16,185,129,0.12); color:#065f46; border:1px solid rgba(16,185,129,0.2); }
.badge-overtime     { background:rgba(234,179,8,0.12);  color:#713f12; border:1px solid rgba(234,179,8,0.2); }
</style>
    @await RenderSectionAsync("Styles", required: false)
    <!-- Theme init — runs immediately to prevent flash of wrong theme -->
    <script>(function(){var v=['light','coffee','slate','dark','midnight'];var t=localStorage.getItem('cafetheme');if(v.indexOf(t)<0)t='light';document.documentElement.setAttribute('data-theme',t);})();</script>

    <!-- Per-tenant white-label branding: overrides design-system variables (no per-tenant CSS).
         Emitted only for values the tenant actually customized, so the themes' own
         accent/sidebar apply otherwise (this inline block outranks every [data-theme]). -->
    @if (brand.PrimaryColor != "#d4af37" || brand.SidebarColor != "#1e2a3a")
    {
        <style>
            @if (brand.PrimaryColor != "#d4af37")
            {
                <text>:root, [data-theme] { --accent: @brand.PrimaryColor; }</text>
            }
            @if (brand.SidebarColor != "#1e2a3a")
            {
                <text>.sidebar { background: @brand.SidebarColor; }</text>
            }
        </style>
    }
</head>
<body>
    @* Pages send this via a "RequestVerificationToken" header on JSON/fetch POSTs.
       Rendered once here so every page has it, instead of relying on each view
       happening to contain a <form> that incidentally emits the same field. *@
    <form style="display:none">@Html.AntiForgeryToken()</form>
    @{
        var userRole = Context.Session.GetString("UserRole");
        var userName = Context.Session.GetString("UserName");
        var isOwner = userRole == "Owner";
        var isManager = userRole == "BranchManager";
        var isStaff = Cafe.Helpers.AppRoles.IsStaffLevel(userRole);
        var isOwnerOrManager = isOwner || isManager;
        var isAuthenticated = Context.Session.GetString("UserId") != null;
    }

    <!-- Sidebar Overlay (mobile) -->
    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <div class="app-shell">
        <!-- ═══ SIDEBAR ═══ -->
        <aside class="sidebar" id="sidebar">
            <!-- Brand -->
            <div class="sidebar-brand">
                <div class="sidebar-brand-icon">
                    @if (!string.IsNullOrEmpty(brand.LogoUrl))
                    {
                        <img src="@brand.LogoUrl" alt="logo" style="width:100%;height:100%;object-fit:cover;border-radius:inherit;" />
                    }
                    else
                    {
                        <i class="fas fa-mug-hot"></i>
                    }
                </div>
                <div class="sidebar-brand-text">
                    <div class="sidebar-brand-name">@(isPlatform ? "Platform Console" : brand.BusinessName)</div>
                    <div class="sidebar-brand-sub">
                        @if (isAuthenticated)
                        {
                            @(isPlatform ? "SaaS Operator" : userRole + " Panel")
                        }
                        else
                        {
                            <text>Please sign in</text>
                        }
                    </div>
                </div>
            </div>

            <!-- Navigation -->
            <nav class="sidebar-nav">
                @{
                    // One link, one place: every module lives in exactly one group below.
                    void NavLink(string controller, string action, string icon, string label, string nav)
                    {
                        <a href="@Url.Action(action, controller)" class="sidebar-link" data-nav="@nav">
                            <span class="sidebar-link-icon"><i class="fas @icon"></i></span>
                            <span class="sidebar-link-text">@label</span>
                        </a>
                    }
                }
                @if (isPlatform)
                {
                    <!-- ═══ PLATFORM ADMIN NAV ═══ -->
                    <div class="sidebar-section-label">Platform</div>
                    NavLink("Platform", "Index", "fa-gauge-high", "Console", "PlatformIndex");
                    NavLink("Platform", "Tenants", "fa-building", "Tenants", "PlatformTenants");
                    NavLink("Platform", "Plans", "fa-layer-group", "Plans", "PlatformPlans");

                    <div class="sidebar-section-label">System</div>
                    NavLink("AuditLog", "Index", "fa-shield-halved", "Audit Logs", "AuditLog");
                }
                else
                {
                    <!-- ═══ TENANT NAV ═══
                         Grouped by business domain the way an owner / manager / accountant /
                         cashier thinks, not by code structure. Role checks and plan feature
                         gates are identical to the controllers they link to. -->

                    NavLink("Home", "Index", "fa-gauge-high", "Dashboard", "Home");

                    @* ── Point of Sale — the cashier's daily loop ── *@
                    @if (userRole != "Customer")
                    {
                        <div class="sidebar-group" data-group="pos">
                            <button type="button" class="sidebar-group-header">
                                <span class="sidebar-link-icon"><i class="fas fa-cash-register"></i></span>
                                <span class="sidebar-link-text">Point of Sale</span>
                                <span class="sidebar-group-chevron"><i class="fas fa-chevron-right"></i></span>
                            </button>
                            <div class="sidebar-submenu"><div class="sidebar-submenu-inner">
                                @{ NavLink("Pos", "Index", "fa-cash-register", "Register", "Pos"); }
                                @{ NavLink("Order", "Index", "fa-receipt", "Orders", "Order"); }
                                @if (canFeature(Cafe.Services.FeatureCatalog.Kds))
                                {
                                    NavLink("Kitchen", "Index", "fa-fire-burner", "Kitchen Display", "Kitchen");
                                }
                                @if (canFeature(Cafe.Services.FeatureCatalog.Tables))
                                {
                                    NavLink("Table", "Index", "fa-chair", "Tables", "Table");
                                }
                                @if (canFeature(Cafe.Services.FeatureCatalog.Invoicing))
                                {
                                    NavLink("Invoice", "Index", "fa-file-invoice-dollar", "Bill History", "Invoice");
                                }
                            </div></div>
                        </div>
                    }

                    @* ── Sales — quotes, dispatch and targets ── *@
                    @if (isOwnerOrManager)
                    {
                        <div class="sidebar-group" data-group="sales">
                            <button type="button" class="sidebar-group-header">
                                <span class="sidebar-link-icon"><i class="fas fa-handshake"></i></span>
                                <span class="sidebar-link-text">Sales</span>
                                <span class="sidebar-group-chevron"><i class="fas fa-chevron-right"></i></span>
                            </button>
                            <div class="sidebar-submenu"><div class="sidebar-submenu-inner">
                                @{ NavLink("Quotation", "Index", "fa-file-signature", "Quotations", "Quotation"); }
                                @{ NavLink("Delivery", "Index", "fa-motorcycle", "Delivery & Riders", "Delivery"); }
                                @{ NavLink("Shipment", "Index", "fa-box", "Shipments", "Shipment"); }
                                @if (canFeature(Cafe.Services.FeatureCatalog.Inventory))
                                {
                                    NavLink("SellReturn", "Index", "fa-rotate-left", "Sell Returns", "SellReturn");
                                }
                                @if (canFeature(Cafe.Services.FeatureCatalog.Analytics))
                                {
                                    NavLink("SalesTarget", "Index", "fa-bullseye", "Sales Targets", "SalesTarget");
                                }
                            </div></div>
                        </div>
                    }

                    @* ── Menu & Catalog — what the business sells ── *@
                    @if (userRole != "Customer")
                    {
                        <div class="sidebar-group" data-group="catalog">
                            <button type="button" class="sidebar-group-header">
                                <span class="sidebar-link-icon"><i class="fas fa-utensils"></i></span>
                                <span class="sidebar-link-text">Menu & Catalog</span>
                                <span class="sidebar-group-chevron"><i class="fas fa-chevron-right"></i></span>
                            </button>
                            <div class="sidebar-submenu"><div class="sidebar-submenu-inner">
                                @{ NavLink("MenuItem", "Index", "fa-utensils", "Menu Items", "MenuItem"); }
                                @if (isOwnerOrManager)
                                {
                                    NavLink("Modifier", "Index", "fa-sliders", "Modifiers", "Modifier");
                                    NavLink("Combo", "Index", "fa-gift", "Combos", "Combo");
                                    NavLink("Brand", "Index", "fa-copyright", "Brands", "Brand");
                                    NavLink("Unit", "Index", "fa-ruler", "Units", "Unit");
                                    NavLink("PriceGroup", "Index", "fa-layer-group", "Price Groups", "PriceGroup");
                                    NavLink("TaxGroup", "Index", "fa-percent", "Tax Groups", "TaxGroup");
                                }
                            </div></div>
                        </div>
                    }

                    @* ── Inventory — stock on hand and how it moves ── *@
                    @if (isOwnerOrManager && canFeature(Cafe.Services.FeatureCatalog.Inventory))
                    {
                        <div class="sidebar-group" data-group="inventory">
                            <button type="button" class="sidebar-group-header">
                                <span class="sidebar-link-icon"><i class="fas fa-boxes-stacked"></i></span>
                                <span class="sidebar-link-text">Inventory</span>
                                <span class="sidebar-group-chevron"><i class="fas fa-chevron-right"></i></span>
                            </button>
                            <div class="sidebar-submenu"><div class="sidebar-submenu-inner">
                                @{ NavLink("InventoryItem", "Index", "fa-boxes-stacked", "Stock Items", "InventoryItem"); }
                                @{ NavLink("StockTransfer", "Index", "fa-right-left", "Stock Transfers", "StockTransfer"); }
                                @{ NavLink("StockAdjustment", "Index", "fa-scale-balanced", "Stock Adjustments", "StockAdjustment"); }
                                @{ NavLink("Production", "Index", "fa-industry", "Production", "Production"); }
                            </div></div>
                        </div>
                    }

                    @* ── Purchasing — suppliers and inbound goods ── *@
                    @if (isOwnerOrManager && (canFeature(Cafe.Services.FeatureCatalog.Suppliers)
                                              || canFeature(Cafe.Services.FeatureCatalog.Purchases)
                                              || canFeature(Cafe.Services.FeatureCatalog.Inventory)))
                    {
                        <div class="sidebar-group" data-group="purchasing">
                            <button type="button" class="sidebar-group-header">
                                <span class="sidebar-link-icon"><i class="fas fa-truck"></i></span>
                                <span class="sidebar-link-text">Purchasing</span>
                                <span class="sidebar-group-chevron"><i class="fas fa-chevron-right"></i></span>
                            </button>
                            <div class="sidebar-submenu"><div class="sidebar-submenu-inner">
                                @if (canFeature(Cafe.Services.FeatureCatalog.Suppliers))
                                {
                                    NavLink("Supplier", "Index", "fa-truck", "Suppliers", "Supplier");
                                }
                                @if (canFeature(Cafe.Services.FeatureCatalog.Purchases))
                                {
                                    NavLink("Purchase", "Index", "fa-shopping-cart", "Purchases", "Purchase");
                                }
                                @if (canFeature(Cafe.Services.FeatureCatalog.Inventory))
                                {
                                    NavLink("PurchaseReturn", "Index", "fa-truck-ramp-box", "Purchase Returns", "PurchaseReturn");
                                }
                            </div></div>
                        </div>
                    }

                    @* ── Finance — the accountant's home ── *@
                    @if (isOwnerOrManager && canFeature(Cafe.Services.FeatureCatalog.Analytics))
                    {
                        <div class="sidebar-group" data-group="finance">
                            <button type="button" class="sidebar-group-header">
                                <span class="sidebar-link-icon"><i class="fas fa-coins"></i></span>
                                <span class="sidebar-link-text">Finance</span>
                                <span class="sidebar-group-chevron"><i class="fas fa-chevron-right"></i></span>
                            </button>
                            <div class="sidebar-submenu"><div class="sidebar-submenu-inner">
                                @{ NavLink("Financial", "Dashboard", "fa-chart-pie", "Financial Dashboard", "Financial"); }
                                @{ NavLink("Reports", "Index", "fa-chart-line", "Reports", "Reports"); }
                                @{ NavLink("Accounting", "Index", "fa-book", "Accounting", "Accounting"); }
                                @{ NavLink("Receivables", "Index", "fa-scale-unbalanced", "Receivables & Payables", "Receivables"); }
                                @{ NavLink("Budget", "Index", "fa-sack-dollar", "Budgets", "Budget"); }
                                @{ NavLink("PaymentAccount", "Index", "fa-building-columns", "Payment Accounts", "PaymentAccount"); }
                            </div></div>
                        </div>
                    }

                    @* ── Human Resources — staff see Attendance; managers see it all ── *@
                    @if (userRole != "Customer")
                    {
                        <div class="sidebar-group" data-group="hr">
                            <button type="button" class="sidebar-group-header">
                                <span class="sidebar-link-icon"><i class="fas fa-users"></i></span>
                                <span class="sidebar-link-text">Human Resources</span>
                                <span class="sidebar-group-chevron"><i class="fas fa-chevron-right"></i></span>
                            </button>
                            <div class="sidebar-submenu"><div class="sidebar-submenu-inner">
                                @if (isOwnerOrManager)
                                {
                                    NavLink("Staff", "Index", "fa-users", "Staff", "Staff");
                                }
                                @{ NavLink("Attendance", "Index", "fa-calendar-check", "Attendance", "Attendance"); }
                                @if (isOwnerOrManager)
                                {
                                    if (canFeature(Cafe.Services.FeatureCatalog.Payroll))
                                    {
                                        NavLink("Salary", "Index", "fa-wallet", "Payroll", "Salary");
                                        NavLink("Leave", "Index", "fa-plane-departure", "Leave", "Leave");
                                    }
                                    if (isOwner)
                                    {
                                        NavLink("SalaryPolicy", "Index", "fa-file-contract", "Salary Policies", "SalaryPolicy");
                                    }
                                    NavLink("Holiday", "Index", "fa-calendar-day", "Holidays", "Holiday");
                                    NavLink("Department", "Index", "fa-network-wired", "Departments", "Department");
                                    NavLink("EmployeeDocument", "Index", "fa-folder-open", "Documents", "EmployeeDocument");
                                }
                            </div></div>
                        </div>
                    }

                    @* ── Customers & Marketing — loyalty, promotions, CRM, feedback ── *@
                    @if (isOwnerOrManager && (canFeature(Cafe.Services.FeatureCatalog.Marketing)
                                              || canFeature(Cafe.Services.FeatureCatalog.Feedback)))
                    {
                        <div class="sidebar-group" data-group="marketing">
                            <button type="button" class="sidebar-group-header">
                                <span class="sidebar-link-icon"><i class="fas fa-bullhorn"></i></span>
                                <span class="sidebar-link-text">Customers & Marketing</span>
                                <span class="sidebar-group-chevron"><i class="fas fa-chevron-right"></i></span>
                            </button>
                            <div class="sidebar-submenu"><div class="sidebar-submenu-inner">
                                @if (canFeature(Cafe.Services.FeatureCatalog.Marketing))
                                {
                                    NavLink("Crm", "Index", "fa-user-group", "CRM", "Crm");
                                    NavLink("Loyalty", "Index", "fa-star", "Loyalty", "Loyalty");
                                    NavLink("GiftCard", "Index", "fa-gift", "Gift Cards", "GiftCard");
                                    NavLink("PromoCode", "Index", "fa-tags", "Promo Codes", "PromoCode");
                                    NavLink("Partnership", "Index", "fa-credit-card", "Card Partnerships", "Partnership");
                                    NavLink("NotificationTemplate", "Index", "fa-envelope-open-text", "Message Templates", "NotificationTemplate");
                                }
                                @if (canFeature(Cafe.Services.FeatureCatalog.Feedback))
                                {
                                    NavLink("Feedback", "Index", "fa-message", "Feedback", "Feedback");
                                }
                            </div></div>
                        </div>
                    }

                    @* ── Workspace — internal collaboration ── *@
                    @if (userRole != "Customer")
                    {
                        <div class="sidebar-group" data-group="workspace">
                            <button type="button" class="sidebar-group-header">
                                <span class="sidebar-link-icon"><i class="fas fa-clipboard-list"></i></span>
                                <span class="sidebar-link-text">Workspace</span>
                                <span class="sidebar-group-chevron"><i class="fas fa-chevron-right"></i></span>
                            </button>
                            <div class="sidebar-submenu"><div class="sidebar-submenu-inner">
                                @{ NavLink("Essentials", "Index", "fa-clipboard-list", "Team Workspace", "Essentials"); }
                                @{ NavLink("Message", "Index", "fa-comments", "Messages", "Message"); }
                            </div></div>
                        </div>
                    }

                    @* ── Administration — org structure, devices, billing, system ── *@
                    @if (isOwnerOrManager)
                    {
                        <div class="sidebar-group" data-group="admin">
                            <button type="button" class="sidebar-group-header">
                                <span class="sidebar-link-icon"><i class="fas fa-gear"></i></span>
                                <span class="sidebar-link-text">Administration</span>
                                <span class="sidebar-group-chevron"><i class="fas fa-chevron-right"></i></span>
                            </button>
                            <div class="sidebar-submenu"><div class="sidebar-submenu-inner">
                                @{ NavLink("Branch", "Index", "fa-store", "Branches", "Branch"); }
                                @if (isOwner)
                                {
                                    NavLink("User", "Index", "fa-user-shield", "Users & Roles", "Users");
                                }
                                @{ NavLink("KitchenPrinter", "Index", "fa-print", "Kitchen Printers", "KitchenPrinter"); }
                                @{ NavLink("PosProfile", "Index", "fa-receipt", "POS & Receipts", "PosProfile"); }
                                @if (canFeature(Cafe.Services.FeatureCatalog.Marketing))
                                {
                                    NavLink("CheckoutSettings", "Index", "fa-cash-register", "Checkout Settings", "CheckoutSettings");
                                }
                                @if (isOwner)
                                {
                                    NavLink("Subscription", "Index", "fa-gem", "Plan & Billing", "Subscription");
                                    NavLink("TenantSettings", "Branding", "fa-palette", "Branding", "TenantSettings");
                                    NavLink("Setup", "Index", "fa-wand-magic-sparkles", "Setup Wizard", "Setup");
                                    NavLink("Demo", "Index", "fa-flask", "Demo Data", "Demo");
                                    NavLink("Notification", "Index", "fa-bell", "Notifications", "Notification");
                                    NavLink("AuditLog", "Index", "fa-shield-halved", "Audit Logs", "AuditLog");
                                }
                            </div></div>
                        </div>
                    }
                }
            </nav>

            <!-- Sidebar Footer -->
            <div class="sidebar-footer">
                @if (isAuthenticated)
                {
                    <a asp-controller="User" asp-action="Profile" class="sidebar-link" data-nav="User">
                        <span class="sidebar-link-icon"><i class="fas fa-circle-user"></i></span>
                        <span class="sidebar-link-text">My Profile</span>
                    </a>
                    <a asp-controller="User" asp-action="Settings" class="sidebar-link" data-nav="Settings">
                        <span class="sidebar-link-icon"><i class="fas fa-gear"></i></span>
                        <span class="sidebar-link-text">Settings</span>
                    </a>
                }

                <!-- Pin/Unpin Toggle -->
                <button class="sidebar-toggle" id="sidebarToggle" title="Pin sidebar">
                    <i class="fas fa-thumbtack"></i>
                </button>
            </div>
        </aside>

        <!-- ═══ MAIN WRAPPER ═══ -->
        <div class="main-wrapper" id="mainWrapper">
            <!-- Top Header -->
            <header class="top-header">
                <div class="header-left">
                    <button class="mobile-menu-btn" id="mobileMenuBtn">
                        <i class="fas fa-bars"></i>
                    </button>
                    <div>
                        <h1 class="header-title">@ViewData["Title"]</h1>
                    </div>
                </div>

                <div class="header-right">
                    @* POS quick-launch: one click to the register from any page. Shown only to
                       roles that can actually open the POS (Staff and above — mirrors
                       PosController's [RequireStaffOrAbove]) and only when the plan enables the
                       POS/Orders feature, the same gate the sidebar Register link lives under. *@
                    @if (isAuthenticated && !isPlatform && (isOwnerOrManager || isStaff)
                         && canFeature(Cafe.Services.FeatureCatalog.Orders))
                    {
                        <a asp-controller="Pos" asp-action="Index" id="posQuickBtn" class="header-icon-btn"
                           data-tooltip="New Sale (POS)" style="text-decoration:none;color:var(--accent);">
                            <i class="fas fa-cash-register"></i>
                        </a>
                    }
                    <!-- Notification Bell -->
                    @if (isAuthenticated)
                    {
                        <div style="position:relative;" id="notifBellContainer">
                            <button class="header-icon-btn" data-tooltip="Notifications" id="notifBellBtn" onclick="toggleNotifDropdown(event)" style="position:relative;">
                                <i class="fas fa-bell" id="notifBellIcon"></i>
                                <span id="notifBadge" style="display:none;position:absolute;top:0;right:0;min-width:18px;height:18px;border-radius:10px;background:linear-gradient(135deg,var(--danger),var(--danger));color:#fff;font-size:0.6rem;font-weight:800;align-items:center;justify-content:center;padding:0 4px;line-height:1;box-shadow:0 2px 6px rgba(220,38,38,0.4);border:2px solid var(--surface);">0</span>
                            </button>

                            <!-- Premium Dropdown -->
                            <div id="notifDropdown" style="display:none;position:absolute;top:calc(100% + 10px);right:-40px;width:400px;background:var(--bg-surface);border-radius:16px;box-shadow:0 12px 48px rgba(0,0,0,0.22),0 2px 8px rgba(0,0,0,0.14);border:1px solid var(--border);z-index:9999;overflow:hidden;opacity:0;transform:translateY(-10px);transition:opacity 0.25s ease,transform 0.25s ease;">
                                <!-- Arrow -->
                                <div style="position:absolute;top:-6px;right:52px;width:12px;height:12px;background:var(--bg-surface);border-left:1px solid var(--border);border-top:1px solid var(--border);transform:rotate(45deg);z-index:1;"></div>
                                <!-- Header -->
                                <div style="padding:1rem 1.15rem;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;background:var(--bg-surface-alt);">
                                    <div style="display:flex;align-items:center;gap:0.5rem;">
                                        <span style="font-weight:800;font-size:0.92rem;color:var(--text-primary);">Notifications</span>
                                        <span id="notifCountPill" style="display:none;background:linear-gradient(135deg,var(--info),#8b5cf6);color:#fff;font-size:0.55rem;font-weight:700;padding:2px 7px;border-radius:20px;"></span>
                                    </div>
                                    <button onclick="markAllReadFromBell()" style="background:none;border:none;color:var(--info);font-size:0.72rem;cursor:pointer;font-weight:600;padding:4px 8px;border-radius:6px;transition:background 0.15s;" onmouseenter="this.style.background='var(--info-light)'" onmouseleave="this.style.background='none'">
                                        <i class="fas fa-check-double" style="margin-right:0.25rem;font-size:0.6rem;"></i>Mark all read
                                    </button>
                                </div>
                                <!-- Loading State -->
                                <div id="notifLoading" style="display:none;text-align:center;padding:2rem;">
                                    <div style="width:28px;height:28px;border:3px solid var(--border-light);border-top-color:var(--info);border-radius:50%;animation:notifSpin 0.8s linear infinite;margin:0 auto;"></div>
                                    <div class="caption" style="margin-top:0.5rem;">Loading...</div>
                                </div>
                                <!-- Items -->
                                <div id="notifDropdownList" style="max-height:380px;overflow-y:auto;scrollbar-width:thin;"></div>
                                <!-- Footer -->
                                <div style="padding:0.7rem 1rem;border-top:1px solid var(--border);text-align:center;background:var(--bg-surface-alt);">
                                    <a href="/Notification/Index" style="color:var(--info);font-size:0.78rem;font-weight:700;text-decoration:none;display:flex;align-items:center;justify-content:center;gap:0.35rem;padding:4px 0;border-radius:6px;transition:background 0.15s;" onmouseenter="this.style.background='rgba(99,102,241,0.06)'" onmouseleave="this.style.background='transparent'">
                                        View All Notifications <i class="fas fa-arrow-right" style="font-size:0.6rem;"></i>
                                    </a>
                                </div>
                            </div>
                        </div>

                        <!-- Toast Container -->
                        <div id="notifToastContainer" style="position:fixed;top:80px;right:20px;z-index:99999;display:flex;flex-direction:column;gap:0.5rem;pointer-events:none;"></div>
                    }
                    @{
                        var curCulture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
                        var returnPath = Context.Request.Path + Context.Request.QueryString;
                    }
                    <div style="position:relative;" id="langMenu">
                        <button class="header-icon-btn" data-tooltip="Language" onclick="document.getElementById('langDrop').style.display=document.getElementById('langDrop').style.display==='block'?'none':'block'">
                            <i class="fas fa-language"></i>
                        </button>
                        <div id="langDrop" style="display:none;position:absolute;top:calc(100% + 8px);right:0;background:var(--bg-surface);border:1px solid var(--border);border-radius:10px;box-shadow:0 8px 24px rgba(0,0,0,0.15);z-index:9999;overflow:hidden;min-width:130px;">
                            @foreach (var (code, label) in new[] { ("en", "English"), ("ur", "اردو") })
                            {
                                <a href="/Language/Set?culture=@code&returnUrl=@Uri.EscapeDataString(returnPath)" style="display:block;padding:0.55rem 0.9rem;text-decoration:none;color:var(--text-primary);font-size:0.85rem;@(curCulture == code ? "background:var(--accent-light);font-weight:700;" : "")">@label</a>
                            }
                        </div>
                    </div>
                    <div style="position:relative;" id="themeMenu">
                        <button class="header-icon-btn" id="themeToggle" data-tooltip="Theme" aria-haspopup="menu" aria-expanded="false">
                            <i class="fas fa-sun" id="themeIcon"></i>
                        </button>
                    </div>
                    <button class="header-icon-btn" data-tooltip="Search" id="globalSearchBtn">
                        <i class="fas fa-magnifying-glass"></i>
                    </button>

                    <div class="header-avatar">
                        <div class="header-avatar-img">
                            @if (!string.IsNullOrEmpty(userName))
                            {
                                @userName.Substring(0, 1).ToUpper()
                            }
                            else
                            {
                                <i class="fas fa-user" style="font-size:13px;"></i>
                            }
                        </div>
                        <div class="header-avatar-info" style="display:none;">
                        </div>
                    </div>

                    @if (isAuthenticated)
                    {
                        <form asp-controller="Auth" asp-action="Logout" method="post" style="margin:0;">
                            <button type="submit" class="header-icon-btn" data-tooltip="Sign out">
                                <i class="fas fa-arrow-right-from-bracket"></i>
                            </button>
                        </form>
                    }
                </div>
            </header>

            <!-- Page Content -->
            <main class="page-content">
                @if (impersonatingId.HasValue)
                {
                    <div style="display:flex;align-items:center;justify-content:space-between;gap:1rem;flex-wrap:wrap;background:linear-gradient(135deg,#7c3aed,var(--info));color:#fff;padding:0.7rem 1.1rem;border-radius:12px;margin-bottom:1.25rem;box-shadow:0 4px 14px rgba(99,102,241,0.3);">
                        <div style="display:flex;align-items:center;gap:0.6rem;font-weight:600;font-size:0.9rem;">
                            <i class="fas fa-user-secret"></i>
                            Impersonating <b>@impersonatingName</b> — actions are audited.
                        </div>
                        <form asp-controller="Platform" asp-action="ExitImpersonation" method="post" style="margin:0;">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm" style="background:rgba(255,255,255,0.2);color:#fff;border:1px solid rgba(255,255,255,0.4);">
                                <i class="fas fa-arrow-right-from-bracket" style="margin-right:0.4rem;"></i>Exit to Console
                            </button>
                        </form>
                    </div>
                }
                <!-- ActionCard TempData triggers -->
                @if (TempData["Success"] != null)
                {
                    <div id="ac-tempdata-success" data-message="@TempData["Success"]" style="display:none;"></div>
                }
                @if (TempData["Error"] != null)
                {
                    <div id="ac-tempdata-error" data-message="@TempData["Error"]" style="display:none;"></div>
                }

                @RenderBody()
            </main>

            <!-- Footer -->
            <footer class="app-footer">
                &copy; @DateTime.Now.Year Cafe Management System &middot;
                <a asp-controller="Home" asp-action="Privacy">Privacy Policy</a>
            </footer>
        </div>
    </div>

    @if (isAuthenticated)
    {
        <!-- ═══ COMMAND PALETTE (Ctrl+K) — indexes the rendered nav, so it only
             ever offers pages this user's role and plan can actually open ═══ -->
        <div class="cmdk-overlay" id="cmdkOverlay">
            <div class="cmdk-panel">
                <div class="cmdk-input-row">
                    <i class="fas fa-magnifying-glass"></i>
                    <input type="text" class="cmdk-input" id="cmdkInput" placeholder="Go to a module or action..." autocomplete="off" />
                    <span class="cmdk-hint">Esc</span>
                </div>
                <div class="cmdk-list" id="cmdkList"></div>
            </div>
        </div>
    }

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/actioncard.js"></script>
    <script src="~/js/ui.js" asp-append-version="true"></script>
    <script>
        // ── Sidebar: collapsed by default, expand on hover ──
        (function() {
            const sidebar = document.getElementById('sidebar');
            const toggle = document.getElementById('sidebarToggle');
            const overlay = document.getElementById('sidebarOverlay');
            const mobileBtn = document.getElementById('mobileMenuBtn');

            // Toggle pin/unpin sidebar
            toggle?.addEventListener('click', function() {
                sidebar.classList.toggle('expanded');
            });

            mobileBtn?.addEventListener('click', function() {
                sidebar.classList.toggle('mobile-open');
                overlay.classList.toggle('visible');
            });

            overlay?.addEventListener('click', function() {
                sidebar.classList.remove('mobile-open');
                overlay.classList.remove('visible');
            });

            // ── Collapsible Groups — open state persists per user in localStorage ──
            const GROUP_KEY = 'cafenav-open-groups';
            let openGroups = [];
            try { openGroups = JSON.parse(localStorage.getItem(GROUP_KEY)) || []; } catch (e) { openGroups = []; }

            document.querySelectorAll('.sidebar-group').forEach(group => {
                const key = group.getAttribute('data-group');
                if (openGroups.includes(key)) group.classList.add('open');
                group.querySelector('.sidebar-group-header')?.addEventListener('click', function () {
                    group.classList.toggle('open');
                    const open = group.classList.contains('open');
                    openGroups = openGroups.filter(k => k !== key);
                    if (open) openGroups.push(key);
                    localStorage.setItem(GROUP_KEY, JSON.stringify(openGroups));
                });
            });

            // ── Active Nav Highlight — longest href-prefix wins, falling back to
            //    matching the controller segment (so /Financial/Reports still lights
            //    up the "Financial Dashboard" entry) ──
            const currentPath = window.location.pathname.toLowerCase();
            const links = Array.from(document.querySelectorAll('.sidebar-link[data-nav]'));
            let best = null, bestLen = -1;
            links.forEach(link => {
                const href = (link.getAttribute('href') || '').toLowerCase();
                if (!href) return;
                if ((href === '/' && currentPath === '/') ||
                    (href !== '/' && currentPath.startsWith(href))) {
                    if (href.length > bestLen) { best = link; bestLen = href.length; }
                }
            });
            if (!best && currentPath !== '/') {
                const seg = currentPath.split('/')[1];
                if (seg) {
                    best = links.find(link => {
                        const href = (link.getAttribute('href') || '').toLowerCase();
                        return href.split('/')[1] === seg;
                    }) || null;
                }
            }
            if (best) {
                best.classList.add('active');
                // Reveal the group that owns the current page, without persisting it
                const group = best.closest('.sidebar-group');
                if (group) group.classList.add('open', 'has-active');
            }
        })();

        // ── Command Palette — Ctrl+K / header search: jump anywhere in two keys ──
        (function() {
            const overlay = document.getElementById('cmdkOverlay');
            const input = document.getElementById('cmdkInput');
            const listEl = document.getElementById('cmdkList');
            if (!overlay || !input || !listEl) return;

            // Build the index from the sidebar + footer links actually rendered
            const items = [];
            document.querySelectorAll('.sidebar-nav .sidebar-link[data-nav], .sidebar-footer .sidebar-link[data-nav]').forEach(link => {
                const label = link.querySelector('.sidebar-link-text')?.textContent.trim();
                const href = link.getAttribute('href');
                if (!label || !href) return;
                const group = link.closest('.sidebar-group');
                const groupLabel = group
                    ? group.querySelector('.sidebar-group-header .sidebar-link-text')?.textContent.trim() || ''
                    : (link.closest('.sidebar-footer') ? 'Account' : 'General');
                const icon = link.querySelector('.sidebar-link-icon i')?.className || 'fas fa-link';
                items.push({ label, href, group: groupLabel, icon });
            });

            let selected = 0, filtered = items;

            function render() {
                if (filtered.length === 0) {
                    listEl.innerHTML = '<div class="cmdk-empty"><i class="fas fa-magnifying-glass" style="display:block;margin-bottom:0.5rem;opacity:0.4;"></i>No matching pages</div>';
                    return;
                }
                let html = '', lastGroup = null;
                filtered.forEach((it, i) => {
                    if (it.group !== lastGroup) {
                        html += `<div class="cmdk-section">${it.group}</div>`;
                        lastGroup = it.group;
                    }
                    html += `<a class="cmdk-item ${i === selected ? 'selected' : ''}" data-idx="${i}" href="${it.href}">
                        <span class="cmdk-item-icon"><i class="${it.icon}"></i></span>
                        <span>${it.label}</span>
                        <span class="cmdk-item-group">${it.group}</span>
                    </a>`;
                });
                listEl.innerHTML = html;
                listEl.querySelector('.cmdk-item.selected')?.scrollIntoView({ block: 'nearest' });
            }

            function filter(q) {
                q = q.trim().toLowerCase();
                filtered = !q ? items : items.filter(it =>
                    it.label.toLowerCase().includes(q) || it.group.toLowerCase().includes(q));
                selected = 0;
                render();
            }

            window.openCmdk = function() {
                overlay.classList.add('open');
                input.value = '';
                filter('');
                setTimeout(() => input.focus(), 30);
            };
            function closeCmdk() { overlay.classList.remove('open'); }

            document.getElementById('globalSearchBtn')?.addEventListener('click', window.openCmdk);
            overlay.addEventListener('click', e => { if (e.target === overlay) closeCmdk(); });
            input.addEventListener('input', () => filter(input.value));
            input.addEventListener('keydown', function(e) {
                if (e.key === 'ArrowDown') { e.preventDefault(); selected = Math.min(selected + 1, filtered.length - 1); render(); }
                else if (e.key === 'ArrowUp') { e.preventDefault(); selected = Math.max(selected - 1, 0); render(); }
                else if (e.key === 'Enter') { e.preventDefault(); if (filtered[selected]) window.location.href = filtered[selected].href; }
                else if (e.key === 'Escape') { closeCmdk(); }
            });
            listEl.addEventListener('mousemove', function(e) {
                const item = e.target.closest('.cmdk-item');
                if (item) { selected = parseInt(item.dataset.idx, 10); render(); }
            });
            document.addEventListener('keydown', function(e) {
                if ((e.ctrlKey || e.metaKey) && (e.key === 'k' || e.key === 'K')) {
                    e.preventDefault();
                    overlay.classList.contains('open') ? closeCmdk() : window.openCmdk();
                }
            });
        })();

        // ── Theme engine lives in ~/js/ui.js (UI.setTheme + picker popover) ──

        // ── Submit Spinner — disable buttons and show spinner on form submit ──
        (function() {
            document.addEventListener('submit', function(e) {
                const form = e.target;
                // Skip forms with data-no-spinner attribute
                if (form.hasAttribute('data-no-spinner')) return;
                // Skip forms handled by data-confirm (they use ActionCard)
                // Actually we let them through since ActionCard calls form.submit() directly
                const btns = form.querySelectorAll('button[type="submit"], input[type="submit"]');
                btns.forEach(function(btn) {
                    btn.disabled = true;
                    const originalContent = btn.innerHTML;
                    btn.setAttribute('data-original', originalContent);
                    btn.innerHTML = '<i class="fas fa-spinner fa-spin" style="margin-right:0.4rem;"></i>' + (btn.textContent.trim() || 'Saving...');
                });
                // Re-enable after 8s fallback (in case server errors don't redirect)
                setTimeout(function() {
                    btns.forEach(function(btn) {
                        btn.disabled = false;
                        const orig = btn.getAttribute('data-original');
                        if (orig) btn.innerHTML = orig;
                    });
                }, 8000);
            });
        })();

        // ── Inline Validation — real-time feedback on required fields ──
        (function() {
            document.addEventListener('DOMContentLoaded', function() {
                // Add validation on blur for required inputs
                document.querySelectorAll('input[required], select[required], textarea[required]').forEach(function(el) {
                    el.addEventListener('blur', function() {
                        if (!el.value.trim()) {
                            el.style.borderColor = 'var(--danger)';
                            el.style.boxShadow = '0 0 0 3px var(--danger-light)';
                        } else {
                            el.style.borderColor = 'var(--success)';
                            el.style.boxShadow = '0 0 0 3px var(--success-light)';
                        }
                    });
                    el.addEventListener('input', function() {
                        if (el.value.trim()) {
                            el.style.borderColor = 'var(--success)';
                            el.style.boxShadow = '0 0 0 3px var(--success-light)';
                        }
                    });
                });
                // Email format validation
                document.querySelectorAll('input[type="email"]').forEach(function(el) {
                    el.addEventListener('blur', function() {
                        const emailRe = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
                        if (el.value && !emailRe.test(el.value)) {
                            el.style.borderColor = 'var(--danger)';
                            el.style.boxShadow = '0 0 0 3px var(--danger-light)';
                        }
                    });
                });
                // Number range validation
                document.querySelectorAll('input[type="number"]').forEach(function(el) {
                    el.addEventListener('blur', function() {
                        const min = el.getAttribute('min');
                        const max = el.getAttribute('max');
                        let invalid = false;
                        if (min !== null && parseFloat(el.value) < parseFloat(min)) invalid = true;
                        if (max !== null && parseFloat(el.value) > parseFloat(max)) invalid = true;
                        if (invalid && el.value !== '') {
                            el.style.borderColor = 'var(--danger)';
                            el.style.boxShadow = '0 0 0 3px var(--danger-light)';
                        }
                    });
                });
            });
        })();

        // ── Keyboard Shortcuts ──
        (function() {
            document.addEventListener('keydown', function(e) {
                // Skip if typing in an input/textarea/select
                const tag = document.activeElement && document.activeElement.tagName;
                if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT') return;

                // N = click first "New" / "Add" / "Create" / primary action btn in header
                if (e.key === 'n' || e.key === 'N') {
                    const primaryBtn = document.querySelector('.btn-primary[href], a.btn-primary');
                    if (primaryBtn) { e.preventDefault(); primaryBtn.click(); }
                }
                // P = open the POS register (only when the quick-launch icon is rendered,
                // i.e. the user's role + plan allow POS)
                if (e.key === 'p' || e.key === 'P') {
                    const posBtn = document.getElementById('posQuickBtn');
                    if (posBtn) { e.preventDefault(); window.location.href = posBtn.href; }
                }
                // Escape = click Cancel link/button
                if (e.key === 'Escape') {
                    const cancelBtn = document.querySelector('a.btn-secondary[href*="Index"], a.btn[href*="Index"]');
                    if (cancelBtn) { e.preventDefault(); cancelBtn.click(); }
                }
                // / = focus the page's search input; fall back to the command palette
                if (e.key === '/') {
                    const searchInput = document.querySelector('input[type="search"], input[placeholder*="Search"], input[placeholder*="search"]');
                    if (searchInput) { e.preventDefault(); searchInput.focus(); }
                    else if (window.openCmdk) { e.preventDefault(); window.openCmdk(); }
                }
                // ? = show keyboard shortcuts help
                if (e.key === '?') {
                    e.preventDefault();
                    if (window.ActionCard) {
                        ActionCard.info('Keyboard Shortcuts',
                            '<div style="text-align:left;font-size:0.875rem;line-height:2;">' +
                            '<b>Ctrl+K</b> — Go to any module<br>' +
                            '<b>N</b> — New / Add record<br>' +
                            '<b>P</b> — Open POS register<br>' +
                            '<b>Esc</b> — Cancel / Back<br>' +
                            '<b>/</b> — Focus search<br>' +
                            '<b>?</b> — Show this help' +
                            '</div>'
                        );
                    }
                }
            });
        })();

        // ── Skeleton Loader Utility ──
        window.Skeleton = {
            show: function(containerSelector) {
                const el = document.querySelector(containerSelector);
                if (!el) return;
                el.classList.add('skeleton-loading');
            },
            hide: function(containerSelector) {
                const el = document.querySelector(containerSelector);
                if (!el) return;
                el.classList.remove('skeleton-loading');
            }
        };
    </script>

    <!-- SignalR -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

    @if (isAuthenticated)
    {
        <script>
        // ── Premium Notification System ──
        (function() {
            const badge = document.getElementById('notifBadge');
            const dropdown = document.getElementById('notifDropdown');
            const list = document.getElementById('notifDropdownList');
            const loading = document.getElementById('notifLoading');
            const countPill = document.getElementById('notifCountPill');
            const bellIcon = document.getElementById('notifBellIcon');
            const toastContainer = document.getElementById('notifToastContainer');
            let isOpen = false;
            let lastUnreadCount = 0;
            let isFirstLoad = true;

            // ── Badge ──
            function updateBadge(count) {
                if (!badge) return;
                if (count > 0) {
                    badge.textContent = count > 99 ? '99+' : count;
                    badge.style.display = 'flex';
                } else {
                    badge.style.display = 'none';
                }
                // Header pill
                if (countPill) {
                    if (count > 0) {
                        countPill.textContent = count + ' new';
                        countPill.style.display = 'inline';
                    } else {
                        countPill.style.display = 'none';
                    }
                }
            }

            // ── Bell Ring Animation ──
            function ringBell() {
                if (!bellIcon) return;
                bellIcon.classList.add('bell-ringing');
                setTimeout(() => bellIcon.classList.remove('bell-ringing'), 1200);
            }

            // ── Colors ──
            function typeColor(type) {
                switch(type) {
                    case 'Success': return 'var(--success)';
                    case 'Warning': return 'var(--warning)';
                    case 'Error':   return 'var(--danger)';
                    default:        return 'var(--info)';
                }
            }
            function typeBg(type) {
                switch(type) {
                    case 'Success': return 'rgba(22,163,106,0.08)';
                    case 'Warning': return 'rgba(217,119,6,0.08)';
                    case 'Error':   return 'rgba(220,38,38,0.08)';
                    default:        return 'var(--info-light)';
                }
            }

            // ── Toast Popup ──
            function showToast(notification) {
                if (!toastContainer) return;
                const c = typeColor(notification.type);
                const toast = document.createElement('div');
                toast.style.cssText = `pointer-events:auto;display:flex;align-items:flex-start;gap:0.65rem;padding:0.85rem 1rem;background:var(--surface);border-radius:12px;box-shadow:0 8px 32px rgba(0,0,0,0.12),0 2px 4px rgba(0,0,0,0.06);border:1px solid var(--border-light);border-left:4px solid ${c};min-width:320px;max-width:400px;transform:translateX(120%);transition:transform 0.4s cubic-bezier(0.34,1.56,0.64,1),opacity 0.3s;cursor:pointer;`;
                toast.innerHTML = `
                    <div style="width:32px;height:32px;border-radius:10px;background:${typeBg(notification.type)};color:${c};display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:0.8rem;">
                        <i class="${notification.icon || 'fas fa-bell'}"></i>
                    </div>
                    <div style="flex:1;min-width:0;">
                        <div style="font-weight:700;font-size:0.8rem;color:var(--text-primary);margin-bottom:2px;">${notification.title || 'New Notification'}</div>
                        <div style="font-size:0.72rem;color:var(--text-secondary);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${notification.message || ''}</div>
                    </div>
                    <button onclick="this.parentElement.remove()" style="background:none;border:none;color:var(--text-tertiary);cursor:pointer;font-size:0.7rem;padding:2px;flex-shrink:0;">&times;</button>
                `;
                toast.onclick = function(e) {
                    if (e.target.tagName === 'BUTTON') return;
                    if (notification.redirectUrl) window.location.href = notification.redirectUrl;
                    else window.location.href = '/Notification/Index';
                    toast.remove();
                };
                toastContainer.appendChild(toast);
                requestAnimationFrame(() => { toast.style.transform = 'translateX(0)'; });
                setTimeout(() => {
                    toast.style.opacity = '0';
                    toast.style.transform = 'translateX(120%)';
                    setTimeout(() => toast.remove(), 400);
                }, 5000);
            }

            // ── Render Dropdown Items ──
            function renderItems(notifications) {
                if (!list) return;
                if (!notifications || notifications.length === 0) {
                    list.innerHTML = `
                        <div style="text-align:center;padding:2.5rem 1rem;">
                            <div style="width:56px;height:56px;border-radius:14px;background:rgba(99,102,241,0.06);display:flex;align-items:center;justify-content:center;margin:0 auto 0.75rem;">
                                <i class="fas fa-bell-slash" style="font-size:1.3rem;color:var(--text-tertiary);"></i>
                            </div>
                            <div style="font-weight:600;font-size:0.85rem;color:var(--text-secondary);margin-bottom:0.2rem;">All caught up!</div>
                            <div style="font-size:0.72rem;color:var(--text-tertiary);">No new notifications right now</div>
                        </div>`;
                    return;
                }

                // Group: Today / Yesterday / Earlier
                const now = new Date();
                const today = new Date(now.getFullYear(), now.getMonth(), now.getDate()).getTime();
                const yesterday = today - 86400000;

                const groups = { today: [], yesterday: [], earlier: [] };
                notifications.forEach(n => {
                    const created = new Date(n.createdAt).getTime();
                    if (created >= today) groups.today.push(n);
                    else if (created >= yesterday) groups.yesterday.push(n);
                    else groups.earlier.push(n);
                });

                let html = '';

                function renderGroup(label, items) {
                    if (items.length === 0) return '';
                    let h = `<div style="padding:0.45rem 1.15rem 0.2rem;font-size:0.6rem;font-weight:800;color:var(--text-tertiary);text-transform:uppercase;letter-spacing:1px;background:var(--bg-surface-alt);">${label}</div>`;
                    items.forEach(n => {
                        const c = typeColor(n.type);
                        const bg = n.isRead ? 'var(--bg-surface)' : 'var(--bg-surface-alt)';
                        const bl = n.isRead ? '3px solid transparent' : '3px solid ' + c;
                        h += `<a href="javascript:void(0)" onclick="clickNotif(${n.id}, '${n.redirectUrl || ''}')"
                            style="display:flex;align-items:flex-start;gap:0.65rem;padding:0.7rem 1.1rem;border-bottom:1px solid var(--border-light);text-decoration:none;background:${bg};border-left:${bl};transition:all 0.2s;"
                            onmouseenter="this.style.background='var(--bg-surface-hover)';this.style.paddingLeft='1.3rem'"
                            onmouseleave="this.style.background='${bg}';this.style.paddingLeft='1.1rem'">
                            <div style="width:34px;height:34px;border-radius:10px;background:${typeBg(n.type)};color:${c};display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:0.78rem;">
                                <i class="${n.icon || 'fas fa-info-circle'}"></i>
                            </div>
                            <div style="flex:1;min-width:0;">
                                <div style="display:flex;align-items:center;gap:0.4rem;">
                                    <span style="font-weight:${n.isRead ? '500' : '700'};font-size:0.8rem;color:var(--text-primary);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;flex:1;">${n.title}</span>
                                    ${!n.isRead ? `<span style="width:7px;height:7px;border-radius:50%;background:${c};flex-shrink:0;animation:notifPulse 2s infinite;"></span>` : ''}
                                </div>
                                <div style="font-size:0.72rem;color:var(--text-secondary);margin-top:1px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${n.message}</div>
                                <div style="display:flex;align-items:center;gap:0.5rem;margin-top:3px;">
                                    <span style="font-size:0.62rem;color:var(--text-tertiary);"><i class="far fa-clock" style="margin-right:2px;"></i>${n.timeAgo}</span>
                                    <span style="font-size:0.55rem;font-weight:700;color:${c};background:${typeBg(n.type)};padding:1px 6px;border-radius:4px;text-transform:uppercase;letter-spacing:0.3px;">${n.type}</span>
                                </div>
                            </div>
                        </a>`;
                    });
                    return h;
                }

                html += renderGroup('Today', groups.today);
                html += renderGroup('Yesterday', groups.yesterday);
                html += renderGroup('Earlier', groups.earlier);

                list.innerHTML = html;
            }

            // ── Load Notifications ──
            async function loadNotifications(showLoading) {
                try {
                    if (showLoading && loading) {
                        loading.style.display = 'block';
                        if (list) list.style.display = 'none';
                    }
                    const res = await fetch('/Notification/GetRecent');
                    if (!res.ok) throw new Error('API error');
                    const data = await res.json();

                    if (loading) loading.style.display = 'none';
                    if (list) list.style.display = 'block';

                    updateBadge(data.unreadCount);
                    renderItems(data.notifications);

                    // Ring bell + show toast if new notifications appeared
                    if (!isFirstLoad && data.unreadCount > lastUnreadCount) {
                        ringBell();
                        // Show toast for the newest notification
                        if (data.notifications && data.notifications.length > 0) {
                            showToast(data.notifications[0]);
                        }
                    }
                    lastUnreadCount = data.unreadCount;
                    isFirstLoad = false;
                } catch(e) {
                    console.warn('Notification load error:', e);
                    if (loading) loading.style.display = 'none';
                    if (list) {
                        list.style.display = 'block';
                        list.innerHTML = `
                            <div style="text-align:center;padding:2rem;color:var(--text-tertiary);">
                                <i class="fas fa-wifi" style="font-size:1.2rem;margin-bottom:0.5rem;display:block;opacity:0.4;"></i>
                                <div style="font-size:0.78rem;">Unable to load notifications</div>
                                <button onclick="loadNotifications(true)" style="margin-top:0.5rem;background:none;border:1px solid var(--border-light);color:var(--info);font-size:0.72rem;padding:4px 12px;border-radius:6px;cursor:pointer;">Retry</button>
                            </div>`;
                    }
                }
            }

            // ── Toggle Dropdown ──
            window.toggleNotifDropdown = function(e) {
                e?.stopPropagation();
                isOpen = !isOpen;
                if (isOpen) {
                    dropdown.style.display = 'block';
                    requestAnimationFrame(() => {
                        dropdown.style.opacity = '1';
                        dropdown.style.transform = 'translateY(0)';
                    });
                    loadNotifications(true);
                } else {
                    closeDropdown();
                }
            };

            function closeDropdown() {
                isOpen = false;
                if (!dropdown) return;
                dropdown.style.opacity = '0';
                dropdown.style.transform = 'translateY(-10px)';
                setTimeout(() => { dropdown.style.display = 'none'; }, 250);
            }

            // Close on outside click
            document.addEventListener('click', function(e) {
                const container = document.getElementById('notifBellContainer');
                if (container && !container.contains(e.target)) closeDropdown();
            });

            // Close on Escape
            document.addEventListener('keydown', function(e) {
                if (e.key === 'Escape' && isOpen) closeDropdown();
            });

            // ── Click Notification ──
            window.clickNotif = async function(id, url) {
                await fetch('/Notification/MarkAsRead?id=' + id, { method: 'POST' });
                closeDropdown();
                if (url && url.length > 0) window.location.href = url;
                else {
                    await loadNotifications(false);
                }
            };

            // ── Mark All Read ──
            window.markAllReadFromBell = async function() {
                await fetch('/Notification/MarkAllAsRead', { method: 'POST' });
                await loadNotifications(false);
            };

            // ── Initial Load ──
            loadNotifications(false);

            // ── Poll every 30s ──
            setInterval(() => loadNotifications(false), 30000);

            // ── SignalR Real-time ──
            try {
                const connection = new signalR.HubConnectionBuilder()
                    .withUrl('/hubs/notifications')
                    .withAutomaticReconnect()
                    .build();

                connection.on('ReceiveNotification', function(notif) {
                    ringBell();
                    showToast(notif);
                    loadNotifications(false);
                });

                connection.start().catch(err => console.warn('SignalR connect error:', err));
            } catch(e) { console.warn('SignalR init error', e); }

            // ── Expose for external use ──
            window.loadNotifications = loadNotifications;
        })();
        </script>

        <!-- Notification Animations -->
        <style>
            @@keyframes notifSpin { to { transform: rotate(360deg); } }
            @@keyframes notifPulse {
                0%, 100% { opacity: 1; transform: scale(1); }
                50% { opacity: 0.4; transform: scale(1.4); }
            }
            @@keyframes bellRing {
                0%   { transform: rotate(0); }
                10%  { transform: rotate(14deg); }
                20%  { transform: rotate(-12deg); }
                30%  { transform: rotate(10deg); }
                40%  { transform: rotate(-8deg); }
                50%  { transform: rotate(6deg); }
                60%  { transform: rotate(-4deg); }
                70%  { transform: rotate(2deg); }
                80%  { transform: rotate(0); }
                100% { transform: rotate(0); }
            }
            .bell-ringing {
                animation: bellRing 1.2s ease-in-out;
                color: var(--accent) !important;
            }
            #notifDropdownList::-webkit-scrollbar { width: 4px; }
            #notifDropdownList::-webkit-scrollbar-track { background: transparent; }
            #notifDropdownList::-webkit-scrollbar-thumb { background: rgba(0,0,0,0.1); border-radius: 4px; }
        </style>
    }
</body>
</html>