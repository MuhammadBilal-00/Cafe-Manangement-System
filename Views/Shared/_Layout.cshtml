<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Cafe Management</title>

    <!-- Design System -->
    <link rel="stylesheet" href="~/css/design-system.css" asp-append-version="true" />

    <!-- Tailwind CSS (utility support) -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        accent: { DEFAULT: '#d4af37', hover: '#c5a028', light: 'rgba(212,175,55,0.10)' },
                        surface: { DEFAULT: '#ffffff', alt: '#faf9f7', hover: '#fafaf8' },
                        body: '#f5f3f0',
                        sidebar: '#1e2a3a',
                    },
                    fontFamily: { sans: ['Inter', 'system-ui', 'sans-serif'] },
                    borderRadius: { card: '16px' }
                }
            }
        }
    </script>

    <!-- Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    @{
        var userRole = Context.Session.GetString("UserRole");
        var userName = Context.Session.GetString("UserName");
        var isOwner = userRole == "Owner";
        var isManager = userRole == "BranchManager";
        var isStaff = userRole == "Staff";
        var isOwnerOrManager = isOwner || isManager;
        var isAuthenticated = Context.Session.GetString("UserId") != null;
    }

    <!-- Sidebar Overlay (mobile) -->
    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <div class="app-shell">
        <!-- ═══ SIDEBAR ═══ -->
        <aside class="sidebar" id="sidebar">
            <!-- Brand -->
            <div class="sidebar-brand">
                <div class="sidebar-brand-icon">
                    <i class="fas fa-mug-hot"></i>
                </div>
                <div class="sidebar-brand-text">
                    <div class="sidebar-brand-name">Cafe Manager</div>
                    <div class="sidebar-brand-sub">
                        @if (isAuthenticated)
                        {
                            @userRole<text> Panel</text>
                        }
                        else
                        {
                            <text>Please sign in</text>
                        }
                    </div>
                </div>
            </div>

            <!-- Navigation -->
            <nav class="sidebar-nav">
                <!-- Main Navigation -->
                <div class="sidebar-section-label">Main</div>

                <a asp-controller="Home" asp-action="Index" class="sidebar-link" data-nav="Home">
                    <span class="sidebar-link-icon"><i class="fas fa-grid-2"></i></span>
                    <span class="sidebar-link-text">Dashboard</span>
                </a>

                @if (isOwnerOrManager)
                {
                    <a asp-controller="Branch" asp-action="Index" class="sidebar-link" data-nav="Branch">
                        <span class="sidebar-link-icon"><i class="fas fa-store"></i></span>
                        <span class="sidebar-link-text">Branches</span>
                    </a>

                    <a asp-controller="Staff" asp-action="Index" class="sidebar-link" data-nav="Staff">
                        <span class="sidebar-link-icon"><i class="fas fa-users"></i></span>
                        <span class="sidebar-link-text">Staff</span>
                    </a>
                }

                @if (userRole != "Customer")
                {
                    <div class="sidebar-section-label">Operations</div>

                    <a asp-controller="MenuItem" asp-action="Index" class="sidebar-link" data-nav="MenuItem">
                        <span class="sidebar-link-icon"><i class="fas fa-utensils"></i></span>
                        <span class="sidebar-link-text">Menu</span>
                    </a>

                    <a asp-controller="Order" asp-action="Index" class="sidebar-link" data-nav="Order">
                        <span class="sidebar-link-icon"><i class="fas fa-receipt"></i></span>
                        <span class="sidebar-link-text">Orders</span>
                    </a>
                }

                @if (isOwnerOrManager)
                {
                    <a asp-controller="InventoryItem" asp-action="Index" class="sidebar-link" data-nav="InventoryItem">
                        <span class="sidebar-link-icon"><i class="fas fa-boxes-stacked"></i></span>
                        <span class="sidebar-link-text">Inventory</span>
                    </a>
                }

                @if (userRole != "Customer")
                {
                    <div class="sidebar-section-label">People</div>

                    <a asp-controller="Attendance" asp-action="Index" class="sidebar-link" data-nav="Attendance">
                        <span class="sidebar-link-icon"><i class="fas fa-calendar-check"></i></span>
                        <span class="sidebar-link-text">Attendance</span>
                    </a>
                }

                @if (isOwnerOrManager)
                {
                    <a asp-controller="Salary" asp-action="Index" class="sidebar-link" data-nav="Salary">
                        <span class="sidebar-link-icon"><i class="fas fa-wallet"></i></span>
                        <span class="sidebar-link-text">Payroll</span>
                    </a>

                    <div class="sidebar-section-label">Analytics</div>

                    <a asp-controller="Financial" asp-action="Dashboard" class="sidebar-link" data-nav="Financial">
                        <span class="sidebar-link-icon"><i class="fas fa-chart-pie"></i></span>
                        <span class="sidebar-link-text">Financials</span>
                    </a>

                    <a asp-controller="Reports" asp-action="Index" class="sidebar-link" data-nav="Reports">
                        <span class="sidebar-link-icon"><i class="fas fa-chart-line"></i></span>
                        <span class="sidebar-link-text">Reports</span>
                    </a>

                    <a asp-controller="Feedback" asp-action="Index" class="sidebar-link" data-nav="Feedback">
                        <span class="sidebar-link-icon"><i class="fas fa-message"></i></span>
                        <span class="sidebar-link-text">Feedback</span>
                    </a>
                }

                @if (isOwner)
                {
                    <div class="sidebar-section-label">System</div>

                    <a asp-controller="Notification" asp-action="Admin" class="sidebar-link" data-nav="NotificationAdmin">
                        <span class="sidebar-link-icon"><i class="fas fa-bullhorn"></i></span>
                        <span class="sidebar-link-text">Notifications</span>
                    </a>

                    <a asp-controller="AuditLog" asp-action="Index" class="sidebar-link" data-nav="AuditLog">
                        <span class="sidebar-link-icon"><i class="fas fa-shield-halved"></i></span>
                        <span class="sidebar-link-text">Audit Logs</span>
                    </a>
                }
            </nav>

            <!-- Sidebar Footer -->
            <div class="sidebar-footer">
                @if (isAuthenticated)
                {
                    <a asp-controller="User" asp-action="Profile" class="sidebar-link" data-nav="User">
                        <span class="sidebar-link-icon"><i class="fas fa-circle-user"></i></span>
                        <span class="sidebar-link-text">My Profile</span>
                    </a>
                    <a asp-controller="User" asp-action="Settings" class="sidebar-link" data-nav="Settings">
                        <span class="sidebar-link-icon"><i class="fas fa-gear"></i></span>
                        <span class="sidebar-link-text">Settings</span>
                    </a>
                }

                <!-- Pin/Unpin Toggle -->
                <button class="sidebar-toggle" id="sidebarToggle" title="Pin sidebar">
                    <i class="fas fa-thumbtack"></i>
                </button>
            </div>
        </aside>

        <!-- ═══ MAIN WRAPPER ═══ -->
        <div class="main-wrapper" id="mainWrapper">
            <!-- Top Header -->
            <header class="top-header">
                <div class="header-left">
                    <button class="mobile-menu-btn" id="mobileMenuBtn">
                        <i class="fas fa-bars"></i>
                    </button>
                    <div>
                        <h1 class="header-title">@ViewData["Title"]</h1>
                    </div>
                </div>

                <div class="header-right">
                    <!-- Notification Bell -->
                    @if (isAuthenticated)
                    {
                        <div style="position:relative;" id="notifBellContainer">
                            <button class="header-icon-btn" data-tooltip="Notifications" id="notifBellBtn" onclick="toggleNotifDropdown(event)">
                                <i class="fas fa-bell"></i>
                                <span class="notif-badge" id="notifBadge" style="display:none;position:absolute;top:2px;right:2px;min-width:16px;height:16px;border-radius:8px;background:#dc2626;color:#fff;font-size:0.55rem;font-weight:700;display:none;align-items:center;justify-content:center;padding:0 4px;line-height:1;">0</span>
                            </button>

                            <!-- Dropdown -->
                            <div id="notifDropdown" style="display:none;position:absolute;top:calc(100% + 8px);right:0;width:360px;background:var(--surface);border-radius:12px;box-shadow:0 8px 32px rgba(0,0,0,0.12);border:1px solid var(--border-light);z-index:9999;overflow:hidden;opacity:0;transform:translateY(-8px);transition:opacity 0.2s ease,transform 0.2s ease;">
                                <!-- Header -->
                                <div style="padding:0.85rem 1rem;border-bottom:1px solid var(--border-light);display:flex;align-items:center;justify-content:space-between;">
                                    <span style="font-weight:700;font-size:0.9rem;color:var(--text-primary);">Notifications</span>
                                    <button onclick="markAllReadFromBell()" style="background:none;border:none;color:#6366f1;font-size:0.72rem;cursor:pointer;font-weight:600;">Mark all read</button>
                                </div>
                                <!-- Items -->
                                <div id="notifDropdownList" style="max-height:320px;overflow-y:auto;"></div>
                                <!-- Footer -->
                                <div style="padding:0.6rem 1rem;border-top:1px solid var(--border-light);text-align:center;">
                                    <a href="/Notification/Index" style="color:#6366f1;font-size:0.78rem;font-weight:600;text-decoration:none;">View All Notifications</a>
                                </div>
                            </div>
                        </div>
                    }
                    <button class="header-icon-btn" data-tooltip="Search" id="globalSearchBtn">
                        <i class="fas fa-magnifying-glass"></i>
                    </button>

                    <div class="header-avatar">
                        <div class="header-avatar-img">
                            @if (!string.IsNullOrEmpty(userName))
                            {
                                @userName.Substring(0, 1).ToUpper()
                            }
                            else
                            {
                                <i class="fas fa-user" style="font-size:13px;"></i>
                            }
                        </div>
                        <div class="header-avatar-info" style="display:none;">
                        </div>
                    </div>

                    @if (isAuthenticated)
                    {
                        <form asp-controller="Auth" asp-action="Logout" method="post" style="margin:0;">
                            <button type="submit" class="header-icon-btn" data-tooltip="Sign out">
                                <i class="fas fa-arrow-right-from-bracket"></i>
                            </button>
                        </form>
                    }
                </div>
            </header>

            <!-- Page Content -->
            <main class="page-content">
                <!-- ActionCard TempData triggers -->
                @if (TempData["Success"] != null)
                {
                    <div id="ac-tempdata-success" data-message="@TempData["Success"]" style="display:none;"></div>
                }
                @if (TempData["Error"] != null)
                {
                    <div id="ac-tempdata-error" data-message="@TempData["Error"]" style="display:none;"></div>
                }

                @RenderBody()
            </main>

            <!-- Footer -->
            <footer class="app-footer">
                &copy; @DateTime.Now.Year Cafe Management System &middot;
                <a asp-controller="Home" asp-action="Privacy">Privacy Policy</a>
            </footer>
        </div>
    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/actioncard.js"></script>
    <script>
        // ── Sidebar: collapsed by default, expand on hover ──
        (function() {
            const sidebar = document.getElementById('sidebar');
            const toggle = document.getElementById('sidebarToggle');
            const overlay = document.getElementById('sidebarOverlay');
            const mobileBtn = document.getElementById('mobileMenuBtn');

            // Toggle pin/unpin sidebar
            toggle?.addEventListener('click', function() {
                sidebar.classList.toggle('expanded');
            });

            mobileBtn?.addEventListener('click', function() {
                sidebar.classList.toggle('mobile-open');
                overlay.classList.toggle('visible');
            });

            overlay?.addEventListener('click', function() {
                sidebar.classList.remove('mobile-open');
                overlay.classList.remove('visible');
            });

            // ── Active Nav Highlight ──
            const currentPath = window.location.pathname.toLowerCase();
            document.querySelectorAll('.sidebar-link[data-nav]').forEach(link => {
                const href = link.getAttribute('href');
                if (href) {
                    const hrefLower = href.toLowerCase();
                    if ((hrefLower === '/' && currentPath === '/') ||
                        (hrefLower !== '/' && currentPath.startsWith(hrefLower))) {
                        link.classList.add('active');
                    }
                }
            });
        })();
    </script>

    <!-- SignalR -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

    @if (isAuthenticated)
    {
        <script>
        // ── Notification System ──
        (function() {
            const badge = document.getElementById('notifBadge');
            const dropdown = document.getElementById('notifDropdown');
            const list = document.getElementById('notifDropdownList');
            let isOpen = false;

            function updateBadge(count) {
                if (!badge) return;
                if (count > 0) {
                    badge.textContent = count > 99 ? '99+' : count;
                    badge.style.display = 'flex';
                } else {
                    badge.style.display = 'none';
                }
            }

            function typeColor(type) {
                switch(type) {
                    case 'Success': return '#16a34a';
                    case 'Warning': return '#d97706';
                    case 'Error':   return '#dc2626';
                    default:        return '#6366f1';
                }
            }

            function renderItems(notifications) {
                if (!list) return;
                if (!notifications || notifications.length === 0) {
                    list.innerHTML = '<div style="text-align:center;padding:2rem;color:var(--text-tertiary);font-size:0.82rem;"><i class="fas fa-bell-slash" style="font-size:1.5rem;margin-bottom:0.5rem;display:block;"></i>No notifications</div>';
                    return;
                }
                list.innerHTML = notifications.map(n => {
                    const c = typeColor(n.type);
                    return `<a href="javascript:void(0)" onclick="clickNotif(${n.id}, '${n.redirectUrl || ''}')" style="display:flex;align-items:flex-start;gap:0.7rem;padding:0.75rem 1rem;border-bottom:1px solid var(--border-light);text-decoration:none;background:${n.isRead ? 'transparent' : 'rgba(99,102,241,0.04)'};transition:background 0.15s;" onmouseenter="this.style.background='var(--bg-hover)'" onmouseleave="this.style.background='${n.isRead ? 'transparent' : 'rgba(99,102,241,0.04)}'">
                        <div style="width:32px;height:32px;border-radius:8px;background:${c}12;color:${c};display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:0.75rem;"><i class="${n.icon || 'fas fa-info-circle'}"></i></div>
                        <div style="flex:1;min-width:0;">
                            <div style="font-weight:${n.isRead ? '500' : '700'};font-size:0.8rem;color:var(--text-primary);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${n.title}</div>
                            <div style="font-size:0.72rem;color:var(--text-secondary);margin-top:1px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${n.message}</div>
                            <div style="font-size:0.65rem;color:var(--text-tertiary);margin-top:3px;">${n.timeAgo}</div>
                        </div>
                        ${!n.isRead ? `<span style="width:7px;height:7px;border-radius:50%;background:${c};flex-shrink:0;margin-top:6px;"></span>` : ''}
                    </a>`;
                }).join('');
            }

            async function loadNotifications() {
                try {
                    const res = await fetch('/Notification/GetRecent');
                    if (!res.ok) return;
                    const data = await res.json();
                    updateBadge(data.unreadCount);
                    renderItems(data.notifications);
                } catch(e) { console.warn('Notif load error', e); }
            }

            window.toggleNotifDropdown = function(e) {
                e?.stopPropagation();
                isOpen = !isOpen;
                if (isOpen) {
                    dropdown.style.display = 'block';
                    requestAnimationFrame(() => {
                        dropdown.style.opacity = '1';
                        dropdown.style.transform = 'translateY(0)';
                    });
                    loadNotifications();
                } else {
                    closeDropdown();
                }
            };

            function closeDropdown() {
                isOpen = false;
                if (!dropdown) return;
                dropdown.style.opacity = '0';
                dropdown.style.transform = 'translateY(-8px)';
                setTimeout(() => { dropdown.style.display = 'none'; }, 200);
            }

            document.addEventListener('click', function(e) {
                const container = document.getElementById('notifBellContainer');
                if (container && !container.contains(e.target)) closeDropdown();
            });

            window.clickNotif = async function(id, url) {
                await fetch('/Notification/MarkAsRead?id=' + id, { method: 'POST' });
                closeDropdown();
                if (url && url.length > 0) window.location.href = url;
                else loadNotifications();
            };

            window.markAllReadFromBell = async function() {
                await fetch('/Notification/MarkAllAsRead', { method: 'POST' });
                loadNotifications();
            };

            // Initial load
            loadNotifications();

            // Poll every 30s as fallback
            setInterval(loadNotifications, 30000);

            // ── SignalR Real-time ──
            try {
                const connection = new signalR.HubConnectionBuilder()
                    .withUrl('/hubs/notifications')
                    .withAutomaticReconnect()
                    .build();

                connection.on('ReceiveNotification', function(notif) {
                    loadNotifications(); // Refresh dropdown + badge
                });

                connection.start().catch(err => console.warn('SignalR connect error:', err));
            } catch(e) { console.warn('SignalR init error', e); }
        })();
        </script>
    }
</body>
</html>