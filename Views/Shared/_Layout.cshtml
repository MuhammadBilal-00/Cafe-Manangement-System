@inject Cafe.Services.ITenantBrandingService Branding
@inject Cafe.Services.IFeatureGate FeatureGate
@inject Cafe.Services.ITenantContext TenantCtx
@{
    var brand = await Branding.GetCurrentAsync();
    var sessRole = Context.Session.GetString("UserRole");
    var isPlatform = sessRole == "PlatformAdmin";
    var impersonatingId = Context.Session.GetInt32("ImpersonatingTenantId");
    var impersonatingName = Context.Session.GetString("ImpersonatingTenantName");
    var sessAuthed = Context.Session.GetString("UserId") != null;
    HashSet<string>? planFeatures = (sessAuthed && !isPlatform) ? await FeatureGate.GetEnabledFeaturesAsync() : null;
    Func<string, bool> canFeature = key =>
        isPlatform
        || Cafe.Services.FeatureCatalog.Core.Contains(key)
        || (planFeatures != null && (planFeatures.Contains("*") || planFeatures.Contains(key)));

    // Phase 10 (i18n): drive the page language + direction from the active culture (Urdu/Arabic = RTL).
    var uiCulture = System.Globalization.CultureInfo.CurrentUICulture;
    var isRtl = uiCulture.TextInfo.IsRightToLeft;
    var pageDir = isRtl ? "rtl" : "ltr";
}
<!DOCTYPE html>
<html lang="@uiCulture.TwoLetterISOLanguageName" dir="@pageDir">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Cafe Management</title>

    <!-- Design System -->
    <link rel="stylesheet" href="~/css/design-system.css" asp-append-version="true" />

    <!-- Tailwind CSS (utility support) -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        accent: { DEFAULT: '#d4af37', hover: '#c5a028', light: 'rgba(212,175,55,0.10)' },
                        surface: { DEFAULT: '#ffffff', alt: '#faf9f7', hover: '#fafaf8' },
                        body: '#f5f3f0',
                        sidebar: '#1e2a3a',
                    },
                    fontFamily: { sans: ['Inter', 'system-ui', 'sans-serif'] },
                    borderRadius: { card: '16px', 'card-lg': '20px' },
                    boxShadow: {
                        'card': '0 1px 3px rgba(0,0,0,0.04), 0 4px 14px rgba(0,0,0,0.03)',
                        'card-hover': '0 4px 12px rgba(0,0,0,0.07), 0 12px 32px rgba(0,0,0,0.06)',
                        'card-elevated': '0 8px 30px rgba(0,0,0,0.08), 0 2px 8px rgba(0,0,0,0.04)',
                        'card-premium': '0 20px 60px rgba(0,0,0,0.08), 0 4px 16px rgba(0,0,0,0.04)',
                    },
                    transitionDuration: {
                        '350': '350ms',
                    },
                    transitionTimingFunction: {
                        'premium': 'cubic-bezier(0.4, 0, 0.2, 1)',
                    },
                }
            }
        }
    </script>

    <!-- Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>

    <style>
/* ── Skeleton Loader ── */
.skeleton-pulse {
    background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
    background-size: 200% 100%;
    animation: skeleton-wave 1.5s infinite;
    border-radius: 6px;
}
@@keyframes skeleton-wave {
    0% { background-position: 200% 0; }
    100% { background-position: -200% 0; }
}
.skeleton-loading .skeleton-pulse {
    animation-play-state: running;
}

/* ── Status Badges for all 10 attendance statuses ── */
.badge-paid-leave   { background:rgba(212,175,55,0.15); color:#92400e; border:1px solid rgba(212,175,55,0.3); }
.badge-sick-leave   { background:rgba(239,68,68,0.1);   color:#991b1b; border:1px solid rgba(239,68,68,0.2); }
.badge-casual-leave { background:rgba(249,115,22,0.1);  color:#9a3412; border:1px solid rgba(249,115,22,0.2); }
.badge-wfh          { background:rgba(99,102,241,0.12); color:#3730a3; border:1px solid rgba(99,102,241,0.2); }
.badge-holiday      { background:rgba(16,185,129,0.12); color:#065f46; border:1px solid rgba(16,185,129,0.2); }
.badge-overtime     { background:rgba(234,179,8,0.12);  color:#713f12; border:1px solid rgba(234,179,8,0.2); }
</style>
    @await RenderSectionAsync("Styles", required: false)
    <!-- Theme init — runs immediately to prevent flash of wrong theme -->
    <script>(function(){var t=localStorage.getItem('cafetheme')||'light';document.documentElement.setAttribute('data-theme',t);})();</script>

    <!-- Per-tenant white-label branding: overrides design-system variables (no per-tenant CSS) -->
    <style>
        :root {
            --accent: @brand.PrimaryColor;
            --accent-hover: @brand.PrimaryColor;
        }
        .sidebar { background: @brand.SidebarColor; }
    </style>
</head>
<body>
    @* Pages send this via a "RequestVerificationToken" header on JSON/fetch POSTs.
       Rendered once here so every page has it, instead of relying on each view
       happening to contain a <form> that incidentally emits the same field. *@
    <form style="display:none">@Html.AntiForgeryToken()</form>
    @{
        var userRole = Context.Session.GetString("UserRole");
        var userName = Context.Session.GetString("UserName");
        var isOwner = userRole == "Owner";
        var isManager = userRole == "BranchManager";
        var isStaff = Cafe.Helpers.AppRoles.IsStaffLevel(userRole);
        var isOwnerOrManager = isOwner || isManager;
        var isAuthenticated = Context.Session.GetString("UserId") != null;
    }

    <!-- Sidebar Overlay (mobile) -->
    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <div class="app-shell">
        <!-- ═══ SIDEBAR ═══ -->
        <aside class="sidebar" id="sidebar">
            <!-- Brand -->
            <div class="sidebar-brand">
                <div class="sidebar-brand-icon">
                    @if (!string.IsNullOrEmpty(brand.LogoUrl))
                    {
                        <img src="@brand.LogoUrl" alt="logo" style="width:100%;height:100%;object-fit:cover;border-radius:inherit;" />
                    }
                    else
                    {
                        <i class="fas fa-mug-hot"></i>
                    }
                </div>
                <div class="sidebar-brand-text">
                    <div class="sidebar-brand-name">@(isPlatform ? "Platform Console" : brand.BusinessName)</div>
                    <div class="sidebar-brand-sub">
                        @if (isAuthenticated)
                        {
                            @(isPlatform ? "SaaS Operator" : userRole + " Panel")
                        }
                        else
                        {
                            <text>Please sign in</text>
                        }
                    </div>
                </div>
            </div>

            <!-- Navigation -->
            <nav class="sidebar-nav">
                @if (isPlatform)
                {
                    <!-- ═══ PLATFORM ADMIN NAV ═══ -->
                    <div class="sidebar-section-label">Platform</div>
                    <a asp-controller="Platform" asp-action="Index" class="sidebar-link" data-nav="PlatformIndex">
                        <span class="sidebar-link-icon"><i class="fas fa-gauge-high"></i></span>
                        <span class="sidebar-link-text">Console</span>
                    </a>
                    <a asp-controller="Platform" asp-action="Tenants" class="sidebar-link" data-nav="PlatformTenants">
                        <span class="sidebar-link-icon"><i class="fas fa-building"></i></span>
                        <span class="sidebar-link-text">Tenants</span>
                    </a>
                    <a asp-controller="Platform" asp-action="Plans" class="sidebar-link" data-nav="PlatformPlans">
                        <span class="sidebar-link-icon"><i class="fas fa-layer-group"></i></span>
                        <span class="sidebar-link-text">Plans</span>
                    </a>

                    <div class="sidebar-section-label">System</div>
                    <a asp-controller="AuditLog" asp-action="Index" class="sidebar-link" data-nav="AuditLog">
                        <span class="sidebar-link-icon"><i class="fas fa-shield-halved"></i></span>
                        <span class="sidebar-link-text">Audit Logs</span>
                    </a>
                }
                else
                {
                    <!-- ═══ TENANT NAV (feature-gated by plan) ═══ -->
                    <div class="sidebar-section-label">Main</div>

                    <a asp-controller="Home" asp-action="Index" class="sidebar-link" data-nav="Home">
                        <span class="sidebar-link-icon"><i class="fas fa-gauge-high"></i></span>
                        <span class="sidebar-link-text">Dashboard</span>
                    </a>

                    @* Customer portal links removed: customers never log in on the closed platform
                       (the Shop module stays in the codebase behind a disabled feature flag). *@
                    @if (isOwnerOrManager)
                    {
                        <a asp-controller="Branch" asp-action="Index" class="sidebar-link" data-nav="Branch">
                            <span class="sidebar-link-icon"><i class="fas fa-store"></i></span>
                            <span class="sidebar-link-text">Branches</span>
                        </a>

                        <a asp-controller="Staff" asp-action="Index" class="sidebar-link" data-nav="Staff">
                            <span class="sidebar-link-icon"><i class="fas fa-users"></i></span>
                            <span class="sidebar-link-text">Staff</span>
                        </a>

                        @if (isOwner)
                        {
                            <a asp-controller="User" asp-action="Index" class="sidebar-link" data-nav="Users">
                                <span class="sidebar-link-icon"><i class="fas fa-user-shield"></i></span>
                                <span class="sidebar-link-text">Users</span>
                            </a>
                        }
                    }

                    @if (userRole != "Customer")
                    {
                        <div class="sidebar-section-label">Operations</div>

                        <a asp-controller="MenuItem" asp-action="Index" class="sidebar-link" data-nav="MenuItem">
                            <span class="sidebar-link-icon"><i class="fas fa-utensils"></i></span>
                            <span class="sidebar-link-text">Menu</span>
                        </a>

                        <a asp-controller="Pos" asp-action="Index" class="sidebar-link" data-nav="Pos">
                            <span class="sidebar-link-icon"><i class="fas fa-cash-register"></i></span>
                            <span class="sidebar-link-text">Register</span>
                        </a>

                        <a asp-controller="Order" asp-action="Index" class="sidebar-link" data-nav="Order">
                            <span class="sidebar-link-icon"><i class="fas fa-receipt"></i></span>
                            <span class="sidebar-link-text">Orders</span>
                        </a>

                        @if (canFeature(Cafe.Services.FeatureCatalog.Kds))
                        {
                            <a asp-controller="Kitchen" asp-action="Index" class="sidebar-link" data-nav="Kitchen">
                                <span class="sidebar-link-icon"><i class="fas fa-fire-burner"></i></span>
                                <span class="sidebar-link-text">Kitchen (KDS)</span>
                            </a>
                        }

                        @if (canFeature(Cafe.Services.FeatureCatalog.Tables))
                        {
                            <a asp-controller="Table" asp-action="Index" class="sidebar-link" data-nav="Table">
                                <span class="sidebar-link-icon"><i class="fas fa-chair"></i></span>
                                <span class="sidebar-link-text">Tables</span>
                            </a>
                        }

                        @if (isOwnerOrManager)
                        {
                            <a asp-controller="KitchenPrinter" asp-action="Index" class="sidebar-link" data-nav="KitchenPrinter">
                                <span class="sidebar-link-icon"><i class="fas fa-print"></i></span>
                                <span class="sidebar-link-text">Kitchen Printers</span>
                            </a>
                        }

                        @if (canFeature(Cafe.Services.FeatureCatalog.Invoicing))
                        {
                            <a asp-controller="Invoice" asp-action="Index" class="sidebar-link" data-nav="Invoice">
                                <span class="sidebar-link-icon"><i class="fas fa-file-invoice-dollar"></i></span>
                                <span class="sidebar-link-text">Bill History</span>
                            </a>
                        }
                    }

                    @if (isOwnerOrManager)
                    {
                        @if (canFeature(Cafe.Services.FeatureCatalog.Inventory))
                        {
                            <a asp-controller="InventoryItem" asp-action="Index" class="sidebar-link" data-nav="InventoryItem">
                                <span class="sidebar-link-icon"><i class="fas fa-boxes-stacked"></i></span>
                                <span class="sidebar-link-text">Inventory</span>
                            </a>
                        }
                        @if (canFeature(Cafe.Services.FeatureCatalog.Suppliers))
                        {
                            <a asp-controller="Supplier" asp-action="Index" class="sidebar-link" data-nav="Supplier">
                                <span class="sidebar-link-icon"><i class="fas fa-truck"></i></span>
                                <span class="sidebar-link-text">Suppliers</span>
                            </a>
                        }
                        @if (canFeature(Cafe.Services.FeatureCatalog.Purchases))
                        {
                            <a asp-controller="Purchase" asp-action="Index" class="sidebar-link" data-nav="Purchase">
                                <span class="sidebar-link-icon"><i class="fas fa-shopping-cart"></i></span>
                                <span class="sidebar-link-text">Purchases</span>
                            </a>
                        }

                        @if (canFeature(Cafe.Services.FeatureCatalog.Inventory))
                        {
                            <a asp-controller="StockTransfer" asp-action="Index" class="sidebar-link" data-nav="StockTransfer">
                                <span class="sidebar-link-icon"><i class="fas fa-right-left"></i></span>
                                <span class="sidebar-link-text">Stock Transfers</span>
                            </a>
                            <a asp-controller="StockAdjustment" asp-action="Index" class="sidebar-link" data-nav="StockAdjustment">
                                <span class="sidebar-link-icon"><i class="fas fa-scale-balanced"></i></span>
                                <span class="sidebar-link-text">Stock Adjustments</span>
                            </a>
                            <a asp-controller="Production" asp-action="Index" class="sidebar-link" data-nav="Production">
                                <span class="sidebar-link-icon"><i class="fas fa-industry"></i></span>
                                <span class="sidebar-link-text">Production</span>
                            </a>
                            <a asp-controller="SellReturn" asp-action="Index" class="sidebar-link" data-nav="SellReturn">
                                <span class="sidebar-link-icon"><i class="fas fa-rotate-left"></i></span>
                                <span class="sidebar-link-text">Sell Returns</span>
                            </a>
                            <a asp-controller="PurchaseReturn" asp-action="Index" class="sidebar-link" data-nav="PurchaseReturn">
                                <span class="sidebar-link-icon"><i class="fas fa-truck-ramp-box"></i></span>
                                <span class="sidebar-link-text">Purchase Returns</span>
                            </a>
                        }

                        <div class="sidebar-section-label">Sales</div>
                        <a asp-controller="Quotation" asp-action="Index" class="sidebar-link" data-nav="Quotation">
                            <span class="sidebar-link-icon"><i class="fas fa-file-signature"></i></span>
                            <span class="sidebar-link-text">Quotations</span>
                        </a>
                        <a asp-controller="Delivery" asp-action="Index" class="sidebar-link" data-nav="Delivery">
                            <span class="sidebar-link-icon"><i class="fas fa-motorcycle"></i></span>
                            <span class="sidebar-link-text">Delivery &amp; Riders</span>
                        </a>
                        <a asp-controller="Shipment" asp-action="Index" class="sidebar-link" data-nav="Shipment">
                            <span class="sidebar-link-icon"><i class="fas fa-box"></i></span>
                            <span class="sidebar-link-text">Shipments</span>
                        </a>
                    }

                    @if (isOwnerOrManager)
                    {
                        <div class="sidebar-section-label">Catalog</div>

                        <a asp-controller="Modifier" asp-action="Index" class="sidebar-link" data-nav="Modifier">
                            <span class="sidebar-link-icon"><i class="fas fa-sliders"></i></span>
                            <span class="sidebar-link-text">Modifiers</span>
                        </a>
                        <a asp-controller="Combo" asp-action="Index" class="sidebar-link" data-nav="Combo">
                            <span class="sidebar-link-icon"><i class="fas fa-gift"></i></span>
                            <span class="sidebar-link-text">Combos</span>
                        </a>
                        <a asp-controller="Brand" asp-action="Index" class="sidebar-link" data-nav="Brand">
                            <span class="sidebar-link-icon"><i class="fas fa-copyright"></i></span>
                            <span class="sidebar-link-text">Brands</span>
                        </a>
                        <a asp-controller="Unit" asp-action="Index" class="sidebar-link" data-nav="Unit">
                            <span class="sidebar-link-icon"><i class="fas fa-ruler"></i></span>
                            <span class="sidebar-link-text">Units</span>
                        </a>
                        <a asp-controller="PriceGroup" asp-action="Index" class="sidebar-link" data-nav="PriceGroup">
                            <span class="sidebar-link-icon"><i class="fas fa-layer-group"></i></span>
                            <span class="sidebar-link-text">Price Groups</span>
                        </a>
                        <a asp-controller="TaxGroup" asp-action="Index" class="sidebar-link" data-nav="TaxGroup">
                            <span class="sidebar-link-icon"><i class="fas fa-percent"></i></span>
                            <span class="sidebar-link-text">Tax Groups</span>
                        </a>
                    }

                    @if (userRole != "Customer")
                    {
                        <div class="sidebar-section-label">People</div>

                        <a asp-controller="Attendance" asp-action="Index" class="sidebar-link" data-nav="Attendance">
                            <span class="sidebar-link-icon"><i class="fas fa-calendar-check"></i></span>
                            <span class="sidebar-link-text">Attendance</span>
                        </a>

                        <div class="sidebar-section-label">Essentials</div>
                        <a asp-controller="Essentials" asp-action="Index" class="sidebar-link" data-nav="Essentials">
                            <span class="sidebar-link-icon"><i class="fas fa-clipboard-list"></i></span>
                            <span class="sidebar-link-text">Workspace</span>
                        </a>
                        <a asp-controller="Message" asp-action="Index" class="sidebar-link" data-nav="Message">
                            <span class="sidebar-link-icon"><i class="fas fa-comments"></i></span>
                            <span class="sidebar-link-text">Messages</span>
                        </a>
                    }

                    @if (isOwnerOrManager)
                    {
                        @if (canFeature(Cafe.Services.FeatureCatalog.Payroll))
                        {
                            <a asp-controller="Salary" asp-action="Index" class="sidebar-link" data-nav="Salary">
                                <span class="sidebar-link-icon"><i class="fas fa-wallet"></i></span>
                                <span class="sidebar-link-text">Payroll</span>
                            </a>
                            <a asp-controller="Leave" asp-action="Index" class="sidebar-link" data-nav="Leave">
                                <span class="sidebar-link-icon"><i class="fas fa-plane-departure"></i></span>
                                <span class="sidebar-link-text">Leave</span>
                            </a>
                        }
                        <a asp-controller="Holiday" asp-action="Index" class="sidebar-link" data-nav="Holiday">
                            <span class="sidebar-link-icon"><i class="fas fa-calendar-day"></i></span>
                            <span class="sidebar-link-text">Holidays</span>
                        </a>
                        <a asp-controller="Department" asp-action="Index" class="sidebar-link" data-nav="Department">
                            <span class="sidebar-link-icon"><i class="fas fa-network-wired"></i></span>
                            <span class="sidebar-link-text">Departments</span>
                        </a>
                        <a asp-controller="EmployeeDocument" asp-action="Index" class="sidebar-link" data-nav="EmployeeDocument">
                            <span class="sidebar-link-icon"><i class="fas fa-folder-open"></i></span>
                            <span class="sidebar-link-text">Documents</span>
                        </a>
                        @if (canFeature(Cafe.Services.FeatureCatalog.Analytics))
                        {
                            <a asp-controller="SalesTarget" asp-action="Index" class="sidebar-link" data-nav="SalesTarget">
                                <span class="sidebar-link-icon"><i class="fas fa-bullseye"></i></span>
                                <span class="sidebar-link-text">Sales Targets</span>
                            </a>
                        }

                        @if (canFeature(Cafe.Services.FeatureCatalog.Analytics))
                        {
                            <div class="sidebar-section-label">Analytics</div>

                            <a asp-controller="Financial" asp-action="Dashboard" class="sidebar-link" data-nav="Financial">
                                <span class="sidebar-link-icon"><i class="fas fa-chart-pie"></i></span>
                                <span class="sidebar-link-text">Financials</span>
                            </a>

                            <a asp-controller="Reports" asp-action="Index" class="sidebar-link" data-nav="Reports">
                                <span class="sidebar-link-icon"><i class="fas fa-chart-line"></i></span>
                                <span class="sidebar-link-text">Reports</span>
                            </a>

                            <a asp-controller="Receivables" asp-action="Index" class="sidebar-link" data-nav="Receivables">
                                <span class="sidebar-link-icon"><i class="fas fa-scale-unbalanced"></i></span>
                                <span class="sidebar-link-text">Receivables / Payables</span>
                            </a>

                            <a asp-controller="Accounting" asp-action="Index" class="sidebar-link" data-nav="Accounting">
                                <span class="sidebar-link-icon"><i class="fas fa-book"></i></span>
                                <span class="sidebar-link-text">Accounting</span>
                            </a>
                        }

                        @if (canFeature(Cafe.Services.FeatureCatalog.Feedback))
                        {
                            <a asp-controller="Feedback" asp-action="Index" class="sidebar-link" data-nav="Feedback">
                                <span class="sidebar-link-icon"><i class="fas fa-message"></i></span>
                                <span class="sidebar-link-text">Feedback</span>
                            </a>
                        }

                        @if (canFeature(Cafe.Services.FeatureCatalog.Marketing))
                        {
                            <div class="sidebar-section-label">Marketing</div>

                            <a asp-controller="PromoCode" asp-action="Index" class="sidebar-link" data-nav="PromoCode">
                                <span class="sidebar-link-icon"><i class="fas fa-tags"></i></span>
                                <span class="sidebar-link-text">Promo Codes</span>
                            </a>

                            <a asp-controller="Partnership" asp-action="Index" class="sidebar-link" data-nav="Partnership">
                                <span class="sidebar-link-icon"><i class="fas fa-credit-card"></i></span>
                                <span class="sidebar-link-text">Card Partnerships</span>
                            </a>

                            <a asp-controller="Loyalty" asp-action="Index" class="sidebar-link" data-nav="Loyalty">
                                <span class="sidebar-link-icon"><i class="fas fa-star"></i></span>
                                <span class="sidebar-link-text">Loyalty</span>
                            </a>
                            <a asp-controller="GiftCard" asp-action="Index" class="sidebar-link" data-nav="GiftCard">
                                <span class="sidebar-link-icon"><i class="fas fa-gift"></i></span>
                                <span class="sidebar-link-text">Gift Cards</span>
                            </a>
                            <a asp-controller="Crm" asp-action="Index" class="sidebar-link" data-nav="Crm">
                                <span class="sidebar-link-icon"><i class="fas fa-user-group"></i></span>
                                <span class="sidebar-link-text">CRM</span>
                            </a>
                            <a asp-controller="NotificationTemplate" asp-action="Index" class="sidebar-link" data-nav="NotificationTemplate">
                                <span class="sidebar-link-icon"><i class="fas fa-envelope-open-text"></i></span>
                                <span class="sidebar-link-text">Templates</span>
                            </a>

                            <a asp-controller="CheckoutSettings" asp-action="Index" class="sidebar-link" data-nav="CheckoutSettings">
                                <span class="sidebar-link-icon"><i class="fas fa-cash-register"></i></span>
                                <span class="sidebar-link-text">Checkout Settings</span>
                            </a>
                            <a asp-controller="PosProfile" asp-action="Index" class="sidebar-link" data-nav="PosProfile">
                                <span class="sidebar-link-icon"><i class="fas fa-receipt"></i></span>
                                <span class="sidebar-link-text">POS &amp; Receipts</span>
                            </a>
                        }
                    }

                    @if (isOwner)
                    {
                        <div class="sidebar-section-label">Workspace</div>

                        <a asp-controller="Subscription" asp-action="Index" class="sidebar-link" data-nav="Subscription">
                            <span class="sidebar-link-icon"><i class="fas fa-gem"></i></span>
                            <span class="sidebar-link-text">Plan &amp; Billing</span>
                        </a>

                        <a asp-controller="TenantSettings" asp-action="Branding" class="sidebar-link" data-nav="TenantSettings">
                            <span class="sidebar-link-icon"><i class="fas fa-palette"></i></span>
                            <span class="sidebar-link-text">Branding</span>
                        </a>

                        <a asp-controller="Setup" asp-action="Index" class="sidebar-link" data-nav="Setup">
                            <span class="sidebar-link-icon"><i class="fas fa-wand-magic-sparkles"></i></span>
                            <span class="sidebar-link-text">Setup Wizard</span>
                        </a>

                        <div class="sidebar-section-label">System</div>

                        <a asp-controller="Notification" asp-action="Index" class="sidebar-link" data-nav="Notification">
                            <span class="sidebar-link-icon"><i class="fas fa-bell"></i></span>
                            <span class="sidebar-link-text">Notifications</span>
                        </a>

                        <a asp-controller="AuditLog" asp-action="Index" class="sidebar-link" data-nav="AuditLog">
                            <span class="sidebar-link-icon"><i class="fas fa-shield-halved"></i></span>
                            <span class="sidebar-link-text">Audit Logs</span>
                        </a>
                    }
                }
            </nav>

            <!-- Sidebar Footer -->
            <div class="sidebar-footer">
                @if (isAuthenticated)
                {
                    <a asp-controller="User" asp-action="Profile" class="sidebar-link" data-nav="User">
                        <span class="sidebar-link-icon"><i class="fas fa-circle-user"></i></span>
                        <span class="sidebar-link-text">My Profile</span>
                    </a>
                    <a asp-controller="User" asp-action="Settings" class="sidebar-link" data-nav="Settings">
                        <span class="sidebar-link-icon"><i class="fas fa-gear"></i></span>
                        <span class="sidebar-link-text">Settings</span>
                    </a>
                }

                <!-- Pin/Unpin Toggle -->
                <button class="sidebar-toggle" id="sidebarToggle" title="Pin sidebar">
                    <i class="fas fa-thumbtack"></i>
                </button>
            </div>
        </aside>

        <!-- ═══ MAIN WRAPPER ═══ -->
        <div class="main-wrapper" id="mainWrapper">
            <!-- Top Header -->
            <header class="top-header">
                <div class="header-left">
                    <button class="mobile-menu-btn" id="mobileMenuBtn">
                        <i class="fas fa-bars"></i>
                    </button>
                    <div>
                        <h1 class="header-title">@ViewData["Title"]</h1>
                    </div>
                </div>

                <div class="header-right">
                    <!-- Notification Bell -->
                    @if (isAuthenticated)
                    {
                        <div style="position:relative;" id="notifBellContainer">
                            <button class="header-icon-btn" data-tooltip="Notifications" id="notifBellBtn" onclick="toggleNotifDropdown(event)" style="position:relative;">
                                <i class="fas fa-bell" id="notifBellIcon"></i>
                                <span id="notifBadge" style="display:none;position:absolute;top:0;right:0;min-width:18px;height:18px;border-radius:10px;background:linear-gradient(135deg,#ef4444,#dc2626);color:#fff;font-size:0.6rem;font-weight:800;align-items:center;justify-content:center;padding:0 4px;line-height:1;box-shadow:0 2px 6px rgba(220,38,38,0.4);border:2px solid var(--surface);">0</span>
                            </button>

                            <!-- Premium Dropdown -->
                            <div id="notifDropdown" style="display:none;position:absolute;top:calc(100% + 10px);right:-40px;width:400px;background:var(--bg-surface);border-radius:16px;box-shadow:0 12px 48px rgba(0,0,0,0.22),0 2px 8px rgba(0,0,0,0.14);border:1px solid var(--border);z-index:9999;overflow:hidden;opacity:0;transform:translateY(-10px);transition:opacity 0.25s ease,transform 0.25s ease;">
                                <!-- Arrow -->
                                <div style="position:absolute;top:-6px;right:52px;width:12px;height:12px;background:var(--bg-surface);border-left:1px solid var(--border);border-top:1px solid var(--border);transform:rotate(45deg);z-index:1;"></div>
                                <!-- Header -->
                                <div style="padding:1rem 1.15rem;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;background:var(--bg-surface-alt);">
                                    <div style="display:flex;align-items:center;gap:0.5rem;">
                                        <span style="font-weight:800;font-size:0.92rem;color:var(--text-primary);">Notifications</span>
                                        <span id="notifCountPill" style="display:none;background:linear-gradient(135deg,#6366f1,#8b5cf6);color:#fff;font-size:0.55rem;font-weight:700;padding:2px 7px;border-radius:20px;"></span>
                                    </div>
                                    <button onclick="markAllReadFromBell()" style="background:none;border:none;color:#6366f1;font-size:0.72rem;cursor:pointer;font-weight:600;padding:4px 8px;border-radius:6px;transition:background 0.15s;" onmouseenter="this.style.background='rgba(99,102,241,0.08)'" onmouseleave="this.style.background='none'">
                                        <i class="fas fa-check-double" style="margin-right:0.25rem;font-size:0.6rem;"></i>Mark all read
                                    </button>
                                </div>
                                <!-- Loading State -->
                                <div id="notifLoading" style="display:none;text-align:center;padding:2rem;">
                                    <div style="width:28px;height:28px;border:3px solid var(--border-light);border-top-color:#6366f1;border-radius:50%;animation:notifSpin 0.8s linear infinite;margin:0 auto;"></div>
                                    <div class="caption" style="margin-top:0.5rem;">Loading...</div>
                                </div>
                                <!-- Items -->
                                <div id="notifDropdownList" style="max-height:380px;overflow-y:auto;scrollbar-width:thin;"></div>
                                <!-- Footer -->
                                <div style="padding:0.7rem 1rem;border-top:1px solid var(--border);text-align:center;background:var(--bg-surface-alt);">
                                    <a href="/Notification/Index" style="color:#6366f1;font-size:0.78rem;font-weight:700;text-decoration:none;display:flex;align-items:center;justify-content:center;gap:0.35rem;padding:4px 0;border-radius:6px;transition:background 0.15s;" onmouseenter="this.style.background='rgba(99,102,241,0.06)'" onmouseleave="this.style.background='transparent'">
                                        View All Notifications <i class="fas fa-arrow-right" style="font-size:0.6rem;"></i>
                                    </a>
                                </div>
                            </div>
                        </div>

                        <!-- Toast Container -->
                        <div id="notifToastContainer" style="position:fixed;top:80px;right:20px;z-index:99999;display:flex;flex-direction:column;gap:0.5rem;pointer-events:none;"></div>
                    }
                    @{
                        var curCulture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
                        var returnPath = Context.Request.Path + Context.Request.QueryString;
                    }
                    <div style="position:relative;" id="langMenu">
                        <button class="header-icon-btn" data-tooltip="Language" onclick="document.getElementById('langDrop').style.display=document.getElementById('langDrop').style.display==='block'?'none':'block'">
                            <i class="fas fa-language"></i>
                        </button>
                        <div id="langDrop" style="display:none;position:absolute;top:calc(100% + 8px);right:0;background:var(--bg-surface);border:1px solid var(--border);border-radius:10px;box-shadow:0 8px 24px rgba(0,0,0,0.15);z-index:9999;overflow:hidden;min-width:130px;">
                            @foreach (var (code, label) in new[] { ("en", "English"), ("ur", "اردو") })
                            {
                                <a href="/Language/Set?culture=@code&returnUrl=@Uri.EscapeDataString(returnPath)" style="display:block;padding:0.55rem 0.9rem;text-decoration:none;color:var(--text-primary);font-size:0.85rem;@(curCulture == code ? "background:var(--accent-light);font-weight:700;" : "")">@label</a>
                            }
                        </div>
                    </div>
                    <button class="header-icon-btn" id="themeToggle" data-tooltip="Toggle theme" onclick="toggleTheme()">
                        <i class="fas fa-moon" id="themeIcon"></i>
                    </button>
                    <button class="header-icon-btn" data-tooltip="Search" id="globalSearchBtn">
                        <i class="fas fa-magnifying-glass"></i>
                    </button>

                    <div class="header-avatar">
                        <div class="header-avatar-img">
                            @if (!string.IsNullOrEmpty(userName))
                            {
                                @userName.Substring(0, 1).ToUpper()
                            }
                            else
                            {
                                <i class="fas fa-user" style="font-size:13px;"></i>
                            }
                        </div>
                        <div class="header-avatar-info" style="display:none;">
                        </div>
