@model List<Cafe.Models.Budget>
@{
    ViewData["Title"] = "Budgets";
    var accounts = ViewBag.Accounts as List<Cafe.Models.Account> ?? new();
    var actuals = ViewBag.Actuals as Dictionary<int, decimal> ?? new();
    string m(decimal v) => "Rs. " + v.ToString("N0");
}
<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1.5rem;flex-wrap:wrap;gap:1rem;">
    <div><h1 class="page-title" style="margin:0;">Budgets</h1><p class="body-text" style="margin-top:0.25rem;">Target amounts per account vs actuals from posted journals.</p></div>
    <button class="btn btn-primary" onclick="bNew()"><i class="fas fa-plus" style="margin-right:0.5rem;"></i> New Budget</button>
</div>
<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(340px,1fr));gap:1.25rem;">
    @if (!Model.Any()) { <div class="card"><div class="card-body" style="text-align:center;padding:2.5rem;color:var(--text-secondary);">No budgets yet.</div></div> }
    @foreach (var b in Model)
    {
        <div class="card"><div class="card-body">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:0.5rem;"><h3 style="margin:0;font-size:1.05rem;">@b.Name <span class="caption">@b.Year</span></h3></div>
            <table class="premium-table"><thead><tr><th>Account</th><th style="text-align:right;">Budget</th><th style="text-align:right;">Actual</th><th style="text-align:right;">Var</th></tr></thead><tbody>
                @foreach (var l in b.Lines)
                {
                    var actual = actuals.TryGetValue(l.AccountId * 10000 + b.Year, out var a) ? a : 0;
                    var variance = actual - l.Amount;
                    <tr><td>@l.Account?.Name</td><td style="text-align:right;">@m(l.Amount)</td><td style="text-align:right;">@m(actual)</td><td style="text-align:right;color:@(variance >= 0 ? "#16a34a" : "#dc2626");">@m(variance)</td></tr>
                }
            </tbody></table>
        </div></div>
    }
</div>
<div id="bModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:9999;align-items:center;justify-content:center;padding:1rem;"><div class="card" style="max-width:520px;width:100%;max-height:90vh;overflow:auto;"><div class="card-body">
    <h3 style="margin:0 0 1rem;">New Budget</h3>
    <div class="form-row"><div class="form-group"><label class="form-label">Name</label><input id="bName" class="form-control" /></div><div class="form-group"><label class="form-label">Year</label><input id="bYear" type="number" value="@DateTime.Now.Year" class="form-control" /></div></div>
    <label class="form-label">Lines</label>
    <div style="display:flex;gap:0.4rem;margin-bottom:0.5rem;">
        <select id="bAcc" class="form-select" style="flex:1;">@foreach (var a in accounts){<option value="@a.Id">@a.Code — @a.Name</option>}</select>
        <input id="bAmt" type="number" step="0.01" placeholder="Amount" class="form-control" style="width:120px;">
        <button class="btn btn-secondary" onclick="bAdd()">Add</button>
    </div>
    <div id="bLines" style="margin-bottom:0.75rem;"></div>
    <div style="display:flex;gap:0.5rem;"><button class="btn btn-primary" onclick="bSave()">Save</button><button class="btn btn-secondary" onclick="document.getElementById('bModal').style.display='none'">Cancel</button></div>
</div></div></div>
@section Scripts {
<script>
const _tok = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
const accs = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(accounts.Select(a => new { id = a.Id, label = a.Code + " — " + a.Name })));
const accMap = Object.fromEntries(accs.map(a => [a.id, a.label]));
let lines = [];
const money = v => 'Rs. ' + Math.round(v).toLocaleString();
function render() { document.getElementById('bLines').innerHTML = lines.map((l, x) => `<div style="display:flex;justify-content:space-between;padding:0.3rem 0;border-bottom:1px solid var(--border-light);"><span>${accMap[l.accountId]}</span><span>${money(l.amount)} <a href="javascript:void(0)" onclick="bDel(${x})" style="color:#dc2626;">×</a></span></div>`).join(''); }
window.bNew = () => { lines = []; render(); document.getElementById('bModal').style.display = 'flex'; };
window.bAdd = () => { const id = parseInt(document.getElementById('bAcc').value); const amt = parseFloat(document.getElementById('bAmt').value) || 0; if (!id || !amt) return; const e = lines.find(l => l.accountId === id); if (e) e.amount = amt; else lines.push({ accountId: id, amount: amt }); document.getElementById('bAmt').value = ''; render(); };
window.bDel = i => { lines.splice(i, 1); render(); };
window.bSave = async () => { if (!lines.length) return; const d = await fetch('/Budget/Save', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': _tok }, body: `id=0&name=${encodeURIComponent(document.getElementById('bName').value)}&year=${document.getElementById('bYear').value}&lines=${encodeURIComponent(JSON.stringify(lines))}` }).then(r => r.json()); if (d.success) location.reload(); else if (window.ActionCard) ActionCard.error('Budget', d.message); };
</script>
}
