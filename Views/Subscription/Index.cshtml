@{
    ViewData["Title"] = "Plan & Billing";
    var plans = ViewBag.Plans as List<Cafe.Models.Plan> ?? new();
    var currentPlanId = ViewBag.CurrentPlanId as int?;
    var lockedFeature = ViewBag.LockedFeature as string;
}

<div style="margin-bottom:1.5rem;">
    <h1 class="page-title" style="margin:0;">Plan &amp; Billing</h1>
    <p class="body-text" style="margin-top:0.25rem;">Choose the plan that fits your business.</p>
</div>

@if (!string.IsNullOrEmpty(lockedFeature))
{
    <div class="card" style="border-left:4px solid var(--accent);margin-bottom:1.5rem;">
        <div class="card-body" style="display:flex;align-items:center;gap:0.75rem;">
            <i class="fas fa-lock" style="font-size:1.4rem;color:var(--accent);"></i>
            <div>
                <div style="font-weight:700;">“@lockedFeature” isn’t included in your current plan.</div>
                <div class="caption">Upgrade below to unlock it.</div>
            </div>
        </div>
    </div>
}

<div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(260px,1fr)); gap:1.25rem;">
    @foreach (var p in plans)
    {
        var isCurrent = currentPlanId == p.Id;
        var feats = p.Features == "*" ? new[] { "All features" } : p.Features.Split(',', StringSplitOptions.RemoveEmptyEntries);
        <div class="card" style="@(isCurrent ? "border:2px solid var(--accent);" : "")">
            <div class="card-body">
                <div style="display:flex;justify-content:space-between;align-items:center;">
                    <h3 style="margin:0;font-size:1.2rem;">@p.Name</h3>
                    @if (isCurrent)
                    {
                        <span class="badge badge-accent">Current</span>
                    }
                </div>
                <div class="caption" style="min-height:1.2rem;">@p.Description</div>
                <div style="margin:1rem 0;">
                    <span style="font-size:1.9rem;font-weight:800;">Rs. @p.PriceMonthly.ToString("N0")</span>
                    <span class="caption">/month</span>
                </div>
                <div class="caption" style="margin-bottom:0.75rem;"><i class="fas fa-store" style="margin-right:0.3rem;"></i>@p.MaxBranches branches · @p.MaxUsers users</div>
                <ul style="list-style:none;padding:0;margin:0 0 1rem;display:flex;flex-direction:column;gap:0.35rem;">
                    @foreach (var f in feats)
                    {
                        <li style="font-size:0.82rem;"><i class="fas fa-check" style="color:var(--success);margin-right:0.45rem;"></i>@f</li>
                    }
                </ul>
                @if (isCurrent)
                {
                    <button class="btn btn-secondary btn-sm" style="width:100%;" disabled>Your plan</button>
                }
                else
                {
                    <form asp-action="Subscribe" method="post" style="margin:0;">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="planId" value="@p.Id" />
                        <button type="submit" class="btn btn-primary btn-sm" style="width:100%;">
                            @(p.PriceMonthly == 0 ? "Switch to Free" : "Choose " + p.Name)
                        </button>
                    </form>
                }
            </div>
        </div>
    }
    @if (!plans.Any())
    {
        <div class="card"><div class="card-body" style="text-align:center;padding:3rem;color:var(--text-secondary);">No plans are available yet. Please contact support.</div></div>
    }
</div>
