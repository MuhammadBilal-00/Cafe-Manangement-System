@{
    ViewData["Title"] = "Order Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="p-6 space-y-6">
    <h2 class="text-2xl font-bold text-gray-800">Order Management</h2>

    <!-- Tabs -->
    <div class="flex space-x-4 border-b pb-2">
        <button class="tab-btn active" data-status="all-orders">All</button>
        <button class="tab-btn" data-status="pending-orders">Pending</button>
        <button class="tab-btn" data-status="preparing-orders">Preparing</button>
        <button class="tab-btn" data-status="ready-orders">Ready</button>
        <button class="tab-btn" data-status="completed-orders">Completed</button>
        <button class="tab-btn" data-status="cancelled-orders">Cancelled</button>
    </div>

    <!-- Filters -->
    <div class="flex flex-wrap items-center gap-4">
        <input id="search" type="text" placeholder="Search orders..." class="border rounded px-3 py-2 w-64">
        <select id="branchFilter" class="border rounded px-3 py-2">
            <option value="">All Branches</option>
        </select>
        <input id="dateFilter" type="date" class="border rounded px-3 py-2">
        <button id="createOrderBtn" class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700">
            + New Order
        </button>
    </div>

    <!-- Orders Table -->
    <div class="overflow-x-auto border rounded-lg shadow-sm">
        <table class="min-w-full divide-y divide-gray-200 text-sm">
            <thead class="bg-gray-100">
                <tr>
                    <th class="px-4 py-2">Order #</th>
                    <th class="px-4 py-2">Customer</th>
                    <th class="px-4 py-2">Branch</th>
                    <th class="px-4 py-2">Date</th>
                    <th class="px-4 py-2">Amount</th>
                    <th class="px-4 py-2">Status</th>
                    <th class="px-4 py-2">Actions</th>
                </tr>
            </thead>
            <tbody id="ordersTable" class="divide-y divide-gray-200"></tbody>
        </table>
    </div>

    <!-- Pagination -->
    <div class="flex justify-between items-center mt-4 text-sm text-gray-600">
        <span id="orderCount">Showing 0 orders</span>
        <div id="pagination" class="flex gap-1"></div>
    </div>
</div>

<!-- View Order Modal -->
<div id="viewOrderModal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center">
    <div class="bg-white p-6 rounded-lg w-1/2">
        <div class="flex justify-between items-center mb-4">
            <h3 class="text-lg font-bold">Order Details</h3>
            <button onclick="closeModal('viewOrderModal')" class="text-gray-500 hover:text-black">✕</button>
        </div>
        <div id="orderDetails" class="space-y-2"></div>
        <div class="text-right mt-4">
            <button class="bg-gray-300 px-3 py-1 rounded" onclick="closeModal('viewOrderModal')">Close</button>
        </div>
    </div>
</div>

<!-- Create Order Modal -->
<div id="createOrderModal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center">
    <div class="bg-white p-6 rounded-lg w-1/2">
        <div class="flex justify-between items-center mb-4">
            <h3 class="text-lg font-bold">Create New Order</h3>
            <button onclick="closeModal('createOrderModal')" class="text-gray-500 hover:text-black">✕</button>
        </div>

        <div class="space-y-4">
            <select id="customerSelect" class="border rounded px-3 py-2 w-full">
                <option value="">Select Customer</option>
            </select>
            <select id="branchSelect" class="border rounded px-3 py-2 w-full">
                <option value="">Select Branch</option>
            </select>
            <select id="menuItemSelect" class="border rounded px-3 py-2 w-full">
                <option value="">Select Menu Item</option>
            </select>
            <input id="quantity" type="number" min="1" value="1" class="border rounded px-3 py-2 w-full">
            <textarea id="orderNotes" placeholder="Order Notes" class="border rounded px-3 py-2 w-full"></textarea>
        </div>

        <div class="mt-4 text-right space-x-2">
            <button class="bg-gray-300 px-3 py-1 rounded" onclick="closeModal('createOrderModal')">Cancel</button>
            <button id="saveOrderBtn" class="bg-blue-600 text-white px-3 py-1 rounded hover:bg-blue-700">Save</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let currentStatus = "all-orders";
        let currentPage = 1;

        document.addEventListener("DOMContentLoaded", function () {
            loadBranches();
            loadOrders();
            loadCustomers();

            document.querySelectorAll(".tab-btn").forEach(btn => {
                btn.addEventListener("click", () => {
                    document.querySelectorAll(".tab-btn").forEach(b => b.classList.remove("active"));
                    btn.classList.add("active");
                    currentStatus = btn.dataset.status;
                    loadOrders();
                });
            });
                document.getElementById("branchSelect").addEventListener("change", function () {
                const branchId = this.value;
                if (branchId) {
                    loadMenuItems(branchId);
                }});
            document.getElementById("search").addEventListener("input", loadOrders);
            document.getElementById("branchFilter").addEventListener("change", loadOrders);
            document.getElementById("dateFilter").addEventListener("change", loadOrders);
            document.getElementById("createOrderBtn").addEventListener("click", () => openModal('createOrderModal'));
            document.getElementById("saveOrderBtn").addEventListener("click", createOrder);
        });

        function loadBranches() {
            fetch("/Order/GetBranches").then(r => r.json()).then(data => {
                const branchSelect = document.getElementById("branchFilter");
                const createBranch = document.getElementById("branchSelect");
                data.forEach(b => {
                    branchSelect.innerHTML += `<option value="${b.id}">${b.name}</option>`;
                    createBranch.innerHTML += `<option value="${b.id}">${b.name}</option>`;
                });
            });
        }

        function loadCustomers() {
            fetch("/Order/GetCustomers").then(r => r.json()).then(data => {
                const select = document.getElementById("customerSelect");
                data.forEach(c => select.innerHTML += `<option value="${c.id}">${c.name}</option>`);
            });
        }

               function loadMenuItems(branchId) {
            fetch(`/Order/GetMenuItems?branchId=${branchId}`)
                .then(r => r.json())
                .then(data => {
                    const select = document.getElementById("menuItemSelect");
                    select.innerHTML = '<option value="">Select Menu Item</option>';
                    data.forEach(m => {
                        select.innerHTML += `<option value="${m.id}">${m.name} - $${m.price}</option>`;
                    });
                })
                .catch(err => console.error("Error loading menu items:", err));
        }


        function loadOrders(page = 1) {
            currentPage = page;
            const search = document.getElementById("search").value;
            const branchId = document.getElementById("branchFilter").value;
            const date = document.getElementById("dateFilter").value;
            fetch(`/Order/GetOrders?status=${currentStatus}&search=${search}&branchId=${branchId}&orderDate=${date}&page=${page}`)
                .then(r => r.json()).then(data => {
                    const tbody = document.getElementById("ordersTable");
                    tbody.innerHTML = "";
                    data.orders.forEach(o => {
                        tbody.innerHTML += `
                            <tr>
                                <td class="px-4 py-2">${o.orderNumber}</td>
                                <td class="px-4 py-2">${o.customerName}</td>
                                <td class="px-4 py-2">${o.branchName}</td>
                                <td class="px-4 py-2">${o.orderDate}</td>
                                <td class="px-4 py-2">$${o.totalAmount}</td>
                                <td class="px-4 py-2">${o.status}</td>
                                <td class="px-4 py-2 space-x-1">
                                    <button onclick="viewOrder(${o.id})" class="bg-gray-200 px-2 py-1 rounded">View</button>
                                    <button onclick="updateOrderStatus(${o.id}, 'Completed')" class="bg-green-200 px-2 py-1 rounded">Complete</button>
                                    <button onclick="cancelOrder(${o.id})" class="bg-red-200 px-2 py-1 rounded">Cancel</button>
                                </td>
                            </tr>`;
                    });
                    document.getElementById("orderCount").innerText = `Showing ${data.orders.length} of ${data.totalCount} orders`;
                });
        }

        function viewOrder(id) {
            fetch(`/Order/GetOrderDetails/${id}`).then(r => r.json()).then(o => {
                const details = document.getElementById("orderDetails");
                details.innerHTML = `
                    <p><b>Order #:</b> ${o.orderNumber}</p>
                    <p><b>Customer:</b> ${o.customer.name}</p>
                    <p><b>Branch:</b> ${o.branch}</p>
                    <p><b>Total:</b> $${o.totalAmount}</p>
                    <p><b>Status:</b> ${o.status}</p>
                `;
                openModal('viewOrderModal');
            });
        }

        function createOrder() {
            const request = {
                customerId: document.getElementById("customerSelect").value,
                branchId: document.getElementById("branchSelect").value,
                notes: document.getElementById("orderNotes").value,
                items: [{ menuItemId: document.getElementById("menuItemSelect").value, quantity: document.getElementById("quantity").value }]
            };

            fetch("/Order/CreateOrder", {
                method: "POST",
                headers: { "Content-Type": "application/json", "RequestVerificationToken": getToken() },
                body: JSON.stringify(request)
            }).then(r => r.json()).then(res => {
                if (res.success) {
                    closeModal('createOrderModal');
                    loadOrders();
                    alert("Order created successfully");
                } else {
                    alert(res.message);
                }
            });
        }

        function updateOrderStatus(id, status) {
            fetch("/Order/UpdateOrderStatus", {
                method: "POST",
                headers: { "Content-Type": "application/json", "RequestVerificationToken": getToken() },
                body: JSON.stringify({ orderId: id, newStatus: status })
            }).then(r => r.json()).then(res => {
                if (res.success) loadOrders();
                else alert(res.message);
            });
        }

        function cancelOrder(id) {
            fetch("/Order/CancelOrder", {
                method: "POST",
                headers: { "Content-Type": "application/json", "RequestVerificationToken": getToken() },
                body: JSON.stringify({ orderId: id, reason: "Cancelled by admin" })
            }).then(r => r.json()).then(res => {
                if (res.success) loadOrders();
                else alert(res.message);
            });
        }

        function openModal(id) { document.getElementById(id).classList.remove("hidden"); }
        function closeModal(id) { document.getElementById(id).classList.add("hidden"); }

        function getToken() {
            return document.querySelector('[name="__RequestVerificationToken"]').value;
        }
    </script>
}

<style>
    .tab-btn {
        padding: 6px 12px;
        border-radius: 4px;
    }

        .tab-btn.active {
            background: #2563eb;
            color: white;
        }
</style>
