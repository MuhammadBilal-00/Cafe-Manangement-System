@model Cafe.Services.ProvisionTenantRequest
@{
    ViewData["Title"] = "Start your workspace";
}

<div style="max-width:560px;margin:2rem auto;">
    <div style="text-align:center;margin-bottom:1.5rem;">
        <div style="width:56px;height:56px;border-radius:16px;background:var(--accent);display:flex;align-items:center;justify-content:center;margin:0 auto 1rem;color:#fff;font-size:1.4rem;"><i class="fas fa-mug-hot"></i></div>
        <h1 class="page-title" style="margin:0;">Create your restaurant workspace</h1>
        <p class="body-text" style="margin-top:0.35rem;">Set up in under a minute — comes with a starter menu and demo branch.</p>
    </div>

    <div class="card">
        <div class="card-body">
            <form asp-action="Index" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="All" class="text-danger" style="margin-bottom:1rem;"></div>

                <div class="form-group">
                    <label class="form-label">Business name</label>
                    <input name="BusinessName" id="BusinessName" value="@Model.BusinessName" class="form-control" required placeholder="Acme Cafe" />
                </div>

                <div class="form-group">
                    <label class="form-label">Workspace address</label>
                    <div style="display:flex;align-items:center;gap:0.4rem;">
                        <input name="Slug" id="Slug" value="@Model.Slug" class="form-control" placeholder="acme-cafe" />
                        <span class="caption" style="white-space:nowrap;">.yourbrand.com</span>
                    </div>
                    <div class="caption" id="slugStatus" style="margin-top:0.3rem;"></div>
                </div>

                <div class="form-group">
                    <label class="form-label">Business type</label>
                    <select name="Template" class="form-select">
                        <option value="cafe">Cafe</option>
                        <option value="restaurant">Restaurant</option>
                        <option value="bakery">Bakery</option>
                    </select>
                </div>

                <div class="divider" style="margin:1.25rem 0;"></div>

                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Your name</label>
                        <input name="AdminName" value="@Model.AdminName" class="form-control" required />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Phone</label>
                        <input name="AdminPhone" value="@Model.AdminPhone" class="form-control" />
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label">Email</label>
                    <input name="AdminEmail" type="email" value="@Model.AdminEmail" class="form-control" required />
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Password</label>
                        <input name="AdminPassword" type="password" class="form-control" required minlength="6" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Confirm password</label>
                        <input name="confirmPassword" type="password" class="form-control" required minlength="6" />
                    </div>
                </div>

                <button type="submit" class="btn btn-primary btn-lg" style="width:100%;margin-top:0.5rem;">
                    <i class="fas fa-rocket" style="margin-right:0.5rem;"></i> Create workspace
                </button>

                <p style="text-align:center;margin-top:1rem;" class="caption">
                    Already have an account? <a asp-controller="Auth" asp-action="Login">Sign in</a>
                </p>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    (function () {
        const name = document.getElementById('BusinessName');
        const slug = document.getElementById('Slug');
        const status = document.getElementById('slugStatus');
        let touched = false;
        slug.addEventListener('input', () => { touched = true; check(); });
        name.addEventListener('input', () => { if (!touched) { slug.value = slugify(name.value); check(); } });
        function slugify(s){return (s||'').toLowerCase().trim().replace(/[^a-z0-9]+/g,'-').replace(/^-+|-+$/g,'');}
        let t;
        function check(){
            clearTimeout(t);
            const v = slugify(slug.value);
            if(!v){status.textContent='';return;}
            t = setTimeout(async () => {
                try {
                    const r = await fetch('/Onboarding/CheckSlug?slug=' + encodeURIComponent(v));
                    const d = await r.json();
                    status.innerHTML = d.available
                        ? '<span style="color:#16a34a;"><i class="fas fa-check"></i> ' + d.slug + '.yourbrand.com is available</span>'
                        : '<span style="color:#dc2626;"><i class="fas fa-times"></i> taken — try another</span>';
                } catch(e){}
            }, 300);
        }
    })();
</script>
}
