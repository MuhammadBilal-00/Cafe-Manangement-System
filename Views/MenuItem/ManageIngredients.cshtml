@model Cafe.Models.MenuItem

@{
    ViewData["Title"] = "Manage Ingredients for " + Model.Name;
}

<div>
    <div class="flex justify-between items-center mb-6 flex-wrap gap-4">
        <h1 class="page-title" style="margin:0;">@ViewData["Title"]</h1>
        <a asp-action="Index" class="btn btn-secondary btn-sm">
            <i class="fas fa-arrow-left"></i> Back to List
        </a>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-5">
        <div class="lg:col-span-2">
            <div class="card mb-5">
                <div class="card-header">
                    <h5 class="font-semibold" style="margin:0;">Current Ingredients</h5>
                </div>
                <div class="card-body card-body-flush">
                    @if (Model.Ingredients.Any())
                    {
                        <div style="overflow-x:auto;">
                            <table class="premium-table">
                                <thead>
                                    <tr>
                                        <th>Ingredient</th>
                                        <th>Quantity</th>
                                        <th>Unit</th>
                                        <th>Optional</th>
                                        <th>Extra Charge</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var ingredient in Model.Ingredients)
                                    {
                                        <tr>
                                            <td>@ingredient.Ingredient?.Name</td>
                                            <td>@ingredient.Quantity</td>
                                            <td>@ingredient.Unit</td>
                                            <td>
                                                @if (ingredient.IsOptional)
                                                {
                                                    <span class="badge badge-info">Yes</span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-secondary">No</span>
                                                }
                                            </td>
                                            <td>
                                                @if (ingredient.ExtraCharge.HasValue)
                                                {
                                                    <span class="text-green-600 font-medium">$@ingredient.ExtraCharge.Value</span>
                                                }
                                                else
                                                {
                                                    <span class="text-gray-400">-</span>
                                                }
                                            </td>
                                            <td>
                                                <form asp-action="RemoveIngredient" method="post" class="inline">
                                                    <input type="hidden" name="menuItemId" value="@Model.Id" />
                                                    <input type="hidden" name="ingredientId" value="@ingredient.IngredientId" />
                                                    <button type="submit" class="btn btn-danger btn-sm">
                                                        <i class="fas fa-trash"></i> Remove
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="empty-state">
                            <i class="fas fa-info-circle text-2xl text-blue-400 mb-2"></i>
                            <p class="caption">No ingredients added yet.</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div>
            <div class="card">
                <div class="card-header">
                    <h5 class="font-semibold" style="margin:0;">Add New Ingredient</h5>
                </div>
                <div class="card-body">
                    <form asp-action="AddIngredient" method="post" class="space-y-4">
                        <input type="hidden" name="menuItemId" value="@Model.Id" />

                        <div class="form-group">
                            <label class="form-label">Ingredient</label>
                            <select name="ingredientId" asp-items="ViewBag.AvailableIngredients" class="form-control"
                                    required>
                                <option value="">Select Ingredient</option>
                            </select>
                        </div>

                        <div class="grid grid-cols-2 gap-3">
                            <div class="form-group">
                                <label class="form-label">Quantity</label>
                                <input type="number" name="quantity" class="form-control" step="0.01" min="0"
                                       required />
                            </div>
                            <div class="form-group">
                                <label class="form-label">Unit</label>
                                <input type="text" name="unit" class="form-control" value="g" required />
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="flex items-center gap-2 cursor-pointer">
                                <input type="checkbox" name="isOptional" value="true"
                                       class="form-checkbox rounded border-gray-300" />
                                <span class="text-sm">Optional Ingredient</span>
                            </label>
                        </div>

                        <div class="form-group">
                            <label class="form-label">Extra Charge ($)</label>
                            <input type="number" name="extraCharge" class="form-control" step="0.01" min="0" />
                        </div>

                        <button type="submit" class="btn btn-primary w-full">
                            <i class="fas fa-plus"></i> Add Ingredient
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>