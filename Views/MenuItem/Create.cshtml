@model Cafe.Models.MenuItem

@{
    ViewData["Title"] = "Add New Menu Item";
}

<div class="container-fluid px-4 py-6">
    <div class="flex justify-between items-center mb-6">
        <h1 class="text-3xl font-bold text-gray-800">@ViewData["Title"]</h1>
        <a asp-action="Index" class="bg-gray-600 hover:bg-gray-700 text-white px-4 py-2 rounded-lg transition duration-200 flex items-center">
            <i class="fas fa-arrow-left mr-2"></i> Back to List
        </a>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="bg-red-50 border-l-4 border-red-400 p-4 mb-6 rounded-lg">
            <div class="flex">
                <div class="flex-shrink-0">
                    <i class="fas fa-exclamation-triangle text-red-400"></i>
                </div>
                <div class="ml-3">
                    <p class="text-sm text-red-700">@TempData["Error"]</p>
                </div>
            </div>
        </div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="bg-green-50 border-l-4 border-green-400 p-4 mb-6 rounded-lg">
            <div class="flex">
                <div class="flex-shrink-0">
                    <i class="fas fa-check-circle text-green-400"></i>
                </div>
                <div class="ml-3">
                    <p class="text-sm text-green-700">@TempData["Success"]</p>
                </div>
            </div>
        </div>
    }

    <div class="bg-white rounded-xl shadow-lg overflow-hidden">
        <form asp-action="Create" method="post" class="p-8">
            @Html.AntiForgeryToken()
            
            <div asp-validation-summary="All" class="text-red-600 mb-4"></div>

            <!-- Basic Information Section -->
            <div class="mb-8">
                <h2 class="text-xl font-semibold text-gray-800 mb-6 pb-2 border-b border-gray-200">Basic Information</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <!-- Name -->
                    <div class="md:col-span-2">
                        <label asp-for="Name" class="block text-sm font-semibold text-gray-700 mb-2">
                            Item Name <span class="text-red-500">*</span>
                        </label>
                        <input asp-for="Name" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all duration-200" placeholder="Enter menu item name" />
                        <span asp-validation-for="Name" class="text-red-500 text-xs mt-1"></span>
                    </div>

                    <!-- Description -->
                    <div class="md:col-span-2">
                        <label asp-for="Description" class="block text-sm font-semibold text-gray-700 mb-2">Short Description</label>
                        <textarea asp-for="Description" rows="2" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all duration-200 resize-none" placeholder="Brief description of the item"></textarea>
                        <span asp-validation-for="Description" class="text-red-500 text-xs mt-1"></span>
                    </div>

                    <!-- Long Description -->
                    <div class="md:col-span-2">
                        <label asp-for="LongDescription" class="block text-sm font-semibold text-gray-700 mb-2">Detailed Description</label>
                        <textarea asp-for="LongDescription" rows="3" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all duration-200 resize-none" placeholder="Detailed description"></textarea>
                        <span asp-validation-for="LongDescription" class="text-red-500 text-xs mt-1"></span>
                    </div>

                    <!-- Category -->
                    <div>
                        <label asp-for="CategoryId" class="block text-sm font-semibold text-gray-700 mb-2">
                            Category <span class="text-red-500">*</span>
                        </label>
                        <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all duration-200">
                            <option value="">-- Select Category --</option>
                        </select>
                        <span asp-validation-for="CategoryId" class="text-red-500 text-xs mt-1"></span>
                    </div>

                    <!-- Branch -->
                    <div>
                        <label asp-for="BranchId" class="block text-sm font-semibold text-gray-700 mb-2">
                            Branch <span class="text-red-500">*</span>
                        </label>
                        <select asp-for="BranchId" asp-items="ViewBag.Branches" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all duration-200">
                            <option value="">-- Select Branch --</option>
                        </select>
                        <span asp-validation-for="BranchId" class="text-red-500 text-xs mt-1"></span>
                    </div>

                    <!-- Image URL -->
                    <div class="md:col-span-2">
                        <label asp-for="ImageUrl" class="block text-sm font-semibold text-gray-700 mb-2">Image URL</label>
                        <input asp-for="ImageUrl" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all duration-200" placeholder="https://example.com/image.jpg" />
                        <span asp-validation-for="ImageUrl" class="text-red-500 text-xs mt-1"></span>
                    </div>
                </div>
            </div>

            <!-- Pricing Section -->
            <div class="mb-8">
                <h2 class="text-xl font-semibold text-gray-800 mb-6 pb-2 border-b border-gray-200">Pricing Information</h2>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <!-- Price -->
                    <div>
                        <label asp-for="Price" class="block text-sm font-semibold text-gray-700 mb-2">
                            Selling Price <span class="text-red-500">*</span>
                        </label>
                        <div class="relative">
                            <span class="absolute inset-y-0 left-0 pl-4 flex items-center text-gray-500">$</span>
                            <input asp-for="Price" type="number" step="0.01" min="0.01" class="w-full pl-8 pr-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all duration-200" placeholder="0.00" />
                        </div>
                        <span asp-validation-for="Price" class="text-red-500 text-xs mt-1"></span>
                    </div>

                    <!-- Original Price -->
                    <div>
                        <label asp-for="OriginalPrice" class="block text-sm font-semibold text-gray-700 mb-2">Original Price</label>
                        <div class="relative">
                            <span class="absolute inset-y-0 left-0 pl-4 flex items-center text-gray-500">$</span>
                            <input asp-for="OriginalPrice" type="number" step="0.01" min="0" class="w-full pl-8 pr-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all duration-200" placeholder="0.00" />
                        </div>
                        <span asp-validation-for="OriginalPrice" class="text-red-500 text-xs mt-1"></span>
                    </div>

                    <!-- Cost Price -->
                    <div>
                        <label asp-for="CostPrice" class="block text-sm font-semibold text-gray-700 mb-2">Cost Price</label>
                        <div class="relative">
                            <span class="absolute inset-y-0 left-0 pl-4 flex items-center text-gray-500">$</span>
                            <input asp-for="CostPrice" type="number" step="0.01" min="0" value="0" class="w-full pl-8 pr-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all duration-200" placeholder="0.00" />
                        </div>
                        <span asp-validation-for="CostPrice" class="text-red-500 text-xs mt-1"></span>
                    </div>
                </div>
            </div>

            <!-- Nutritional Information Section -->
            <div class="mb-8">
                <h2 class="text-xl font-semibold text-gray-800 mb-6 pb-2 border-b border-gray-200">Nutritional Information (Optional)</h2>
                <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
                    <div>
                        <label asp-for="Calories" class="block text-sm font-semibold text-gray-700 mb-2">Calories</label>
                        <input asp-for="Calories" type="number" min="0" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all duration-200" />
                    </div>
                    <div>
                        <label asp-for="Protein" class="block text-sm font-semibold text-gray-700 mb-2">Protein (g)</label>
                        <input asp-for="Protein" type="number" step="0.1" min="0" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all duration-200" />
                    </div>
                    <div>
                        <label asp-for="Carbohydrates" class="block text-sm font-semibold text-gray-700 mb-2">Carbs (g)</label>
                        <input asp-for="Carbohydrates" type="number" step="0.1" min="0" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all duration-200" />
                    </div>
                    <div>
                        <label asp-for="Fat" class="block text-sm font-semibold text-gray-700 mb-2">Fat (g)</label>
                        <input asp-for="Fat" type="number" step="0.1" min="0" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all duration-200" />
                    </div>
                    <div>
                        <label asp-for="Fiber" class="block text-sm font-semibold text-gray-700 mb-2">Fiber (g)</label>
                        <input asp-for="Fiber" type="number" step="0.1" min="0" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all duration-200" />
                    </div>
                    <div>
                        <label asp-for="Sugar" class="block text-sm font-semibold text-gray-700 mb-2">Sugar (g)</label>
                        <input asp-for="Sugar" type="number" step="0.1" min="0" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all duration-200" />
                    </div>
                    <div>
                        <label asp-for="Sodium" class="block text-sm font-semibold text-gray-700 mb-2">Sodium (mg)</label>
                        <input asp-for="Sodium" type="number" step="0.1" min="0" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all duration-200" />
                    </div>
                </div>
            </div>

            <!-- Dietary Flags & Business Settings Section -->
            <div class="mb-8">
                <h2 class="text-xl font-semibold text-gray-800 mb-6 pb-2 border-b border-gray-200">Dietary Flags & Settings</h2>
                
                <!-- Dietary Flags -->
                <div class="mb-6">
                    <h3 class="text-sm font-semibold text-gray-700 mb-4">Dietary Options</h3>
                    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
                        <div class="flex items-center space-x-2 p-3 bg-green-50 rounded-lg">
                            <input asp-for="IsVegetarian" type="checkbox" class="h-4 w-4 text-green-600 focus:ring-green-500 border-gray-300 rounded" />
                            <label asp-for="IsVegetarian" class="text-sm font-medium text-gray-700">Vegetarian</label>
                        </div>
                        <div class="flex items-center space-x-2 p-3 bg-green-50 rounded-lg">
                            <input asp-for="IsVegan" type="checkbox" class="h-4 w-4 text-green-600 focus:ring-green-500 border-gray-300 rounded" />
                            <label asp-for="IsVegan" class="text-sm font-medium text-gray-700">Vegan</label>
                        </div>
                        <div class="flex items-center space-x-2 p-3 bg-blue-50 rounded-lg">
                            <input asp-for="IsGlutenFree" type="checkbox" class="h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 rounded" />
                            <label asp-for="IsGlutenFree" class="text-sm font-medium text-gray-700">Gluten Free</label>
                        </div>
                        <div class="flex items-center space-x-2 p-3 bg-blue-50 rounded-lg">
                            <input asp-for="IsDairyFree" type="checkbox" class="h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 rounded" />
                            <label asp-for="IsDairyFree" class="text-sm font-medium text-gray-700">Dairy Free</label>
                        </div>
                        <div class="flex items-center space-x-2 p-3 bg-purple-50 rounded-lg">
                            <input asp-for="IsNutFree" type="checkbox" class="h-4 w-4 text-purple-600 focus:ring-purple-500 border-gray-300 rounded" />
                            <label asp-for="IsNutFree" class="text-sm font-medium text-gray-700">Nut Free</label>
                        </div>
                        <div class="flex items-center space-x-2 p-3 bg-red-50 rounded-lg">
                            <input asp-for="IsSpicy" type="checkbox" class="h-4 w-4 text-red-600 focus:ring-red-500 border-gray-300 rounded" />
                            <label asp-for="IsSpicy" class="text-sm font-medium text-gray-700">Spicy</label>
                        </div>
                    </div>
                </div>

                <!-- Spice Level (conditional on IsSpicy) -->
                <div class="mb-6">
                    <label asp-for="SpiceLevel" class="block text-sm font-semibold text-gray-700 mb-2">Spice Level (1-5)</label>
                    <select asp-for="SpiceLevel" asp-items="ViewBag.SpiceLevels" class="w-full md:w-1/3 px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all duration-200">
                        <option value="">-- Select Spice Level --</option>
                    </select>
                </div>

                <!-- Business Settings -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <div>
                        <label asp-for="PreparationTime" class="block text-sm font-semibold text-gray-700 mb-2">Preparation Time (minutes)</label>
                        <input asp-for="PreparationTime" type="number" min="1" value="15" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all duration-200" />
                    </div>

                    <div>
                        <label asp-for="DisplayOrder" class="block text-sm font-semibold text-gray-700 mb-2">Display Order</label>
                        <input asp-for="DisplayOrder" type="number" min="0" value="0" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all duration-200" />
                    </div>

                    <div>
                        <label asp-for="Tags" class="block text-sm font-semibold text-gray-700 mb-2">Tags (comma-separated)</label>
                        <input asp-for="Tags" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all duration-200" placeholder="breakfast, popular, new" />
                    </div>
                </div>

                <!-- Status Checkboxes -->
                <div class="mt-6">
                    <h3 class="text-sm font-semibold text-gray-700 mb-4">Status Options</h3>
                    <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
                        <div class="flex items-center space-x-2 p-3 bg-green-50 rounded-lg">
                            <input asp-for="Availability" type="checkbox" checked class="h-4 w-4 text-green-600 focus:ring-green-500 border-gray-300 rounded" />
                            <label asp-for="Availability" class="text-sm font-medium text-gray-700">Available</label>
                        </div>
                        <div class="flex items-center space-x-2 p-3 bg-yellow-50 rounded-lg">
                            <input asp-for="IsFeatured" type="checkbox" class="h-4 w-4 text-yellow-600 focus:ring-yellow-500 border-gray-300 rounded" />
                            <label asp-for="IsFeatured" class="text-sm font-medium text-gray-700">Featured</label>
                        </div>
                        <div class="flex items-center space-x-2 p-3 bg-purple-50 rounded-lg">
                            <input asp-for="IsSpecial" type="checkbox" class="h-4 w-4 text-purple-600 focus:ring-purple-500 border-gray-300 rounded" />
                            <label asp-for="IsSpecial" class="text-sm font-medium text-gray-700">Daily Special</label>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Form Actions -->
            <div class="flex flex-col sm:flex-row justify-end space-y-3 sm:space-y-0 sm:space-x-4 pt-8 border-t border-gray-200">
                <a asp-action="Index" class="w-full sm:w-auto px-8 py-3 border border-gray-300 rounded-lg text-gray-700 font-medium hover:bg-gray-50 transition-all duration-200 text-center">
                    <i class="fas fa-times mr-2"></i>Cancel
                </a>
                <button type="submit" class="w-full sm:w-auto px-8 py-3 bg-blue-600 text-white font-medium rounded-lg hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 transition-all duration-200 shadow-md hover:shadow-lg">
                    <i class="fas fa-plus mr-2"></i>Create Menu Item
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
