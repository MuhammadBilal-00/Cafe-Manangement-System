@model List<Cafe.Models.AuditLog>
@{
    ViewData["Title"] = "Audit Logs";
    var totalItems = ViewBag.TotalItems ?? Model.Count;
    var currentPage = (int)(ViewBag.CurrentPage ?? 1);
    var totalPages = (int)(ViewBag.TotalPages ?? 1);
}

<!-- Page Header -->
<div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:1rem;margin-bottom:2rem;">
    <div>
        <h1 class="page-title" style="margin:0;">Audit Logs</h1>
        <p class="body-text" style="margin-top:0.25rem;">Track system activity and user actions across the application.
        </p>
    </div>
    @if (Context.Session.GetString("UserRole") == "Owner")
    {
        <div style="display:flex;gap:0.5rem;">
            <a href="@Url.Action("ExportCsv", "AuditLog")" class="btn btn-secondary btn-sm">
                <i class="fas fa-download"></i> Export CSV
            </a>
        </div>
    }
</div>

<!-- KPI Cards -->
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:1rem;margin-bottom:1.5rem;">
    <div class="kpi-card">
        <div class="kpi-icon" style="background:var(--accent-light);color:var(--accent);">
            <i class="fas fa-list-alt"></i>
        </div>
        <span class="kpi-label">Total Entries</span>
        <span class="kpi-value">@totalItems</span>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon" style="background:#dcfce7;color:var(--success);">
            <i class="fas fa-plus-circle"></i>
        </div>
        <span class="kpi-label">Creates</span>
        <span class="kpi-value">@Model.Count(l => l.Action == "Create")</span>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon" style="background:#dbeafe;color:#2563eb;">
            <i class="fas fa-edit"></i>
        </div>
        <span class="kpi-label">Updates</span>
        <span class="kpi-value">@Model.Count(l => l.Action == "Update")</span>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon" style="background:#fee2e2;color:var(--danger);">
            <i class="fas fa-trash-alt"></i>
        </div>
        <span class="kpi-label">Deletes</span>
        <span class="kpi-value">@Model.Count(l => l.Action == "Delete")</span>
    </div>
</div>

<!-- Filters -->
<div class="card mb-6">
    <div class="card-body">
        <form method="get"
              style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:1rem;align-items:end;">
            <div class="form-group">
                <label class="form-label">Entity Type</label>
                <select name="entityType" class="form-select">
                    <option value="">All Types</option>
                    @if (ViewBag.EntityTypes != null)
                    {
                        foreach (var et in ViewBag.EntityTypes)
                        {
                            <option value="@et" selected="@(ViewBag.SelectedEntityType == et)">@et</option>
                        }
                    }
                </select>
            </div>
            <div class="form-group">
                <label class="form-label">Action</label>
                <select name="logAction" class="form-select">
                    <option value="">All Actions</option>
                    @if (ViewBag.Actions != null)
                    {
                        foreach (var a in ViewBag.Actions)
                        {
                            <option value="@a" selected="@(ViewBag.SelectedAction == a)">@a</option>
                        }
                    }
                </select>
            </div>
            <div class="form-group">
                <label class="form-label">From Date</label>
                <input type="date" name="from"
                       value="@(ViewBag.FromDate != null ? ((DateTime)ViewBag.FromDate).ToString("yyyy-MM-dd") : "")"
                       class="form-control" />
            </div>
            <div class="form-group">
                <label class="form-label">To Date</label>
                <input type="date" name="to"
                       value="@(ViewBag.ToDate != null ? ((DateTime)ViewBag.ToDate).ToString("yyyy-MM-dd") : "")"
                       class="form-control" />
            </div>
            <div class="form-group" style="display:flex;gap:0.5rem;">
                <button type="submit" class="btn btn-primary btn-sm" style="flex:1;">
                    <i class="fas fa-filter"></i> Filter
                </button>
                <a href="@Url.Action("Index", "AuditLog")" class="btn btn-secondary btn-sm">Reset</a>
            </div>
        </form>
    </div>
</div>

<!-- Results Table -->
<div class="card">
    <div class="card-header flex justify-between items-center">
        <span class="font-semibold">Activity Log</span>
        <span class="caption">Showing @Model.Count of @totalItems entries &middot; Page @currentPage of
            @totalPages</span>
        </div>

        @if (Model.Count == 0)
        {
            <div class="empty-state">
                <i class="fas fa-clipboard-list" style="font-size:2.5rem;color:var(--text-tertiary);margin-bottom:0.75rem;"></i>
                <p style="font-weight:600;color:var(--text-primary);">No audit log entries found</p>
                <p style="color:var(--text-tertiary);font-size:0.85rem;">Activity will appear here as users interact with the
                    system.</p>
                </div>
            }
    else
            {
                <div style="overflow-x:auto;">
                    <table class="premium-table">
                        <thead>
                            <tr>
                                <th>Timestamp</th>
                                <th>User</th>
                                <th>Action</th>
                                <th>Entity</th>
                                <th>Branch</th>
                                <th>Details</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var log in Model)
                            {
                                var badgeClass = log.Action switch
                                {
                                    "Create" => "badge badge-success",
                                    "Update" => "badge badge-info",
                                    "Delete" => "badge badge-danger",
                                    "Login" => "badge badge-accent",
                                    "Logout" => "badge badge-neutral",
                                    _ => "badge badge-warning"
                                };

                                <tr>
                                    <td style="white-space:nowrap;">
                                        <span style="font-weight:500;">@log.Timestamp.ToLocalTime().ToString("MMM dd, yyyy")</span>
                                        <br />
                                        <span class="caption">@log.Timestamp.ToLocalTime().ToString("HH:mm:ss")</span>
                                    </td>
                                    <td>
                                        <span style="font-weight:600;">@(log.UserName ?? "System")</span>
                                        @if (!string.IsNullOrEmpty(log.UserRole))
                                        {
                                            <br />
                                
                                            <span class="caption">@log.UserRole</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="@badgeClass">@log.Action</span>
                                    </td>
                                    <td>
                                        <span style="font-weight:500;">@log.EntityType</span>
                                        @if (log.EntityId.HasValue)
                                        {
                                            <span class="caption" style="margin-left:0.25rem;">#@log.EntityId</span>
                                        }
                                    </td>
                                    <td style="white-space:nowrap;">
                                        @if (log.Branch != null)
                                        {
                                            @log.Branch.Name
                                        }
                                        else if (log.BranchId.HasValue)
                                        {
                                            <span class="caption">#@log.BranchId</span>
                                        }
                                        else
                                        {
                                            <span style="color:var(--text-tertiary);">&mdash;</span>
                                        }
                                    </td>
                                    <td style="max-width:280px;">
                                        <span style="display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">
                                            @(log.Details ?? "—")
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                @if (totalPages > 1)
                {
                    <div style="padding:1rem 1.5rem;border-top:1px solid var(--border-light);display:flex;justify-content:space-between;align-items:center;">
                        <span class="caption">Page @currentPage of @totalPages</span>
                        <div style="display:flex;gap:0.5rem;">
                            @if (currentPage > 1)
                            {
                                <a href="@Url.Action("Index", new { entityType = ViewBag.SelectedEntityType, logAction = ViewBag.SelectedAction, from = ViewBag.FromDate, to = ViewBag.ToDate, page = currentPage - 1 })"
                                       class="btn btn-secondary btn-sm">
                                    <i class="fas fa-chevron-left"></i> Previous
                                </a>
                            }
                            @if (currentPage < totalPages)
                            {
                                <a href="@Url.Action("Index", new { entityType = ViewBag.SelectedEntityType, logAction = ViewBag.SelectedAction, from = ViewBag.FromDate, to = ViewBag.ToDate, page = currentPage + 1 })"
                                       class="btn btn-secondary btn-sm">
                                    Next <i class="fas fa-chevron-right"></i>
                                </a>
                            }
                        </div>
                    </div>
                }
            }
        </div>