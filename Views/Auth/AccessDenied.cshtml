@{
    ViewData["Title"] = "Access Denied";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Access Denied — Cafe Management</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        accent: { DEFAULT: '#b8912c', hover: '#a37f24' },
                    },
                    fontFamily: { sans: ['Inter', 'system-ui', 'sans-serif'] },
                }
            }
        }
    </script>
</head>
<body class="font-sans min-h-screen flex items-center justify-center bg-[#eef1f4] p-6">
    <div class="bg-white rounded-[20px] shadow-[0_1px_3px_rgba(0,0,0,0.04),0_20px_60px_rgba(0,0,0,0.08)] border border-black/5 max-w-[440px] w-full text-center overflow-hidden transition-shadow duration-500 hover:shadow-[0_4px_12px_rgba(0,0,0,0.07),0_24px_64px_rgba(0,0,0,0.10)]">
        <div class="px-8 pt-10 pb-6 bg-gradient-to-br from-red-50 to-white">
            <div class="w-[72px] h-[72px] rounded-full bg-red-100 inline-flex items-center justify-center text-[1.75rem] text-red-600 mb-5">
                <i class="fas fa-shield-alt"></i>
            </div>
            <h1 class="text-2xl font-bold text-gray-900 mb-1.5">Access Denied</h1>
            <p class="text-[0.88rem] text-gray-500 leading-relaxed">You don't have permission to access this page. Please contact your administrator if you believe this is an error.</p>
        </div>

        @if (TempData["Error"] != null)
        {
            <div class="mx-8 p-3 bg-red-50 border border-red-200 rounded-xl text-red-600 text-[0.82rem]">@TempData["Error"]</div>
        }

        <div class="px-8 pt-6 pb-8 flex flex-col gap-3">
            <a asp-action="Index" asp-controller="Home" class="block w-full py-3 bg-accent text-white rounded-xl font-semibold text-[0.88rem] no-underline text-center transition-all duration-300 hover:bg-accent-hover hover:shadow-[0_4px_16px_rgba(184,145,44,0.35)]">
                <i class="fas fa-home mr-1.5"></i> Go to Dashboard
            </a>
            <a asp-action="Login" asp-controller="Auth" class="block w-full py-3 bg-white text-gray-700 border border-gray-200 rounded-xl font-semibold text-[0.88rem] no-underline text-center transition-all duration-300 hover:bg-gray-50 hover:border-gray-300">
                <i class="fas fa-sign-in-alt mr-1.5"></i> Sign in with different account
            </a>
            <p class="text-[0.78rem] text-gray-400 mt-2">Need help? <a href="mailto:support@cafe.com" class="text-accent no-underline hover:underline">support@cafe.com</a></p>
        </div>
    </div>
</body>
</html>
