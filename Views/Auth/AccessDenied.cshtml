@{
    ViewData["Title"] = "Access Denied";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Access Denied — Cafe Management</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: 'Inter', sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #f5f3f0;
            padding: 1.5rem;
        }
        .card {
            background: #fff;
            border-radius: 20px;
            box-shadow: 0 4px 24px rgba(0,0,0,0.06);
            max-width: 440px;
            width: 100%;
            text-align: center;
            overflow: hidden;
        }
        .card-top {
            padding: 2.5rem 2rem 1.5rem;
            background: linear-gradient(135deg, #fef2f2, #fff);
        }
        .icon-circle {
            width: 72px; height: 72px; border-radius: 50%;
            background: #fee2e2;
            display: inline-flex; align-items: center; justify-content: center;
            font-size: 1.75rem; color: #dc2626; margin-bottom: 1.25rem;
        }
        .card-top h1 { font-size: 1.5rem; font-weight: 700; color: #1a1a1a; margin-bottom: 0.4rem; }
        .card-top p { font-size: 0.88rem; color: #6b7280; line-height: 1.5; }
        .error-box {
            margin: 0 2rem;
            padding: 0.75rem;
            background: #fef2f2;
            border: 1px solid #fecaca;
            border-radius: 10px;
            color: #dc2626;
            font-size: 0.82rem;
        }
        .card-body {
            padding: 1.5rem 2rem 2rem;
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
        }
        .btn-primary-full {
            display: block;
            width: 100%;
            padding: 0.75rem;
            background: #d4af37;
            color: #fff;
            border: none;
            border-radius: 10px;
            font-family: inherit;
            font-size: 0.88rem;
            font-weight: 600;
            text-decoration: none;
            text-align: center;
            transition: background 0.2s;
        }
        .btn-primary-full:hover { background: #c49e2c; }
        .btn-outline-full {
            display: block;
            width: 100%;
            padding: 0.75rem;
            background: #fff;
            color: #374151;
            border: 1px solid #e5e7eb;
            border-radius: 10px;
            font-family: inherit;
            font-size: 0.88rem;
            font-weight: 600;
            text-decoration: none;
            text-align: center;
            transition: background 0.2s;
        }
        .btn-outline-full:hover { background: #f9fafb; }
        .support-text { font-size: 0.78rem; color: #9ca3af; margin-top: 0.5rem; }
        .support-text a { color: #d4af37; text-decoration: none; }
        .support-text a:hover { text-decoration: underline; }
    </style>
</head>
<body>
    <div class="card">
        <div class="card-top">
            <div class="icon-circle"><i class="fas fa-shield-alt"></i></div>
            <h1>Access Denied</h1>
            <p>You don't have permission to access this page. Please contact your administrator if you believe this is an error.</p>
        </div>

        @if (TempData["Error"] != null)
        {
            <div class="error-box">@TempData["Error"]</div>
        }

        <div class="card-body">
            <a asp-action="Index" asp-controller="Home" class="btn-primary-full">
                <i class="fas fa-home" style="margin-right:0.4rem;"></i> Go to Dashboard
            </a>
            <a asp-action="Login" asp-controller="Auth" class="btn-outline-full">
                <i class="fas fa-sign-in-alt" style="margin-right:0.4rem;"></i> Sign in with different account
            </a>
            <p class="support-text">Need help? <a href="mailto:support@cafe.com">support@cafe.com</a></p>
        </div>
    </div>
</body>
</html>
