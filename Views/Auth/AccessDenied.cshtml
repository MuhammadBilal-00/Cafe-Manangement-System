@{
    ViewData["Title"] = "Access Denied";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Access Denied - Cafe Management System</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/AccessDeniedStyle.css" />
</head>
<body>
    <div class="bg-white p-8 rounded-xl shadow-lg w-full max-w-md text-center">
        <div class="mb-6">
            <div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-red-100 text-red-500 mb-4">
                <i class="fas fa-ban text-3xl"></i>
            </div>
            <h1 class="text-2xl font-bold text-gray-800 mb-2">Access Denied</h1>
            <p class="text-gray-600">You don't have permission to access this page.</p>
        </div>

        @if (TempData["Error"] != null)
        {
            <div class="mb-6 p-4 bg-red-50 text-red-700 rounded-lg">
                <p>@TempData["Error"]</p>
            </div>
        }

        <div class="space-y-3">
            <a asp-action="Index" asp-controller="Home" class="w-full bg-blue-600 text-white py-3 px-4 rounded-lg hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 font-medium transition duration-150 block">
                Go to Dashboard
            </a>

            <a asp-action="Login" asp-controller="Auth" class="w-full border border-gray-300 text-gray-700 py-3 px-4 rounded-lg hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 font-medium transition duration-150 block">
                Sign in with different account
            </a>
        </div>

        <div class="mt-6 text-center">
            <p class="text-sm text-gray-600">
                Need help? Contact support at
                <a href="mailto:support@cafe.com" class="text-blue-600 hover:text-blue-500">support@cafe.com</a>
            </p>
        </div>
    </div>
</body>
</html>