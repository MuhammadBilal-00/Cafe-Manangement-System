@model Cafe.Models.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Register";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Create Account — Cafe Management</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        accent: { DEFAULT: '#d4af37', hover: '#c5a028', light: 'rgba(212,175,55,0.10)' },
                        surface: { DEFAULT: '#ffffff', alt: '#faf9f7' },
                        body: '#f5f3f0',
                        sidebar: '#1e2a3a',
                    },
                    fontFamily: { sans: ['Inter', 'system-ui', 'sans-serif'] },
                }
            }
        }
    </script>
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: 'Inter', sans-serif;
            min-height: 100vh;
            display: flex;
            background: #f5f3f0;
            color: #1a1a1a;
        }
        .split-left {
            flex: 1;
            background: linear-gradient(135deg, #1e2a3a 0%, #2d3e50 50%, #1e2a3a 100%);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 3rem;
            position: relative;
            overflow: hidden;
        }
        .split-left::before {
            content: '';
            position: absolute;
            bottom: -50%;
            left: -50%;
            width: 100%;
            height: 100%;
            background: radial-gradient(circle, rgba(212,175,55,0.08) 0%, transparent 70%);
            border-radius: 50%;
        }

        .pw-toggle {
            position: absolute; right: 0.75rem; top: 50%; transform: translateY(-50%);
            background: none; border: none; color: #9ca3af; cursor: pointer; font-size: 0.85rem;
        }
        .pw-toggle:hover { color: #6b7280; }
        .pw-bar-bg { height: 4px; background: #e5e7eb; border-radius: 4px; overflow: hidden; }
        .pw-bar { height: 100%; border-radius: 4px; transition: width 0.3s, background 0.3s; width: 0%; }

        @@media (max-width: 768px) {
            .split-left { display: none; }
            .split-right { padding: 1.5rem; }
        }
    </style>
</head>
<body>
    <div class="split-left">
        <div class="w-20 h-20 rounded-[20px] bg-accent/15 flex items-center justify-center text-[2rem] text-accent mb-8">
            <i class="fas fa-user-plus"></i>
        </div>
        <div class="text-[1.75rem] font-bold text-white mb-2">Join Us</div>
        <div class="text-[0.9rem] text-white/60 max-w-[280px] text-center leading-relaxed">Create your account in minutes and start managing your operations.</div>
        <div class="mt-10 flex flex-col gap-5">
            <div class="flex items-center gap-3 text-white/70 text-[0.85rem]"><div class="w-7 h-7 rounded-full bg-accent/20 text-accent flex items-center justify-center text-xs font-bold shrink-0">1</div> Fill in your details</div>
            <div class="flex items-center gap-3 text-white/70 text-[0.85rem]"><div class="w-7 h-7 rounded-full bg-accent/20 text-accent flex items-center justify-center text-xs font-bold shrink-0">2</div> Choose your role</div>
            <div class="flex items-center gap-3 text-white/70 text-[0.85rem]"><div class="w-7 h-7 rounded-full bg-accent/20 text-accent flex items-center justify-center text-xs font-bold shrink-0">3</div> Set a secure password</div>
            <div class="flex items-center gap-3 text-white/70 text-[0.85rem]"><div class="w-7 h-7 rounded-full bg-accent/20 text-accent flex items-center justify-center text-xs font-bold shrink-0">4</div> Start managing your cafe!</div>
        </div>
    </div>
    <div class="flex-1 flex items-center justify-center p-8 overflow-y-auto">
        <div class="w-full max-w-[480px] bg-white rounded-2xl shadow-[0_1px_3px_rgba(0,0,0,0.04),0_8px_30px_rgba(0,0,0,0.06)] border border-black/5 p-8 transition-shadow duration-300 hover:shadow-[0_4px_12px_rgba(0,0,0,0.07),0_12px_32px_rgba(0,0,0,0.06)]">
            <h2 class="text-2xl font-bold text-gray-900 mb-1">Create Account</h2>
            <p class="text-sm text-gray-500 mb-7">Join the cafe management platform</p>

            <form asp-action="Register" method="post">
                <div asp-validation-summary="ModelOnly" class="bg-red-50 border border-red-200 text-red-600 text-[0.8rem] p-3 rounded-xl mb-4"></div>

                @if (TempData["Success"] != null)
                {
                    <div class="bg-green-50 border border-green-200 text-green-600 text-[0.8rem] p-3 rounded-xl mb-4">@TempData["Success"]</div>
                }

                <div class="mb-4">
                    <label asp-for="Name" class="block text-[0.8rem] font-semibold text-gray-700 mb-1"></label>
                    <input asp-for="Name" placeholder="Your full name" class="w-full py-2.5 px-3.5 border border-gray-200 rounded-xl font-sans text-[0.85rem] bg-white transition-all duration-200 focus:outline-none focus:border-accent focus:ring-[3px] focus:ring-accent/10" />
                    <div class="text-red-600 text-[0.72rem] mt-0.5"><span asp-validation-for="Name"></span></div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-4">
                    <div>
                        <label asp-for="Email" class="block text-[0.8rem] font-semibold text-gray-700 mb-1"></label>
                        <input asp-for="Email" placeholder="name@cafe.com" class="w-full py-2.5 px-3.5 border border-gray-200 rounded-xl font-sans text-[0.85rem] bg-white transition-all duration-200 focus:outline-none focus:border-accent focus:ring-[3px] focus:ring-accent/10" />
                        <div class="text-red-600 text-[0.72rem] mt-0.5"><span asp-validation-for="Email"></span></div>
                    </div>
                    <div>
                        <label asp-for="Phone" class="block text-[0.8rem] font-semibold text-gray-700 mb-1"></label>
                        <input asp-for="Phone" placeholder="+1234567890" class="w-full py-2.5 px-3.5 border border-gray-200 rounded-xl font-sans text-[0.85rem] bg-white transition-all duration-200 focus:outline-none focus:border-accent focus:ring-[3px] focus:ring-accent/10" />
                        <div class="text-red-600 text-[0.72rem] mt-0.5"><span asp-validation-for="Phone"></span></div>
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="Role" class="block text-[0.8rem] font-semibold text-gray-700 mb-1"></label>
                    <select asp-for="Role" class="w-full py-2.5 px-3.5 border border-gray-200 rounded-xl font-sans text-[0.85rem] bg-white transition-all duration-200 focus:outline-none focus:border-accent focus:ring-[3px] focus:ring-accent/10 appearance-none cursor-pointer">
                        <option value="">Select Role</option>
                        <option value="Customer">Customer</option>
                        <option value="Staff">Staff</option>
                        <option value="BranchManager">Branch Manager</option>
                        <option value="Owner">Owner</option>
                    </select>
                    <div class="text-red-600 text-[0.72rem] mt-0.5"><span asp-validation-for="Role"></span></div>
                </div>

                <div class="mb-4">
                    <label asp-for="Address" class="block text-[0.8rem] font-semibold text-gray-700 mb-1"></label>
                    <textarea asp-for="Address" placeholder="Your address (optional)" rows="2" class="w-full py-2.5 px-3.5 border border-gray-200 rounded-xl font-sans text-[0.85rem] bg-white transition-all duration-200 focus:outline-none focus:border-accent focus:ring-[3px] focus:ring-accent/10 resize-none"></textarea>
                    <div class="text-red-600 text-[0.72rem] mt-0.5"><span asp-validation-for="Address"></span></div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-4">
                    <div>
                        <label asp-for="Password" class="block text-[0.8rem] font-semibold text-gray-700 mb-1"></label>
                        <div class="relative">
                            <input asp-for="Password" type="password" id="password" placeholder="••••••••" class="w-full py-2.5 px-3.5 border border-gray-200 rounded-xl font-sans text-[0.85rem] bg-white transition-all duration-200 focus:outline-none focus:border-accent focus:ring-[3px] focus:ring-accent/10" />
                            <button type="button" class="pw-toggle" onclick="togglePw('password')"><i class="fas fa-eye"></i></button>
                        </div>
                        <div class="text-red-600 text-[0.72rem] mt-0.5"><span asp-validation-for="Password"></span></div>
                        <div class="mt-1.5" id="strengthWrap" style="display:none;">
                            <div class="pw-bar-bg"><div class="pw-bar" id="pwBar"></div></div>
                        </div>
                    </div>
                    <div>
                        <label asp-for="ConfirmPassword" class="block text-[0.8rem] font-semibold text-gray-700 mb-1"></label>
                        <div class="relative">
                            <input asp-for="ConfirmPassword" type="password" id="confirmPassword" placeholder="••••••••" class="w-full py-2.5 px-3.5 border border-gray-200 rounded-xl font-sans text-[0.85rem] bg-white transition-all duration-200 focus:outline-none focus:border-accent focus:ring-[3px] focus:ring-accent/10" />
                            <button type="button" class="pw-toggle" onclick="togglePw('confirmPassword')"><i class="fas fa-eye"></i></button>
                        </div>
                        <div class="text-red-600 text-[0.72rem] mt-0.5"><span asp-validation-for="ConfirmPassword"></span></div>
                    </div>
                </div>

                <button type="submit" class="w-full py-3 mt-2 bg-accent text-white border-none rounded-xl font-sans text-[0.9rem] font-semibold cursor-pointer transition-all duration-300 hover:bg-accent-hover hover:shadow-[0_4px_16px_rgba(212,175,55,0.35)] active:scale-[0.98]">Create Account</button>
            </form>

            <p class="text-center mt-5 text-[0.8rem] text-gray-500">
                Already have an account? <a asp-action="Login" class="text-accent font-semibold hover:underline">Sign in here</a>
            </p>
        </div>
    </div>

    <script>
        function togglePw(id) {
            const inp = document.getElementById(id);
            const icon = inp.parentElement.querySelector('i');
            if (inp.type === 'password') { inp.type = 'text'; icon.className = 'fas fa-eye-slash'; }
            else { inp.type = 'password'; icon.className = 'fas fa-eye'; }
        }
        const pw = document.getElementById('password');
        const bar = document.getElementById('pwBar');
        const wrap = document.getElementById('strengthWrap');
        if (pw) pw.addEventListener('input', function () {
            const v = this.value;
            if (!v) { wrap.style.display = 'none'; return; }
            wrap.style.display = 'block';
            let s = 0;
            if (v.length >= 8) s += 25;
            if (/[a-z]/.test(v)) s += 25;
            if (/[A-Z]/.test(v)) s += 25;
            if (/[0-9!@@#$%^&*]/.test(v)) s += 25;
            bar.style.width = s + '%';
            bar.style.background = s < 50 ? '#dc2626' : s < 75 ? '#d97706' : '#16a34a';
        });
    </script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
