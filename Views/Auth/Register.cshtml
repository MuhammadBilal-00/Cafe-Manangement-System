@model Cafe.Models.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Register";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Create Account — Cafe Management</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: 'Inter', sans-serif;
            min-height: 100vh;
            display: flex;
            background: #f5f3f0;
            color: #1a1a1a;
        }
        .split-left {
            flex: 1;
            background: linear-gradient(135deg, #1e2a3a 0%, #2d3e50 50%, #1e2a3a 100%);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 3rem;
            position: relative;
            overflow: hidden;
        }
        .split-left::before {
            content: '';
            position: absolute;
            bottom: -50%;
            left: -50%;
            width: 100%;
            height: 100%;
            background: radial-gradient(circle, rgba(212,175,55,0.08) 0%, transparent 70%);
            border-radius: 50%;
        }
        .brand-icon {
            width: 80px; height: 80px; border-radius: 20px;
            background: rgba(212,175,55,0.15);
            display: flex; align-items: center; justify-content: center;
            font-size: 2rem; color: #d4af37; margin-bottom: 2rem;
        }
        .brand-title { font-size: 1.75rem; font-weight: 700; color: #fff; margin-bottom: 0.5rem; }
        .brand-sub { font-size: 0.9rem; color: rgba(255,255,255,0.6); max-width: 280px; text-align: center; line-height: 1.6; }
        .step-list { margin-top: 2.5rem; display: flex; flex-direction: column; gap: 1.25rem; }
        .step-item { display: flex; align-items: center; gap: 0.75rem; color: rgba(255,255,255,0.7); font-size: 0.85rem; }
        .step-num { width: 28px; height: 28px; border-radius: 50%; background: rgba(212,175,55,0.2); color: #d4af37; display: flex; align-items: center; justify-content: center; font-size: 0.75rem; font-weight: 700; flex-shrink: 0; }

        .split-right {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem;
            overflow-y: auto;
        }
        .reg-card { width: 100%; max-width: 480px; }
        .reg-card h2 { font-size: 1.5rem; font-weight: 700; margin-bottom: 0.25rem; }
        .reg-card .subtitle { font-size: 0.85rem; color: #6b7280; margin-bottom: 1.75rem; }

        .field { margin-bottom: 1rem; }
        .field label { display: block; font-size: 0.8rem; font-weight: 600; color: #374151; margin-bottom: 0.35rem; }
        .field input, .field select, .field textarea {
            width: 100%; padding: 0.65rem 0.8rem; border: 1px solid #e5e7eb; border-radius: 10px;
            font-family: inherit; font-size: 0.85rem; background: #fff;
            transition: border-color 0.2s, box-shadow 0.2s;
        }
        .field input:focus, .field select:focus, .field textarea:focus {
            outline: none; border-color: #d4af37; box-shadow: 0 0 0 3px rgba(212,175,55,0.12);
        }
        .field .error { color: #dc2626; font-size: 0.72rem; margin-top: 0.2rem; }
        .field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; }
        .validation-summary { background: #fef2f2; border: 1px solid #fecaca; color: #dc2626; font-size: 0.8rem; padding: 0.75rem; border-radius: 10px; margin-bottom: 1rem; }
        .success-msg { background: #f0fdf4; border: 1px solid #bbf7d0; color: #16a34a; font-size: 0.8rem; padding: 0.75rem; border-radius: 10px; margin-bottom: 1rem; }

        .pw-strength { margin-top: 0.35rem; }
        .pw-bar-bg { height: 4px; background: #e5e7eb; border-radius: 4px; overflow: hidden; }
        .pw-bar { height: 100%; border-radius: 4px; transition: width 0.3s, background 0.3s; width: 0%; }

        .btn-submit {
            width: 100%; padding: 0.75rem; background: #d4af37; color: #fff; border: none; border-radius: 10px;
            font-family: inherit; font-size: 0.9rem; font-weight: 600; cursor: pointer;
            transition: background 0.2s, transform 0.1s; margin-top: 0.5rem;
        }
        .btn-submit:hover { background: #c49e2c; }
        .btn-submit:active { transform: scale(0.98); }

        .footer-text { text-align: center; margin-top: 1.25rem; font-size: 0.8rem; color: #6b7280; }
        .footer-text a { color: #d4af37; text-decoration: none; font-weight: 600; }
        .footer-text a:hover { text-decoration: underline; }

        .pw-toggle {
            position: absolute; right: 0.75rem; top: 50%; transform: translateY(-50%);
            background: none; border: none; color: #9ca3af; cursor: pointer; font-size: 0.85rem;
        }
        .pw-toggle:hover { color: #6b7280; }

        @@media (max-width: 768px) {
            .split-left { display: none; }
            .split-right { padding: 1.5rem; }
            .field-row { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>
    <div class="split-left">
        <div class="brand-icon"><i class="fas fa-user-plus"></i></div>
        <div class="brand-title">Join Us</div>
        <div class="brand-sub">Create your account in minutes and start managing your operations.</div>
        <div class="step-list">
            <div class="step-item"><div class="step-num">1</div> Fill in your details</div>
            <div class="step-item"><div class="step-num">2</div> Choose your role</div>
            <div class="step-item"><div class="step-num">3</div> Set a secure password</div>
            <div class="step-item"><div class="step-num">4</div> Start managing your cafe!</div>
        </div>
    </div>
    <div class="split-right">
        <div class="reg-card">
            <h2>Create Account</h2>
            <p class="subtitle">Join the cafe management platform</p>

            <form asp-action="Register" method="post">
                <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

                @if (TempData["Success"] != null)
                {
                    <div class="success-msg">@TempData["Success"]</div>
                }

                <div class="field">
                    <label asp-for="Name"></label>
                    <input asp-for="Name" placeholder="Your full name" />
                    <div class="error"><span asp-validation-for="Name"></span></div>
                </div>

                <div class="field-row">
                    <div class="field">
                        <label asp-for="Email"></label>
                        <input asp-for="Email" placeholder="name@cafe.com" />
                        <div class="error"><span asp-validation-for="Email"></span></div>
                    </div>
                    <div class="field">
                        <label asp-for="Phone"></label>
                        <input asp-for="Phone" placeholder="+1234567890" />
                        <div class="error"><span asp-validation-for="Phone"></span></div>
                    </div>
                </div>

                <div class="field">
                    <label asp-for="Role"></label>
                    <select asp-for="Role">
                        <option value="">Select Role</option>
                        <option value="Customer">Customer</option>
                        <option value="Staff">Staff</option>
                        <option value="BranchManager">Branch Manager</option>
                        <option value="Owner">Owner</option>
                    </select>
                    <div class="error"><span asp-validation-for="Role"></span></div>
                </div>

                <div class="field">
                    <label asp-for="Address"></label>
                    <textarea asp-for="Address" placeholder="Your address (optional)" rows="2"></textarea>
                    <div class="error"><span asp-validation-for="Address"></span></div>
                </div>

                <div class="field-row">
                    <div class="field">
                        <label asp-for="Password"></label>
                        <div style="position:relative;">
                            <input asp-for="Password" type="password" id="password" placeholder="••••••••" />
                            <button type="button" class="pw-toggle" onclick="togglePw('password')"><i class="fas fa-eye"></i></button>
                        </div>
                        <div class="error"><span asp-validation-for="Password"></span></div>
                        <div class="pw-strength" id="strengthWrap" style="display:none;">
                            <div class="pw-bar-bg"><div class="pw-bar" id="pwBar"></div></div>
                        </div>
                    </div>
                    <div class="field">
                        <label asp-for="ConfirmPassword"></label>
                        <div style="position:relative;">
                            <input asp-for="ConfirmPassword" type="password" id="confirmPassword" placeholder="••••••••" />
                            <button type="button" class="pw-toggle" onclick="togglePw('confirmPassword')"><i class="fas fa-eye"></i></button>
                        </div>
                        <div class="error"><span asp-validation-for="ConfirmPassword"></span></div>
                    </div>
                </div>

                <button type="submit" class="btn-submit">Create Account</button>
            </form>

            <p class="footer-text">
                Already have an account? <a asp-action="Login">Sign in here</a>
            </p>
        </div>
    </div>

    <script>
        function togglePw(id) {
            const inp = document.getElementById(id);
            const icon = inp.parentElement.querySelector('i');
            if (inp.type === 'password') { inp.type = 'text'; icon.className = 'fas fa-eye-slash'; }
            else { inp.type = 'password'; icon.className = 'fas fa-eye'; }
        }
        const pw = document.getElementById('password');
        const bar = document.getElementById('pwBar');
        const wrap = document.getElementById('strengthWrap');
        if (pw) pw.addEventListener('input', function () {
            const v = this.value;
            if (!v) { wrap.style.display = 'none'; return; }
            wrap.style.display = 'block';
            let s = 0;
            if (v.length >= 8) s += 25;
            if (/[a-z]/.test(v)) s += 25;
            if (/[A-Z]/.test(v)) s += 25;
            if (/[0-9!@@#$%^&*]/.test(v)) s += 25;
            bar.style.width = s + '%';
            bar.style.background = s < 50 ? '#dc2626' : s < 75 ? '#d97706' : '#16a34a';
        });
    </script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
