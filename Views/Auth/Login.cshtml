@model Cafe.Models.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign In — Cafe Management</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        // Literal hexes (not var()) so Tailwind opacity modifiers like
        // bg-accent/15 keep working; values mirror the light theme tokens.
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        accent: { DEFAULT: '#b8912c', hover: '#a37f24', light: 'rgba(184,145,44,0.12)' },
                        surface: { DEFAULT: '#ffffff', alt: '#f6f8fa' },
                        body: '#eef1f4',
                        sidebar: '#101215',
                    },
                    fontFamily: { sans: ['Inter', 'system-ui', 'sans-serif'] },
                }
            }
        }
    </script>
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: 'Inter', sans-serif;
            min-height: 100vh;
            display: flex;
            background: var(--bg-body);
            color: var(--text-primary);
        }
        .split-left {
            flex: 1;
            background: linear-gradient(135deg, #101215 0%, #1c2026 50%, #101215 100%);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 3rem;
            position: relative;
            overflow: hidden;
        }
        .split-left::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -50%;
            width: 100%;
            height: 100%;
            background: radial-gradient(circle, var(--accent-lighter) 0%, transparent 70%);
            border-radius: 50%;
        }

        @@media (max-width: 768px) {
            .split-left { display: none; }
            .split-right { padding: 1.5rem; }
        }
    </style>
</head>
<body>
    <div class="split-left">
        <div class="w-20 h-20 rounded-[20px] bg-accent/15 flex items-center justify-center text-[2rem] text-accent mb-8">
            <i class="fas fa-utensils"></i>
        </div>
        <div class="text-[1.75rem] font-bold text-white mb-2">Cafe Management</div>
        <div class="text-[0.9rem] text-white/60 max-w-[280px] text-center leading-relaxed">Enterprise-grade restaurant management platform for modern hospitality.</div>
        <div class="mt-10 flex flex-col gap-4">
            <div class="flex items-center gap-3 text-white/70 text-[0.85rem]"><i class="fas fa-chart-line text-accent w-5 text-center"></i> Real-time analytics & reports</div>
            <div class="flex items-center gap-3 text-white/70 text-[0.85rem]"><i class="fas fa-store text-accent w-5 text-center"></i> Multi-branch operations</div>
            <div class="flex items-center gap-3 text-white/70 text-[0.85rem]"><i class="fas fa-shield-alt text-accent w-5 text-center"></i> Role-based access control</div>
            <div class="flex items-center gap-3 text-white/70 text-[0.85rem]"><i class="fas fa-clipboard-list text-accent w-5 text-center"></i> Order & inventory tracking</div>
        </div>
    </div>
    <div class="flex-1 flex items-center justify-center p-8">
        <div class="w-full max-w-[420px] bg-white rounded-2xl shadow-[0_1px_3px_rgba(0,0,0,0.04),0_8px_30px_rgba(0,0,0,0.06)] border border-black/5 p-8 transition-shadow duration-300 hover:shadow-[0_4px_12px_rgba(0,0,0,0.07),0_12px_32px_rgba(0,0,0,0.06)]">
            <h2 class="text-2xl font-bold text-gray-900 mb-1">Welcome back</h2>
            <p class="text-sm text-gray-500 mb-8">Sign in to your account to continue</p>

            <form asp-action="Login" method="post">
                <div asp-validation-summary="ModelOnly" class="bg-red-50 border border-red-200 text-red-600 text-[0.8rem] p-3 rounded-xl mb-5"></div>

                @if (TempData["Success"] != null)
                {
                    <div class="bg-green-50 border border-green-200 text-green-600 text-[0.8rem] p-3 rounded-xl mb-5">@TempData["Success"]</div>
                }

                <div class="mb-5">
                    <label asp-for="Email" class="block text-[0.8rem] font-semibold text-gray-700 mb-1.5"></label>
                    <input asp-for="Email" placeholder="name@cafe.com" class="w-full py-3 px-4 border border-gray-200 rounded-xl font-sans text-[0.88rem] bg-white transition-all duration-200 focus:outline-none focus:border-accent focus:ring-[3px] focus:ring-accent/10" />
                    <div class="text-red-600 text-xs mt-1"><span asp-validation-for="Email"></span></div>
                </div>

                <div class="mb-5">
                    <label asp-for="Password" class="block text-[0.8rem] font-semibold text-gray-700 mb-1.5"></label>
                    <input asp-for="Password" type="password" placeholder="••••••••" class="w-full py-3 px-4 border border-gray-200 rounded-xl font-sans text-[0.88rem] bg-white transition-all duration-200 focus:outline-none focus:border-accent focus:ring-[3px] focus:ring-accent/10" />
                    <div class="text-red-600 text-xs mt-1"><span asp-validation-for="Password"></span></div>
                </div>

                <div class="flex items-center justify-between mb-6">
                    <label class="flex items-center gap-1.5 text-[0.8rem] text-gray-500 cursor-pointer">
                        <input asp-for="RememberMe" class="accent-accent w-4 h-4" />
                        Remember me
                    </label>
                    <span class="text-[0.75rem] text-gray-400">Forgot password? Contact your administrator.</span>
                </div>

                <button type="submit" class="w-full py-3 bg-accent text-white border-none rounded-xl font-sans text-[0.9rem] font-semibold cursor-pointer transition-all duration-300 hover:bg-accent-hover hover:shadow-[0_4px_16px_rgba(212,175,55,0.35)] active:scale-[0.98]">Sign in</button>
            </form>

            <p class="text-center mt-6 text-[0.8rem] text-gray-500">
                Accounts are created by your administrator.
            </p>

            <div class="mt-6 p-4 bg-surface-alt border border-gray-200/60 rounded-xl text-center">
                <strong class="text-[0.78rem] text-gray-700">Demo Accounts</strong>
                <span class="block text-[0.72rem] text-gray-500 mt-1">Owner: admin&#64;cafe.com / admin123</span>
                <span class="block text-[0.72rem] text-gray-500 mt-0.5">Manager: sarah&#64;cafe.com / manager123</span>
                <span class="block text-[0.72rem] text-gray-500 mt-0.5">Staff: emily&#64;cafe.com / staff123</span>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
