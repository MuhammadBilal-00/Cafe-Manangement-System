@model Cafe.Models.User
@{
    ViewData["Title"] = "My Profile";
}

<div class="grid grid-cols-1 lg:grid-cols-3 gap-5">
    <div class="lg:col-span-2 card">
        <div class="card-header">
            <h3 class="section-title flex items-center gap-2">
                <i class="fas fa-user-circle text-accent"></i> My Profile
            </h3>
        </div>
        <div class="card-body">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="space-y-3.5">
                    <div>
                        <span class="text-xs font-medium text-[var(--text-tertiary)] uppercase tracking-wider">Name</span>
                        <p class="text-sm font-semibold text-[var(--text-primary)] mt-0.5">@Model.Name</p>
                    </div>
                    <div>
                        <span class="text-xs font-medium text-[var(--text-tertiary)] uppercase tracking-wider">Email</span>
                        <p class="text-sm font-semibold text-[var(--text-primary)] mt-0.5">@Model.Email</p>
                    </div>
                    <div>
                        <span class="text-xs font-medium text-[var(--text-tertiary)] uppercase tracking-wider">Phone</span>
                        <p class="text-sm font-semibold text-[var(--text-primary)] mt-0.5">@Model.Phone</p>
                    </div>
                    <div>
                        <span class="text-xs font-medium text-[var(--text-tertiary)] uppercase tracking-wider">Role</span>
                        <div class="mt-1">
                            @{
                                var roleBadge = Model.Role switch
                                {
                                    "Owner" => "badge-danger",
                                    "BranchManager" => "badge-warning",
                                    "Staff" => "badge-info",
                                    _ => "badge-neutral"
                                };
                            }
                            <span class="badge @roleBadge">@Model.Role</span>
                        </div>
                    </div>
                </div>
                <div class="space-y-3.5">
                    <div>
                        <span class="text-xs font-medium text-[var(--text-tertiary)] uppercase tracking-wider">Member Since</span>
                        <p class="text-sm font-semibold text-[var(--text-primary)] mt-0.5">@Model.CreatedDate.ToString("MMM dd, yyyy")</p>
                    </div>
                    <div>
                        <span class="text-xs font-medium text-[var(--text-tertiary)] uppercase tracking-wider">Account Status</span>
                        <p class="text-sm font-semibold text-green-600 mt-0.5 flex items-center gap-1.5">
                            <span class="w-2 h-2 rounded-full bg-green-500"></span> Active
                        </p>
                    </div>
                </div>
            </div>

            <div class="flex flex-wrap gap-3 mt-6 pt-5 border-t border-[var(--border-light)]">
                <a href="#" class="btn btn-primary">
                    <i class="fas fa-edit"></i> Edit Profile
                </a>
                <a href="#" class="btn btn-secondary">
                    <i class="fas fa-key"></i> Change Password
                </a>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h3 class="section-title flex items-center gap-2">
                <i class="fas fa-cog text-accent"></i> Quick Actions
            </h3>
        </div>
        <div class="card-body flex flex-col gap-2.5">
            @if (ViewBag.UserRole == "Customer")
            {
                <a asp-controller="CustomerOrder" asp-action="Menu" class="btn btn-secondary btn-sm w-full">
                    <i class="fas fa-utensils"></i> Browse Menu
                </a>
                <a asp-controller="CustomerOrder" asp-action="Index" class="btn btn-secondary btn-sm w-full">
                    <i class="fas fa-receipt"></i> My Orders
                </a>
            }
            @if (ViewBag.UserRole == "Staff" || ViewBag.UserRole == "BranchManager" || ViewBag.UserRole == "Owner")
            {
                <a asp-controller="Order" asp-action="Index" class="btn btn-secondary btn-sm w-full">
                    <i class="fas fa-clipboard-list"></i> Manage Orders
                </a>
                <a asp-controller="InventoryItem" asp-action="Index" class="btn btn-secondary btn-sm w-full">
                    <i class="fas fa-boxes"></i> Inventory
                </a>
            }
            @if (ViewBag.UserRole == "Owner" || ViewBag.UserRole == "BranchManager")
            {
                <a asp-controller="Reports" asp-action="Index" class="btn btn-secondary btn-sm w-full">
                    <i class="fas fa-chart-bar"></i> Reports
                </a>
            }

            <div class="border-t border-[var(--border-light)] pt-2.5 mt-1">
                <form asp-controller="Auth" asp-action="Logout" method="post">
                    <button type="submit" class="btn btn-danger btn-sm w-full">
                        <i class="fas fa-sign-out-alt"></i> Logout
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
