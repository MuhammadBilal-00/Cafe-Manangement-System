@model Cafe.Models.User
@{
    ViewData["Title"] = "Settings";
}

<!-- Page Header -->
<div style="margin-bottom:2rem;">
    <h1 class="page-title" style="margin:0;">Account Settings</h1>
    <p class="body-text" style="margin-top:0.25rem;">Manage your account preferences and security.</p>
</div>

<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(340px,1fr));gap:1.5rem;">
    <!-- Profile Info (read-only) -->
    <div class="card">
        <div class="card-header">
            <i class="fas fa-user-circle" style="color:var(--accent);margin-right:0.5rem;"></i>
            Profile Information
        </div>
        <div class="card-body flex flex-col gap-5">
            <div>
                <span class="caption" style="text-transform:uppercase;letter-spacing:0.08em;">Name</span>
                <p style="font-weight:600;color:var(--text-primary);margin-top:0.15rem;">@Model.Name</p>
            </div>
            <div>
                <span class="caption" style="text-transform:uppercase;letter-spacing:0.08em;">Email</span>
                <p style="font-weight:500;color:var(--text-primary);margin-top:0.15rem;">@Model.Email</p>
            </div>
            <div>
                <span class="caption" style="text-transform:uppercase;letter-spacing:0.08em;">Phone</span>
                <p style="font-weight:500;color:var(--text-primary);margin-top:0.15rem;">@(Model.Phone ?? "Not set")</p>
            </div>
            <div>
                <span class="caption" style="text-transform:uppercase;letter-spacing:0.08em;">Role</span>
                <p style="margin-top:0.15rem;"><span class="badge badge-accent">@Model.Role</span></p>
            </div>
            <div>
                <span class="caption" style="text-transform:uppercase;letter-spacing:0.08em;">Member Since</span>
                <p style="font-weight:500;color:var(--text-primary);margin-top:0.15rem;">
                    @Model.CreatedDate.ToString("MMMM dd, yyyy")</p>
                </div>
            </div>
        </div>

        <!-- Change Password -->
        <div class="card">
            <div class="card-header">
                <i class="fas fa-lock" style="color:var(--accent);margin-right:0.5rem;"></i>
                Change Password
            </div>
            <div class="card-body">
                <form asp-controller="User" asp-action="ChangePassword" method="post">
                    @Html.AntiForgeryToken()
                    <div class="form-group">
                        <label class="form-label">Current Password</label>
                        <input type="password" name="CurrentPassword" required class="form-control"
                               placeholder="Enter current password" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">New Password</label>
                        <input type="password" name="NewPassword" required minlength="6" class="form-control"
                               placeholder="Min 6 characters" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Confirm New Password</label>
                        <input type="password" name="ConfirmNewPassword" required minlength="6" class="form-control"
                               placeholder="Re-enter new password" />
                    </div>
                    <button type="submit" class="btn btn-primary" style="width:100%;">
                        <i class="fas fa-key"></i> Update Password
                    </button>
                </form>
            </div>
        </div>
    </div>