@model Cafe.Models.User
@{
    ViewData["Title"] = "My Profile";
}

<div class="mb-6">
    <h1 class="text-2xl font-bold text-gray-800">My Profile</h1>
    <p class="text-sm text-gray-500 mt-1">View your account information.</p>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <!-- Profile Information -->
    <div class="bg-white rounded-xl shadow-md p-6">
        <h2 class="text-lg font-semibold text-gray-800 mb-4">
            <i class="fas fa-user-circle mr-2 text-indigo-600"></i>Profile Information
        </h2>
        <div class="space-y-4">
            <div>
                <label class="block text-sm font-medium text-gray-600">Name</label>
                <p class="mt-1 text-gray-800 font-medium">@Model.Name</p>
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-600">Email</label>
                <p class="mt-1 text-gray-800">@Model.Email</p>
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-600">Phone</label>
                <p class="mt-1 text-gray-800">@(Model.Phone ?? "Not set")</p>
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-600">Role</label>
                <span class="mt-1 inline-block px-3 py-1 text-xs rounded-full font-medium bg-indigo-100 text-indigo-800">@Model.Role</span>
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-600">Member Since</label>
                <p class="mt-1 text-gray-800">@Model.CreatedDate.ToString("MMMM dd, yyyy")</p>
            </div>
        </div>
    </div>

    <!-- Quick Links -->
    <div class="bg-white rounded-xl shadow-md p-6">
        <h2 class="text-lg font-semibold text-gray-800 mb-4">
            <i class="fas fa-link mr-2 text-indigo-600"></i>Quick Links
        </h2>
        <div class="space-y-3">
            <a asp-controller="User" asp-action="Settings" class="flex items-center text-indigo-600 hover:text-indigo-800 transition-colors">
                <i class="fas fa-cog mr-2"></i> Account Settings
            </a>
            <a asp-controller="Home" asp-action="Index" class="flex items-center text-indigo-600 hover:text-indigo-800 transition-colors">
                <i class="fas fa-home mr-2"></i> Dashboard
            </a>
        </div>
    </div>
</div>
