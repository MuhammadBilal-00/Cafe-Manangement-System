@{
    ViewData["Title"] = "Setup Wizard";
    bool hasBranch = ViewBag.HasBranchDetails ?? false;
    int menuCount = ViewBag.MenuCount ?? 0;
    int staffCount = ViewBag.StaffCount ?? 0;
    int catCount = ViewBag.CategoryCount ?? 0;

    var steps = new[]
    {
        new { Done = hasBranch, Title = "Complete your branch details", Sub = "Add location, hours and contact info.",
              Controller = "Branch", Action = "Index" },
        new { Done = menuCount > 0, Title = "Build your menu", Sub = $"{menuCount} item(s) across {catCount} categories. Import below or add manually.",
              Controller = "MenuItem", Action = "Index" },
        new { Done = staffCount > 0, Title = "Add your team", Sub = $"{staffCount} staff member(s) added.",
              Controller = "Staff", Action = "Index" }
    };
    int doneCount = steps.Count(s => s.Done);
    int pct = (int)Math.Round(doneCount * 100.0 / steps.Length);
}

@section Styles {
<style>
/* Onboarding stepper: numbered circles + connector line */
.setup-stepper { display: flex; flex-direction: column; }
.setup-step { display: flex; gap: 1rem; position: relative; padding-bottom: 1.6rem; }
.setup-step:last-child { padding-bottom: 0; }
.setup-step::before {
    content: '';
    position: absolute;
    inset-inline-start: 19px;
    top: 40px;
    bottom: 4px;
    width: 2px;
    background: var(--border);
}
.setup-step:last-child::before { display: none; }
.setup-step.done::before { background: var(--success); }
.setup-step-dot {
    width: 40px; height: 40px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-weight: 700; font-size: 0.9rem; flex-shrink: 0;
    background: var(--bg-inset); color: var(--text-tertiary);
    border: 2px solid var(--border);
    position: relative; z-index: 1;
    transition: all var(--transition-base);
}
.setup-step.done .setup-step-dot {
    background: var(--success); border-color: var(--success); color: #fff;
}
.setup-step.next .setup-step-dot {
    background: var(--accent-light); border-color: var(--accent); color: var(--accent);
}
.setup-step-body {
    flex: 1; display: flex; align-items: center; justify-content: space-between;
    gap: 1rem; flex-wrap: wrap; padding-top: 6px;
}
.setup-progress-track {
    height: 8px; border-radius: var(--radius-full); background: var(--bg-inset); overflow: hidden;
}
.setup-progress-fill {
    height: 100%; border-radius: var(--radius-full); background: var(--success);
    transition: width 600ms cubic-bezier(0.4,0,0.2,1);
}
</style>
}

<div style="max-width:820px;margin:0 auto;">
    <div style="margin-bottom:1.5rem;">
        <h1 class="page-title" style="margin:0;">Welcome — let’s finish setup</h1>
        <p class="body-text" style="margin-top:0.25rem;">A few quick steps to get your restaurant live.</p>
    </div>

    <!-- Progress -->
    <div class="card mb-6">
        <div class="card-body" style="padding:1.2rem 1.5rem;">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:0.6rem;">
                <span style="font-weight:700;font-size:0.9rem;">Setup progress</span>
                <span class="num" style="font-weight:700;font-size:0.9rem;color:@(pct == 100 ? "var(--success)" : "var(--text-secondary)");">@doneCount of @steps.Length · @pct%</span>
            </div>
            <div class="setup-progress-track">
                <div class="setup-progress-fill" style="width:@pct%;"></div>
            </div>
        </div>
    </div>

    <!-- Stepper -->
    <div class="card mb-6">
        <div class="card-body" style="padding:1.6rem 1.5rem;">
            <div class="setup-stepper">
                @{ bool nextMarked = false; }
                @for (int i = 0; i < steps.Length; i++)
                {
                    var s = steps[i];
                    var isNext = !s.Done && !nextMarked;
                    if (isNext) { nextMarked = true; }
                    <div class="setup-step @(s.Done ? "done" : "") @(isNext ? "next" : "")">
                        <div class="setup-step-dot">
                            @if (s.Done)
                            {
                                <i class="fas fa-check"></i>
                            }
                            else
                            {
                                @(i + 1)
                            }
                        </div>
                        <div class="setup-step-body">
                            <div>
                                <div style="font-weight:600;">@s.Title</div>
                                <div class="caption">@s.Sub</div>
                            </div>
                            <a asp-controller="@s.Controller" asp-action="@s.Action"
                               class="btn @(isNext ? "btn-primary" : "btn-secondary") btn-sm">@(s.Done ? "Review" : "Open")</a>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- CSV import -->
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:1.25rem;">
        <div class="card">
            <div class="card-body">
                <h3 style="margin:0 0 0.25rem;font-size:1.05rem;"><i class="fas fa-file-csv" style="color:var(--accent);margin-right:0.4rem;"></i> Import products</h3>
                <p class="caption" style="margin:0 0 0.75rem;">CSV columns: <b>Name, Category, Price, CostPrice</b></p>
                <form asp-controller="Setup" asp-action="ImportProducts" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="file" name="file" accept=".csv" class="form-control" required style="margin-bottom:0.75rem;" />
                    <button type="submit" class="btn btn-primary btn-sm" style="width:100%;"><i class="fas fa-upload" style="margin-right:0.4rem;"></i> Import products</button>
                </form>
            </div>
        </div>
        <div class="card">
            <div class="card-body">
                <h3 style="margin:0 0 0.25rem;font-size:1.05rem;"><i class="fas fa-file-csv" style="color:var(--accent);margin-right:0.4rem;"></i> Import customers</h3>
                <p class="caption" style="margin:0 0 0.75rem;">CSV columns: <b>Name, Email, Phone</b></p>
                <form asp-controller="Setup" asp-action="ImportCustomers" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="file" name="file" accept=".csv" class="form-control" required style="margin-bottom:0.75rem;" />
                    <button type="submit" class="btn btn-primary btn-sm" style="width:100%;"><i class="fas fa-upload" style="margin-right:0.4rem;"></i> Import customers</button>
                </form>
            </div>
        </div>
    </div>

    <div style="text-align:center;margin-top:1.5rem;">
        <a asp-controller="Home" asp-action="Index" class="btn btn-ghost">Skip for now <i class="fas fa-arrow-right" style="margin-left:0.3rem;"></i></a>
    </div>
</div>
