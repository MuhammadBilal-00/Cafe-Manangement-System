@{
    ViewData["Title"] = "Setup Wizard";
    bool hasBranch = ViewBag.HasBranchDetails ?? false;
    int menuCount = ViewBag.MenuCount ?? 0;
    int staffCount = ViewBag.StaffCount ?? 0;
    int catCount = ViewBag.CategoryCount ?? 0;

    (string,string) Step(bool done) => done ? ("var(--success)", "fa-circle-check") : ("var(--text-tertiary)", "fa-circle");
}

<div style="max-width:820px;margin:0 auto;">
    <div style="margin-bottom:1.5rem;">
        <h1 class="page-title" style="margin:0;">Welcome — let’s finish setup</h1>
        <p class="body-text" style="margin-top:0.25rem;">A few quick steps to get your restaurant live.</p>
    </div>

    <!-- Checklist -->
    <div class="card mb-6">
        <div class="card-body" style="display:flex;flex-direction:column;gap:0.9rem;">
            @{ var s1 = Step(hasBranch); var s2 = Step(menuCount > 0); var s3 = Step(staffCount > 0); }
            <div style="display:flex;align-items:center;justify-content:space-between;gap:1rem;">
                <div style="display:flex;align-items:center;gap:0.75rem;">
                    <i class="fas @s1.Item2" style="color:@s1.Item1;font-size:1.2rem;"></i>
                    <div><div style="font-weight:600;">Complete your branch details</div><div class="caption">Add location, hours and contact info.</div></div>
                </div>
                <a asp-controller="Branch" asp-action="Index" class="btn btn-secondary btn-sm">Open</a>
            </div>
            <div class="divider"></div>
            <div style="display:flex;align-items:center;justify-content:space-between;gap:1rem;">
                <div style="display:flex;align-items:center;gap:0.75rem;">
                    <i class="fas @s2.Item2" style="color:@s2.Item1;font-size:1.2rem;"></i>
                    <div><div style="font-weight:600;">Build your menu</div><div class="caption">@menuCount item(s) across @catCount categories. Import below or add manually.</div></div>
                </div>
                <a asp-controller="MenuItem" asp-action="Index" class="btn btn-secondary btn-sm">Open</a>
            </div>
            <div class="divider"></div>
            <div style="display:flex;align-items:center;justify-content:space-between;gap:1rem;">
                <div style="display:flex;align-items:center;gap:0.75rem;">
                    <i class="fas @s3.Item2" style="color:@s3.Item1;font-size:1.2rem;"></i>
                    <div><div style="font-weight:600;">Add your team</div><div class="caption">@staffCount staff member(s) added.</div></div>
                </div>
                <a asp-controller="Staff" asp-action="Index" class="btn btn-secondary btn-sm">Open</a>
            </div>
        </div>
    </div>

    <!-- CSV import -->
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:1.25rem;">
        <div class="card">
            <div class="card-body">
                <h3 style="margin:0 0 0.25rem;font-size:1.05rem;"><i class="fas fa-file-csv" style="color:var(--accent);margin-right:0.4rem;"></i> Import products</h3>
                <p class="caption" style="margin:0 0 0.75rem;">CSV columns: <b>Name, Category, Price, CostPrice</b></p>
                <form asp-controller="Setup" asp-action="ImportProducts" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="file" name="file" accept=".csv" class="form-control" required style="margin-bottom:0.75rem;" />
                    <button type="submit" class="btn btn-primary btn-sm" style="width:100%;"><i class="fas fa-upload" style="margin-right:0.4rem;"></i> Import products</button>
                </form>
            </div>
        </div>
        <div class="card">
            <div class="card-body">
                <h3 style="margin:0 0 0.25rem;font-size:1.05rem;"><i class="fas fa-file-csv" style="color:var(--accent);margin-right:0.4rem;"></i> Import customers</h3>
                <p class="caption" style="margin:0 0 0.75rem;">CSV columns: <b>Name, Email, Phone</b></p>
                <form asp-controller="Setup" asp-action="ImportCustomers" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="file" name="file" accept=".csv" class="form-control" required style="margin-bottom:0.75rem;" />
                    <button type="submit" class="btn btn-primary btn-sm" style="width:100%;"><i class="fas fa-upload" style="margin-right:0.4rem;"></i> Import customers</button>
                </form>
            </div>
        </div>
    </div>

    <div style="text-align:center;margin-top:1.5rem;">
        <a asp-controller="Home" asp-action="Index" class="btn btn-ghost">Skip for now <i class="fas fa-arrow-right" style="margin-left:0.3rem;"></i></a>
    </div>
</div>
