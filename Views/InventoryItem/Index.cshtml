@model IEnumerable<Cafe.Models.InventoryItem>
@{
    ViewData["Title"] = "Inventory Management";
    var branches = ViewBag.Branches as List<Cafe.Models.Branch> ?? new List<Cafe.Models.Branch>();
    var selectedBranchId = ViewBag.SelectedBranchId as int?;
    var currentBranch = ViewBag.CurrentBranch as string ?? "All Branches";
    var itemsByBranch = Model.GroupBy(i => i.Branch).ToList();

    var totalItems = Model.Count();
    var needReorder = Model.Count(i => i.Quantity <= i.ReorderLevel);
    var totalValue = Model.Sum(i => i.Quantity * i.UnitPrice);
    var healthy = totalItems == 0 ? 0 : (int)(Model.Count(i => i.Quantity > i.ReorderLevel) * 100.0 / totalItems);
}

<!-- Page Header -->
<div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:1rem;margin-bottom:2rem;">
    <div>
        <h1 class="page-title" style="margin:0;">Inventory Management</h1>
        <p class="body-text" style="margin-top:0.25rem;">
            Viewing: <strong>@currentBranch</strong>
        </p>
    </div>
    <div style="display:flex;gap:0.5rem;">
        @if (Context.Session.GetString("UserRole") == "Owner")
        {
            <a href="@Url.Action("ExportCsv", "InventoryItem")" class="btn btn-secondary btn-sm">
                <i class="fas fa-download"></i> Export
            </a>
        }
        <a href="@Url.Action("Create")" class="btn btn-primary btn-sm">
            <i class="fas fa-plus"></i> Add Item
        </a>
    </div>
</div>

<!-- KPI Cards -->
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:1rem;margin-bottom:1.5rem;">
    <div class="kpi-card">
        <div class="kpi-icon" style="background:var(--accent-light);color:var(--accent);">
            <i class="fas fa-boxes"></i>
        </div>
        <span class="kpi-label">Total Items</span>
        <span class="kpi-value">@totalItems</span>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon" style="background:#dbeafe;color:#2563eb;">
            <i class="fas fa-building"></i>
        </div>
        <span class="kpi-label">Branches</span>
        <span class="kpi-value">@branches.Count</span>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon" style="background:#fef3c7;color:#d97706;">
            <i class="fas fa-exclamation-triangle"></i>
        </div>
        <span class="kpi-label">Need Reorder</span>
        <span class="kpi-value">@needReorder</span>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon" style="background:#dcfce7;color:#16a34a;">
            <i class="fas fa-dollar-sign"></i>
        </div>
        <span class="kpi-label">Total Value</span>
        <span class="kpi-value">$@totalValue.ToString("N0")</span>
    </div>
</div>

<!-- Stock Health Bar -->
<div class="card" style="margin-bottom:1.5rem;">
    <div class="card-body" style="padding:0.75rem 1.25rem;">
        <div style="display:flex;justify-content:space-between;font-size:0.75rem;color:var(--text-tertiary);margin-bottom:0.3rem;">
            <span>Stock Health</span>
            <span>@healthy% OK</span>
        </div>
        <div style="height:6px;border-radius:3px;background:var(--border-light);overflow:hidden;">
            <div style="height:100%;border-radius:3px;background:linear-gradient(90deg,#10b981,var(--accent));width:@(healthy)%;transition:width 0.6s;"></div>
        </div>
    </div>
</div>

<!-- Controls -->
<div class="card" style="margin-bottom:1.5rem;">
    <div class="card-body" style="display:flex;flex-wrap:wrap;gap:1rem;align-items:end;">
        <!-- Search -->
        <div class="form-group" style="flex:1;min-width:200px;margin:0;">
            <label class="form-label">Search</label>
            <input type="text" id="searchInput" class="form-control" placeholder="Find items by name..." />
        </div>

        <!-- Branch Filter -->
        <div style="display:flex;gap:0.4rem;flex-wrap:wrap;">
            <a href="@Url.Action("Index")"
               class="btn btn-sm @(selectedBranchId == null ? "btn-primary" : "btn-secondary")">
                All
            </a>
            @foreach (var branch in branches)
            {
                <a href="@Url.Action("Index", new { branchId = branch.Id })"
                   class="btn btn-sm @(selectedBranchId == branch.Id ? "btn-primary" : "btn-secondary")">
                    @branch.Name
                </a>
            }
        </div>

        <!-- Status Filter -->
        <div style="display:flex;gap:0.25rem;background:var(--bg-body);border-radius:10px;border:1px solid var(--border-light);padding:0.2rem;">
            <button data-filter="all" class="filter-btn btn btn-sm btn-primary" style="border-radius:8px;">All</button>
            <button data-filter="reorder" class="filter-btn btn btn-sm btn-ghost" style="border-radius:8px;">⚠ Reorder</button>
            <button data-filter="out" class="filter-btn btn btn-sm btn-ghost" style="border-radius:8px;">Out</button>
        </div>
    </div>
</div>

<!-- Inventory Grid -->
@if (Model.Any())
{
    if (selectedBranchId == null)
    {
        foreach (var branchGroup in itemsByBranch)
        {
            var branch = branchGroup.Key;
            var items = branchGroup.ToList();
            var branchReorder = items.Count(i => i.Quantity <= i.ReorderLevel);
            var branchValue = items.Sum(i => i.Quantity * i.UnitPrice);

            <div class="branch-section" data-branch-id="@branch?.Id" style="margin-bottom:2rem;">
                <div class="card" style="margin-bottom:1rem;">
                    <div class="card-body" style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:1rem;">
                        <div>
                            <h3 class="section-title" style="margin:0;">
                                <i class="fas fa-building" style="color:var(--accent);margin-right:0.4rem;"></i>
                                @branch?.Name
                            </h3>
                            <p class="caption" style="margin-top:0.15rem;">@branch?.Location</p>
                        </div>
                        <div style="display:flex;gap:1rem;">
                            <div style="text-align:center;">
                                <span class="caption" style="font-size:0.65rem;text-transform:uppercase;">Items</span>
                                <p style="font-weight:700;font-size:1.1rem;color:var(--text-primary);">@items.Count</p>
                            </div>
                            <div style="text-align:center;">
                                <span class="caption" style="font-size:0.65rem;text-transform:uppercase;color:#d97706;">Reorder</span>
                                <p style="font-weight:700;font-size:1.1rem;color:#d97706;">@branchReorder</p>
                            </div>
                            <div style="text-align:center;">
                                <span class="caption" style="font-size:0.65rem;text-transform:uppercase;color:#16a34a;">Value</span>
                                <p style="font-weight:700;font-size:1.1rem;color:#16a34a;">$@branchValue.ToString("N0")</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:1rem;">
                    @foreach (var item in items)
                    {
                        @await Html.PartialAsync("_InventoryItemCard", item)
                    }
                </div>
            </div>
        }
    }
    else
    {
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:1rem;">
            @foreach (var item in Model)
            {
                @await Html.PartialAsync("_InventoryItemCard", item)
            }
        </div>
    }
}
else
{
    <div class="card">
        <div class="empty-state">
            <i class="fas fa-box-open" style="font-size:3rem;color:var(--text-tertiary);margin-bottom:1rem;"></i>
            <p style="font-weight:600;font-size:1.1rem;color:var(--text-primary);">No Inventory Items Yet</p>
            <p class="caption" style="margin-bottom:1.25rem;">Add your first item to start tracking stock across branches.</p>
            <a href="@Url.Action("Create")" class="btn btn-primary">
                <i class="fas fa-plus"></i> Add First Item
            </a>
        </div>
    </div>
}

<!-- Restock Modal -->
<div id="restockModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.5);backdrop-filter:blur(4px);z-index:1000;align-items:center;justify-content:center;padding:1rem;">
    <div style="background:#fff;border-radius:var(--radius-card);max-width:420px;width:100%;padding:2rem;box-shadow:0 24px 60px rgba(0,0,0,0.2);position:relative;">
        <button onclick="closeRestockModal()" style="position:absolute;top:1rem;right:1rem;background:var(--bg-body);border:1px solid var(--border-light);border-radius:50%;width:32px;height:32px;cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:0.9rem;color:var(--text-tertiary);">×</button>
        <div style="text-align:center;margin-bottom:1.5rem;">
            <div style="width:48px;height:48px;background:linear-gradient(135deg,#10b981,#06b6d4);border-radius:14px;display:flex;align-items:center;justify-content:center;margin:0 auto 0.75rem;">
                <i class="fas fa-box" style="color:#fff;font-size:1.25rem;"></i>
            </div>
            <h2 style="font-weight:700;font-size:1.15rem;color:var(--text-primary);">Restock Item</h2>
            <p id="restockItemName" class="caption"></p>
        </div>
        <form id="restockForm" onsubmit="handleRestock(event)">
            <input type="hidden" id="restockItemId" />
            <div class="form-group">
                <label class="form-label">Add Quantity</label>
                <input type="number" id="restockQuantity" class="form-control" min="1" step="0.01" required />
                <small id="unitDisplay" class="caption" style="margin-top:0.25rem;display:block;"></small>
            </div>
            <div style="display:flex;gap:0.75rem;margin-top:1rem;">
                <button type="button" onclick="closeRestockModal()" class="btn btn-secondary" style="flex:1;">Cancel</button>
                <button type="submit" class="btn btn-primary" style="flex:1;">Confirm Restock</button>
            </div>
        </form>
    </div>
</div>

<div id="toastContainer" style="position:fixed;top:1rem;right:1rem;z-index:1100;pointer-events:none;"></div>

@section Scripts {
<script>
    // Search
    document.getElementById('searchInput')?.addEventListener('input', filterCards);

    // Status filter buttons
    document.querySelectorAll('.filter-btn').forEach(btn => {
        btn.addEventListener('click', function () {
            document.querySelectorAll('.filter-btn').forEach(b => {
                b.className = 'filter-btn btn btn-sm btn-ghost';
                b.style.borderRadius = '8px';
            });
            this.className = 'filter-btn btn btn-sm btn-primary';
            this.style.borderRadius = '8px';
            filterCards();
        });
    });

    function filterCards() {
        const searchTerm = (document.getElementById('searchInput')?.value || '').toLowerCase();
        const activeBtn = document.querySelector('.filter-btn.btn-primary');
        const activeFilter = activeBtn ? activeBtn.dataset.filter : 'all';
        document.querySelectorAll('.inventory-card').forEach(card => {
            const name = (card.dataset.name || '').toLowerCase();
            const stockStatus = card.dataset.stockStatus;
            let show = true;
            if (searchTerm && !name.includes(searchTerm)) show = false;
            if (activeFilter === 'reorder' && stockStatus !== 'low' && stockStatus !== 'critical') show = false;
            if (activeFilter === 'out' && stockStatus !== 'critical') show = false;
            card.style.display = show ? '' : 'none';
        });
    }

    function openRestockModal(id, name, unit) {
        document.getElementById('restockItemId').value = id;
        document.getElementById('restockItemName').textContent = name;
        document.getElementById('unitDisplay').textContent = 'Unit: ' + unit;
        document.getElementById('restockQuantity').value = '';
        const modal = document.getElementById('restockModal');
        modal.style.display = 'flex';
    }
    function closeRestockModal() {
        document.getElementById('restockModal').style.display = 'none';
    }
    function handleRestock(e) {
        e.preventDefault();
        const itemId = document.getElementById('restockItemId').value;
        const quantity = document.getElementById('restockQuantity').value;
        fetch('@Url.Action("Restock")', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: 'id=' + encodeURIComponent(itemId) + '&quantity=' + encodeURIComponent(quantity)
        })
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                showNotification('Stock updated successfully!', 'success');
                closeRestockModal();
                setTimeout(() => location.reload(), 900);
            } else {
                showNotification('Failed to update stock', 'error');
            }
        })
        .catch(() => showNotification('Failed to update stock', 'error'));
    }
    function showNotification(message, type) {
        const container = document.getElementById('toastContainer');
        const toast = document.createElement('div');
        toast.style.cssText = 'pointer-events:auto;margin-bottom:0.5rem;padding:0.75rem 1rem;border-radius:12px;font-size:0.85rem;font-weight:600;color:#fff;box-shadow:0 8px 24px rgba(0,0,0,0.15);transform:translateX(120%);transition:transform 0.3s;';
        toast.style.background = type === 'success' ? '#10b981' : '#ef4444';
        toast.textContent = message;
        container.appendChild(toast);
        requestAnimationFrame(() => toast.style.transform = 'translateX(0)');
        setTimeout(() => { toast.style.transform = 'translateX(120%)'; setTimeout(() => toast.remove(), 300); }, 2600);
    }
    document.getElementById('restockModal')?.addEventListener('click', function(e) {
        if (e.target === this) closeRestockModal();
    });
</script>
}
