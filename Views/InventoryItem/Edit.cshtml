@model Cafe.Models.InventoryItem
@{
    ViewData["Title"] = "Edit Inventory Item";
    var branches = ViewBag.Branches as List<Cafe.Models.Branch> ?? new List<Cafe.Models.Branch>();
}

<!-- Page Header -->
<div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:1rem;margin-bottom:2rem;">
    <div>
        <h1 class="page-title" style="margin:0;">Edit Inventory Item</h1>
        <p class="body-text" style="margin-top:0.25rem;">Update stock, pricing or branch for this item.</p>
    </div>
    <a href="@Url.Action("Index")" class="btn btn-secondary btn-sm">
        <i class="fas fa-arrow-left"></i> Back to Inventory
    </a>
</div>

<div style="display:grid;grid-template-columns:2fr 1fr;gap:1.5rem;">
    <!-- Form -->
    <div class="card">
        <div class="card-header">Item Details</div>
        <div class="card-body">
            @using (Html.BeginForm("Edit", "InventoryItem", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.Id)

                <div class="form-row">
                    <div class="form-group" style="grid-column:1/-1;">
                        <label class="form-label">Item Name</label>
                        @Html.TextBoxFor(m => m.Name, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.Name, "", new { @class = "form-error" })
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Branch</label>
                        @if (branches.Any())
                        {
                            @Html.DropDownListFor(m => m.BranchId, new SelectList(branches, "Id", "Name", Model.BranchId), "-- Select Branch --", new { @class = "form-select" })
                        }
                        else
                        {
                            <select class="form-select" disabled><option>No branches available</option></select>
                        }
                        @Html.ValidationMessageFor(m => m.BranchId, "", new { @class = "form-error" })
                    </div>
                    <div class="form-group">
                        <label class="form-label">Unit</label>
                        @Html.TextBoxFor(m => m.Unit, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.Unit, "", new { @class = "form-error" })
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Current Quantity</label>
                        @Html.TextBoxFor(m => m.Quantity, new { type = "number", step = "0.01", min = "0", @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.Quantity, "", new { @class = "form-error" })
                    </div>
                    <div class="form-group">
                        <label class="form-label">Unit Price ($)</label>
                        @Html.TextBoxFor(m => m.UnitPrice, new { type = "number", step = "0.01", min = "0", @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.UnitPrice, "", new { @class = "form-error" })
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Reorder Level</label>
                        @Html.TextBoxFor(m => m.ReorderLevel, new { type = "number", step = "0.01", min = "0", @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.ReorderLevel, "", new { @class = "form-error" })
                    </div>
                    <div class="form-group"></div>
                </div>

                <div class="divider"></div>

                <div style="display:flex;justify-content:flex-end;gap:0.75rem;">
                    <a href="@Url.Action("Index")" class="btn btn-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Save Changes</button>
                </div>
            }
        </div>
    </div>

    <!-- Current Snapshot -->
    <div class="card" style="background:linear-gradient(135deg,#1e2a3a,#2d3f54);color:#fff;border:none;align-self:start;">
        <div class="card-header" style="border-color:rgba(255,255,255,0.1);color:#fff;">
            <i class="fas fa-camera" style="margin-right:0.4rem;"></i> Current Snapshot
        </div>
        <div class="card-body" style="color:#fff;">
            <div style="margin-bottom:1rem;">
                <span style="font-size:0.65rem;text-transform:uppercase;letter-spacing:0.12em;color:rgba(255,255,255,0.5);">Inventory Card</span>
                <h3 style="font-weight:700;font-size:1.1rem;margin-top:0.2rem;">@Model.Name</h3>
                <p style="font-size:0.8rem;color:rgba(255,255,255,0.6);margin-top:0.15rem;">
                    <i class="fas fa-building" style="font-size:0.65rem;margin-right:0.2rem;"></i>
                    @(Model.Branch?.Name ?? "No branch")
                </p>
            </div>
            <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:0.5rem;text-align:center;">
                <div style="background:rgba(255,255,255,0.1);border-radius:10px;padding:0.5rem;">
                    <span style="font-size:0.6rem;text-transform:uppercase;color:rgba(255,255,255,0.5);">Qty</span>
                    <p style="font-weight:600;font-size:0.9rem;">@Model.Quantity.ToString("0.##")</p>
                </div>
                <div style="background:rgba(255,255,255,0.1);border-radius:10px;padding:0.5rem;">
                    <span style="font-size:0.6rem;text-transform:uppercase;color:rgba(255,255,255,0.5);">Unit</span>
                    <p style="font-weight:600;font-size:0.9rem;">@Model.Unit</p>
                </div>
                <div style="background:rgba(255,255,255,0.1);border-radius:10px;padding:0.5rem;">
                    <span style="font-size:0.6rem;text-transform:uppercase;color:rgba(255,255,255,0.5);">Reorder</span>
                    <p style="font-weight:600;font-size:0.9rem;color:var(--accent);">@Model.ReorderLevel.ToString("0.##")</p>
                </div>
            </div>
            <div style="margin-top:1rem;text-align:right;">
                <span style="font-size:0.65rem;text-transform:uppercase;color:rgba(255,255,255,0.5);">Total Value</span>
                <p style="font-weight:700;font-size:1.25rem;color:#10b981;">@((Model.Quantity * Model.UnitPrice).ToString("C0"))</p>
            </div>
            <div style="margin-top:0.75rem;padding-top:0.75rem;border-top:1px solid rgba(255,255,255,0.1);font-size:0.75rem;color:rgba(255,255,255,0.5);">
                Last updated: <strong style="color:#fff;">@Model.LastUpdated.ToString("g")</strong>
            </div>
        </div>
    </div>
</div>
