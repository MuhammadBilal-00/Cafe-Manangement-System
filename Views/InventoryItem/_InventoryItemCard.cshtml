@model Cafe.Models.InventoryItem

@{
    string stockStatus;
    if (Model.Quantity == 0) stockStatus = "critical";
    else if (Model.Quantity <= Model.ReorderLevel) stockStatus = "low";
    else stockStatus = "normal";

    var statusLabel = stockStatus == "critical"
        ? "Out of Stock"
        : stockStatus == "low"
            ? "Low Stock"
            : "In Stock";

    var statusBg = stockStatus == "critical"
        ? "bg-red-50 border-red-200 text-red-700"
        : stockStatus == "low"
            ? "bg-amber-50 border-amber-200 text-amber-700"
            : "bg-emerald-50 border-emerald-200 text-emerald-700";

    var statusDot = stockStatus == "critical"
        ? "bg-red-500"
        : stockStatus == "low"
            ? "bg-amber-500"
            : "bg-emerald-500";
}

<div class="inventory-card rounded-2xl shadow-md border border-slate-200 bg-white/90 p-4 flex flex-col h-full relative overflow-hidden"
     data-name="@Model.Name.ToLower()"
     data-stock-status="@stockStatus">

    <!-- soft background accent -->
    <div class="pointer-events-none absolute -right-8 -top-8 w-24 h-24 rounded-full bg-sky-100"></div>

    <div class="relative flex flex-col h-full">
        <!-- Header -->
        <div class="flex items-start justify-between gap-2 mb-2.5">
            <div>
                <h4 class="text-sm font-semibold text-slate-900 line-clamp-1">
                    @Model.Name
                </h4>
                <p class="text-[11px] text-slate-500 mt-0.5 flex items-center gap-1">
                    <span class="text-xs">🏢</span>
                    @Model.Branch?.Name
                </p>
            </div>

            <span class="inline-flex items-center px-2.5 py-1 rounded-full border text-[11px] font-medium @statusBg">
                <span class="w-1.5 h-1.5 rounded-full mr-1.5 @statusDot"></span>
                @statusLabel
            </span>
        </div>

        <!-- Metrics -->
        <div class="mt-2 mb-3 grid grid-cols-3 gap-2 text-center">
            <div class="rounded-xl bg-slate-50 border border-slate-200 p-2.5">
                <p class="text-[10px] text-slate-500 uppercase tracking-wide">Qty</p>
                <p class="text-sm font-semibold text-slate-900">
                    @Model.Quantity.ToString("0.##")
                </p>
            </div>
            <div class="rounded-xl bg-slate-50 border border-slate-200 p-2.5">
                <p class="text-[10px] text-slate-500 uppercase tracking-wide">Unit</p>
                <p class="text-sm font-semibold text-slate-900">
                    @Model.Unit
                </p>
            </div>
            <div class="rounded-xl bg-gradient-to-br from-sky-50 to-emerald-50 border border-sky-200 p-2.5">
                <p class="text-[10px] text-sky-700 uppercase tracking-wide">Value</p>
                <p class="text-sm font-semibold text-sky-900">
                    @("$" + (Model.Quantity * Model.UnitPrice).ToString("N2"))
                </p>
            </div>
        </div>

        <!-- Reorder / Price -->
        <div class="flex items-center justify-between text-[11px] mb-3">
            <span class="text-slate-500">
                Reorder at
                <span class="font-semibold text-slate-900">
                    @Model.ReorderLevel.ToString("0.##")
                </span>
            </span>
            <span class="text-slate-500">
                Price:
                <span class="font-semibold text-slate-900">
                    @("$" + Model.UnitPrice.ToString("N2"))
                </span>
            </span>
        </div>

        <div class="border-t border-slate-200 my-2"></div>

        <!-- Actions -->
        <div class="mt-auto flex items-center justify-between pt-1 gap-2">
            <button type="button"
                    onclick="openRestockModal('@Model.Id', '@Model.Name.Replace("'", "\\'")', '@Model.Unit')"
                    class="inline-flex items-center px-3 py-1.5 rounded-xl text-xs font-semibold border border-emerald-200 text-emerald-700 bg-emerald-50 hover:bg-emerald-100 transition-colors">
                <span class="mr-1.5">➕</span>
                Restock
            </button>

            <div class="flex items-center gap-2">
                <a href="@Url.Action("Edit", "InventoryItem", new { id = Model.Id })"
                   class="inline-flex items-center justify-center w-8 h-8 rounded-xl border border-slate-200 text-slate-500 bg-white hover:bg-slate-50 hover:text-slate-800 text-xs shadow-sm transition-colors">
                    ✏️
                </a>
                <a href="@Url.Action("Delete", "InventoryItem", new { id = Model.Id })"
                   class="inline-flex items-center justify-center w-8 h-8 rounded-xl border border-rose-200 text-rose-500 bg-rose-50 hover:bg-rose-100 hover:text-rose-700 text-xs shadow-sm transition-colors">
                    🗑
                </a>
            </div>
        </div>
    </div>
</div>