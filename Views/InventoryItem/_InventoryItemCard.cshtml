@model InventoryItem

@{
    var stockPercentage = Model.MinimumThreshold > 0 ? Math.Min(100, (decimal)(Model.CurrentQuantity * 100) / (Model.MinimumThreshold * 3)) : 100;
    var needsReorder = Model.CurrentQuantity <= Model.MinimumThreshold;
    var isOutOfStock = Model.CurrentQuantity == 0;
    var stockStatus = isOutOfStock ? "critical" : needsReorder ? "low" : Model.CurrentQuantity <= (Model.MinimumThreshold * 2) ? "medium" : "good";

    var badgeColor = isOutOfStock ? "bg-red-500" : needsReorder ? "bg-yellow-500" : "bg-green-500";
    var badgeText = isOutOfStock ? "Out of Stock" : needsReorder ? "Reorder Now" : "In Stock";
    var progressColor = isOutOfStock ? "bg-gradient-to-r from-red-500 to-red-600" :
                       needsReorder ? "bg-gradient-to-r from-yellow-500 to-orange-500" :
                       Model.CurrentQuantity <= (Model.MinimumThreshold * 2) ? "bg-gradient-to-r from-blue-500 to-indigo-500" :
                       "bg-gradient-to-r from-green-500 to-emerald-600";

    var icon = Model.Unit.ToLower() switch
    {
        "kg" or "grams" => "⚖️",
        "liters" or "ml" => "🥤",
        "pieces" or "pcs" => "📦",
        _ => "🧂"
    };
}

<div class="inventory-card bg-white rounded-3xl shadow-xl hover:shadow-2xl transition-all duration-500 transform hover:scale-105 overflow-hidden border-2 border-gray-100 relative group"
     data-stock-status="@stockStatus"
     data-name="@Model.Name.ToLower()"
     data-branch-id="@Model.BranchId">

    <!-- Top accent bar -->
    <div class="h-2 @(isOutOfStock ? "bg-gradient-to-r from-red-500 to-pink-500" : needsReorder ? "bg-gradient-to-r from-yellow-500 to-orange-500" : "bg-gradient-to-r from-purple-600 to-pink-600")"></div>

    <!-- Stock badge -->
    @if (isOutOfStock || needsReorder)
    {
        <div class="absolute top-6 right-6 z-10">
            <span class="@badgeColor text-white px-4 py-2 rounded-full text-xs font-bold uppercase tracking-wider shadow-lg animate-pulse-slow">
                @badgeText
            </span>
        </div>
    }

    <div class="p-6">
        <!-- Header -->
        <div class="flex items-start gap-4 mb-6">
            <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-purple-100 to-pink-100 flex items-center justify-center text-3xl group-hover:scale-110 transition-transform duration-300">
                @icon
            </div>
            <div class="flex-1">
                <h3 class="text-xl font-black text-gray-800 mb-1 group-hover:text-purple-600 transition-colors duration-300">
                    @Model.Name
                </h3>
                <p class="text-sm text-gray-500 flex items-center gap-1">
                    <span>🏢</span> @Model.Branch.Name
                </p>
            </div>
        </div>

        <!-- Stock details -->
        <div class="bg-gradient-to-br from-gray-50 to-gray-100 rounded-2xl p-4 mb-4 space-y-3">
            <div class="flex justify-between items-center">
                <span class="text-sm text-gray-600 font-medium">Current Stock</span>
                <span class="text-2xl font-black @(isOutOfStock ? "text-red-500" : needsReorder ? "text-yellow-600" : "text-purple-600")">
                    @Model.CurrentQuantity <span class="text-sm font-normal text-gray-500">@Model.Unit</span>
                </span>
            </div>

            <div class="flex justify-between items-center py-2 border-t border-gray-200">
                <span class="text-sm text-gray-600">Reorder Level</span>
                <span class="text-sm font-bold text-gray-800">@Model.MinimumThreshold @Model.Unit</span>
            </div>

            <div class="flex justify-between items-center py-2 border-t border-gray-200">
                <span class="text-sm text-gray-600">Unit Price</span>
                <span class="text-sm font-bold bg-gradient-to-r from-yellow-400 to-orange-400 text-gray-800 px-3 py-1 rounded-lg">
                    $@Model.CostPerUnit.ToString("F2")
                </span>
            </div>

            <div class="flex justify-between items-center py-2 border-t border-gray-200">
                <span class="text-sm text-gray-600 font-semibold">Total Value</span>
                <span class="text-lg font-black text-transparent bg-clip-text bg-gradient-to-r from-purple-600 to-pink-600">
                    $@((Model.CurrentQuantity * Model.CostPerUnit).ToString("F2"))
                </span>
            </div>
        </div>

        <!-- Progress bar -->
        <div class="mb-4">
            <div class="flex justify-between items-center mb-2">
                <span class="text-xs font-semibold text-gray-600">Stock Level</span>
                <span class="text-xs font-bold text-gray-800">@((int)stockPercentage)%</span>
            </div>
            <div class="h-3 bg-gray-200 rounded-full overflow-hidden">
                <div class="@progressColor h-full rounded-full transition-all duration-1000 ease-out relative overflow-hidden"
                     style="width: @stockPercentage%">
                    <div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/30 to-transparent animate-shimmer"></div>
                </div>
            </div>
        </div>

        <!-- Last updated -->
        <div class="text-center text-xs text-gray-400 mb-4 py-3 border-t border-gray-100">
            🕒 Updated: @Model.LastUpdated.ToString("MMM dd, HH:mm")
        </div>

        <!-- Action buttons -->
        <div class="grid grid-cols-3 gap-2">
            <button onclick="openRestockModal(@Model.Id, '@Model.Name', '@Model.Unit')"
                    class="px-4 py-3 bg-gradient-to-r from-green-500 to-emerald-600 hover:from-green-600 hover:to-emerald-700 text-white rounded-xl font-bold text-sm transition-all duration-300 transform hover:scale-105 shadow-lg hover:shadow-xl flex items-center justify-center gap-1">
                <span>📦</span>
            </button>

            <a href="@Url.Action("Edit", new { id = Model.Id })"
               class="px-4 py-3 bg-gradient-to-r from-blue-500 to-indigo-600 hover:from-blue-600 hover:to-indigo-700 text-white rounded-xl font-bold text-sm transition-all duration-300 transform hover:scale-105 shadow-lg hover:shadow-xl flex items-center justify-center gap-1">
                <span>✏️</span>
            </a>

            <a href="@Url.Action("Delete", new { id = Model.Id })"
                    class="px-4 py-3 bg-gradient-to-r from-red-500 to-pink-600 hover:from-red-600 hover:to-pink-700 text-white rounded-xl font-bold text-sm transition-all duration-300 transform hover:scale-105 shadow-lg hover:shadow-xl flex items-center justify-center gap-1">
                <span>🗑️</span>
           </a>
        </div>
    </div>
</div>