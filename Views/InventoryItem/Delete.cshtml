@model Cafe.Models.InventoryItem
@{
    ViewData["Title"] = "Delete Inventory Item";
}

<!-- Page Header -->
<div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:1rem;margin-bottom:2rem;">
    <div>
        <h1 class="page-title" style="margin:0;">Delete Inventory Item</h1>
        <p class="body-text" style="margin-top:0.25rem;">Review the details below before removing this item.</p>
    </div>
    <a href="@Url.Action("Index")" class="btn btn-secondary btn-sm">
        <i class="fas fa-arrow-left"></i> Back to Inventory
    </a>
</div>

<!-- Danger Banner -->
<div class="card border-red-200 mb-6 overflow-hidden">
    <div class="bg-gradient-to-br from-red-600 to-red-800 text-white p-6 rounded-t-[var(--radius-card)]">
        <div class="flex items-center gap-3">
            <i class="fas fa-exclamation-triangle text-2xl"></i>
            <div>
                <h2 class="font-bold text-lg" style="margin:0;">Confirm Deletion</h2>
                <p class="text-sm opacity-90 mt-0.5">This will permanently remove the inventory item and cannot be
                    undone.</p>
                </div>
            </div>
        </div>
        <div class="card-body">
            <div class="grid grid-cols-[repeat(auto-fit,minmax(200px,1fr))] gap-4">
                <div>
                    <span class="caption uppercase tracking-wider">Item Name</span>
                    <p class="font-semibold text-[var(--text-primary)] mt-0.5">@Model.Name</p>
                </div>
                <div>
                    <span class="caption uppercase tracking-wider">Branch</span>
                    <p class="font-medium text-[var(--text-primary)] mt-0.5">@(Model.Branch?.Name ?? "N/A")</p>
                </div>
                <div>
                    <span class="caption uppercase tracking-wider">Quantity</span>
                    <p class="font-semibold text-[var(--text-primary)] mt-0.5">@Model.Quantity.ToString("0.##") @Model.Unit
                    </p>
                </div>
                <div>
                    <span class="caption uppercase tracking-wider">Total Value</span>
                    <p class="font-semibold text-red-600 mt-0.5">@((Model.Quantity * Model.UnitPrice).ToString("C2"))</p>
                </div>
            </div>

            <div class="divider"></div>

            <form asp-action="Delete" method="post" class="flex justify-end gap-3">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <a href="@Url.Action("Index")" class="btn btn-secondary">Cancel</a>
                <button type="submit" class="btn btn-danger">
                    <i class="fas fa-trash"></i> Delete Permanently
                </button>
            </form>
        </div>
    </div>