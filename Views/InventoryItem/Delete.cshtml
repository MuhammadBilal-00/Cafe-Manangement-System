@model Cafe.Models.InventoryItem
@{
    ViewData["Title"] = "Delete Inventory Item";
}

<!-- Page Header -->
<div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:1rem;margin-bottom:2rem;">
    <div>
        <h1 class="page-title" style="margin:0;">Delete Inventory Item</h1>
        <p class="body-text" style="margin-top:0.25rem;">Review the details below before removing this item.</p>
    </div>
    <a href="@Url.Action("Index")" class="btn btn-secondary btn-sm">
        <i class="fas fa-arrow-left"></i> Back to Inventory
    </a>
</div>

<!-- Danger Banner -->
<div class="card" style="border-color:#fecaca;margin-bottom:1.5rem;">
    <div style="background:linear-gradient(135deg,#dc2626,#991b1b);color:#fff;padding:1.5rem;border-radius:var(--radius-card) var(--radius-card) 0 0;">
        <div style="display:flex;align-items:center;gap:0.75rem;">
            <i class="fas fa-exclamation-triangle" style="font-size:1.5rem;"></i>
            <div>
                <h2 style="font-weight:700;font-size:1.1rem;margin:0;">Confirm Deletion</h2>
                <p style="font-size:0.8rem;opacity:0.9;margin-top:0.15rem;">This will permanently remove the inventory item and cannot be undone.</p>
            </div>
        </div>
    </div>
    <div class="card-body">
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:1rem;">
            <div>
                <span class="caption" style="text-transform:uppercase;letter-spacing:0.08em;">Item Name</span>
                <p style="font-weight:600;color:var(--text-primary);margin-top:0.15rem;">@Model.Name</p>
            </div>
            <div>
                <span class="caption" style="text-transform:uppercase;letter-spacing:0.08em;">Branch</span>
                <p style="font-weight:500;color:var(--text-primary);margin-top:0.15rem;">@(Model.Branch?.Name ?? "N/A")</p>
            </div>
            <div>
                <span class="caption" style="text-transform:uppercase;letter-spacing:0.08em;">Quantity</span>
                <p style="font-weight:600;color:var(--text-primary);margin-top:0.15rem;">@Model.Quantity.ToString("0.##") @Model.Unit</p>
            </div>
            <div>
                <span class="caption" style="text-transform:uppercase;letter-spacing:0.08em;">Total Value</span>
                <p style="font-weight:600;color:#dc2626;margin-top:0.15rem;">@((Model.Quantity * Model.UnitPrice).ToString("C2"))</p>
            </div>
        </div>

        <div class="divider"></div>

        <form asp-action="Delete" method="post" style="display:flex;justify-content:flex-end;gap:0.75rem;">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />
            <a href="@Url.Action("Index")" class="btn btn-secondary">Cancel</a>
            <button type="submit" class="btn btn-danger">
                <i class="fas fa-trash"></i> Delete Permanently
            </button>
        </form>
    </div>
</div>
