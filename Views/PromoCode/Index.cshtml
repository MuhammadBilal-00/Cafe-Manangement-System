@model IEnumerable<Cafe.Models.PromoCode>
@{
    ViewData["Title"] = "Promo Codes";
    var branches = ViewBag.Branches as List<Cafe.Models.Branch> ?? new List<Cafe.Models.Branch>();
    var selectedBranchId = ViewBag.SelectedBranchId as int?;
    var isOwner = Context.Session.GetString("UserRole") == "Owner";
    var now = DateTime.Now;

    var total = Model.Count();
    var activeNow = Model.Count(p => p.IsActive && now >= p.ValidFrom && now <= p.ValidUntil
        && (p.UsageLimit == null || p.TimesUsed < p.UsageLimit));
    var scheduled = Model.Count(p => p.IsActive && now < p.ValidFrom);
    var redemptions = Model.Sum(p => p.TimesUsed);
}

@functions {
    (string Label, string Css) PromoStatus(Cafe.Models.PromoCode p)
    {
        var now = DateTime.Now;
        if (!p.IsActive) return ("Inactive", "badge-neutral");
        if (now < p.ValidFrom) return ("Scheduled", "badge-info");
        if (now > p.ValidUntil) return ("Expired", "badge-danger");
        if (p.UsageLimit.HasValue && p.TimesUsed >= p.UsageLimit.Value) return ("Used up", "badge-warning");
        return ("Active", "badge-success");
    }
}

<!-- Page Header -->
<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:2rem; flex-wrap:wrap; gap:1rem;">
    <div>
        <h1 class="page-title" style="margin:0;">Promo Codes</h1>
        <p class="body-text" style="margin-top:0.25rem;">Create and manage discount codes applied at checkout.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary"><i class="fas fa-plus" style="margin-right:0.5rem;"></i> New Promo Code</a>
</div>

<!-- KPI Cards -->
<div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(180px,1fr)); gap:1rem; margin-bottom:2rem;">
    <div class="kpi-card">
        <div class="kpi-icon" style="background:var(--accent-light); color:var(--accent);"><i class="fas fa-tags"></i></div>
        <div class="kpi-label">Total Codes</div>
        <div class="kpi-value">@total</div>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon" style="background:var(--success-light); color:var(--success);"><i class="fas fa-circle-check"></i></div>
        <div class="kpi-label">Active Now</div>
        <div class="kpi-value" style="color:var(--success);">@activeNow</div>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon" style="background:rgba(59,130,246,0.1); color:var(--info);"><i class="fas fa-clock"></i></div>
        <div class="kpi-label">Scheduled</div>
        <div class="kpi-value" style="color:var(--info);">@scheduled</div>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon" style="background:var(--info-light); color:var(--info);"><i class="fas fa-receipt"></i></div>
        <div class="kpi-label">Total Redemptions</div>
        <div class="kpi-value">@redemptions</div>
    </div>
</div>

<!-- Filters -->
@if (branches.Count > 1)
{
    <div class="card mb-6">
        <div class="card-body">
            <form method="get" style="display:flex; gap:1rem; align-items:flex-end; flex-wrap:wrap;">
                <div class="form-group" style="margin-bottom:0;">
                    <label class="form-label">Branch</label>
                    <select name="branchId" class="form-select" onchange="this.form.submit()">
                        <option value="">All Branches</option>
                        @foreach (var b in branches)
                        {
                            <option value="@b.Id" selected="@(selectedBranchId == b.Id)">@b.Name</option>
                        }
                    </select>
                </div>
                <button type="submit" class="btn btn-primary"><i class="fas fa-filter" style="margin-right:0.5rem;"></i> Filter</button>
            </form>
        </div>
    </div>
}

<!-- Table -->
<div class="card">
    <div class="card-body card-body-flush">
        <div style="overflow-x:auto;">
            <table class="premium-table">
                <thead>
                    <tr>
                        <th>Code</th>
                        <th>Discount</th>
                        <th>Min. Order</th>
                        <th>Validity</th>
                        <th style="text-align:center;">Usage</th>
                        <th>Scope</th>
                        <th style="text-align:center;">Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8" style="text-align:center; padding:3rem 1rem;">
                                <i class="fas fa-tags" style="font-size:2.5rem; color:var(--border-light); margin-bottom:1rem; display:block;"></i>
                                <p style="font-weight:600; margin:0 0 0.25rem; color:var(--text-secondary);">No promo codes yet</p>
                                <p class="caption" style="margin:0 0 1rem;">Create your first discount code to use at checkout.</p>
                                <a asp-action="Create" class="btn btn-primary btn-sm"><i class="fas fa-plus" style="margin-right:0.4rem;"></i> New Promo Code</a>
                            </td>
                        </tr>
                    }
                    @foreach (var p in Model)
                    {
                        var status = PromoStatus(p);
                        <tr>
                            <td>
                                <span style="font-family:ui-monospace,monospace; font-weight:700; letter-spacing:0.5px; background:var(--accent-light); color:#92400e; padding:3px 9px; border-radius:7px; font-size:0.85rem;">@p.Code</span>
                                @if (!string.IsNullOrEmpty(p.Description))
                                {
                                    <div class="caption" style="max-width:220px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; margin-top:0.3rem;" title="@p.Description">@p.Description</div>
                                }
                            </td>
                            <td>
                                @if (p.DiscountType == "Percentage")
                                {
                                    <span style="font-weight:700; color:var(--text-primary);">@p.DiscountValue.ToString("0.##")%</span>
                                    @if (p.MaxDiscountAmount.HasValue)
                                    {
                                        <div class="caption">max Rs. @p.MaxDiscountAmount.Value.ToString("N0")</div>
                                    }
                                }
                                else
                                {
                                    <span style="font-weight:700; color:var(--text-primary);">Rs. @p.DiscountValue.ToString("N0")</span>
                                    <div class="caption">flat</div>
                                }
                            </td>
                            <td>@(p.MinimumOrderAmount > 0 ? $"Rs. {p.MinimumOrderAmount:N0}" : "—")</td>
                            <td>
                                <div style="font-size:0.82rem;"><i class="far fa-calendar" style="font-size:0.7rem; margin-right:0.3rem; color:var(--text-tertiary);"></i>@p.ValidFrom.ToString("dd MMM yyyy")</div>
                                <div class="caption">to @p.ValidUntil.ToString("dd MMM yyyy")</div>
                            </td>
                            <td style="text-align:center;">
                                @if (p.UsageLimit.HasValue)
                                {
                                    var pct = p.UsageLimit.Value == 0 ? 0 : Math.Min(100, (int)(100.0 * p.TimesUsed / p.UsageLimit.Value));
                                    <div style="font-weight:600; font-size:0.82rem;">@p.TimesUsed / @p.UsageLimit</div>
                                    <div style="height:5px; background:var(--border-light); border-radius:3px; overflow:hidden; margin-top:4px; width:70px; margin-left:auto; margin-right:auto;">
                                        <div style="height:100%; width:@(pct)%; background:@(pct >= 100 ? "var(--danger)" : "var(--accent)");"></div>
                                    </div>
                                }
                                else
                                {
                                    <span style="font-weight:600;">@p.TimesUsed</span>
                                    <div class="caption">unlimited</div>
                                }
                            </td>
                            <td>
                                @if (p.BranchId == null)
                                {
                                    <span class="badge badge-accent">All branches</span>
                                }
                                else
                                {
                                    <span class="caption">@p.Branch?.Name</span>
                                }
                            </td>
                            <td style="text-align:center;"><span class="badge @status.Css">@status.Label</span></td>
                            <td>
                                <div style="display:flex; gap:0.4rem;">
                                    <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-ghost btn-sm" title="Edit"><i class="fas fa-edit"></i></a>
                                    <form asp-action="ToggleActive" asp-route-id="@p.Id" method="post" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-ghost btn-sm" title="@(p.IsActive ? "Deactivate" : "Activate")">
                                            <i class="fas @(p.IsActive ? "fa-pause" : "fa-play")"></i>
                                        </button>
                                    </form>
                                    @if (isOwner)
                                    {
                                        <a asp-action="Delete" asp-route-id="@p.Id" class="btn btn-ghost btn-sm" title="Delete" style="color:var(--danger);"><i class="fas fa-trash"></i></a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
