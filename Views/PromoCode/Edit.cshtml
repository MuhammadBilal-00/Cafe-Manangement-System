@model Cafe.Models.PromoCode
@{
    ViewData["Title"] = "Edit Promo Code";
    var branches = ViewBag.Branches as List<Cafe.Models.Branch> ?? new List<Cafe.Models.Branch>();
    var isOwner = Context.Session.GetString("UserRole") == "Owner";
}

<div class="max-w-[760px] mx-auto">
    <div style="display:flex; align-items:center; margin-bottom:1.5rem; gap:1rem;">
        <a asp-action="Index" class="btn btn-ghost btn-sm"><i class="fas fa-arrow-left"></i></a>
        <div>
            <h1 class="page-title" style="margin:0;">Edit Promo Code</h1>
            <p class="body-text" style="margin-top:0.2rem;">Update discount rules. Past invoices keep their original snapshot.</p>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="CreatedAt" />
                <input type="hidden" asp-for="TimesUsed" />

                <div asp-validation-summary="ModelOnly" class="caption" style="color:#dc2626;"></div>

                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Code *</label>
                        <input asp-for="Code" id="codeInput" class="form-control" required
                               style="font-family:ui-monospace,monospace; text-transform:uppercase; letter-spacing:0.5px;" />
                        <span asp-validation-for="Code" class="caption" style="color:#dc2626;"></span>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Description</label>
                        <input asp-for="Description" class="form-control" />
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Discount Type *</label>
                        <select asp-for="DiscountType" id="discountType" class="form-select" onchange="updatePreview()">
                            <option value="Percentage">Percentage (%)</option>
                            <option value="Flat">Flat amount (Rs.)</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label" id="valueLabel">Discount Value *</label>
                        <input asp-for="DiscountValue" id="discountValue" type="number" step="0.01" min="0" class="form-control" required oninput="updatePreview()" />
                        <span asp-validation-for="DiscountValue" class="caption" style="color:#dc2626;"></span>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group" id="maxDiscountGroup">
                        <label class="form-label">Max Discount Cap (Rs.)</label>
                        <input asp-for="MaxDiscountAmount" type="number" step="0.01" min="0" class="form-control" placeholder="Optional cap for % codes" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Minimum Order (Rs.)</label>
                        <input asp-for="MinimumOrderAmount" type="number" step="0.01" min="0" class="form-control" />
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Valid From *</label>
                        <input asp-for="ValidFrom" type="date" class="form-control" required />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Valid Until *</label>
                        <input asp-for="ValidUntil" type="date" class="form-control" required />
                        <span asp-validation-for="ValidUntil" class="caption" style="color:#dc2626;"></span>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Usage Limit <span class="caption">(used: @Model.TimesUsed)</span></label>
                        <input asp-for="UsageLimit" type="number" min="1" class="form-control" placeholder="Blank = unlimited" />
                    </div>
                    @if (isOwner)
                    {
                        <div class="form-group">
                            <label class="form-label">Branch Scope</label>
                            <select asp-for="BranchId" class="form-select">
                                <option value="">All branches</option>
                                @foreach (var b in branches)
                                {
                                    <option value="@b.Id">@b.Name</option>
                                }
                            </select>
                        </div>
                    }
                    else
                    {
                        <div class="form-group">
                            <label class="form-label">Scope</label>
                            <input class="form-control" value="@(Model.BranchId == null ? "All branches" : Model.Branch?.Name ?? "Your branch")" disabled />
                        </div>
                    }
                </div>

                <label class="form-label" style="display:flex; align-items:center; gap:0.5rem; cursor:pointer;">
                    <input asp-for="IsActive" type="checkbox" style="width:auto;" />
                    Active
                </label>

                <div id="promoPreview" style="margin-top:1.25rem; padding:0.9rem 1.1rem; background:var(--accent-light); border:1px dashed rgba(212,175,55,0.5); border-radius:12px; display:flex; align-items:center; gap:0.7rem;">
                    <i class="fas fa-tag" style="color:var(--accent);"></i>
                    <span style="font-size:0.88rem; color:var(--text-secondary);" id="previewText"></span>
                </div>

                <div class="divider"></div>
                <div style="display:flex; justify-content:flex-end; gap:0.75rem;">
                    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary"><i class="fas fa-save" style="margin-right:0.5rem;"></i> Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function updatePreview() {
            const type = document.getElementById('discountType').value;
            const val = parseFloat(document.getElementById('discountValue').value) || 0;
            document.getElementById('maxDiscountGroup').style.display = type === 'Percentage' ? 'block' : 'none';
            document.getElementById('valueLabel').textContent = type === 'Percentage' ? 'Percentage (%) *' : 'Flat Amount (Rs.) *';
            const text = document.getElementById('previewText');
            if (!val) { text.textContent = 'Enter values to preview the discount.'; return; }
            text.innerHTML = type === 'Percentage'
                ? `Customers get <b>${val}% off</b> their order total.`
                : `Customers get <b>Rs. ${val.toLocaleString()} off</b> their order total.`;
        }
        document.getElementById('codeInput')?.addEventListener('input', e => e.target.value = e.target.value.toUpperCase());
        updatePreview();
    </script>
}
