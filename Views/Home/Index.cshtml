@{
    ViewData["Title"] = "Dashboard";
    var userRole = Context.Session.GetString("UserRole");
    var userName = Context.Session.GetString("UserName");
    var isOwner = userRole == "Owner";
    var isManager = userRole == "BranchManager";
    var isOwnerOrManager = isOwner || isManager;
}

<!-- Welcome Bar -->
<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-7">
    <div>
        <h1 class="page-title">Welcome back, @(userName ?? "User") 👋</h1>
        <p class="body-text mt-1">Here's what's happening across your operations today.</p>
    </div>
    @if (isOwnerOrManager)
    {
        <div class="flex items-center gap-3">
            <a asp-controller="Reports" asp-action="Index" class="btn btn-primary">
                <i class="fas fa-chart-line"></i> View Reports
            </a>
        </div>
    }
</div>

<!-- KPI Cards Row -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 mb-7">
    <!-- Branches -->
    <div class="kpi-card">
        <div class="kpi-icon" style="background: rgba(212,175,55,0.10); color: #d4af37;">
            <i class="fas fa-store"></i>
        </div>
        <div class="kpi-label">Active Branches</div>
        <div class="kpi-value">@ViewBag.DashboardData.TotalBranches</div>
        <div class="kpi-change neutral">
            <i class="fas fa-building"></i> Operating
        </div>
    </div>

    <!-- Staff -->
    <div class="kpi-card">
        <div class="kpi-icon" style="background: rgba(99,102,241,0.10); color: #6366f1;">
            <i class="fas fa-users"></i>
        </div>
        <div class="kpi-label">Total Staff</div>
        <div class="kpi-value">@ViewBag.TotalStaff</div>
        <div class="kpi-change up">
            <i class="fas fa-user-check"></i> @ViewBag.ActiveStaff active
        </div>
    </div>

    <!-- Orders Today -->
    <div class="kpi-card">
        <div class="kpi-icon" style="background: rgba(34,197,94,0.10); color: #22c55e;">
            <i class="fas fa-receipt"></i>
        </div>
        <div class="kpi-label">Today's Orders</div>
        <div class="kpi-value">@ViewBag.TodayOrders</div>
        <div class="kpi-change neutral">
            <i class="fas fa-clock"></i> @ViewBag.PendingOrders pending
        </div>
    </div>

    <!-- Total Orders -->
    <div class="kpi-card">
        <div class="kpi-icon" style="background: rgba(168,85,247,0.10); color: #a855f7;">
            <i class="fas fa-chart-bar"></i>
        </div>
        <div class="kpi-label">Total Orders</div>
        <div class="kpi-value">@ViewBag.TotalOrders</div>
        <div class="kpi-change up">
            <i class="fas fa-check-circle"></i> @ViewBag.CompletedOrders completed
        </div>
    </div>
</div>

<!-- Second Row: More KPIs for Owner/Manager -->
@if (isOwnerOrManager)
{
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 mb-7">
        <div class="kpi-card">
            <div class="kpi-icon" style="background: rgba(236,72,153,0.10); color: #ec4899;">
                <i class="fas fa-user-friends"></i>
            </div>
            <div class="kpi-label">Customers</div>
            <div class="kpi-value">@ViewBag.TotalCustomers</div>
            <div class="kpi-change neutral">
                <i class="fas fa-heart"></i> Registered
            </div>
        </div>

        <div class="kpi-card">
            <div class="kpi-icon" style="background: rgba(14,165,233,0.10); color: #0ea5e9;">
                <i class="fas fa-utensils"></i>
            </div>
            <div class="kpi-label">Menu Items</div>
            <div class="kpi-value">@ViewBag.TotalMenuItems</div>
            <div class="kpi-change up">
                <i class="fas fa-check"></i> Available
            </div>
        </div>

        <div class="kpi-card">
            <div class="kpi-icon" style="background: rgba(34,197,94,0.10); color: #22c55e;">
                <i class="fas fa-dollar-sign"></i>
            </div>
            <div class="kpi-label">Avg. Order Value</div>
            <div class="kpi-value">$@ViewBag.AverageOrderValue</div>
            <div class="kpi-change neutral">
                <i class="fas fa-arrow-trend-up"></i> Per order
            </div>
        </div>

        <div class="kpi-card">
            <div class="kpi-icon" style="background: rgba(245,158,11,0.10); color: #f59e0b;">
                <i class="fas fa-triangle-exclamation"></i>
            </div>
            <div class="kpi-label">Low Stock Items</div>
            <div class="kpi-value">@(ViewBag.LowStockItems != null ? ((IEnumerable<dynamic>)ViewBag.LowStockItems).Count() : 0)</div>
            <div class="kpi-change @(ViewBag.LowStockItems != null && ((IEnumerable<dynamic>)ViewBag.LowStockItems).Count() > 0 ? "down" : "up")">
                <i class="fas fa-boxes-stacked"></i> @(ViewBag.LowStockItems != null && ((IEnumerable<dynamic>)ViewBag.LowStockItems).Count() > 0 ? "Needs attention" : "All healthy")
            </div>
        </div>
    </div>
}

<!-- Charts Row -->
<div class="grid grid-cols-1 lg:grid-cols-3 gap-5 mb-7">
    <!-- Revenue Chart -->
    <div class="lg:col-span-2 card">
        <div class="card-header">
            <h3 class="section-title">Revenue Overview</h3>
            <span class="badge badge-neutral">Last 12 Months</span>
        </div>
        <div class="card-body">
            <div class="chart-container" style="height:300px;">
                <canvas id="revenueChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Quick Stats -->
    <div class="card">
        <div class="card-header">
            <h3 class="section-title">Quick Stats</h3>
        </div>
        <div class="card-body space-y-4">
            <div class="flex items-center justify-between py-2">
                <div class="flex items-center gap-3">
                    <div class="w-9 h-9 rounded-lg flex items-center justify-center text-sm" style="background:rgba(99,102,241,0.08); color:#6366f1;">
                        <i class="fas fa-utensils"></i>
                    </div>
                    <span class="text-sm text-[var(--text-secondary)]">Active Menu</span>
                </div>
                <span class="font-semibold text-sm">@ViewBag.TotalMenuItems</span>
            </div>
            <hr class="divider" style="margin:0;">
            <div class="flex items-center justify-between py-2">
                <div class="flex items-center gap-3">
                    <div class="w-9 h-9 rounded-lg flex items-center justify-center text-sm" style="background:rgba(245,158,11,0.08); color:#f59e0b;">
                        <i class="fas fa-hourglass-half"></i>
                    </div>
                    <span class="text-sm text-[var(--text-secondary)]">Pending</span>
                </div>
                <span class="font-semibold text-sm text-amber-600">@ViewBag.PendingOrders</span>
            </div>
            <hr class="divider" style="margin:0;">
            <div class="flex items-center justify-between py-2">
                <div class="flex items-center gap-3">
                    <div class="w-9 h-9 rounded-lg flex items-center justify-center text-sm" style="background:rgba(34,197,94,0.08); color:#22c55e;">
                        <i class="fas fa-circle-check"></i>
                    </div>
                    <span class="text-sm text-[var(--text-secondary)]">Completed</span>
                </div>
                <span class="font-semibold text-sm text-green-600">@ViewBag.CompletedOrders</span>
            </div>
            <hr class="divider" style="margin:0;">
            <div class="flex items-center justify-between py-2">
                <div class="flex items-center gap-3">
                    <div class="w-9 h-9 rounded-lg flex items-center justify-center text-sm" style="background:rgba(212,175,55,0.08); color:#d4af37;">
                        <i class="fas fa-coins"></i>
                    </div>
                    <span class="text-sm text-[var(--text-secondary)]">Avg. Value</span>
                </div>
                <span class="font-semibold text-sm">$@ViewBag.AverageOrderValue</span>
            </div>

            @if (isOwner)
            {
                <hr class="divider" style="margin:4px 0 8px;">
                <div class="caption mb-3">Quick Actions</div>
                <div class="flex flex-col gap-2">
                    <a asp-controller="Staff" asp-action="Create" class="btn btn-secondary btn-sm w-full">
                        <i class="fas fa-user-plus"></i> Add Staff
                    </a>
                    <a asp-controller="Order" asp-action="Index" class="btn btn-primary btn-sm w-full">
                        <i class="fas fa-plus"></i> New Order
                    </a>
                </div>
            }
        </div>
    </div>
</div>

<!-- To-Do Widget -->
<div class="card mb-5">
    <div class="card-header">
        <h3 class="section-title" style="display:flex; align-items:center; gap:0.5rem;">
            <i class="fas fa-tasks" style="color:var(--accent);"></i> My Tasks
        </h3>
        <span id="todoCount" class="badge badge-accent" style="font-size:0.7rem;">0</span>
    </div>
    <div class="card-body">
        <!-- Add Task -->
        <div style="display:flex; gap:0.5rem; margin-bottom:1rem;">
            <input type="text" id="todoInput" class="form-control" placeholder="Add a new task..." style="flex:1;" onkeydown="if(event.key==='Enter')addTodo()" />
            <select id="todoPriority" class="form-select" style="width:110px;">
                <option value="Low">Low</option>
                <option value="Medium" selected>Medium</option>
                <option value="High">High</option>
            </select>
            <button onclick="addTodo()" class="btn btn-primary btn-sm"><i class="fas fa-plus"></i></button>
        </div>
        <!-- Task List -->
        <div id="todoList" style="max-height:280px; overflow-y:auto;"></div>
        <div id="todoEmpty" class="empty-state" style="display:none; padding:1.5rem;">
            <i class="fas fa-clipboard-check" style="font-size:1.5rem; color:var(--text-tertiary);"></i>
            <p class="caption" style="margin-top:0.5rem;">No tasks yet. Add one above!</p>
        </div>
    </div>
</div>

<!-- Notification Activity Feed -->
<div class="card mb-5">
    <div class="card-header">
        <h3 class="section-title" style="display:flex; align-items:center; gap:0.5rem;">
            <i class="fas fa-bell" style="color:#d4af37;"></i> Recent Activity
        </h3>
        <div style="display:flex; align-items:center; gap:0.75rem;">
            @{
                var unreadCount = (int)(ViewBag.NotifUnreadCount ?? 0);
            }
            @if (unreadCount > 0)
            {
                <span class="badge badge-danger" style="font-size:0.65rem; padding:2px 8px;">@unreadCount unread</span>
            }
            <a asp-controller="Notification" asp-action="Index" class="text-xs font-medium" style="color:var(--accent);">View all</a>
        </div>
    </div>
    <div class="card-body" style="padding:0;">
        @{
            var recentNotifs = ViewBag.RecentNotifications as IEnumerable<Cafe.Services.NotificationDto>;
        }
        @if (recentNotifs != null && recentNotifs.Any())
        {
            <div style="max-height:360px; overflow-y:auto;">
                @foreach (var notif in recentNotifs)
                {
                    var typeColor = notif.Type switch
                    {
                        "Success" => "#22c55e",
                        "Warning" => "#f59e0b",
                        "Error" => "#ef4444",
                        "Order" => "#6366f1",
                        "Staff" => "#8b5cf6",
                        "Inventory" => "#0ea5e9",
                        "Financial" => "#10b981",
                        _ => "#d4af37"
                    };
                    var typeBg = notif.Type switch
                    {
                        "Success" => "rgba(34,197,94,0.08)",
                        "Warning" => "rgba(245,158,11,0.08)",
                        "Error" => "rgba(239,68,68,0.08)",
                        "Order" => "rgba(99,102,241,0.08)",
                        "Staff" => "rgba(139,92,246,0.08)",
                        "Inventory" => "rgba(14,165,233,0.08)",
                        "Financial" => "rgba(16,185,129,0.08)",
                        _ => "rgba(212,175,55,0.08)"
                    };
                    var icon = !string.IsNullOrEmpty(notif.Icon) ? notif.Icon : notif.Type switch
                    {
                        "Success" => "fas fa-check-circle",
                        "Warning" => "fas fa-exclamation-triangle",
                        "Error" => "fas fa-times-circle",
                        "Order" => "fas fa-receipt",
                        "Staff" => "fas fa-user",
                        "Inventory" => "fas fa-boxes-stacked",
                        "Financial" => "fas fa-dollar-sign",
                        _ => "fas fa-bell"
                    };
                    var isUnread = !notif.IsRead;
                    <a href="@(notif.RedirectUrl ?? "/Notification")"
                       style="display:flex; align-items:flex-start; gap:0.75rem; padding:0.85rem 1.25rem; border-bottom:1px solid var(--border-light); text-decoration:none; transition:background 0.15s; position:relative; @(isUnread ? "background:rgba(212,175,55,0.03);" : "")"
                       onmouseover="this.style.background='var(--bg-secondary)'" onmouseout="this.style.background='@(isUnread ? "rgba(212,175,55,0.03)" : "transparent")'">
                        @if (isUnread)
                        {
                            <span style="position:absolute; left:6px; top:50%; transform:translateY(-50%); width:5px; height:5px; border-radius:50%; background:@typeColor;"></span>
                        }
                        <div style="width:34px; height:34px; border-radius:10px; background:@typeBg; display:flex; align-items:center; justify-content:center; flex-shrink:0; color:@typeColor; font-size:0.8rem; border:1px solid rgba(0,0,0,0.04);">
                            <i class="@icon"></i>
                        </div>
                        <div style="flex:1; min-width:0;">
                            <div style="display:flex; align-items:center; gap:0.5rem; margin-bottom:2px;">
                                <span style="font-size:0.8rem; font-weight:600; color:var(--text-primary); @(isUnread ? "font-weight:700;" : "")">@notif.Title</span>
                                <span style="font-size:0.6rem; padding:1px 6px; border-radius:4px; background:@typeBg; color:@typeColor; font-weight:600; text-transform:uppercase; letter-spacing:0.3px;">@notif.Type</span>
                            </div>
                            <p style="font-size:0.75rem; color:var(--text-secondary); margin:0; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">@notif.Message</p>
                            <span style="font-size:0.65rem; color:var(--text-tertiary); margin-top:3px; display:block;">@notif.TimeAgo</span>
                        </div>
                    </a>
                }
            </div>
        }
        else
        {
            <div class="empty-state" style="padding:2rem;">
                <div style="width:48px; height:48px; border-radius:14px; background:rgba(212,175,55,0.08); display:flex; align-items:center; justify-content:center; margin:0 auto 0.75rem;">
                    <i class="fas fa-bell-slash" style="font-size:1.2rem; color:var(--text-tertiary);"></i>
                </div>
                <p class="caption">No recent activity</p>
                <p style="font-size:0.7rem; color:var(--text-tertiary); margin-top:0.25rem;">Notifications will appear here as events occur.</p>
            </div>
        }
    </div>
</div>

<!-- Bottom Row: Low Stock + Recent Orders -->
<div class="grid grid-cols-1 lg:grid-cols-3 gap-5">
    <!-- Low Stock Alerts -->
    <div class="card">
        <div class="card-header">
            <h3 class="section-title flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-amber-400"></span>
                Low Stock
            </h3>
            <a asp-controller="InventoryItem" asp-action="Index" class="text-xs font-medium" style="color:var(--accent);">View all</a>
        </div>
        <div class="card-body">
            @if (ViewBag.LowStockItems != null && ((IEnumerable<dynamic>)ViewBag.LowStockItems).Any())
            {
                <div class="space-y-3">
                    @foreach (var item in ViewBag.LowStockItems)
                    {
                        <div class="flex items-center justify-between p-3 rounded-lg" style="border:1px solid var(--border-light);">
                            <div>
                                <p class="text-sm font-medium" style="color:var(--text-primary);">@item.Name</p>
                                <p class="text-xs" style="color:var(--text-tertiary);">@item.Branch?.Name</p>
                            </div>
                            <div class="text-right">
                                <span class="text-sm font-bold @(item.Quantity == 0 ? "text-red-500" : "text-amber-500")">
                                    @item.Quantity @item.Unit
                                </span>
                                <p class="text-xs" style="color:var(--text-tertiary);">Min: @item.ReorderLevel</p>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="empty-state" style="padding:32px 16px;">
                    <div class="empty-state-icon" style="background:rgba(34,197,94,0.08); color:#22c55e;">
                        <i class="fas fa-check-circle"></i>
                    </div>
                    <p class="empty-state-text">All stock levels are healthy</p>
                </div>
            }
        </div>
    </div>

    <!-- Recent Orders -->
    <div class="lg:col-span-2 card">
        <div class="card-header">
            <h3 class="section-title">Recent Orders</h3>
            <a asp-controller="Order" asp-action="Index" class="text-xs font-medium" style="color:var(--accent);">View all</a>
        </div>
        <div class="card-body" style="padding-top:8px;">
            @if (ViewBag.RecentOrders != null && ((IEnumerable<dynamic>)ViewBag.RecentOrders).Any())
            {
                <table class="premium-table">
                    <thead>
                        <tr>
                            <th>Order #</th>
                            <th>Customer</th>
                            <th>Amount</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in ViewBag.RecentOrders)
                        {
                            <tr>
                                <td class="font-medium">#@order.OrderNumber</td>
                                <td>@order.CustomerName</td>
                                <td class="font-medium">$@order.TotalAmount</td>
                                <td>
                                    @{
                                        var badgeCls = (string)order.Status switch
                                        {
                                            "Completed" => "badge-success",
                                            "Pending" => "badge-warning",
                                            "Preparing" => "badge-info",
                                            "Ready" => "badge-accent",
                                            _ => "badge-danger"
                                        };
                                    }
                                    <span class="badge @badgeCls">@order.Status</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="empty-state">
                    <div class="empty-state-icon"><i class="fas fa-receipt"></i></div>
                    <p class="empty-state-title">No recent orders</p>
                    <p class="empty-state-text">Orders will appear here once placed.</p>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // ── To-Do Widget ──
        const todoList = document.getElementById('todoList');
        const todoEmpty = document.getElementById('todoEmpty');
        const todoCount = document.getElementById('todoCount');
        const todoInput = document.getElementById('todoInput');

        function getToken() {
            return document.querySelector('[name="__RequestVerificationToken"]')?.value ||
                   document.querySelector('meta[name="RequestVerificationToken"]')?.content || '';
        }

        async function loadTodos() {
            try {
                const res = await fetch('/Todo/Index');
                if (!res.ok) throw new Error('Failed to load');
                const items = await res.json();
                renderTodos(items);
            } catch { todoList.innerHTML = ''; }
        }

        function renderTodos(items) {
            const pending = items.filter(t => !t.isCompleted);
            todoCount.textContent = pending.length;
            if (!items.length) { todoList.innerHTML = ''; todoEmpty.style.display = 'block'; return; }
            todoEmpty.style.display = 'none';
            todoList.innerHTML = items.map(t => {
                const priColor = t.priority === 'High' ? '#ef4444' : t.priority === 'Medium' ? '#f59e0b' : '#22c55e';
                const checked = t.isCompleted ? 'checked' : '';
                const strike = t.isCompleted ? 'text-decoration:line-through; opacity:0.5;' : '';
                return `<div style="display:flex; align-items:center; gap:0.75rem; padding:0.5rem 0; border-bottom:1px solid var(--border-light);">
                    <input type="checkbox" ${checked} onchange="toggleTodo(${t.id})" style="width:1rem; height:1rem; accent-color:var(--accent); cursor:pointer;" />
                    <span style="width:6px; height:6px; border-radius:50%; background:${priColor}; flex-shrink:0;" title="${t.priority}"></span>
                    <span style="flex:1; font-size:0.875rem; ${strike}">${t.title}</span>
                    ${t.dueDate ? `<span class="caption">${new Date(t.dueDate).toLocaleDateString('en-GB', {day:'numeric',month:'short'})}</span>` : ''}
                    <button onclick="deleteTodo(${t.id})" style="background:none; border:none; color:var(--text-tertiary); cursor:pointer; padding:0.25rem;" title="Delete">
                        <i class="fas fa-times" style="font-size:0.7rem;"></i>
                    </button>
                </div>`;
            }).join('');
        }

        async function addTodo() {
            const title = todoInput.value.trim();
            if (!title) return;
            const priority = document.getElementById('todoPriority').value;
            try {
                const res = await fetch('/Todo/Create', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getToken() },
                    body: JSON.stringify({ title, priority })
                });
                if (!res.ok) throw new Error('Failed to create');
                todoInput.value = '';
                loadTodos();
            } catch (e) { console.error('addTodo failed:', e); }
        }

        async function toggleTodo(id) {
            try {
                await fetch(`/Todo/Toggle/${id}`, { method: 'PUT', headers: { 'RequestVerificationToken': getToken() } });
                loadTodos();
            } catch {}
        }

        async function deleteTodo(id) {
            try {
                await fetch(`/Todo/Delete/${id}`, { method: 'DELETE', headers: { 'RequestVerificationToken': getToken() } });
                loadTodos();
            } catch {}
        }

        document.addEventListener('DOMContentLoaded', loadTodos);

        // ── Revenue Chart ──
        document.addEventListener('DOMContentLoaded', function () {
            var labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.ChartLabels));
            var data = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.ChartData));

            const ctx = document.getElementById('revenueChart')?.getContext('2d');
            if (!ctx) return;

            new Chart(ctx, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Revenue',
                        data: data,
                        borderColor: '#d4af37',
                        backgroundColor: 'rgba(212,175,55,0.06)',
                        tension: 0.4,
                        fill: true,
                        borderWidth: 2.5,
                        pointBackgroundColor: '#d4af37',
                        pointBorderColor: '#fff',
                        pointBorderWidth: 2,
                        pointRadius: 4,
                        pointHoverRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: { mode: 'index', intersect: false },
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: '#1e2a3a',
                            titleColor: '#94a3b8',
                            bodyColor: '#fff',
                            bodyFont: { weight: '600' },
                            padding: 12,
                            cornerRadius: 8,
                            displayColors: false,
                            callbacks: {
                                label: ctx => '$' + ctx.parsed.y.toLocaleString()
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: { color: 'rgba(0,0,0,0.04)', drawBorder: false },
                            ticks: {
                                color: '#9ca3af',
                                font: { size: 11 },
                                callback: v => '$' + v.toLocaleString()
                            }
                        },
                        x: {
                            grid: { display: false },
                            ticks: { color: '#9ca3af', font: { size: 11 } }
                        }
                    }
                }
            });
        });
    </script>
