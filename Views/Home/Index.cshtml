@{
    ViewData["Title"] = "Dashboard";
    var userRole = Context.Session.GetString("UserRole");
    var userName = Context.Session.GetString("UserName");
    var isOwner = userRole == "Owner";
    var isManager = userRole == "BranchManager";
    var isOwnerOrManager = isOwner || isManager;

    var completedOrders  = (int)(ViewBag.CompletedOrders ?? 0);
    var pendingOrders    = (int)(ViewBag.PendingOrders ?? 0);
    var totalOrders      = (int)(ViewBag.TotalOrders ?? 0);
    var inProgressOrders = Math.Max(0, totalOrders - completedOrders - pendingOrders);
    var todayOrders      = (int)(ViewBag.TodayOrders ?? 0);
    var totalStaff       = (int)(ViewBag.TotalStaff ?? 0);
    var activeStaff      = (int)(ViewBag.ActiveStaff ?? 0);
    int totalBranches    = ViewBag.DashboardData != null ? (int)ViewBag.DashboardData.TotalBranches : 0;
    var avgOrderValue    = (string)(ViewBag.AverageOrderValue ?? "0.00");
    var lowStockCount    = ViewBag.LowStockItems != null ? ((IEnumerable<dynamic>)ViewBag.LowStockItems).Count() : 0;
    var unreadCount      = (int)(ViewBag.NotifUnreadCount ?? 0);
    var recentNotifs     = ViewBag.RecentNotifications as IEnumerable<Cafe.Services.NotificationDto>;
}

<style>
/* ──────────────────────────────────────────────────────
   PREMIUM DASHBOARD DESIGN SYSTEM
   ────────────────────────────────────────────────────── */

/* Dark card — hero panels */
.pdb-dark {
    background: #16213e;
    border-radius: 22px;
    color: #fff;
    padding: 1.75rem;
    position: relative;
    overflow: hidden;
}
.pdb-dark::after {
    content: '';
    position: absolute;
    top: -80px; right: -80px;
    width: 260px; height: 260px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(212,175,55,0.13) 0%, transparent 65%);
    pointer-events: none;
}
.pdb-dark-title {
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: #d4af37;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.4rem;
    position: relative;
    z-index: 1;
}

/* Light card */
.pdb-light {
    background: #fff;
    border-radius: 22px;
    padding: 1.5rem;
    border: 1px solid rgba(0,0,0,0.06);
    box-shadow: 0 1px 4px rgba(0,0,0,0.04);
}
.pdb-light-title {
    font-size: 0.78rem;
    font-weight: 700;
    color: #1e293b;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.1rem;
}
.pdb-light-title i { color: #d4af37; }

/* Mini KPI card (CUSTOM PKGS / REFUNDS style) */
.pdb-kpi {
    background: #fff;
    border-radius: 18px;
    padding: 1.3rem 1.5rem;
    border: 1px solid rgba(0,0,0,0.07);
    box-shadow: 0 1px 4px rgba(0,0,0,0.04);
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    flex: 1;
}
.pdb-kpi-icon  { font-size: 1rem; margin-bottom: 0.55rem; }
.pdb-kpi-label { font-size: 0.64rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em; color: #94a3b8; }
.pdb-kpi-value { font-size: 2.1rem; font-weight: 800; color: #1e293b; line-height: 1.1; }
.pdb-kpi-trend { font-size: 0.74rem; font-weight: 700; margin-top: 0.25rem; display: flex; align-items: center; gap: 0.3rem; }
.pdb-kpi-trend.up      { color: #22c55e; }
.pdb-kpi-trend.down    { color: #ef4444; }
.pdb-kpi-trend.neutral { color: #f59e0b; }

/* Hero stat */
.pdb-stat-label { font-size: 0.6rem; font-weight: 800; letter-spacing: 0.09em; text-transform: uppercase; color: #64748b; }
.pdb-stat-val   { font-size: 2.25rem; font-weight: 800; color: #fff; line-height: 1.05; margin: 0.2rem 0 1.3rem; position: relative; z-index: 1; }

/* Legend rows */
.pdb-legend       { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.65rem; position: relative; z-index: 1; }
.pdb-dot          { width: 9px; height: 9px; border-radius: 50%; flex-shrink: 0; }
.pdb-legend-label { font-size: 0.8rem; color: #94a3b8; flex: 1; }
.pdb-legend-val   { font-size: 0.82rem; font-weight: 700; color: #e2e8f0; }

/* Metric rows inside light cards */
.pdb-metric-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.6rem 0.875rem;
    background: #f8fafc;
    border-radius: 10px;
    margin-bottom: 0.6rem;
}
.pdb-metric-label { font-size: 0.78rem; color: #64748b; display: flex; align-items: center; gap: 0.45rem; }
.pdb-metric-val   { font-size: 0.88rem; font-weight: 700; color: #1e293b; }
</style>

<!-- ── Page Header ─────────────────────────────────── -->
<div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:1.75rem; flex-wrap:wrap; gap:1rem;">
    <div>
        <h1 class="page-title" style="margin:0;">Welcome back, @(userName ?? "User")</h1>
        <p class="body-text" style="margin-top:0.25rem;">Here's what's happening across your operations today.</p>
    </div>
    @if (isOwnerOrManager)
    {
        <a asp-controller="Reports" asp-action="Index" class="btn btn-primary">
            <i class="fas fa-chart-line" style="margin-right:0.4rem;"></i> View Reports
        </a>
    }
</div>

<!-- ══════════════════════════════════════════════════
     ROW 1 — Dark Hero (Donut + Stats) + Mini KPIs
     ══════════════════════════════════════════════════ -->
<div style="display:grid; grid-template-columns:1fr 1fr 260px; gap:1.25rem; margin-bottom:1.25rem; align-items:stretch;">

    <!-- Dark Hero: Revenue Overview (2 cols) -->
    <div class="pdb-dark" style="grid-column:1/3;">
        <div class="pdb-dark-title"><i class="fas fa-chart-pie"></i> Sales Overview</div>
        <div style="display:flex; align-items:center; gap:2.5rem; flex-wrap:wrap; position:relative; z-index:1;">
            <!-- Donut -->
            <div style="position:relative; width:190px; height:190px; flex-shrink:0;">
                <canvas id="heroDonut" width="190" height="190"></canvas>
                <div style="position:absolute; inset:0; display:flex; flex-direction:column; align-items:center; justify-content:center; pointer-events:none;">
                    <span style="font-size:0.56rem; font-weight:800; letter-spacing:0.08em; text-transform:uppercase; color:#64748b;">TOTAL</span>
                    <span style="font-size:1.8rem; font-weight:800; color:#fff; line-height:1.05;">@totalOrders</span>
                    <span style="font-size:0.6rem; color:#475569; margin-top:1px;">orders</span>
                </div>
            </div>
            <!-- Stats -->
            <div style="flex:1; min-width:160px;">
                <div class="pdb-stat-label">TODAY'S ORDERS</div>
                <div class="pdb-stat-val">@todayOrders</div>
                <div class="pdb-legend">
                    <span class="pdb-dot" style="background:#22c55e;"></span>
                    <span class="pdb-legend-label">Completed</span>
                    <span class="pdb-legend-val">@completedOrders</span>
                </div>
                <div class="pdb-legend">
                    <span class="pdb-dot" style="background:#d4af37;"></span>
                    <span class="pdb-legend-label">Pending</span>
                    <span class="pdb-legend-val">@pendingOrders</span>
                </div>
                <div class="pdb-legend">
                    <span class="pdb-dot" style="background:#3b82f6;"></span>
                    <span class="pdb-legend-label">In Progress</span>
                    <span class="pdb-legend-val">@inProgressOrders</span>
                </div>
                <div class="pdb-legend" style="margin-top:0.5rem; padding-top:0.75rem; border-top:1px solid rgba(255,255,255,0.07);">
                    <span class="pdb-legend-label" style="color:#64748b; font-size:0.75rem;">Avg. Order Value</span>
                    <span class="pdb-legend-val" style="color:#d4af37;">Rs.&nbsp;@avgOrderValue</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Mini KPI Stack -->
    <div style="display:flex; flex-direction:column; gap:1.25rem;">
        <div class="pdb-kpi">
            <div class="pdb-kpi-icon" style="color:#d4af37;"><i class="fas fa-store"></i></div>
            <div class="pdb-kpi-label">Branches</div>
            <div class="pdb-kpi-value">@totalBranches</div>
            <div class="pdb-kpi-trend neutral"><i class="fas fa-check-circle"></i> Operating</div>
        </div>
        <div class="pdb-kpi">
            <div class="pdb-kpi-icon" style="color:@(lowStockCount > 0 ? "#ef4444" : "#22c55e");"><i class="fas fa-boxes-stacked"></i></div>
            <div class="pdb-kpi-label">Low Stock</div>
            <div class="pdb-kpi-value">@lowStockCount</div>
            <div class="pdb-kpi-trend @(lowStockCount > 0 ? "down" : "up")">
                @if (lowStockCount > 0) { <text><i class="fas fa-arrow-down"></i> Needs attention</text> }
                else { <text><i class="fas fa-shield-halved"></i> All healthy</text> }
            </div>
        </div>
    </div>
</div>

<!-- ══════════════════════════════════════════════════
     ROW 2 — Dark Trend Line + Light Order Donut
     ══════════════════════════════════════════════════ -->
<div style="display:grid; grid-template-columns:2fr 1fr; gap:1.25rem; margin-bottom:1.25rem; align-items:stretch;">

    <!-- Dark: Weekly Orders Trend -->
    <div class="pdb-dark">
        <div class="pdb-dark-title"><i class="fas fa-chart-line"></i> Order Trend (7-Day)</div>
        <div style="height:220px; position:relative; z-index:1;">
            <canvas id="weeklyTrend"></canvas>
        </div>
    </div>

    <!-- Light: Order Status Donut -->
    <div class="pdb-light" style="display:flex; flex-direction:column;">
        <div class="pdb-light-title"><i class="fas fa-circle-half-stroke"></i> Order Distribution</div>
        <div style="flex:1; display:flex; align-items:center; justify-content:center; min-height:160px;">
            <canvas id="orderStatusDonut" style="max-width:180px; max-height:180px;"></canvas>
        </div>
        <div style="display:flex; flex-direction:column; gap:0.45rem; margin-top:0.875rem;">
            <div style="display:flex; justify-content:space-between; align-items:center;">
                <span style="font-size:0.74rem; display:flex; align-items:center; gap:0.4rem; color:#64748b;"><span style="width:8px; height:8px; border-radius:50%; background:#22c55e; display:inline-block;"></span>Completed</span>
                <span style="font-size:0.8rem; font-weight:700; color:#1e293b;">@completedOrders</span>
            </div>
            <div style="display:flex; justify-content:space-between; align-items:center;">
                <span style="font-size:0.74rem; display:flex; align-items:center; gap:0.4rem; color:#64748b;"><span style="width:8px; height:8px; border-radius:50%; background:#d4af37; display:inline-block;"></span>Pending</span>
                <span style="font-size:0.8rem; font-weight:700; color:#1e293b;">@pendingOrders</span>
            </div>
            <div style="display:flex; justify-content:space-between; align-items:center;">
                <span style="font-size:0.74rem; display:flex; align-items:center; gap:0.4rem; color:#64748b;"><span style="width:8px; height:8px; border-radius:50%; background:#3b82f6; display:inline-block;"></span>In Progress</span>
                <span style="font-size:0.8rem; font-weight:700; color:#1e293b;">@inProgressOrders</span>
            </div>
        </div>
    </div>
</div>

<!-- ══════════════════════════════════════════════════
     ROW 3 — Monthly Revenue · Attendance · Key Metrics
     ══════════════════════════════════════════════════ -->
<div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:1.25rem; margin-bottom:1.25rem;">

    <!-- Monthly Revenue Bar -->
    <div class="pdb-light">
        <div class="pdb-light-title"><i class="fas fa-chart-column"></i> Monthly Revenue</div>
        <div style="height:170px;">
            <canvas id="monthlyRevBar"></canvas>
        </div>
    </div>

    <!-- 7-Day Attendance Bar -->
    <div class="pdb-light">
        <div class="pdb-light-title"><i class="fas fa-user-check"></i> Daily Attendance</div>
        <div style="height:170px;">
            <canvas id="attendBar"></canvas>
        </div>
    </div>

    <!-- Key Metrics List -->
    <div class="pdb-light">
        <div class="pdb-light-title"><i class="fas fa-gauge-high"></i> Key Metrics</div>
        <div class="pdb-metric-row">
            <span class="pdb-metric-label"><i class="fas fa-utensils" style="color:#d4af37;"></i> Menu Items</span>
            <span class="pdb-metric-val">@ViewBag.TotalMenuItems</span>
        </div>
        <div class="pdb-metric-row">
            <span class="pdb-metric-label"><i class="fas fa-users" style="color:#3b82f6;"></i> Total Staff</span>
            <span class="pdb-metric-val">@totalStaff</span>
        </div>
        <div class="pdb-metric-row">
            <span class="pdb-metric-label"><i class="fas fa-user-check" style="color:#22c55e;"></i> Active Staff</span>
            <span class="pdb-metric-val">@activeStaff</span>
        </div>
        @if (isOwner)
        {
            <div class="pdb-metric-row">
                <span class="pdb-metric-label"><i class="fas fa-user-friends" style="color:#ec4899;"></i> Customers</span>
                <span class="pdb-metric-val">@ViewBag.TotalCustomers</span>
            </div>
        }
        @if (isOwnerOrManager)
        {
            <div style="display:flex; flex-direction:column; gap:0.5rem; margin-top:0.75rem;">
                <a asp-controller="Staff" asp-action="Create" class="btn btn-secondary btn-sm" style="width:100%;">
                    <i class="fas fa-user-plus" style="margin-right:0.3rem;"></i> Add Staff
                </a>
                <a asp-controller="Order" asp-action="Index" class="btn btn-primary btn-sm" style="width:100%;">
                    <i class="fas fa-plus" style="margin-right:0.3rem;"></i> New Order
                </a>
            </div>
        }
    </div>
</div>

<!-- ══════════════════════════════════════════════════
     ROW 4 — To-Do + Activity Feed
     ══════════════════════════════════════════════════ -->
<div style="display:grid; grid-template-columns:1fr 2fr; gap:1.25rem; margin-bottom:1.25rem; align-items:start;">

    <!-- To-Do Widget -->
    <div class="pdb-light">
        <div class="pdb-light-title" style="justify-content:space-between;">
            <span style="display:flex; align-items:center; gap:0.5rem;"><i class="fas fa-tasks"></i> My Tasks</span>
            <span id="todoCount" class="badge badge-accent" style="font-size:0.68rem;">0</span>
        </div>
        <div style="display:flex; gap:0.4rem; margin-bottom:0.75rem;">
            <input type="text" id="todoInput" class="form-control" placeholder="Add a task..." style="flex:1; font-size:0.82rem;" onkeydown="if(event.key==='Enter')addTodo()" />
            <select id="todoPriority" class="form-select" style="width:82px; font-size:0.78rem;">
                <option value="Low">Low</option>
                <option value="Medium" selected>Medium</option>
                <option value="High">High</option>
            </select>
            <button onclick="addTodo()" class="btn btn-primary btn-sm"><i class="fas fa-plus"></i></button>
        </div>
        <div id="todoList" style="max-height:260px; overflow-y:auto;"></div>
        <div id="todoEmpty" style="display:none; text-align:center; padding:1.5rem 1rem;">
            <i class="fas fa-clipboard-check" style="font-size:1.25rem; color:#94a3b8;"></i>
            <p style="font-size:0.78rem; color:#94a3b8; margin:0.4rem 0 0;">No tasks yet. Add one above!</p>
        </div>
    </div>

    <!-- Activity Feed -->
    <div class="pdb-light" style="padding:0; overflow:hidden;">
        <div style="padding:1.1rem 1.5rem; border-bottom:1px solid rgba(0,0,0,0.06); display:flex; justify-content:space-between; align-items:center;">
            <span class="pdb-light-title" style="margin:0;">
                <i class="fas fa-bell" style="color:#d4af37;"></i> Recent Activity
                @if (unreadCount > 0)
                {
                    <span class="badge badge-danger" style="font-size:0.62rem; padding:2px 6px; margin-left:0.3rem;">@unreadCount</span>
                }
            </span>
            <a asp-controller="Notification" asp-action="Index" style="font-size:0.76rem; font-weight:600; color:#d4af37;">View all</a>
        </div>
        <div style="max-height:340px; overflow-y:auto;">
            @if (recentNotifs != null && recentNotifs.Any())
            {
                @foreach (var notif in recentNotifs)
                {
                    var typeColor = notif.Type switch {
                        "Success" => "#22c55e", "Warning" => "#f59e0b", "Error" => "#ef4444",
                        "Order" => "#6366f1", "Staff" => "#8b5cf6", "Inventory" => "#0ea5e9",
                        "Financial" => "#10b981", _ => "#d4af37"
                    };
                    var typeBg = notif.Type switch {
                        "Success" => "rgba(34,197,94,0.08)", "Warning" => "rgba(245,158,11,0.08)",
                        "Error" => "rgba(239,68,68,0.08)", "Order" => "rgba(99,102,241,0.08)",
                        "Staff" => "rgba(139,92,246,0.08)", "Inventory" => "rgba(14,165,233,0.08)",
                        "Financial" => "rgba(16,185,129,0.08)", _ => "rgba(212,175,55,0.08)"
                    };
                    var nIcon = !string.IsNullOrEmpty(notif.Icon) ? notif.Icon : notif.Type switch {
                        "Success" => "fas fa-check-circle", "Warning" => "fas fa-exclamation-triangle",
                        "Error" => "fas fa-times-circle", "Order" => "fas fa-receipt",
                        "Staff" => "fas fa-user", "Inventory" => "fas fa-boxes-stacked",
                        "Financial" => "fas fa-dollar-sign", _ => "fas fa-bell"
                    };
                    var isUnread = !notif.IsRead;
                    <a href="@(notif.RedirectUrl ?? "/Notification")"
                       style="display:flex; align-items:flex-start; gap:0.875rem; padding:0.875rem 1.5rem; border-bottom:1px solid rgba(0,0,0,0.04); text-decoration:none; position:relative; @(isUnread ? "background:rgba(212,175,55,0.025);" : "")">
                        @if (isUnread) {
                            <span style="position:absolute; left:7px; top:50%; transform:translateY(-50%); width:5px; height:5px; border-radius:50%; background:@typeColor;"></span>
                        }
                        <div style="width:34px; height:34px; border-radius:10px; background:@typeBg; display:flex; align-items:center; justify-content:center; flex-shrink:0; color:@typeColor; font-size:0.8rem;">
                            <i class="@nIcon"></i>
                        </div>
                        <div style="flex:1; min-width:0;">
                            <div style="font-size:0.8rem; font-weight:@(isUnread ? "700" : "600"); color:#1e293b; margin-bottom:2px;">@notif.Title</div>
                            <p style="font-size:0.74rem; color:#64748b; margin:0; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">@notif.Message</p>
                            <span style="font-size:0.64rem; color:#94a3b8; margin-top:2px; display:block;">@notif.TimeAgo</span>
                        </div>
                    </a>
                }
            }
            else
            {
                <div style="text-align:center; padding:2.5rem 1rem;">
                    <i class="fas fa-bell-slash" style="font-size:1.5rem; color:#94a3b8;"></i>
                    <p style="font-size:0.8rem; color:#94a3b8; margin:0.5rem 0 0;">No recent activity</p>
                </div>
            }
        </div>
    </div>
</div>

<!-- ══════════════════════════════════════════════════
     ROW 5 — Low Stock + Recent Orders Table
     ══════════════════════════════════════════════════ -->
<div style="display:grid; grid-template-columns:1fr 2fr; gap:1.25rem;">

    <!-- Low Stock -->
    <div class="pdb-light">
        <div class="pdb-light-title" style="justify-content:space-between;">
            <span style="display:flex; align-items:center; gap:0.5rem;"><i class="fas fa-triangle-exclamation" style="color:#f59e0b;"></i> Low Stock</span>
            <a asp-controller="InventoryItem" asp-action="Index" style="font-size:0.74rem; font-weight:600; color:#d4af37;">View all</a>
        </div>
        @if (ViewBag.LowStockItems != null && ((IEnumerable<dynamic>)ViewBag.LowStockItems).Any())
        {
            <div style="display:flex; flex-direction:column; gap:0.55rem;">
                @foreach (var item in ViewBag.LowStockItems)
                {
                    <div style="display:flex; align-items:center; justify-content:space-between; padding:0.6rem 0.875rem; background:#fefce8; border:1px solid rgba(245,158,11,0.2); border-radius:10px;">
                        <div>
                            <p style="font-size:0.82rem; font-weight:600; color:#1e293b; margin:0;">@item.Name</p>
                            <p style="font-size:0.68rem; color:#94a3b8; margin:0;">@item.Branch?.Name</p>
                        </div>
                        <div style="text-align:right;">
                            <span style="font-size:0.85rem; font-weight:700; color:@(item.Quantity == 0 ? "#ef4444" : "#d97706");">@item.Quantity @item.Unit</span>
                            <p style="font-size:0.68rem; color:#94a3b8; margin:0;">Min: @item.ReorderLevel</p>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div style="text-align:center; padding:2rem 1rem;">
                <div style="width:42px; height:42px; border-radius:12px; background:rgba(34,197,94,0.08); display:flex; align-items:center; justify-content:center; margin:0 auto 0.625rem; color:#22c55e; font-size:1.1rem;"><i class="fas fa-check-circle"></i></div>
                <p style="font-size:0.8rem; color:#64748b; margin:0;">All stock levels healthy</p>
            </div>
        }
    </div>

    <!-- Recent Orders -->
    <div class="pdb-light" style="padding:0; overflow:hidden;">
        <div style="padding:1.1rem 1.5rem; border-bottom:1px solid rgba(0,0,0,0.06); display:flex; justify-content:space-between; align-items:center;">
            <span class="pdb-light-title" style="margin:0;"><i class="fas fa-receipt"></i> Recent Orders</span>
            <a asp-controller="Order" asp-action="Index" style="font-size:0.76rem; font-weight:600; color:#d4af37;">View all</a>
        </div>
        <div style="padding:0 0.75rem;">
            @if (ViewBag.RecentOrders != null && ((IEnumerable<dynamic>)ViewBag.RecentOrders).Any())
            {
                <table class="premium-table">
                    <thead>
                        <tr>
                            <th>Order #</th>
                            <th>Customer</th>
                            <th>Amount</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in ViewBag.RecentOrders)
                        {
                            <tr>
                                <td style="font-weight:600;">#@order.OrderNumber</td>
                                <td>@order.CustomerName</td>
                                <td style="font-weight:600;">Rs. @order.TotalAmount</td>
                                <td>
                                    @{ var bc = (string)order.Status switch {
                                        "Completed" => "badge-success", "Pending" => "badge-warning",
                                        "Preparing" => "badge-info",   "Ready"    => "badge-accent",
                                        _ => "badge-danger" }; }
                                    <span class="badge @bc">@order.Status</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div style="text-align:center; padding:2rem 1rem;">
                    <i class="fas fa-receipt" style="font-size:1.5rem; color:#94a3b8;"></i>
                    <p style="font-size:0.82rem; color:#94a3b8; margin:0.5rem 0 0;">No recent orders</p>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
<script>
// ── To-Do Widget ──────────────────────────────────────────────────
const todoList  = document.getElementById('todoList');
const todoEmpty = document.getElementById('todoEmpty');
const todoCount = document.getElementById('todoCount');
const todoInput = document.getElementById('todoInput');

function getToken() {
    return document.querySelector('[name="__RequestVerificationToken"]')?.value ||
           document.querySelector('meta[name="RequestVerificationToken"]')?.content || '';
}
async function loadTodos() {
    try { const r = await fetch('/Todo/Index'); if (!r.ok) throw new Error(); renderTodos(await r.json()); }
    catch { todoList.innerHTML = ''; }
}
function renderTodos(items) {
    const pending = items.filter(t => !t.isCompleted);
    todoCount.textContent = pending.length;
    if (!items.length) { todoList.innerHTML = ''; todoEmpty.style.display = 'block'; return; }
    todoEmpty.style.display = 'none';
    todoList.innerHTML = items.map(t => {
        const priColor = t.priority === 'High' ? '#ef4444' : t.priority === 'Medium' ? '#f59e0b' : '#22c55e';
        const strike = t.isCompleted ? 'text-decoration:line-through;opacity:0.45;' : '';
        return `<div style="display:flex;align-items:center;gap:0.65rem;padding:0.45rem 0;border-bottom:1px solid rgba(0,0,0,0.05);">
            <input type="checkbox" ${t.isCompleted?'checked':''} onchange="toggleTodo(${t.id})" style="width:1rem;height:1rem;accent-color:#d4af37;cursor:pointer;"/>
            <span style="width:6px;height:6px;border-radius:50%;background:${priColor};flex-shrink:0;"></span>
            <span style="flex:1;font-size:0.8rem;${strike}">${t.title}</span>
            ${t.dueDate?`<span style="font-size:0.66rem;color:#94a3b8;">${new Date(t.dueDate).toLocaleDateString('en-GB',{day:'numeric',month:'short'})}</span>`:''}
            <button onclick="deleteTodo(${t.id})" style="background:none;border:none;color:#94a3b8;cursor:pointer;padding:0.15rem;" title="Delete">
                <i class="fas fa-times" style="font-size:0.62rem;"></i>
            </button>
        </div>`;
    }).join('');
}
async function addTodo() {
    const title = todoInput.value.trim(); if (!title) return;
    const priority = document.getElementById('todoPriority').value;
    try {
        const r = await fetch('/Todo/Create', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getToken() },
            body: JSON.stringify({ title, priority })
        });
        if (!r.ok) throw new Error();
        todoInput.value = ''; loadTodos();
    } catch(e) { console.error('addTodo:', e); }
}
async function toggleTodo(id) {
    try { await fetch(`/Todo/Toggle/${id}`,{method:'PUT',headers:{'RequestVerificationToken':getToken()}}); loadTodos(); } catch {}
}
async function deleteTodo(id) {
    try { await fetch(`/Todo/Delete/${id}`,{method:'DELETE',headers:{'RequestVerificationToken':getToken()}}); loadTodos(); } catch {}
}
document.addEventListener('DOMContentLoaded', loadTodos);

// ── Premium Dashboard Charts ──────────────────────────────────────
document.addEventListener('DOMContentLoaded', function () {
    const chartLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.ChartLabels));
    const chartData   = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.ChartData));
    const sparkLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.SparkLabels ?? new List<string>()));
    const orderSpark  = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.OrderSparkData ?? new List<int>()));
    const attendSpark = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.AttendanceSparkData ?? new List<int>()));

    const completed  = @completedOrders;
    const pending    = @pendingOrders;
    const inProgress = @inProgressOrders;

    // Shared dark tooltip config
    const darkTip = {
        backgroundColor: '#0f172a',
        titleColor: '#64748b',
        bodyColor: '#fff',
        bodyFont: { weight: '700', size: 13 },
        padding: 12,
        cornerRadius: 10,
        displayColors: false
    };

    // ─── 1. Hero Donut ────────────────────────────────────────────
    (function() {
        const ctx = document.getElementById('heroDonut')?.getContext('2d');
        if (!ctx) return;
        const hasData = completed + pending + inProgress > 0;
        new Chart(ctx, {
            type: 'doughnut',
            data: {
                labels: ['Completed', 'Pending', 'In Progress'],
                datasets: [{
                    data: hasData ? [completed, pending, inProgress] : [1],
                    backgroundColor: hasData ? ['#22c55e', '#d4af37', '#3b82f6'] : ['rgba(255,255,255,0.1)'],
                    borderColor: '#16213e',
                    borderWidth: 4,
                    hoverOffset: 6
                }]
            },
            options: {
                responsive: true, maintainAspectRatio: false, cutout: '70%',
                plugins: { legend: { display: false }, tooltip: { ...darkTip, displayColors: true } }
            }
        });
    })();

    // ─── 2. Weekly Trend Line (dark, gradient fill) ───────────────
    (function() {
        const ctx = document.getElementById('weeklyTrend')?.getContext('2d');
        if (!ctx || !orderSpark.length) return;
        const grad = ctx.createLinearGradient(0, 0, 0, 220);
        grad.addColorStop(0, 'rgba(212,175,55,0.42)');
        grad.addColorStop(0.6, 'rgba(212,175,55,0.10)');
        grad.addColorStop(1, 'rgba(212,175,55,0.00)');
        new Chart(ctx, {
            type: 'line',
            data: {
                labels: sparkLabels,
                datasets: [{
                    label: 'Orders',
                    data: orderSpark,
                    borderColor: '#d4af37',
                    backgroundColor: grad,
                    tension: 0.45,
                    fill: true,
                    borderWidth: 2.5,
                    pointBackgroundColor: '#d4af37',
                    pointBorderColor: '#16213e',
                    pointBorderWidth: 2,
                    pointRadius: 5,
                    pointHoverRadius: 8
                }]
            },
            options: {
                responsive: true, maintainAspectRatio: false,
                interaction: { mode: 'index', intersect: false },
                plugins: { legend: { display: false }, tooltip: { ...darkTip, callbacks: { label: c => c.parsed.y + ' orders' } } },
                scales: {
                    y: { beginAtZero: true, grid: { color: 'rgba(255,255,255,0.06)', drawBorder: false }, ticks: { color: '#475569', font: { size: 11 } } },
                    x: { grid: { display: false }, ticks: { color: '#475569', font: { size: 11 } } }
                }
            }
        });
    })();

    // ─── 3. Order Status Donut (light card) ──────────────────────
    (function() {
        const ctx = document.getElementById('orderStatusDonut')?.getContext('2d');
        if (!ctx) return;
        const hasData = completed + pending + inProgress > 0;
        new Chart(ctx, {
            type: 'doughnut',
            data: {
                labels: ['Completed', 'Pending', 'In Progress'],
                datasets: [{
                    data: hasData ? [completed, pending, inProgress] : [1],
                    backgroundColor: hasData ? ['#22c55e', '#d4af37', '#3b82f6'] : ['#e2e8f0'],
                    borderColor: '#fff',
                    borderWidth: 3,
                    hoverOffset: 5
                }]
            },
            options: {
                responsive: true, maintainAspectRatio: true, cutout: '65%',
                plugins: {
                    legend: { display: false },
                    tooltip: { backgroundColor: '#1e293b', titleColor: '#94a3b8', bodyColor: '#fff', bodyFont: { weight: '700' }, padding: 10, cornerRadius: 8, displayColors: true }
                }
            }
        });
    })();

    // ─── 4. Monthly Revenue Bar ───────────────────────────────────
    (function() {
        const ctx = document.getElementById('monthlyRevBar')?.getContext('2d');
        if (!ctx) return;
        const maxVal = Math.max(...chartData, 1);
        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: chartLabels,
                datasets: [{
                    label: 'Revenue',
                    data: chartData,
                    backgroundColor: chartData.map(v => v >= maxVal ? '#d4af37' : 'rgba(212,175,55,0.22)'),
                    hoverBackgroundColor: '#d4af37',
                    borderRadius: 6,
                    borderSkipped: false
                }]
            },
            options: {
                responsive: true, maintainAspectRatio: false,
                plugins: { legend: { display: false }, tooltip: {
                    backgroundColor: '#1e293b', titleColor: '#94a3b8', bodyColor: '#fff',
                    bodyFont: { weight: '700' }, padding: 10, cornerRadius: 8,
                    callbacks: { label: c => 'Rs. ' + c.parsed.y.toLocaleString() }
                }},
                scales: {
                    y: { beginAtZero: true, grid: { color: 'rgba(0,0,0,0.04)', drawBorder: false },
                        ticks: { color: '#94a3b8', font: { size: 10 }, callback: v => v >= 1000 ? 'Rs.' + (v/1000).toFixed(0) + 'k' : 'Rs.' + v } },
                    x: { grid: { display: false }, ticks: { color: '#94a3b8', font: { size: 10 } } }
                }
            }
        });
    })();

    // ─── 5. Daily Attendance Bar (gradient green) ─────────────────
    (function() {
        const ctx = document.getElementById('attendBar')?.getContext('2d');
        if (!ctx || !attendSpark.length) return;
        const grad = ctx.createLinearGradient(0, 0, 0, 170);
        grad.addColorStop(0, 'rgba(34,197,94,0.80)');
        grad.addColorStop(1, 'rgba(34,197,94,0.12)');
        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: sparkLabels,
                datasets: [{
                    label: 'Present',
                    data: attendSpark,
                    backgroundColor: grad,
                    hoverBackgroundColor: '#22c55e',
                    borderRadius: 6,
                    borderSkipped: false
                }]
            },
            options: {
                responsive: true, maintainAspectRatio: false,
                plugins: { legend: { display: false }, tooltip: {
                    backgroundColor: '#1e293b', titleColor: '#94a3b8', bodyColor: '#fff',
                    bodyFont: { weight: '700' }, padding: 10, cornerRadius: 8,
                    callbacks: { label: c => c.parsed.y + ' staff present' }
                }},
                scales: {
                    y: { beginAtZero: true, grid: { color: 'rgba(0,0,0,0.04)', drawBorder: false }, ticks: { color: '#94a3b8', font: { size: 10 } } },
                    x: { grid: { display: false }, ticks: { color: '#94a3b8', font: { size: 10 } } }
                }
            }
        });
    })();
});
</script>
}
