@{
    ViewData["Title"] = "Dashboard";
    var userRole = Context.Session.GetString("UserRole");
    var userName = Context.Session.GetString("UserName");
    var isOwner = userRole == "Owner";
    var isManager = userRole == "BranchManager";
    var isOwnerOrManager = isOwner || isManager;

    var completedOrders  = (int)(ViewBag.CompletedOrders ?? 0);
    var pendingOrders    = (int)(ViewBag.PendingOrders ?? 0);
    var totalOrders      = (int)(ViewBag.TotalOrders ?? 0);
    var inProgressOrders = Math.Max(0, totalOrders - completedOrders - pendingOrders);
    var todayOrders      = (int)(ViewBag.TodayOrders ?? 0);
    var totalStaff       = (int)(ViewBag.TotalStaff ?? 0);
    var activeStaff      = (int)(ViewBag.ActiveStaff ?? 0);
    int totalBranches    = ViewBag.DashboardData != null ? (int)ViewBag.DashboardData.TotalBranches : 0;
    var avgOrderValue    = (string)(ViewBag.AverageOrderValue ?? "0.00");
    var lowStockCount    = ViewBag.LowStockItems != null ? ((IEnumerable<dynamic>)ViewBag.LowStockItems).Count() : 0;
    var unreadCount      = (int)(ViewBag.NotifUnreadCount ?? 0);
    var recentNotifs     = ViewBag.RecentNotifications as IEnumerable<Cafe.Services.NotificationDto>;
}

<!-- ── Page Header ─────────────────────────────────── -->
<div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:1.5rem; flex-wrap:wrap; gap:1rem;">
    <div>
        <h1 class="page-title" style="margin:0;">Welcome back, @(userName ?? "User")</h1>
        <p class="body-text" style="margin-top:0.25rem;">Here's what's happening across your operations today.</p>
    </div>
    @if (isOwnerOrManager)
    {
        <a asp-controller="Reports" asp-action="Index" class="btn btn-primary">
            <i class="fas fa-chart-line" style="margin-right:0.4rem;"></i> View Reports
        </a>
    }
</div>

<!-- ── KPI Row ─────────────────────────────────────── -->
<div class="kpi-grid">
    @await Html.PartialAsync("_KpiCard", new Cafe.Models.ViewModels.KpiCardVm {
        Label = "Today's Orders", Value = todayOrders.ToString("N0"), Icon = "fa-receipt", Tint = "accent"
    })
    @await Html.PartialAsync("_KpiCard", new Cafe.Models.ViewModels.KpiCardVm {
        Label = "Avg. Order Value", Value = $"Rs. {avgOrderValue}", Icon = "fa-coins"
    })
    @await Html.PartialAsync("_KpiCard", new Cafe.Models.ViewModels.KpiCardVm {
        Label = "Branches", Value = totalBranches.ToString("N0"), Icon = "fa-store",
        TrendText = "Operating", TrendDirection = "up"
    })
    @await Html.PartialAsync("_KpiCard", new Cafe.Models.ViewModels.KpiCardVm {
        Label = "Active Staff", Value = activeStaff.ToString("N0"), Icon = "fa-user-check",
        TrendText = $"of {totalStaff}", TrendDirection = "neutral"
    })
    @await Html.PartialAsync("_KpiCard", new Cafe.Models.ViewModels.KpiCardVm {
        Label = "Low Stock Items", Value = lowStockCount.ToString("N0"), Icon = "fa-boxes-stacked",
        Tint = lowStockCount > 0 ? "warning" : "success",
        TrendText = lowStockCount > 0 ? "Attention" : "Healthy",
        TrendDirection = lowStockCount > 0 ? "down" : "up",
        Href = Url.Action("Index", "InventoryItem")
    })
</div>

<!-- ── Main Grid: content column + right rail ──────── -->
<div class="dash-grid">

    <!-- LEFT COLUMN -->
    <div class="dash-col">

        <!-- Order Trend -->
        <div class="card" style="padding:1.4rem 1.5rem;">
            <div class="card-title-row">
                <span class="card-title-sm"><i class="fas fa-chart-line"></i> Order Trend</span>
                <span class="caption">Last 7 days</span>
            </div>
            <div style="height:250px;">
                <canvas id="weeklyTrend"></canvas>
            </div>
        </div>

        <!-- Monthly Revenue + Attendance -->
        <div class="dash-row-2">
            <div class="card" style="padding:1.4rem 1.5rem;">
                <div class="card-title-row">
                    <span class="card-title-sm"><i class="fas fa-chart-column"></i> Monthly Revenue</span>
                </div>
                <div style="height:190px;">
                    <canvas id="monthlyRevBar"></canvas>
                </div>
            </div>
            <div class="card" style="padding:1.4rem 1.5rem;">
                <div class="card-title-row">
                    <span class="card-title-sm"><i class="fas fa-user-check"></i> Daily Attendance</span>
                </div>
                <div style="height:190px;">
                    <canvas id="attendBar"></canvas>
                </div>
            </div>
        </div>

        <!-- Sales Mix + Key Metrics -->
        <div class="dash-row-2">
            <div class="card" style="padding:1.4rem 1.5rem; display:flex; flex-direction:column;">
                <div class="card-title-row">
                    <span class="card-title-sm"><i class="fas fa-circle-half-stroke"></i> Sales Mix</span>
                </div>
                <div style="flex:1; display:flex; align-items:center; justify-content:center; min-height:150px;">
                    <canvas id="orderStatusDonut" style="max-width:160px; max-height:160px;"></canvas>
                </div>
                <div style="display:flex; flex-direction:column; gap:0.45rem; margin-top:0.875rem;">
                    <div style="display:flex; justify-content:space-between; align-items:center;">
                        <span style="font-size:0.74rem; display:flex; align-items:center; gap:0.4rem; color:var(--text-secondary);"><span style="width:8px; height:8px; border-radius:50%; background:var(--success); display:inline-block;"></span>Completed</span>
                        <span class="num" style="font-size:0.8rem; font-weight:700; color:var(--text-primary);">@completedOrders</span>
                    </div>
                    <div style="display:flex; justify-content:space-between; align-items:center;">
                        <span style="font-size:0.74rem; display:flex; align-items:center; gap:0.4rem; color:var(--text-secondary);"><span style="width:8px; height:8px; border-radius:50%; background:var(--warning); display:inline-block;"></span>Pending</span>
                        <span class="num" style="font-size:0.8rem; font-weight:700; color:var(--text-primary);">@pendingOrders</span>
                    </div>
                    <div style="display:flex; justify-content:space-between; align-items:center;">
                        <span style="font-size:0.74rem; display:flex; align-items:center; gap:0.4rem; color:var(--text-secondary);"><span style="width:8px; height:8px; border-radius:50%; background:var(--info); display:inline-block;"></span>In Progress</span>
                        <span class="num" style="font-size:0.8rem; font-weight:700; color:var(--text-primary);">@inProgressOrders</span>
                    </div>
                </div>
            </div>

            <div class="card" style="padding:1.4rem 1.5rem;">
                <div class="card-title-row">
                    <span class="card-title-sm"><i class="fas fa-gauge-high"></i> Key Metrics</span>
                </div>
                <div class="metric-row">
                    <span class="metric-row-label"><i class="fas fa-utensils" style="color:var(--accent);"></i> Menu Items</span>
                    <span class="metric-row-val">@ViewBag.TotalMenuItems</span>
                </div>
                <div class="metric-row">
                    <span class="metric-row-label"><i class="fas fa-users" style="color:var(--info);"></i> Total Staff</span>
                    <span class="metric-row-val">@totalStaff</span>
                </div>
                <div class="metric-row">
                    <span class="metric-row-label"><i class="fas fa-user-check" style="color:var(--success);"></i> Active Staff</span>
                    <span class="metric-row-val">@activeStaff</span>
                </div>
                @if (isOwner)
                {
                    <div class="metric-row">
                        <span class="metric-row-label"><i class="fas fa-user-friends" style="color:var(--chart-3);"></i> Customers</span>
                        <span class="metric-row-val">@ViewBag.TotalCustomers</span>
                    </div>
                }
                @if (isOwnerOrManager)
                {
                    <div style="display:flex; gap:0.5rem; margin-top:0.85rem;">
                        <a asp-controller="Staff" asp-action="Create" class="btn btn-secondary btn-sm" style="flex:1;">
                            <i class="fas fa-user-plus" style="margin-right:0.3rem;"></i> Add Staff
                        </a>
                        <a asp-controller="Order" asp-action="Index" class="btn btn-primary btn-sm" style="flex:1;">
                            <i class="fas fa-plus" style="margin-right:0.3rem;"></i> New Order
                        </a>
                    </div>
                }
            </div>
        </div>

        <!-- Recent Orders -->
        <div class="card" style="padding:0; overflow:hidden;">
            <div class="card-title-row" style="padding:1.1rem 1.5rem; margin:0; border-bottom:1px solid var(--border-light);">
                <span class="card-title-sm"><i class="fas fa-receipt"></i> Recent Orders</span>
                <a asp-controller="Order" asp-action="Index" class="card-link">View all</a>
            </div>
            <div style="padding:0 0.75rem 0.5rem; overflow-x:auto;">
                @if (ViewBag.RecentOrders != null && ((IEnumerable<dynamic>)ViewBag.RecentOrders).Any())
                {
                    <table class="premium-table">
                        <thead>
                            <tr>
                                <th>Order #</th>
                                <th>Customer</th>
                                <th>Amount</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in ViewBag.RecentOrders)
                            {
                                <tr>
                                    <td style="font-weight:600;">#@order.OrderNumber</td>
                                    <td>@order.CustomerName</td>
                                    <td class="num" style="font-weight:600;">Rs. @order.TotalAmount</td>
                                    <td>
                                        @{ var bc = (string)order.Status switch {
                                            "Completed" => "badge-success", "Pending" => "badge-warning",
                                            "Preparing" => "badge-info",   "Ready"    => "badge-accent",
                                            _ => "badge-danger" }; }
                                        <span class="badge @bc">@order.Status</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div style="text-align:center; padding:2rem 1rem;">
                        <i class="fas fa-receipt" style="font-size:1.5rem; color:var(--text-tertiary);"></i>
                        <p style="font-size:0.82rem; color:var(--text-tertiary); margin:0.5rem 0 0;">No recent orders</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- RIGHT RAIL -->
    <div class="dash-col">

        <!-- Today at a glance — high-contrast card -->
        <div class="card-contrast">
            <div class="contrast-title">Today at a glance</div>
            <div class="contrast-muted" style="margin-bottom:0.9rem;">Orders placed today</div>
            <div class="contrast-value num" data-countup>@todayOrders</div>
            <div style="display:flex; align-items:center; gap:1.4rem; margin-top:1.1rem; flex-wrap:wrap;">
                <div style="position:relative; width:120px; height:120px; flex-shrink:0;">
                    <canvas id="heroDonut" width="120" height="120"></canvas>
                    <div style="position:absolute; inset:0; display:flex; flex-direction:column; align-items:center; justify-content:center; pointer-events:none;">
                        <span class="num" style="font-size:1.15rem; font-weight:800; line-height:1;">@totalOrders</span>
                        <span class="contrast-muted" style="font-size:0.58rem; text-transform:uppercase; letter-spacing:0.06em;">total</span>
                    </div>
                </div>
                <div style="flex:1; min-width:0;">
                    <div class="contrast-row">
                        <span class="dot" style="background:var(--success);"></span>
                        <span class="contrast-row-label">Completed</span>
                        <span class="contrast-row-val">@completedOrders</span>
                    </div>
                    <div class="contrast-row">
                        <span class="dot" style="background:var(--warning);"></span>
                        <span class="contrast-row-label">Pending</span>
                        <span class="contrast-row-val">@pendingOrders</span>
                    </div>
                    <div class="contrast-row">
                        <span class="dot" style="background:var(--info);"></span>
                        <span class="contrast-row-label">In Progress</span>
                        <span class="contrast-row-val">@inProgressOrders</span>
                    </div>
                </div>
            </div>
            <hr class="contrast-divider" />
            <div class="contrast-row" style="padding:0;">
                <span class="contrast-row-label">Avg. Order Value</span>
                <span class="contrast-row-val num">Rs.&nbsp;@avgOrderValue</span>
            </div>
        </div>

        <!-- To-Do Widget -->
        <div class="card" style="padding:1.4rem 1.5rem;">
            <div class="card-title-row">
                <span class="card-title-sm"><i class="fas fa-tasks"></i> My Tasks</span>
                <span id="todoCount" class="badge badge-accent" style="font-size:0.68rem;">0</span>
            </div>
            <div style="display:flex; gap:0.4rem; margin-bottom:0.75rem;">
                <input type="text" id="todoInput" class="form-control" placeholder="Add a task..." style="flex:1; font-size:0.82rem;" onkeydown="if(event.key==='Enter')addTodo()" />
                <select id="todoPriority" class="form-select" style="width:82px; font-size:0.78rem;">
                    <option value="Low">Low</option>
                    <option value="Medium" selected>Medium</option>
                    <option value="High">High</option>
                </select>
                <button onclick="addTodo()" class="btn btn-primary btn-sm"><i class="fas fa-plus"></i></button>
            </div>
            <div id="todoList" style="max-height:260px; overflow-y:auto;"></div>
            <div id="todoEmpty" style="display:none; text-align:center; padding:1.5rem 1rem;">
                <i class="fas fa-clipboard-check" style="font-size:1.25rem; color:var(--text-tertiary);"></i>
                <p style="font-size:0.78rem; color:var(--text-tertiary); margin:0.4rem 0 0;">No tasks yet. Add one above!</p>
            </div>
        </div>

        <!-- Activity Feed -->
        <div class="card" style="padding:0; overflow:hidden;">
            <div class="card-title-row" style="padding:1.1rem 1.5rem; margin:0; border-bottom:1px solid var(--border-light);">
                <span class="card-title-sm">
                    <i class="fas fa-bell"></i> Recent Activity
                    @if (unreadCount > 0)
                    {
                        <span class="badge badge-danger" style="font-size:0.62rem; padding:2px 6px; margin-left:0.3rem;">@unreadCount</span>
                    }
                </span>
                <a asp-controller="Notification" asp-action="Index" class="card-link">View all</a>
            </div>
            <div style="max-height:320px; overflow-y:auto;">
                @if (recentNotifs != null && recentNotifs.Any())
                {
                    @foreach (var notif in recentNotifs)
                    {
                        var typeColor = notif.Type switch {
                            "Success" => "var(--success)", "Warning" => "var(--warning)", "Error" => "var(--danger)",
                            "Order" => "var(--info)", "Staff" => "var(--chart-7)", "Inventory" => "var(--chart-1)",
                            "Financial" => "var(--chart-5)", _ => "var(--accent)"
                        };
                        var typeBg = notif.Type switch {
                            "Success" => "var(--success-light)", "Warning" => "var(--warning-light)",
                            "Error" => "var(--danger-light)", "Order" => "var(--info-light)",
                            "Staff" => "var(--info-light)", "Inventory" => "var(--info-light)",
                            "Financial" => "var(--success-light)", _ => "var(--accent-light)"
                        };
                        var nIcon = !string.IsNullOrEmpty(notif.Icon) ? notif.Icon : notif.Type switch {
                            "Success" => "fas fa-check-circle", "Warning" => "fas fa-exclamation-triangle",
                            "Error" => "fas fa-times-circle", "Order" => "fas fa-receipt",
                            "Staff" => "fas fa-user", "Inventory" => "fas fa-boxes-stacked",
                            "Financial" => "fas fa-dollar-sign", _ => "fas fa-bell"
                        };
                        var isUnread = !notif.IsRead;
                        <a href="@(notif.RedirectUrl ?? "/Notification")"
                           style="display:flex; align-items:flex-start; gap:0.875rem; padding:0.875rem 1.5rem; border-bottom:1px solid var(--border-light); text-decoration:none; position:relative; @(isUnread ? "background:var(--accent-lighter);" : "")">
                            @if (isUnread) {
                                <span style="position:absolute; left:7px; top:50%; transform:translateY(-50%); width:5px; height:5px; border-radius:50%; background:@typeColor;"></span>
                            }
                            <div style="width:34px; height:34px; border-radius:10px; background:@typeBg; display:flex; align-items:center; justify-content:center; flex-shrink:0; color:@typeColor; font-size:0.8rem;">
                                <i class="@nIcon"></i>
                            </div>
                            <div style="flex:1; min-width:0;">
                                <div style="font-size:0.8rem; font-weight:@(isUnread ? "700" : "600"); color:var(--text-primary); margin-bottom:2px;">@notif.Title</div>
                                <p style="font-size:0.74rem; color:var(--text-secondary); margin:0; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">@notif.Message</p>
                                <span style="font-size:0.64rem; color:var(--text-tertiary); margin-top:2px; display:block;">@notif.TimeAgo</span>
                            </div>
                        </a>
                    }
                }
                else
                {
                    <div style="text-align:center; padding:2.5rem 1rem;">
                        <i class="fas fa-bell-slash" style="font-size:1.5rem; color:var(--text-tertiary);"></i>
                        <p style="font-size:0.8rem; color:var(--text-tertiary); margin:0.5rem 0 0;">No recent activity</p>
                    </div>
                }
            </div>
        </div>

        <!-- Low Stock -->
        <div class="card" style="padding:1.4rem 1.5rem;">
            <div class="card-title-row">
                <span class="card-title-sm"><i class="fas fa-triangle-exclamation" style="color:var(--warning);"></i> Low Stock</span>
                <a asp-controller="InventoryItem" asp-action="Index" class="card-link">View all</a>
            </div>
            @if (ViewBag.LowStockItems != null && ((IEnumerable<dynamic>)ViewBag.LowStockItems).Any())
            {
                <div style="display:flex; flex-direction:column; gap:0.55rem;">
                    @foreach (var item in ViewBag.LowStockItems)
                    {
                        <div style="display:flex; align-items:center; justify-content:space-between; padding:0.6rem 0.875rem; background:var(--warning-light); border:1px solid color-mix(in srgb, var(--warning) 22%, transparent); border-radius:10px;">
                            <div>
                                <p style="font-size:0.82rem; font-weight:600; color:var(--text-primary); margin:0;">@item.Name</p>
                                <p style="font-size:0.68rem; color:var(--text-tertiary); margin:0;">@item.Branch?.Name</p>
                            </div>
                            <div style="text-align:right;">
                                <span class="num" style="font-size:0.85rem; font-weight:700; color:@(item.Quantity == 0 ? "var(--danger)" : "var(--warning)");">@item.Quantity @item.Unit</span>
                                <p style="font-size:0.68rem; color:var(--text-tertiary); margin:0;">Min: @item.ReorderLevel</p>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div style="text-align:center; padding:2rem 1rem;">
                    <div style="width:42px; height:42px; border-radius:12px; background:var(--success-light); display:flex; align-items:center; justify-content:center; margin:0 auto 0.625rem; color:var(--success); font-size:1.1rem;"><i class="fas fa-check-circle"></i></div>
                    <p style="font-size:0.8rem; color:var(--text-secondary); margin:0;">All stock levels healthy</p>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
<script>
// ── To-Do Widget ──────────────────────────────────────────────────
const todoList  = document.getElementById('todoList');
const todoEmpty = document.getElementById('todoEmpty');
const todoCount = document.getElementById('todoCount');
const todoInput = document.getElementById('todoInput');

function getToken() {
    return document.querySelector('[name="__RequestVerificationToken"]')?.value ||
           document.querySelector('meta[name="RequestVerificationToken"]')?.content || '';
}
function todoSkeleton() {
    todoList.innerHTML = Array.from({ length: 3 }, () =>
        '<div class="skeleton-pulse" style="height:14px;border-radius:6px;margin:12px 0;"></div>').join('');
}
async function loadTodos() {
    todoSkeleton();
    try { const r = await fetch('/Todo/Index'); if (!r.ok) throw new Error(); renderTodos(await r.json()); }
    catch { todoList.innerHTML = ''; }
}
function renderTodos(items) {
    const pending = items.filter(t => !t.isCompleted);
    todoCount.textContent = pending.length;
    if (!items.length) { todoList.innerHTML = ''; todoEmpty.style.display = 'block'; return; }
    todoEmpty.style.display = 'none';
    todoList.innerHTML = items.map(t => {
        const priColor = t.priority === 'High' ? 'var(--danger)' : t.priority === 'Medium' ? 'var(--warning)' : 'var(--success)';
        const strike = t.isCompleted ? 'text-decoration:line-through;opacity:0.45;' : '';
        return `<div style="display:flex;align-items:center;gap:0.65rem;padding:0.45rem 0;border-bottom:1px solid var(--border-light);">
            <input type="checkbox" ${t.isCompleted?'checked':''} onchange="toggleTodo(${t.id})" style="width:1rem;height:1rem;accent-color:var(--accent);cursor:pointer;"/>
            <span style="width:6px;height:6px;border-radius:50%;background:${priColor};flex-shrink:0;"></span>
            <span style="flex:1;font-size:0.8rem;${strike}">${t.title}</span>
            ${t.dueDate?`<span style="font-size:0.66rem;color:var(--text-tertiary);">${new Date(t.dueDate).toLocaleDateString('en-GB',{day:'numeric',month:'short'})}</span>`:''}
            <button onclick="deleteTodo(${t.id})" style="background:none;border:none;color:var(--text-tertiary);cursor:pointer;padding:0.15rem;" title="Delete">
                <i class="fas fa-times" style="font-size:0.62rem;"></i>
            </button>
        </div>`;
    }).join('');
}
async function addTodo() {
    const title = todoInput.value.trim(); if (!title) return;
    const priority = document.getElementById('todoPriority').value;
    try {
        const r = await fetch('/Todo/Create', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getToken() },
            body: JSON.stringify({ title, priority })
        });
        if (!r.ok) throw new Error();
        todoInput.value = ''; loadTodos();
    } catch(e) { console.error('addTodo:', e); }
}
async function toggleTodo(id) {
    try { await fetch(`/Todo/Toggle/${id}`,{method:'PUT',headers:{'RequestVerificationToken':getToken()}}); loadTodos(); } catch {}
}
async function deleteTodo(id) {
    try { await fetch(`/Todo/Delete/${id}`,{method:'DELETE',headers:{'RequestVerificationToken':getToken()}}); loadTodos(); } catch {}
}
document.addEventListener('DOMContentLoaded', loadTodos);

// ── Premium Dashboard Charts ──────────────────────────────────────
document.addEventListener('DOMContentLoaded', function () {
    const chartLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.ChartLabels));
    const chartData   = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.ChartData));
    const sparkLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.SparkLabels ?? new List<string>()));
    const orderSpark  = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.OrderSparkData ?? new List<int>()));
    const attendSpark = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.AttendanceSparkData ?? new List<int>()));

    const completed  = @completedOrders;
    const pending    = @pendingOrders;
    const inProgress = @inProgressOrders;

    // ─── 1. Hero Donut ────────────────────────────────────────────
    CafeCharts.make('heroDonut', C => {
        const hasData = completed + pending + inProgress > 0;
        return {
            type: 'doughnut',
            data: {
                labels: ['Completed', 'Pending', 'In Progress'],
                datasets: [{
                    data: hasData ? [completed, pending, inProgress] : [1],
                    backgroundColor: hasData
                        ? [C.status('success'), C.status('warning'), C.status('info')]
                        : [C.alpha(C.ink().tick, 0.25)],
                    borderColor: C.css('--surface-contrast'),
                    borderWidth: 4,
                    hoverOffset: 6
                }]
            },
            options: {
                responsive: true, maintainAspectRatio: false, cutout: '70%',
                plugins: { legend: { display: false }, tooltip: { displayColors: true } }
            }
        };
    });

    // ─── 2. Weekly Trend Line (emphasis ink, soft fill) ───────────
    if (orderSpark.length) CafeCharts.make('weeklyTrend', C => {
        const ctx = document.getElementById('weeklyTrend').getContext('2d');
        const line = C.emphasis();
        const grad = ctx.createLinearGradient(0, 0, 0, 250);
        grad.addColorStop(0, C.alpha(line, 0.10));
        grad.addColorStop(1, C.alpha(line, 0));
        return {
            type: 'line',
            data: {
                labels: sparkLabels,
                datasets: [{
                    label: 'Orders',
                    data: orderSpark,
                    borderColor: line,
                    backgroundColor: grad,
                    tension: 0.4,
                    fill: true,
                    borderWidth: 2.5,
                    pointBackgroundColor: line,
                    pointBorderColor: C.surface(),
                    pointBorderWidth: 2,
                    pointRadius: 0,
                    pointHoverRadius: 6
                }]
            },
            options: {
                responsive: true, maintainAspectRatio: false,
                interaction: { mode: 'index', intersect: false },
                plugins: { legend: { display: false }, tooltip: { callbacks: { label: c => c.parsed.y + ' orders' } } },
                scales: C.scales({ precision: 0 })
            }
        };
    });

    // ─── 3. Order Status Donut (light card) ──────────────────────
    CafeCharts.make('orderStatusDonut', C => {
        const hasData = completed + pending + inProgress > 0;
        return {
            type: 'doughnut',
            data: {
                labels: ['Completed', 'Pending', 'In Progress'],
                datasets: [{
                    data: hasData ? [completed, pending, inProgress] : [1],
                    backgroundColor: hasData
                        ? [C.status('success'), C.status('warning'), C.status('info')]
                        : [C.css('--bg-inset')],
                    borderColor: C.surface(),
                    borderWidth: 3,
                    hoverOffset: 5
                }]
            },
            options: {
                responsive: true, maintainAspectRatio: true, cutout: '65%',
                plugins: { legend: { display: false }, tooltip: { displayColors: true } }
            }
        };
    });

    // ─── 4. Monthly Revenue Bar ───────────────────────────────────
    CafeCharts.make('monthlyRevBar', C => {
        const maxVal = Math.max(...chartData, 1);
        return {
            type: 'bar',
            data: {
                labels: chartLabels,
                datasets: [{
                    label: 'Revenue',
                    data: chartData,
                    backgroundColor: chartData.map(v => v >= maxVal ? C.accent() : C.alpha(C.accent(), 0.22)),
                    hoverBackgroundColor: C.accent(),
                    borderRadius: 6,
                    borderSkipped: false
                }]
            },
            options: {
                responsive: true, maintainAspectRatio: false,
                plugins: { legend: { display: false }, tooltip: {
                    callbacks: { label: c => 'Rs. ' + c.parsed.y.toLocaleString() }
                }},
                scales: C.scales({ yTicks: v => v >= 1000 ? 'Rs.' + (v/1000).toFixed(0) + 'k' : 'Rs.' + v })
            }
        };
    });

    // ─── 5. Daily Attendance Bar (gradient green) ─────────────────
    if (attendSpark.length) CafeCharts.make('attendBar', C => {
        const ctx = document.getElementById('attendBar').getContext('2d');
        const green = C.status('success');
        const grad = ctx.createLinearGradient(0, 0, 0, 170);
        grad.addColorStop(0, C.alpha(green, 0.8));
        grad.addColorStop(1, C.alpha(green, 0.12));
        return {
            type: 'bar',
            data: {
                labels: sparkLabels,
                datasets: [{
                    label: 'Present',
                    data: attendSpark,
                    backgroundColor: grad,
                    hoverBackgroundColor: green,
                    borderRadius: 6,
                    borderSkipped: false
                }]
            },
            options: {
                responsive: true, maintainAspectRatio: false,
                plugins: { legend: { display: false }, tooltip: {
                    callbacks: { label: c => c.parsed.y + ' staff present' }
                }},
                scales: C.scales()
            }
        };
    });
});
</script>
}
