@model Cafe.Models.ViewModels.PayslipViewModel
@{
    ViewData["Title"] = "Payslip";
    var r = Model.Record;
    var monthName = new DateTime(r.Year, r.Month, 1).ToString("MMMM yyyy");
}

<div class="max-w-[800px] mx-auto">
    <!-- Header -->
    <div class="no-print" style="display:flex; align-items:center; justify-content:space-between; margin-bottom:1.5rem; flex-wrap:wrap; gap:1rem;">
        <div style="display:flex; align-items:center; gap:1rem;">
            <a asp-action="Index" class="btn btn-ghost btn-sm"><i class="fas fa-arrow-left"></i></a>
            <h1 class="page-title" style="margin:0;">Payslip — @monthName</h1>
        </div>
        <button onclick="window.print()" class="btn btn-secondary"><i class="fas fa-print" style="margin-right:0.5rem;"></i> Print</button>
    </div>

    <div class="card" id="payslip">
        <div class="card-body p-8">
            <!-- Header -->
            <div style="display:flex; justify-content:space-between; align-items:flex-start; padding-bottom:1.5rem; border-bottom:2px solid var(--border-light); margin-bottom:1.5rem;">
                <div>
                    <h2 style="font-size:1.5rem; font-weight:700; margin:0; color:var(--text-primary);"><i class="fas fa-utensils" style="margin-right:0.5rem; color:var(--accent);"></i> Cafe Management</h2>
                    <p class="caption" style="margin:0.25rem 0 0;">Salary Slip — @monthName</p>
                </div>
                <div style="text-align:right;">
                    <p class="caption" style="margin:0;">Generated: @r.GeneratedAt.ToString("dd MMM yyyy")</p>
                    <div style="margin-top:0.5rem; display:flex; gap:0.5rem; justify-content:flex-end;">
                        @{
                            var wfBadge = r.Status == "Paid" ? "badge badge-accent" :
                                          r.Status == "Finalized" ? "badge badge-success" : "badge badge-neutral";
                            var pyBadge = r.PaymentStatus == "Paid" ? "badge badge-success" : "badge badge-warning";
                        }
                        <span class="@wfBadge">@r.Status</span>
                        <span class="@pyBadge">@r.PaymentStatus</span>
                    </div>
                </div>
            </div>

            <!-- Employee Info -->
            <div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem; margin-bottom:2rem;">
                <div><span class="caption">Employee Name</span><p class="body-text" style="font-weight:600; margin:0.25rem 0 0;">@r.Staff?.User?.Name</p></div>
                <div><span class="caption">Role</span><p class="body-text" style="font-weight:600; margin:0.25rem 0 0;">@r.Staff?.StaffRole?.RoleName</p></div>
                <div><span class="caption">Branch</span><p class="body-text" style="font-weight:600; margin:0.25rem 0 0;">@r.Branch?.Name</p></div>
                <div><span class="caption">Period</span><p class="body-text" style="font-weight:600; margin:0.25rem 0 0;">@monthName</p></div>
                @if (Model.PolicyUsed != null)
                {
                    <div><span class="caption">Salary Policy</span><p class="body-text" style="font-weight:600; margin:0.25rem 0 0; color:var(--accent);">@Model.PolicyUsed.Name</p></div>
                }
            </div>

            <!-- Attendance Summary -->
            <div style="background:var(--bg-body); border-radius:var(--radius-card); padding:1.25rem; margin-bottom:1.5rem;">
                <h3 class="section-title" style="margin-bottom:0.75rem;">Attendance Summary</h3>
                <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(80px,1fr)); gap:0.75rem; text-align:center;">
                    <div><p class="caption" style="margin:0;">Working Days</p><p style="font-size:1.25rem; font-weight:700; margin:0;">@r.TotalWorkingDays</p></div>
                    <div><p class="caption" style="margin:0;">Present</p><p style="font-size:1.25rem; font-weight:700; margin:0; color:var(--success);">@r.DaysPresent</p></div>
                    <div><p class="caption" style="margin:0;">Absent</p><p style="font-size:1.25rem; font-weight:700; margin:0; color:var(--danger);">@r.DaysAbsent</p></div>
                    <div><p class="caption" style="margin:0;">Late</p><p style="font-size:1.25rem; font-weight:700; margin:0; color:#ca8a04;">@r.DaysLate</p></div>
                    <div><p class="caption" style="margin:0;">Half-Day</p><p style="font-size:1.25rem; font-weight:700; margin:0; color:#ea580c;">@r.DaysHalfDay</p></div>
                    <div><p class="caption" style="margin:0;">Overtime</p><p style="font-size:1.25rem; font-weight:700; margin:0; color:var(--accent);">@(r.OvertimeHours > 0 ? $"{r.OvertimeHours:F1}h" : "-")</p></div>
                    <div><p class="caption" style="margin:0;">Rate</p><p style="font-size:1.25rem; font-weight:700; margin:0; color:var(--accent);">@r.AttendancePercentage%</p></div>
                </div>
            </div>

            <!-- Salary Formula Breakdown -->
            <h3 class="section-title" style="margin-bottom:0.75rem;">Salary Breakdown</h3>
            <table class="premium-table">
                <tbody>
                    <tr>
                        <td style="padding:0.75rem 0;">Base Salary</td>
                        <td style="padding:0.75rem 0; text-align:right; font-weight:600;">Rs. @r.BaseSalary.ToString("N2")</td>
                    </tr>
                    @if (r.OvertimePay > 0)
                    {
                        <tr>
                            <td style="padding:0.75rem 0; color:var(--success);"><i class="fas fa-clock" style="margin-right:0.5rem;"></i> Overtime Pay <span class="caption" style="display:block;">@r.OvertimeHours.ToString("F1")h x Hourly Rate x 1.5</span></td>
                            <td style="padding:0.75rem 0; text-align:right; font-weight:600; color:var(--success);">+ Rs. @r.OvertimePay.ToString("N2")</td>
                        </tr>
                    }
                    @if (r.AttendanceBonus > 0)
                    {
                        <tr>
                            <td style="padding:0.75rem 0; color:var(--success);"><i class="fas fa-star" style="margin-right:0.5rem;"></i> Attendance Bonus <span class="caption" style="display:block;">5% of Base (0 absent, &#8804;2 late)</span></td>
                            <td style="padding:0.75rem 0; text-align:right; font-weight:600; color:var(--success);">+ Rs. @r.AttendanceBonus.ToString("N2")</td>
                        </tr>
                    }
                    @foreach (var adj in Model.Adjustments.Where(a => a.Type == "Bonus"))
                    {
                        <tr>
                            <td style="padding:0.75rem 0; color:var(--success);"><i class="fas fa-gift" style="margin-right:0.5rem;"></i> @(adj.Reason ?? "Manual Bonus") <span class="caption" style="display:block;">By @(adj.CreatedBy?.Name ?? "System") on @adj.CreatedAt.ToString("dd MMM")</span></td>
                            <td style="padding:0.75rem 0; text-align:right; font-weight:600; color:var(--success);">+ Rs. @adj.Amount.ToString("N2")</td>
                        </tr>
                    }
                    <tr style="background:rgba(59,130,246,0.05);">
                        <td style="padding:0.75rem 0; font-weight:700;">Gross Salary</td>
                        <td style="padding:0.75rem 0; text-align:right; font-weight:700;">Rs. @r.GrossSalary.ToString("N2")</td>
                    </tr>
                    @if (r.AbsenceDeduction > 0)
                    {
                        <tr>
                            <td style="padding:0.75rem 0; color:var(--danger);"><i class="fas fa-calendar-times" style="margin-right:0.5rem;"></i> Absence Deduction <span class="caption" style="display:block;">@r.DaysAbsent day(s) x Daily Rate</span></td>
                            <td style="padding:0.75rem 0; text-align:right; font-weight:600; color:var(--danger);">- Rs. @r.AbsenceDeduction.ToString("N2")</td>
                        </tr>
                    }
                    @if (r.HalfDayDeduction > 0)
                    {
                        <tr>
                            <td style="padding:0.75rem 0; color:var(--danger);"><i class="fas fa-adjust" style="margin-right:0.5rem;"></i> Half-Day Deduction <span class="caption" style="display:block;">@r.DaysHalfDay day(s) x Daily Rate / 2</span></td>
                            <td style="padding:0.75rem 0; text-align:right; font-weight:600; color:var(--danger);">- Rs. @r.HalfDayDeduction.ToString("N2")</td>
                        </tr>
                    }
                    @if (r.LatePenaltyDeduction > 0)
                    {
                        <tr>
                            <td style="padding:0.75rem 0; color:var(--danger);"><i class="fas fa-exclamation-triangle" style="margin-right:0.5rem;"></i> Late Penalty <span class="caption" style="display:block;">@r.DaysLate late(s) = @(r.DaysLate / 3) half-day penalty</span></td>
                            <td style="padding:0.75rem 0; text-align:right; font-weight:600; color:var(--danger);">- Rs. @r.LatePenaltyDeduction.ToString("N2")</td>
                        </tr>
                    }
                    @foreach (var adj in Model.Adjustments.Where(a => a.Type == "Deduction"))
                    {
                        <tr>
                            <td style="padding:0.75rem 0; color:var(--danger);"><i class="fas fa-minus-circle" style="margin-right:0.5rem;"></i> @(adj.Reason ?? "Manual Deduction") <span class="caption" style="display:block;">By @(adj.CreatedBy?.Name ?? "System") on @adj.CreatedAt.ToString("dd MMM")</span></td>
                            <td style="padding:0.75rem 0; text-align:right; font-weight:600; color:var(--danger);">- Rs. @adj.Amount.ToString("N2")</td>
                        </tr>
                    }
                    <tr style="background:rgba(239,68,68,0.05);">
                        <td style="padding:0.75rem 0; font-weight:700;">Total Deductions</td>
                        <td style="padding:0.75rem 0; text-align:right; font-weight:700; color:var(--danger);">- Rs. @r.TotalDeductions.ToString("N2")</td>
                    </tr>
                    <tr style="background:rgba(147,51,234,0.05); border-top:3px solid var(--accent);">
                        <td style="padding:1rem 0; font-weight:700; font-size:1.15rem;">Net Payable</td>
                        <td style="padding:1rem 0; text-align:right; font-weight:700; font-size:1.15rem; color:#9333ea;">Rs. @r.FinalSalary.ToString("N2")</td>
                    </tr>
                </tbody>
            </table>

            @if (r.FinalizedAt.HasValue)
            {
                <div style="background:rgba(212,175,55,0.08); border-radius:var(--radius-card); padding:1rem; margin-top:1.5rem;">
                    <p class="caption" style="margin:0;"><i class="fas fa-lock" style="color:var(--accent); margin-right:0.5rem;"></i> Finalized by @(r.FinalizedBy?.Name ?? "N/A") on @r.FinalizedAt.Value.ToString("dd MMM yyyy HH:mm")</p>
                </div>
            }

            @if (r.PaidDate.HasValue)
            {
                <div style="background:var(--success-light); border-radius:var(--radius-card); padding:1rem; margin-top:0.75rem;">
                    <div style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:0.5rem;">
                        <p class="caption" style="margin:0;">
                            <i class="fas fa-check-circle" style="color:var(--success); margin-right:0.5rem;"></i>
                            Paid on @r.PaidDate.Value.ToString("dd MMM yyyy")
                        </p>
                        @if (!string.IsNullOrEmpty(r.PaymentMethod))
                        {
                            var pmIcon = r.PaymentMethod switch {
                                "Cash"          => "fa-money-bill-wave",
                                "Bank Transfer" => "fa-university",
                                "Mobile Wallet" => "fa-mobile-alt",
                                "Cheque"        => "fa-file-alt",
                                _               => "fa-credit-card"
                            };
                            <div style="display:flex; align-items:center; gap:0.5rem;">
                                <span class="caption"><i class="fas @pmIcon" style="color:var(--success); margin-right:0.25rem;"></i>@r.PaymentMethod</span>
                                @if (!string.IsNullOrEmpty(r.PaymentReference))
                                {
                                    <span class="caption" style="background:rgba(0,0,0,0.06); padding:2px 8px; border-radius:4px;">@r.PaymentReference</span>
                                }
                            </div>
                        }
                    </div>
                    @if (!string.IsNullOrEmpty(r.PaymentNotes))
                    {
                        <p class="caption" style="margin:0.5rem 0 0; color:var(--text-secondary);"><i class="fas fa-sticky-note" style="margin-right:0.25rem;"></i>@r.PaymentNotes</p>
                    }
                </div>
            }
        </div>
    </div>

    <!-- Attendance Details -->
    @if (Model.AttendanceDetails.Any())
    {
        <div class="card mt-6">
            <div class="card-header">
                <h3 style="margin:0; font-weight:600;">Daily Attendance Details</h3>
            </div>
            <div class="card-body card-body-flush">
                <div style="overflow-x:auto;">
                    <table class="premium-table">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Status</th>
                                <th>Check In</th>
                                <th>Check Out</th>
                                <th>Hours</th>
                                <th>Overtime</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var a in Model.AttendanceDetails)
                            {
                                var sBadge = a.Status switch
                                {
                                    "Present"        => "badge badge-success",
                                    "Absent"         => "badge badge-danger",
                                    "Late"           => "badge badge-warning",
                                    "Half-Day"       => "badge badge-info",
                                    "Paid Leave"     => "badge badge-paid-leave",
                                    "Sick Leave"     => "badge badge-warning",
                                    "Casual Leave"   => "badge badge-warning",
                                    "Holiday"        => "badge badge-success",
                                    "Work From Home" => "badge badge-info",
                                    "Overtime"       => "badge badge-success",
                                    _                => "badge badge-neutral"
                                };
                                <tr>
                                    <td>@a.Date.ToString("dd MMM (ddd)")</td>
                                    <td><span class="@sBadge">@a.Status</span></td>
                                    <td class="caption">@(a.CheckInTime?.ToString(@"hh\:mm") ?? "-")</td>
                                    <td class="caption">@(a.CheckOutTime?.ToString(@"hh\:mm") ?? "-")</td>
                                    <td class="caption">@(a.TotalHours > 0 ? $"{a.TotalHours:F1}h" : "-")</td>
                                    <td style="@(a.OvertimeHours > 0 ? "color:var(--accent); font-weight:600;" : "")">@(a.OvertimeHours > 0 ? $"{a.OvertimeHours:F1}h" : "-")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>
