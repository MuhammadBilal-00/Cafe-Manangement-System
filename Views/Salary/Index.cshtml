@model Cafe.Models.ViewModels.SalaryIndexViewModel
@{
    ViewData["Title"] = "Salary Management";
    var monthName = new DateTime(Model.Year, Model.Month, 1).ToString("MMMM yyyy");
    var isOwner = Context.Session.GetString("UserRole") == "Owner";
}

<div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-bold text-gray-800">Salary Management - @monthName</h1>
    @if (isOwner || Context.Session.GetString("UserRole") == "BranchManager")
    {
        <a asp-action="Generate" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg transition duration-200 flex items-center">
            <i class="fas fa-calculator mr-2"></i> Generate Salaries
        </a>
    }
</div>

<!-- Stats Cards -->
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
    <div class="bg-white rounded-lg shadow-md p-6 border-l-4 border-blue-500">
        <div class="flex items-center">
            <div class="p-3 rounded-lg bg-blue-100 text-blue-600 mr-4">
                <i class="fas fa-money-bill-wave text-xl"></i>
            </div>
            <div>
                <p class="text-sm text-gray-600">Total Base Salary</p>
                <p class="text-xl font-bold text-gray-800">Rs. @Model.TotalBaseSalary.ToString("N0")</p>
            </div>
        </div>
    </div>
    <div class="bg-white rounded-lg shadow-md p-6 border-l-4 border-green-500">
        <div class="flex items-center">
            <div class="p-3 rounded-lg bg-green-100 text-green-600 mr-4">
                <i class="fas fa-gift text-xl"></i>
            </div>
            <div>
                <p class="text-sm text-gray-600">Total Earnings</p>
                <p class="text-xl font-bold text-green-600">+ Rs. @Model.TotalBonuses.ToString("N0")</p>
                <p class="text-xs text-gray-400">OT: @Model.TotalOvertimePay.ToString("N0") | Bonus: @Model.TotalAttendanceBonus.ToString("N0")</p>
            </div>
        </div>
    </div>
    <div class="bg-white rounded-lg shadow-md p-6 border-l-4 border-red-500">
        <div class="flex items-center">
            <div class="p-3 rounded-lg bg-red-100 text-red-600 mr-4">
                <i class="fas fa-minus-circle text-xl"></i>
            </div>
            <div>
                <p class="text-sm text-gray-600">Total Deductions</p>
                <p class="text-xl font-bold text-red-600">- Rs. @Model.TotalDeductions.ToString("N0")</p>
            </div>
        </div>
    </div>
    <div class="bg-white rounded-lg shadow-md p-6 border-l-4 border-purple-500">
        <div class="flex items-center">
            <div class="p-3 rounded-lg bg-purple-100 text-purple-600 mr-4">
                <i class="fas fa-wallet text-xl"></i>
            </div>
            <div>
                <p class="text-sm text-gray-600">Net Payable</p>
                <p class="text-xl font-bold text-gray-800">Rs. @Model.TotalFinalSalary.ToString("N0")</p>
                <p class="text-xs text-gray-400">Draft: @Model.DraftCount | Finalized: @Model.FinalizedCount</p>
            </div>
        </div>
    </div>
</div>

<!-- Filters -->
<div class="bg-white rounded-lg shadow-md p-6 mb-6">
    <form method="get" class="flex gap-4 items-end flex-wrap">
        <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Branch</label>
            <select name="branchId" class="border rounded-lg px-3 py-2">
                <option value="">All Branches</option>
                @foreach (var b in Model.Branches)
                {
                    <option value="@b.Id" selected="@(Model.BranchId == b.Id)">@b.Name</option>
                }
            </select>
        </div>
        <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Year</label>
            <select name="year" class="border rounded-lg px-3 py-2">
                @for (int y = DateTime.Now.Year; y >= DateTime.Now.Year - 3; y--)
                {
                    <option value="@y" selected="@(y == Model.Year)">@y</option>
                }
            </select>
        </div>
        <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Month</label>
            <select name="month" class="border rounded-lg px-3 py-2">
                @for (int m = 1; m <= 12; m++)
                {
                    <option value="@m" selected="@(m == Model.Month)">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(m)</option>
                }
            </select>
        </div>
        <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Workflow</label>
            <select name="workflowStatus" class="border rounded-lg px-3 py-2">
                <option value="">All</option>
                <option value="Draft" selected="@(Model.WorkflowStatus == "Draft")">Draft</option>
                <option value="Finalized" selected="@(Model.WorkflowStatus == "Finalized")">Finalized</option>
            </select>
        </div>
        <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Payment</label>
            <select name="paymentStatus" class="border rounded-lg px-3 py-2">
                <option value="">All</option>
                <option value="Pending" selected="@(Model.PaymentStatus == "Pending")">Pending</option>
                <option value="Paid" selected="@(Model.PaymentStatus == "Paid")">Paid</option>
            </select>
        </div>
        <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg">
            <i class="fas fa-filter mr-1"></i> Filter
        </button>
    </form>
</div>

<!-- Salary Table -->
<div class="bg-white rounded-lg shadow-md overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
            <tr>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Staff</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Branch</th>
                <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase">Base</th>
                <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase">Days</th>
                <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase">Attend%</th>
                <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase">Earnings</th>
                <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase">Deductions</th>
                <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase">Net</th>
                <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase">Workflow</th>
                <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase">Payment</th>
                <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase">Actions</th>
            </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
            @if (!Model.Records.Any())
            {
                <tr>
                    <td colspan="11" class="px-6 py-12 text-center text-gray-500">
                        <i class="fas fa-file-invoice-dollar text-4xl mb-3 block"></i>
                        No salary records found. Generate salaries first.
                    </td>
                </tr>
            }
            @foreach (var r in Model.Records)
            {
                var pctClass = r.AttendancePercentage >= 90 ? "text-green-600" :
                               r.AttendancePercentage >= 70 ? "text-yellow-600" : "text-red-600";
                var wfClass = r.Status == "Finalized" ? "bg-green-100 text-green-800" : "bg-gray-100 text-gray-800";
                var pyClass = r.PaymentStatus == "Paid" ? "bg-green-100 text-green-800" : "bg-yellow-100 text-yellow-800";
                <tr class="hover:bg-gray-50">
                    <td class="px-4 py-4 text-sm font-medium text-gray-800">@r.Staff?.User?.Name</td>
                    <td class="px-4 py-4 text-sm text-gray-600">@r.Branch?.Name</td>
                    <td class="px-4 py-4 text-sm text-right">Rs. @r.BaseSalary.ToString("N0")</td>
                    <td class="px-4 py-4 text-sm text-center">@r.DaysPresent/@r.TotalWorkingDays</td>
                    <td class="px-4 py-4 text-sm text-center font-bold @pctClass">@r.AttendancePercentage%</td>
                    <td class="px-4 py-4 text-sm text-right text-green-600">@(r.BonusAmount > 0 ? $"+{r.BonusAmount:N0}" : "-")</td>
                    <td class="px-4 py-4 text-sm text-right text-red-600">@(r.TotalDeductions > 0 ? $"-{r.TotalDeductions:N0}" : "-")</td>
                    <td class="px-4 py-4 text-sm text-right font-bold">Rs. @r.FinalSalary.ToString("N0")</td>
                    <td class="px-4 py-4 text-center">
                        <span class="px-2 py-1 text-xs font-medium rounded-full @wfClass">@r.Status</span>
                    </td>
                    <td class="px-4 py-4 text-center">
                        <span class="px-2 py-1 text-xs font-medium rounded-full @pyClass">@r.PaymentStatus</span>
                    </td>
                    <td class="px-4 py-4 text-center text-sm">
                        <button onclick="viewSalaryDetail(@r.Id)" class="text-blue-600 hover:text-blue-800 mr-1" title="View Details">
                            <i class="fas fa-file-alt"></i>
                        </button>
                        <a asp-action="Payslip" asp-route-id="@r.Id" class="text-purple-600 hover:text-purple-800 mr-1" title="View Payslip">
                            <i class="fas fa-receipt"></i>
                        </a>
                        @if (r.Status == "Draft" && r.PaymentStatus != "Paid")
                        {
                            <button onclick="openAdjustModal(@r.Id)" class="text-orange-600 hover:text-orange-800 mr-1" title="Add Adjustment">
                                <i class="fas fa-plus-circle"></i>
                            </button>
                        }
                        @if (isOwner && r.Status == "Draft")
                        {
                            <form asp-action="Finalize" asp-route-id="@r.Id" method="post" class="inline" data-confirm="Finalize this salary record?">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="text-indigo-600 hover:text-indigo-800 mr-1" title="Finalize">
                                    <i class="fas fa-lock"></i>
                                </button>
                            </form>
                        }
                        @if (isOwner && r.Status == "Finalized" && r.PaymentStatus != "Paid")
                        {
                            <form asp-action="Unlock" asp-route-id="@r.Id" method="post" class="inline" data-confirm="Unlock this salary record for editing?">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="text-amber-600 hover:text-amber-800 mr-1" title="Unlock">
                                    <i class="fas fa-unlock"></i>
                                </button>
                            </form>
                        }
                        @if (r.Status == "Finalized" && r.PaymentStatus == "Pending")
                        {
                            <form asp-action="MarkPaid" asp-route-id="@r.Id" method="post" class="inline" data-confirm="Mark this salary as paid?">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="text-green-600 hover:text-green-800" title="Mark Paid">
                                    <i class="fas fa-check-circle"></i>
                                </button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Pagination -->
@if (Model.TotalPages > 1)
{
    <div class="flex justify-center items-center mt-6 gap-2">
        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <a asp-action="Index" asp-route-page="@i" asp-route-year="@Model.Year" asp-route-month="@Model.Month"
               asp-route-branchId="@Model.BranchId" asp-route-paymentStatus="@Model.PaymentStatus"
               asp-route-workflowStatus="@Model.WorkflowStatus"
               class="px-3 py-1 rounded @(i == Model.CurrentPage ? "bg-blue-600 text-white" : "bg-gray-200 text-gray-700 hover:bg-gray-300")">
                @i
            </a>
        }
    </div>
}

<!-- Quick Actions -->
<div class="mt-8 bg-blue-50 rounded-lg p-6">
    <h3 class="text-lg font-medium text-blue-800 mb-4">Quick Actions</h3>
    <div class="flex flex-wrap gap-4">
        @if (isOwner && Model.DraftCount > 0)
        {
            <form asp-action="FinalizeAll" method="post" class="inline" data-confirm="Finalize all @Model.DraftCount draft salary records?">
                @Html.AntiForgeryToken()
                <input type="hidden" name="year" value="@Model.Year" />
                <input type="hidden" name="month" value="@Model.Month" />
                <input type="hidden" name="branchId" value="@Model.BranchId" />
                <button type="submit" class="bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-lg flex items-center">
                    <i class="fas fa-lock mr-2"></i> Finalize All Draft (@Model.DraftCount)
                </button>
            </form>
        }
        @if (Model.FinalizedCount > 0 && Model.PendingCount > 0)
        {
            <form asp-action="MarkAllPaid" method="post" class="inline" data-confirm="Mark all finalized pending salaries as paid?">
                @Html.AntiForgeryToken()
                <input type="hidden" name="year" value="@Model.Year" />
                <input type="hidden" name="month" value="@Model.Month" />
                <input type="hidden" name="branchId" value="@Model.BranchId" />
                <button type="submit" class="bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded-lg flex items-center">
                    <i class="fas fa-check-double mr-2"></i> Mark All Paid (Finalized Only)
                </button>
            </form>
        }
        <a asp-action="ExportCsv" asp-route-year="@Model.Year" asp-route-month="@Model.Month" asp-route-branchId="@Model.BranchId"
           class="bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded-lg flex items-center">
            <i class="fas fa-download mr-2"></i> Export Data
        </a>
    </div>
</div>

<!-- Salary Detail Modal -->
<div id="salaryDetailModal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
    <div class="bg-white p-6 rounded-lg w-full max-w-2xl max-h-[90vh] overflow-y-auto">
        <div class="flex justify-between items-center mb-4">
            <h3 class="text-lg font-bold"><i class="fas fa-user-circle mr-2 text-blue-600"></i> Salary Details</h3>
            <button onclick="closeSalaryModal()" class="text-gray-500 hover:text-black text-xl">&times;</button>
        </div>
        <div id="salaryDetailContent" class="space-y-4"></div>
        <div class="text-right mt-4">
            <button class="bg-gray-300 px-3 py-1 rounded" onclick="closeSalaryModal()">Close</button>
        </div>
    </div>
</div>

<!-- Add Adjustment Modal -->
<div id="adjustSalaryModal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
    <div class="bg-white p-6 rounded-lg w-full max-w-md">
        <div class="flex justify-between items-center mb-4">
            <h3 class="text-lg font-bold"><i class="fas fa-plus-circle mr-2 text-orange-600"></i> Add Adjustment</h3>
            <button onclick="closeAdjustModal()" class="text-gray-500 hover:text-black text-xl">&times;</button>
        </div>
        <input type="hidden" id="adjustRecordId">
        <div class="space-y-4">
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Type</label>
                <select id="adjType" class="border rounded px-3 py-2 w-full">
                    <option value="Bonus">Bonus</option>
                    <option value="Deduction">Deduction</option>
                </select>
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Amount (Rs.)</label>
                <input id="adjAmount" type="number" min="1" step="100" class="border rounded px-3 py-2 w-full" placeholder="Enter amount">
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Reason</label>
                <input id="adjReason" type="text" class="border rounded px-3 py-2 w-full" placeholder="e.g., Performance bonus, Advance deduction">
            </div>
        </div>
        <div class="mt-4 flex justify-end space-x-2 border-t pt-4">
            <button class="bg-gray-300 px-4 py-2 rounded hover:bg-gray-400" onclick="closeAdjustModal()">Cancel</button>
            <button id="saveAdjustBtn" class="bg-orange-600 text-white px-4 py-2 rounded hover:bg-orange-700" onclick="saveAdjustment()">
                <i class="fas fa-save mr-1"></i> Add Adjustment
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function getToken() {
            return document.querySelector('[name="__RequestVerificationToken"]').value;
        }

        function viewSalaryDetail(id) {
            fetch(`/Salary/GetSalaryDetail/${id}`)
                .then(r => r.json())
                .then(data => {
                    if (!data.success) { ActionCard.error('Error', data.message); return; }
                    const content = document.getElementById('salaryDetailContent');

                    const pctClass = data.attendancePercentage >= 90 ? 'text-green-600' :
                                     data.attendancePercentage >= 70 ? 'text-yellow-600' : 'text-red-600';

                    const wfClass = data.status === 'Finalized' ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-800';
                    const pyClass = data.paymentStatus === 'Paid' ? 'bg-green-100 text-green-800' : 'bg-yellow-100 text-yellow-800';

                    let adjustmentRows = '';
                    if (data.adjustments && data.adjustments.length > 0) {
                        data.adjustments.forEach(a => {
                            const typeClass = a.type === 'Bonus' ? 'text-green-600' : 'text-red-600';
                            const sign = a.type === 'Bonus' ? '+' : '-';
                            adjustmentRows += `<tr class="border-t text-sm">
                                <td class="px-3 py-1 ${typeClass} font-medium">${a.type}</td>
                                <td class="px-3 py-1 text-right ${typeClass}">${sign} Rs. ${a.amount.toLocaleString()}</td>
                                <td class="px-3 py-1">${a.reason || '-'}</td>
                                <td class="px-3 py-1 text-xs text-gray-400">${a.createdBy} (${a.createdAt})</td>
                            </tr>`;
                        });
                    }

                    let historyRows = '';
                    if (data.history && data.history.length > 0) {
                        data.history.forEach(h => {
                            const monthNames = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
                            const sC = h.paymentStatus === 'Paid' ? 'bg-green-100 text-green-800' : 'bg-yellow-100 text-yellow-800';
                            const wC = h.status === 'Finalized' ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-800';
                            historyRows += `<tr class="border-t text-sm">
                                <td class="px-3 py-1">${monthNames[h.month-1]} ${h.year}</td>
                                <td class="px-3 py-1 text-right">Rs. ${h.baseSalary.toLocaleString()}</td>
                                <td class="px-3 py-1 text-right font-medium">Rs. ${h.finalSalary.toLocaleString()}</td>
                                <td class="px-3 py-1 text-center"><span class="px-2 py-0.5 text-xs rounded-full ${wC}">${h.status}</span></td>
                                <td class="px-3 py-1 text-center"><span class="px-2 py-0.5 text-xs rounded-full ${sC}">${h.paymentStatus}</span></td>
                            </tr>`;
                        });
                    }

                    content.innerHTML = `
                        <div class="grid grid-cols-2 gap-4 text-sm">
                            <p><b>Employee:</b> ${data.staffName}</p>
                            <p><b>Role:</b> ${data.role}</p>
                            <p><b>Branch:</b> ${data.branch}</p>
                            <p><b>Workflow:</b> <span class="px-2 py-0.5 text-xs rounded-full ${wfClass}">${data.status}</span>
                               <span class="px-2 py-0.5 text-xs rounded-full ${pyClass} ml-1">${data.paymentStatus}</span></p>
                        </div>
                        ${data.finalizedBy ? `<p class="text-xs text-gray-400 mt-1">Finalized by ${data.finalizedBy} on ${data.finalizedAt}</p>` : ''}

                        <!-- Formula Breakdown -->
                        <div class="mt-4 border rounded-lg overflow-hidden">
                            <div class="bg-gray-50 px-4 py-2 font-medium text-sm">Salary Formula Breakdown</div>
                            <table class="w-full text-sm">
                                <tbody>
                                    <tr class="border-t"><td class="px-4 py-2 text-gray-600">Base Salary</td><td class="px-4 py-2 text-right font-medium">Rs. ${data.baseSalary.toLocaleString()}</td></tr>
                                    ${data.overtimePay > 0 ? `<tr class="border-t"><td class="px-4 py-2 text-green-600">+ Overtime Pay (${data.overtimeHours}h)</td><td class="px-4 py-2 text-right text-green-600">+ Rs. ${data.overtimePay.toLocaleString()}</td></tr>` : ''}
                                    ${data.attendanceBonus > 0 ? `<tr class="border-t"><td class="px-4 py-2 text-green-600">+ Attendance Bonus (5%)</td><td class="px-4 py-2 text-right text-green-600">+ Rs. ${data.attendanceBonus.toLocaleString()}</td></tr>` : ''}
                                    <tr class="border-t bg-blue-50"><td class="px-4 py-2 font-medium">Gross Salary</td><td class="px-4 py-2 text-right font-bold">Rs. ${data.grossSalary.toLocaleString()}</td></tr>
                                    ${data.absenceDeduction > 0 ? `<tr class="border-t"><td class="px-4 py-2 text-red-600">- Absence Deduction (${data.daysAbsent} days)</td><td class="px-4 py-2 text-right text-red-600">- Rs. ${data.absenceDeduction.toLocaleString()}</td></tr>` : ''}
                                    ${data.halfDayDeduction > 0 ? `<tr class="border-t"><td class="px-4 py-2 text-red-600">- Half-Day Deduction (${data.daysHalfDay} days)</td><td class="px-4 py-2 text-right text-red-600">- Rs. ${data.halfDayDeduction.toLocaleString()}</td></tr>` : ''}
                                    ${data.latePenaltyDeduction > 0 ? `<tr class="border-t"><td class="px-4 py-2 text-red-600">- Late Penalty (${data.daysLate} lates)</td><td class="px-4 py-2 text-right text-red-600">- Rs. ${data.latePenaltyDeduction.toLocaleString()}</td></tr>` : ''}
                                    <tr class="border-t bg-red-50"><td class="px-4 py-2 font-medium">Total Deductions</td><td class="px-4 py-2 text-right font-bold text-red-600">- Rs. ${data.totalDeductions.toLocaleString()}</td></tr>
                                    <tr class="border-t-2 border-gray-400 bg-purple-50"><td class="px-4 py-2 font-bold text-lg">Net Salary</td><td class="px-4 py-2 text-right font-bold text-lg text-purple-700">Rs. ${data.finalSalary.toLocaleString()}</td></tr>
                                </tbody>
                            </table>
                        </div>

                        <!-- Attendance -->
                        <div class="mt-4">
                            <h4 class="font-medium text-sm text-gray-700 mb-1">Attendance Summary</h4>
                            <div class="grid grid-cols-5 gap-2 text-center text-xs">
                                <div class="bg-gray-50 p-2 rounded"><p class="text-gray-500">Present</p><p class="font-bold">${data.daysPresent}</p></div>
                                <div class="bg-gray-50 p-2 rounded"><p class="text-gray-500">Absent</p><p class="font-bold text-red-600">${data.daysAbsent}</p></div>
                                <div class="bg-gray-50 p-2 rounded"><p class="text-gray-500">Late</p><p class="font-bold text-yellow-600">${data.daysLate}</p></div>
                                <div class="bg-gray-50 p-2 rounded"><p class="text-gray-500">Half Day</p><p class="font-bold">${data.daysHalfDay}</p></div>
                                <div class="bg-gray-50 p-2 rounded"><p class="text-gray-500">Rate</p><p class="font-bold ${pctClass}">${data.attendancePercentage}%</p></div>
                            </div>
                        </div>

                        ${adjustmentRows ? `
                        <div class="mt-4">
                            <h4 class="font-medium text-sm text-gray-700 mb-2">Manual Adjustments</h4>
                            <table class="min-w-full border rounded text-xs">
                                <thead class="bg-gray-50"><tr>
                                    <th class="px-3 py-1 text-left">Type</th>
                                    <th class="px-3 py-1 text-right">Amount</th>
                                    <th class="px-3 py-1 text-left">Reason</th>
                                    <th class="px-3 py-1 text-left">By</th>
                                </tr></thead>
                                <tbody>${adjustmentRows}</tbody>
                            </table>
                        </div>` : ''}

                        ${historyRows ? `
                        <div class="mt-4">
                            <h4 class="font-medium text-sm text-gray-700 mb-2">Salary History</h4>
                            <table class="min-w-full border rounded text-xs">
                                <thead class="bg-gray-50"><tr>
                                    <th class="px-3 py-1 text-left">Period</th>
                                    <th class="px-3 py-1 text-right">Base</th>
                                    <th class="px-3 py-1 text-right">Net</th>
                                    <th class="px-3 py-1 text-center">Status</th>
                                    <th class="px-3 py-1 text-center">Payment</th>
                                </tr></thead>
                                <tbody>${historyRows}</tbody>
                            </table>
                        </div>` : ''}
                    `;
                    document.getElementById('salaryDetailModal').classList.remove('hidden');
                });
        }

        function closeSalaryModal() { document.getElementById('salaryDetailModal').classList.add('hidden'); }

        function openAdjustModal(id) {
            document.getElementById('adjustRecordId').value = id;
            document.getElementById('adjType').value = 'Bonus';
            document.getElementById('adjAmount').value = '';
            document.getElementById('adjReason').value = '';
            document.getElementById('adjustSalaryModal').classList.remove('hidden');
        }

        function closeAdjustModal() { document.getElementById('adjustSalaryModal').classList.add('hidden'); }

        function saveAdjustment() {
            const request = {
                recordId: parseInt(document.getElementById('adjustRecordId').value),
                type: document.getElementById('adjType').value,
                amount: parseFloat(document.getElementById('adjAmount').value) || 0,
                reason: document.getElementById('adjReason').value || null
            };

            if (request.amount <= 0) {
                ActionCard.error('Validation Error', 'Amount must be greater than 0.');
                return;
            }

            document.getElementById('saveAdjustBtn').disabled = true;
            document.getElementById('saveAdjustBtn').textContent = 'Saving...';

            fetch('/Salary/AddAdjustment', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getToken() },
                body: JSON.stringify(request)
            }).then(r => r.json()).then(res => {
                document.getElementById('saveAdjustBtn').disabled = false;
                document.getElementById('saveAdjustBtn').innerHTML = '<i class="fas fa-save mr-1"></i> Add Adjustment';
                if (res.success) {
                    closeAdjustModal();
                    ActionCard.success('Adjustment Added', res.message, { autoDismiss: 3000 });
                    setTimeout(() => location.reload(), 2000);
                } else {
                    ActionCard.error('Error', res.message);
                }
            }).catch(() => {
                document.getElementById('saveAdjustBtn').disabled = false;
                document.getElementById('saveAdjustBtn').innerHTML = '<i class="fas fa-save mr-1"></i> Add Adjustment';
            });
        }
    </script>
}
