@model Cafe.Models.ViewModels.SalaryIndexViewModel
@{
    ViewData["Title"] = "Salary Management";
    var monthName = new DateTime(Model.Year, Model.Month, 1).ToString("MMMM yyyy");
    var isOwner = Context.Session.GetString("UserRole") == "Owner";
}

<!-- Page Header -->
<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:2rem; flex-wrap:wrap; gap:1rem;">
    <div>
        <h1 class="page-title" style="margin:0;">Salary Management</h1>
        <p class="body-text" style="margin-top:0.25rem;">@monthName</p>
    </div>
    @if (isOwner || Context.Session.GetString("UserRole") == "BranchManager")
    {
        <a asp-action="Generate" class="btn btn-primary"><i class="fas fa-calculator" style="margin-right:0.5rem;"></i> Generate Salaries</a>
    }
</div>

<!-- Active Policy Info -->
@if (Model.ActivePolicy != null)
{
    <div class="card card-accent mb-6">
        <div class="card-body flex items-center justify-between flex-wrap gap-4">
            <div style="display:flex; align-items:center; gap:0.75rem;">
                <div class="kpi-icon" style="background:rgba(212,175,55,0.1); color:var(--accent); width:40px; height:40px; font-size:1rem;"><i class="fas fa-file-contract"></i></div>
                <div>
                    <p class="body-text" style="font-weight:600; margin:0;">Active Policy: @Model.ActivePolicy.Name</p>
                    <p class="caption" style="margin:0;">
                        Effective from @Model.ActivePolicy.EffectiveFrom.ToString("dd MMM yyyy")
                        @(Model.ActivePolicy.EffectiveTo.HasValue ? $"to {Model.ActivePolicy.EffectiveTo.Value:dd MMM yyyy}" : "(ongoing)")
                        &bull; OT: @(Model.ActivePolicy.OvertimeMultiplier)x &bull; Absence: @(Model.ActivePolicy.AbsenceDeductionFactor)x &bull; Bonus: @(Model.ActivePolicy.AttendanceBonusPercentage)%
                    </p>
                </div>
            </div>
            @if (isOwner)
            {
                <a asp-controller="SalaryPolicy" asp-action="Index" class="btn btn-ghost btn-sm"><i class="fas fa-cog" style="margin-right:0.25rem;"></i> Manage Policies</a>
            }
        </div>
    </div>
}
else if (isOwner)
{
    <div class="card card-accent-warning mb-6">
        <div class="card-body card-body-compact">
            <p class="caption" style="margin:0;"><i class="fas fa-exclamation-triangle" style="color:#f59e0b; margin-right:0.5rem;"></i> No active salary policy found. <a asp-controller="SalaryPolicy" asp-action="Create" style="color:var(--accent); text-decoration:underline; font-weight:600;">Create one</a> before generating salaries.</p>
        </div>
    </div>
}

<!-- KPI Cards -->
<div class="mb-6" style="display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:1.25rem;">
    <div class="kpi-card">
        <div class="kpi-icon" style="background:rgba(59,130,246,0.1); color:#3b82f6;"><i class="fas fa-money-bill-wave"></i></div>
        <div class="kpi-label">Total Base Salary</div>
        <div class="kpi-value">Rs. @Model.TotalBaseSalary.ToString("N0")</div>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon" style="background:rgba(34,197,94,0.1); color:#16a34a;"><i class="fas fa-gift"></i></div>
        <div class="kpi-label">Total Earnings</div>
        <div class="kpi-value" style="color:#16a34a;">+ Rs. @Model.TotalBonuses.ToString("N0")</div>
        <p class="caption" style="margin:0;">OT: @Model.TotalOvertimePay.ToString("N0") | Bonus: @Model.TotalAttendanceBonus.ToString("N0")</p>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon" style="background:rgba(239,68,68,0.1); color:#dc2626;"><i class="fas fa-minus-circle"></i></div>
        <div class="kpi-label">Total Deductions</div>
        <div class="kpi-value" style="color:#dc2626;">- Rs. @Model.TotalDeductions.ToString("N0")</div>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon" style="background:rgba(147,51,234,0.1); color:#9333ea;"><i class="fas fa-wallet"></i></div>
        <div class="kpi-label">Net Payable</div>
        <div class="kpi-value">Rs. @Model.TotalFinalSalary.ToString("N0")</div>
        <p class="caption" style="margin:0;">Draft: @Model.DraftCount | Finalized: @Model.FinalizedCount | Paid: @Model.Records.Count(r => r.Status == "Paid")</p>
    </div>
</div>

<!-- Filters -->
<div class="card mb-6">
    <div class="card-body">
        <form method="get" class="form-row" style="grid-template-columns:repeat(auto-fit,minmax(140px,1fr));">
            <div class="form-group">
                <label class="form-label">Branch</label>
                <select name="branchId" class="form-select">
                    <option value="">All Branches</option>
                    @foreach (var b in Model.Branches)
                    {
                        <option value="@b.Id" selected="@(Model.BranchId == b.Id)">@b.Name</option>
                    }
                </select>
            </div>
            <div class="form-group">
                <label class="form-label">Year</label>
                <select name="year" class="form-select">
                    @for (int y = DateTime.Now.Year; y >= DateTime.Now.Year - 3; y--)
                    {
                        <option value="@y" selected="@(y == Model.Year)">@y</option>
                    }
                </select>
            </div>
            <div class="form-group">
                <label class="form-label">Month</label>
                <select name="month" class="form-select">
                    @for (int m = 1; m <= 12; m++)
                    {
                        <option value="@m" selected="@(m == Model.Month)">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(m)</option>
                    }
                </select>
            </div>
            <div class="form-group">
                <label class="form-label">Workflow</label>
                <select name="workflowStatus" class="form-select">
                    <option value="">All</option>
                    <option value="Draft" selected="@(Model.WorkflowStatus == "Draft")">Draft</option>
                    <option value="Finalized" selected="@(Model.WorkflowStatus == "Finalized")">Finalized</option>
                    <option value="Paid" selected="@(Model.WorkflowStatus == "Paid")">Paid</option>
                </select>
            </div>
            <div class="form-group">
                <label class="form-label">Payment</label>
                <select name="paymentStatus" class="form-select">
                    <option value="">All</option>
                    <option value="Pending" selected="@(Model.PaymentStatus == "Pending")">Pending</option>
                    <option value="Paid" selected="@(Model.PaymentStatus == "Paid")">Paid</option>
                </select>
            </div>
            <div class="form-group" style="display:flex; align-items:flex-end;">
                <button type="submit" class="btn btn-primary" style="width:100%;"><i class="fas fa-filter" style="margin-right:0.5rem;"></i> Filter</button>
            </div>
        </form>
    </div>
</div>

<!-- Salary Table -->
<div class="card">
    <div class="card-body card-body-flush">
        <div style="overflow-x:auto;">
            <table class="premium-table">
                <thead>
                    <tr>
                        <th>Staff</th>
                        <th>Branch</th>
                        <th style="text-align:right;">Base</th>
                        <th style="text-align:center;">Days</th>
                        <th style="text-align:center;">Attend%</th>
                        <th style="text-align:right;">Earnings</th>
                        <th style="text-align:right;">Deductions</th>
                        <th style="text-align:right;">Net</th>
                        <th style="text-align:center;">Workflow</th>
                        <th style="text-align:center;">Payment</th>
                        <th style="text-align:center;">Pay Method</th>
                        <th style="text-align:center;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Records.Any())
                    {
                        <tr>
                            <td colspan="12">
                                <div class="empty-state">
                                    <i class="fas fa-wallet"></i>
                                    <h3>No salary records for this period</h3>
                                    <p>Generate salaries for @monthName to get started.</p>
                                    <a asp-action="Generate" class="btn btn-primary btn-sm"><i class="fas fa-calculator" style="margin-right:0.4rem;"></i> Generate Salaries</a>
                                </div>
                            </td>
                        </tr>
                    }
                    @foreach (var r in Model.Records)
                    {
                        var pctColor = r.AttendancePercentage >= 90 ? "#16a34a" :
                                       r.AttendancePercentage >= 70 ? "#ca8a04" : "#dc2626";
                        var wfBadge = r.Status == "Paid" ? "badge badge-accent" :
                                      r.Status == "Finalized" ? "badge badge-success" : "badge badge-neutral";
                        var pyBadge = r.PaymentStatus == "Paid" ? "badge badge-success" : "badge badge-warning";
                        <tr>
                            <td style="font-weight:500;">@r.Staff?.User?.Name</td>
                            <td class="caption">@r.Branch?.Name</td>
                            <td style="text-align:right;">Rs. @r.BaseSalary.ToString("N0")</td>
                            <td style="text-align:center;">@r.DaysPresent/@r.TotalWorkingDays</td>
                            <td style="text-align:center; font-weight:700; color:@pctColor;">@r.AttendancePercentage%</td>
                            <td style="text-align:right; color:#16a34a;">@(r.BonusAmount > 0 ? $"+{r.BonusAmount:N0}" : "-")</td>
                            <td style="text-align:right; color:#dc2626;">@(r.TotalDeductions > 0 ? $"-{r.TotalDeductions:N0}" : "-")</td>
                            <td style="text-align:right; font-weight:700;">Rs. @r.FinalSalary.ToString("N0")</td>
                            <td style="text-align:center;"><span class="@wfBadge">@r.Status</span></td>
                            <td style="text-align:center;"><span class="@pyBadge">@r.PaymentStatus</span></td>
                            <td style="text-align:center; font-size:0.75rem; color:var(--text-tertiary);">
                                @if (!string.IsNullOrEmpty(r.PaymentMethod))
                                {
                                    var pmIcon = r.PaymentMethod switch
                                    {
                                        "Cash"           => "fa-money-bill-wave",
                                        "Bank Transfer"  => "fa-university",
                                        "Mobile Wallet"  => "fa-mobile-alt",
                                        "Cheque"         => "fa-file-alt",
                                        _                => "fa-credit-card"
                                    };
                                    <span title="@r.PaymentReference"><i class="fas @pmIcon" style="margin-right:0.25rem;"></i>@r.PaymentMethod</span>
                                }
                                else { <span>—</span> }
                            </td>
                            <td style="text-align:center;">
                                <div style="display:flex; align-items:center; justify-content:center; gap:0.25rem;">
                                    <button onclick="viewSalaryDetail(@r.Id)" class="btn btn-ghost btn-sm" title="View Details"><i class="fas fa-file-alt"></i></button>
                                    <a asp-action="Payslip" asp-route-id="@r.Id" class="btn btn-ghost btn-sm" title="Payslip"><i class="fas fa-receipt"></i></a>
                                    @if (r.Status == "Draft" && r.PaymentStatus != "Paid")
                                    {
                                        <button onclick="openAdjustModal(@r.Id)" class="btn btn-ghost btn-sm" title="Add Adjustment" style="color:#ea580c;"><i class="fas fa-plus-circle"></i></button>
                                    }
                                    @if (isOwner && r.Status == "Draft")
                                    {
                                        <form asp-action="Finalize" asp-route-id="@r.Id" method="post" style="display:inline;" data-confirm="Finalize this salary record?">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-ghost btn-sm" title="Finalize" style="color:var(--accent);"><i class="fas fa-lock"></i></button>
                                        </form>
                                    }
                                    @if (isOwner && r.Status == "Finalized" && r.PaymentStatus != "Paid")
                                    {
                                        <form asp-action="Unlock" asp-route-id="@r.Id" method="post" style="display:inline;" data-confirm="Unlock this salary record for editing?">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-ghost btn-sm" title="Unlock" style="color:#f59e0b;"><i class="fas fa-unlock"></i></button>
                                        </form>
                                    }
                                    @if (r.Status == "Finalized" && r.PaymentStatus == "Pending")
                                    {
                                        <a asp-action="MarkPaid" asp-route-id="@r.Id" class="btn btn-ghost btn-sm" title="Mark Paid" style="color:#16a34a;">
                                            <i class="fas fa-check-circle"></i>
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Pagination -->
@if (Model.TotalPages > 1)
{
    <div style="display:flex; justify-content:center; align-items:center; margin-top:1.5rem; gap:0.5rem;">
        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <a asp-action="Index" asp-route-page="@i" asp-route-year="@Model.Year" asp-route-month="@Model.Month"
               asp-route-branchId="@Model.BranchId" asp-route-paymentStatus="@Model.PaymentStatus"
               asp-route-workflowStatus="@Model.WorkflowStatus"
               class="btn @(i == Model.CurrentPage ? "btn-primary" : "btn-secondary") btn-sm">
                @i
            </a>
        }
    </div>
}

<!-- Quick Actions -->
<div class="card card-dark mt-8 border-none">
    <div class="card-body">
        <h3 style="color:#fff; font-weight:600; margin-bottom:1rem;">Quick Actions</h3>
        <div style="display:flex; flex-wrap:wrap; gap:0.75rem;">
            @if (isOwner && Model.DraftCount > 0)
            {
                <form asp-action="FinalizeAll" method="post" style="display:inline;" data-confirm="Finalize all @Model.DraftCount draft salary records?">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="year" value="@Model.Year" />
                    <input type="hidden" name="month" value="@Model.Month" />
                    <input type="hidden" name="branchId" value="@Model.BranchId" />
                    <button type="submit" class="btn btn-primary"><i class="fas fa-lock" style="margin-right:0.5rem;"></i> Finalize All Draft (@Model.DraftCount)</button>
                </form>
            }
            @if (Model.FinalizedCount > 0 && Model.PendingCount > 0)
            {
                <form asp-action="MarkAllPaid" method="post" style="display:inline;" data-confirm="Mark all finalized pending salaries as paid?">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="year" value="@Model.Year" />
                    <input type="hidden" name="month" value="@Model.Month" />
                    <input type="hidden" name="branchId" value="@Model.BranchId" />
                    <button type="submit" class="btn btn-primary" style="background:#16a34a; border-color:#16a34a;"><i class="fas fa-check-double" style="margin-right:0.5rem;"></i> Mark All Paid</button>
                </form>
            }
            <a asp-action="ExportCsv" asp-route-year="@Model.Year" asp-route-month="@Model.Month" asp-route-branchId="@Model.BranchId"
               class="btn btn-secondary"><i class="fas fa-download" style="margin-right:0.5rem;"></i> Export Data</a>
        </div>
    </div>
</div>

<!-- Salary Detail Modal -->
<div id="salaryDetailModal" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.5); z-index:1000; align-items:center; justify-content:center;">
    <div class="card w-full max-w-[720px] max-h-[90vh] overflow-y-auto m-4">
        <div class="card-header flex justify-between items-center">
            <h3 class="m-0 font-semibold"><i class="fas fa-user-circle" style="margin-right:0.5rem; color:var(--accent);"></i> Salary Details</h3>
            <button onclick="closeSalaryModal()" style="background:none; border:none; font-size:1.5rem; cursor:pointer; color:var(--text-tertiary);">&times;</button>
        </div>
        <div class="card-body">
            <div id="salaryDetailContent"></div>
        </div>
        <div style="padding:1rem 1.5rem; border-top:1px solid var(--border-light); text-align:right;">
            <button class="btn btn-secondary btn-sm" onclick="closeSalaryModal()">Close</button>
        </div>
    </div>
</div>

<!-- Add Adjustment Modal -->
<div id="adjustSalaryModal" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.5); z-index:1000; align-items:center; justify-content:center;">
    <div class="card w-full max-w-[480px] m-4">
        <div class="card-header flex justify-between items-center">
            <h3 class="m-0 font-semibold"><i class="fas fa-plus-circle" style="margin-right:0.5rem; color:#ea580c;"></i> Add Adjustment</h3>
            <button onclick="closeAdjustModal()" style="background:none; border:none; font-size:1.5rem; cursor:pointer; color:var(--text-tertiary);">&times;</button>
        </div>
        <div class="card-body">
            <input type="hidden" id="adjustRecordId">
            <div class="form-group">
                <label class="form-label">Type</label>
                <select id="adjType" class="form-select">
                    <option value="Bonus">Bonus</option>
                    <option value="Deduction">Deduction</option>
                </select>
            </div>
            <div class="form-group">
                <label class="form-label">Amount (Rs.)</label>
                <input id="adjAmount" type="number" min="1" step="100" class="form-control" placeholder="Enter amount">
            </div>
            <div class="form-group">
                <label class="form-label">Reason</label>
                <input id="adjReason" type="text" class="form-control" placeholder="e.g., Performance bonus, Advance deduction">
            </div>
        </div>
        <div style="padding:1rem 1.5rem; border-top:1px solid var(--border-light); display:flex; justify-content:flex-end; gap:0.75rem;">
            <button class="btn btn-secondary" onclick="closeAdjustModal()">Cancel</button>
            <button id="saveAdjustBtn" class="btn btn-primary" style="background:#ea580c; border-color:#ea580c;" onclick="saveAdjustment()">
                <i class="fas fa-save" style="margin-right:0.5rem;"></i> Add Adjustment
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function getToken() {
            return document.querySelector('[name="__RequestVerificationToken"]').value;
        }

        function viewSalaryDetail(id) {
            fetch(`/Salary/GetSalaryDetail/${id}`)
                .then(r => r.json())
                .then(data => {
                    if (!data.success) { ActionCard.error('Error', data.message); return; }
                    const content = document.getElementById('salaryDetailContent');

                    const pctClass = data.attendancePercentage >= 90 ? 'text-green-600' :
                                     data.attendancePercentage >= 70 ? 'text-yellow-600' : 'text-red-600';
                    const wfClass = data.status === 'Paid' ? 'bg-purple-100 text-purple-800' :
                                     data.status === 'Finalized' ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-800';
                    const pyClass = data.paymentStatus === 'Paid' ? 'bg-green-100 text-green-800' : 'bg-yellow-100 text-yellow-800';

                    let adjustmentRows = '';
                    if (data.adjustments && data.adjustments.length > 0) {
                        data.adjustments.forEach(a => {
                            const typeClass = a.type === 'Bonus' ? 'text-green-600' : 'text-red-600';
                            const sign = a.type === 'Bonus' ? '+' : '-';
                            adjustmentRows += `<tr class="border-t text-sm">
                                <td class="px-3 py-1 ${typeClass} font-medium">${a.type}</td>
                                <td class="px-3 py-1 text-right ${typeClass}">${sign} Rs. ${a.amount.toLocaleString()}</td>
                                <td class="px-3 py-1">${a.reason || '-'}</td>
                                <td class="px-3 py-1 text-xs text-gray-400">${a.createdBy} (${a.createdAt})</td>
                            </tr>`;
                        });
                    }

                    let historyRows = '';
                    if (data.history && data.history.length > 0) {
                        data.history.forEach(h => {
                            const monthNames = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
                            const sC = h.paymentStatus === 'Paid' ? 'bg-green-100 text-green-800' : 'bg-yellow-100 text-yellow-800';
                            const wC = h.status === 'Paid' ? 'bg-purple-100 text-purple-800' :
                                       h.status === 'Finalized' ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-800';
                            historyRows += `<tr class="border-t text-sm">
                                <td class="px-3 py-1">${monthNames[h.month-1]} ${h.year}</td>
                                <td class="px-3 py-1 text-right">Rs. ${h.baseSalary.toLocaleString()}</td>
                                <td class="px-3 py-1 text-right font-medium">Rs. ${h.finalSalary.toLocaleString()}</td>
                                <td class="px-3 py-1 text-center"><span class="px-2 py-0.5 text-xs rounded-full ${wC}">${h.status}</span></td>
                                <td class="px-3 py-1 text-center"><span class="px-2 py-0.5 text-xs rounded-full ${sC}">${h.paymentStatus}</span></td>
                            </tr>`;
                        });
                    }

                    content.innerHTML = `
                        <div class="grid grid-cols-2 gap-4 text-sm">
                            <p><b>Employee:</b> ${data.staffName}</p>
                            <p><b>Role:</b> ${data.role}</p>
                            <p><b>Branch:</b> ${data.branch}</p>
                            <p><b>Policy:</b> ${data.policyName || 'Default'}</p>
                            <p><b>Workflow:</b> <span class="px-2 py-0.5 text-xs rounded-full ${wfClass}">${data.status}</span>
                               <span class="px-2 py-0.5 text-xs rounded-full ${pyClass} ml-1">${data.paymentStatus}</span></p>
                        </div>
                        ${data.finalizedBy ? `<p class="text-xs text-gray-400 mt-1">Finalized by ${data.finalizedBy} on ${data.finalizedAt}</p>` : ''}
                        <div class="mt-4 border rounded-lg overflow-hidden">
                            <div class="bg-gray-50 px-4 py-2 font-medium text-sm">Salary Formula Breakdown</div>
                            <table class="w-full text-sm">
                                <tbody>
                                    <tr class="border-t"><td class="px-4 py-2 text-gray-600">Base Salary</td><td class="px-4 py-2 text-right font-medium">Rs. ${data.baseSalary.toLocaleString()}</td></tr>
                                    ${data.overtimePay > 0 ? `<tr class="border-t"><td class="px-4 py-2 text-green-600">+ Overtime Pay (${data.overtimeHours}h)</td><td class="px-4 py-2 text-right text-green-600">+ Rs. ${data.overtimePay.toLocaleString()}</td></tr>` : ''}
                                    ${data.attendanceBonus > 0 ? `<tr class="border-t"><td class="px-4 py-2 text-green-600">+ Attendance Bonus (5%)</td><td class="px-4 py-2 text-right text-green-600">+ Rs. ${data.attendanceBonus.toLocaleString()}</td></tr>` : ''}
                                    <tr class="border-t bg-blue-50"><td class="px-4 py-2 font-medium">Gross Salary</td><td class="px-4 py-2 text-right font-bold">Rs. ${data.grossSalary.toLocaleString()}</td></tr>
                                    ${data.absenceDeduction > 0 ? `<tr class="border-t"><td class="px-4 py-2 text-red-600">- Absence (${data.daysAbsent} days)</td><td class="px-4 py-2 text-right text-red-600">- Rs. ${data.absenceDeduction.toLocaleString()}</td></tr>` : ''}
                                    ${data.halfDayDeduction > 0 ? `<tr class="border-t"><td class="px-4 py-2 text-red-600">- Half-Day (${data.daysHalfDay} days)</td><td class="px-4 py-2 text-right text-red-600">- Rs. ${data.halfDayDeduction.toLocaleString()}</td></tr>` : ''}
                                    ${data.latePenaltyDeduction > 0 ? `<tr class="border-t"><td class="px-4 py-2 text-red-600">- Late Penalty (${data.daysLate} lates)</td><td class="px-4 py-2 text-right text-red-600">- Rs. ${data.latePenaltyDeduction.toLocaleString()}</td></tr>` : ''}
                                    <tr class="border-t bg-red-50"><td class="px-4 py-2 font-medium">Total Deductions</td><td class="px-4 py-2 text-right font-bold text-red-600">- Rs. ${data.totalDeductions.toLocaleString()}</td></tr>
                                    <tr class="border-t-2 border-gray-400 bg-purple-50"><td class="px-4 py-2 font-bold text-lg">Net Salary</td><td class="px-4 py-2 text-right font-bold text-lg text-purple-700">Rs. ${data.finalSalary.toLocaleString()}</td></tr>
                                </tbody>
                            </table>
                        </div>
                        <div class="mt-4">
                            <h4 class="font-medium text-sm text-gray-700 mb-1">Attendance Summary</h4>
                            <div class="grid grid-cols-5 gap-2 text-center text-xs">
                                <div class="bg-gray-50 p-2 rounded"><p class="text-gray-500">Present</p><p class="font-bold">${data.daysPresent}</p></div>
                                <div class="bg-gray-50 p-2 rounded"><p class="text-gray-500">Absent</p><p class="font-bold text-red-600">${data.daysAbsent}</p></div>
                                <div class="bg-gray-50 p-2 rounded"><p class="text-gray-500">Late</p><p class="font-bold text-yellow-600">${data.daysLate}</p></div>
                                <div class="bg-gray-50 p-2 rounded"><p class="text-gray-500">Half Day</p><p class="font-bold">${data.daysHalfDay}</p></div>
                                <div class="bg-gray-50 p-2 rounded"><p class="text-gray-500">Rate</p><p class="font-bold ${pctClass}">${data.attendancePercentage}%</p></div>
                            </div>
                        </div>
                        ${adjustmentRows ? `
                        <div class="mt-4">
                            <h4 class="font-medium text-sm text-gray-700 mb-2">Manual Adjustments</h4>
                            <table class="min-w-full border rounded text-xs">
                                <thead class="bg-gray-50"><tr><th class="px-3 py-1 text-left">Type</th><th class="px-3 py-1 text-right">Amount</th><th class="px-3 py-1 text-left">Reason</th><th class="px-3 py-1 text-left">By</th></tr></thead>
                                <tbody>${adjustmentRows}</tbody>
                            </table>
                        </div>` : ''}
                        ${historyRows ? `
                        <div class="mt-4">
                            <h4 class="font-medium text-sm text-gray-700 mb-2">Salary History</h4>
                            <table class="min-w-full border rounded text-xs">
                                <thead class="bg-gray-50"><tr><th class="px-3 py-1 text-left">Period</th><th class="px-3 py-1 text-right">Base</th><th class="px-3 py-1 text-right">Net</th><th class="px-3 py-1 text-center">Status</th><th class="px-3 py-1 text-center">Payment</th></tr></thead>
                                <tbody>${historyRows}</tbody>
                            </table>
                        </div>` : ''}
                    `;
                    document.getElementById('salaryDetailModal').style.display = 'flex';
                });
        }

        function closeSalaryModal() { document.getElementById('salaryDetailModal').style.display = 'none'; }

        function openAdjustModal(id) {
            document.getElementById('adjustRecordId').value = id;
            document.getElementById('adjType').value = 'Bonus';
            document.getElementById('adjAmount').value = '';
            document.getElementById('adjReason').value = '';
            document.getElementById('adjustSalaryModal').style.display = 'flex';
        }

        function closeAdjustModal() { document.getElementById('adjustSalaryModal').style.display = 'none'; }

        function saveAdjustment() {
            const request = {
                recordId: parseInt(document.getElementById('adjustRecordId').value),
                type: document.getElementById('adjType').value,
                amount: parseFloat(document.getElementById('adjAmount').value) || 0,
                reason: document.getElementById('adjReason').value || null
            };
            if (request.amount <= 0) { ActionCard.error('Validation Error', 'Amount must be greater than 0.'); return; }
            document.getElementById('saveAdjustBtn').disabled = true;
            document.getElementById('saveAdjustBtn').textContent = 'Saving...';
            fetch('/Salary/AddAdjustment', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getToken() },
                body: JSON.stringify(request)
            }).then(r => r.json()).then(res => {
                document.getElementById('saveAdjustBtn').disabled = false;
                document.getElementById('saveAdjustBtn').innerHTML = '<i class="fas fa-save" style="margin-right:0.5rem;"></i> Add Adjustment';
                if (res.success) {
                    closeAdjustModal();
                    ActionCard.success('Adjustment Added', res.message, { autoDismiss: 3000 });
                    setTimeout(() => location.reload(), 2000);
                } else { ActionCard.error('Error', res.message); }
            }).catch(() => {
                document.getElementById('saveAdjustBtn').disabled = false;
                document.getElementById('saveAdjustBtn').innerHTML = '<i class="fas fa-save" style="margin-right:0.5rem;"></i> Add Adjustment';
            });
        }
    </script>
}
