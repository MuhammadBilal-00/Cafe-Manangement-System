@model Cafe.Models.ViewModels.BaseSalaryHistoryViewModel
@{
    ViewData["Title"] = "Base Salary History";
}

<div style="max-width:800px; margin:0 auto;">
    <!-- Header -->
    <div style="display:flex; align-items:center; margin-bottom:1.5rem; gap:1rem;">
        <a asp-controller="Salary" asp-action="Index" class="btn btn-ghost btn-sm"><i class="fas fa-arrow-left"></i></a>
        <h1 class="page-title" style="margin:0;">Base Salary History</h1>
    </div>

    <!-- Staff Info -->
    <div class="card" style="margin-bottom:1.5rem;">
        <div class="card-body">
            <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(160px,1fr)); gap:1rem;">
                <div><span class="caption">Employee</span><p class="body-text" style="font-weight:600; margin:0.25rem 0 0;">@Model.Staff.User?.Name</p></div>
                <div><span class="caption">Role</span><p class="body-text" style="font-weight:600; margin:0.25rem 0 0;">@Model.Staff.StaffRole?.RoleName</p></div>
                <div><span class="caption">Branch</span><p class="body-text" style="font-weight:600; margin:0.25rem 0 0;">@Model.Staff.Branch?.Name</p></div>
                <div><span class="caption">Current Base Salary</span><p style="font-size:1.25rem; font-weight:700; margin:0.25rem 0 0; color:var(--accent);">Rs. @Model.CurrentBaseSalary.ToString("N0")</p></div>
            </div>
        </div>
    </div>

    <!-- Update Base Salary -->
    <div class="card" style="margin-bottom:1.5rem;">
        <div class="card-header"><h3 style="margin:0; font-weight:600;">Update Base Salary</h3></div>
        <div class="card-body">
            <div style="display:flex; gap:1rem; align-items:flex-end; flex-wrap:wrap;">
                <div style="flex:1; min-width:180px;">
                    <label class="form-label">New Base Salary (Rs.)</label>
                    <input id="newBaseSalary" type="number" min="1" step="500" class="form-control" placeholder="Enter new base salary" value="@Model.CurrentBaseSalary" />
                </div>
                <div style="flex:1; min-width:180px;">
                    <label class="form-label">Reason</label>
                    <input id="changeReason" type="text" class="form-control" placeholder="e.g., Annual increment, Promotion" />
                </div>
                <button id="updateSalaryBtn" onclick="updateBaseSalary()" class="btn btn-primary">
                    <i class="fas fa-save" style="margin-right:0.5rem;"></i> Update
                </button>
            </div>
        </div>
    </div>

    <!-- History Table -->
    <div class="card">
        <div class="card-header"><h3 style="margin:0; font-weight:600;">Salary History</h3></div>
        <div class="card-body" style="padding:0;">
            <div style="overflow-x:auto;">
                <table class="premium-table">
                    <thead>
                        <tr>
                            <th>Base Salary</th>
                            <th>Payment Type</th>
                            <th>From</th>
                            <th>To</th>
                            <th>Reason</th>
                            <th style="text-align:center;">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.History.Any())
                        {
                            <tr>
                                <td colspan="6">
                                    <div class="empty-state">
                                        <i class="fas fa-history"></i>
                                        <h3>No salary history</h3>
                                        <p>No salary history records found.</p>
                                    </div>
                                </td>
                            </tr>
                        }
                        @foreach (var h in Model.History)
                        {
                            <tr style="@(h.IsActive ? "background:rgba(34,197,94,0.04);" : "")">
                                <td style="font-weight:700;">Rs. @h.BaseSalary.ToString("N0")</td>
                                <td>@h.PaymentType</td>
                                <td>@h.EffectiveFromDate.ToString("dd MMM yyyy")</td>
                                <td>@(h.EffectiveToDate?.ToString("dd MMM yyyy") ?? "Current")</td>
                                <td class="caption">@(h.ChangeReason ?? "-")</td>
                                <td style="text-align:center;">
                                    <span class="badge @(h.IsActive ? "badge-success" : "badge-neutral")">
                                        @(h.IsActive ? "Active" : "Closed")
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function updateBaseSalary() {
            const newSalary = parseFloat(document.getElementById('newBaseSalary').value) || 0;
            const reason = document.getElementById('changeReason').value || null;
            if (newSalary <= 0) {
                ActionCard.error('Validation', 'Please enter a valid salary amount.');
                return;
            }
            if (!confirm(`Update base salary to Rs. ${newSalary.toLocaleString()}?`)) return;
            const btn = document.getElementById('updateSalaryBtn');
            btn.disabled = true;
            btn.textContent = 'Updating...';
            const token = document.querySelector('[name="__RequestVerificationToken"]')?.value ||
                          document.querySelector('meta[name="RequestVerificationToken"]')?.content;
            fetch('@Url.Action("UpdateBaseSalary", "Salary")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify({ staffId: @Model.Staff.Id, newBaseSalary: newSalary, reason: reason })
            }).then(r => r.json()).then(res => {
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-save" style="margin-right:0.5rem;"></i> Update';
                if (res.success) {
                    ActionCard.success('Updated', res.message, { autoDismiss: 3000 });
                    setTimeout(() => location.reload(), 2000);
                } else {
                    ActionCard.error('Error', res.message);
                }
            }).catch(() => {
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-save" style="margin-right:0.5rem;"></i> Update';
            });
        }
    </script>
}
