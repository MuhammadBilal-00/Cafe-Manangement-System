@model Cafe.Models.ViewModels.BaseSalaryHistoryViewModel
@{
    ViewData["Title"] = "Base Salary History";
}

<div class="max-w-3xl mx-auto">
    <div class="flex items-center mb-6">
        <a asp-controller="Salary" asp-action="Index" class="text-gray-500 hover:text-gray-700 mr-4">
            <i class="fas fa-arrow-left text-xl"></i>
        </a>
        <h1 class="text-2xl font-bold text-gray-800">Base Salary History</h1>
    </div>

    <!-- Staff Info -->
    <div class="bg-white rounded-lg shadow-md p-6 mb-6">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
            <div>
                <p class="text-sm text-gray-500">Employee</p>
                <p class="font-medium text-gray-800">@Model.Staff.User?.Name</p>
            </div>
            <div>
                <p class="text-sm text-gray-500">Role</p>
                <p class="font-medium text-gray-800">@Model.Staff.StaffRole?.RoleName</p>
            </div>
            <div>
                <p class="text-sm text-gray-500">Branch</p>
                <p class="font-medium text-gray-800">@Model.Staff.Branch?.Name</p>
            </div>
            <div>
                <p class="text-sm text-gray-500">Current Base Salary</p>
                <p class="font-bold text-lg text-blue-600">Rs. @Model.CurrentBaseSalary.ToString("N0")</p>
            </div>
        </div>
    </div>

    <!-- Update Base Salary -->
    <div class="bg-white rounded-lg shadow-md p-6 mb-6">
        <h3 class="text-lg font-medium text-gray-700 mb-4">Update Base Salary</h3>
        <div class="flex gap-4 items-end">
            <div class="flex-1">
                <label class="block text-sm font-medium text-gray-700 mb-1">New Base Salary (Rs.)</label>
                <input id="newBaseSalary" type="number" min="1" step="500" class="w-full border rounded-lg px-3 py-2"
                       placeholder="Enter new base salary" value="@Model.CurrentBaseSalary" />
            </div>
            <div class="flex-1">
                <label class="block text-sm font-medium text-gray-700 mb-1">Reason</label>
                <input id="changeReason" type="text" class="w-full border rounded-lg px-3 py-2"
                       placeholder="e.g., Annual increment, Promotion" />
            </div>
            <button id="updateSalaryBtn" onclick="updateBaseSalary()" class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-2 rounded-lg">
                <i class="fas fa-save mr-1"></i> Update
            </button>
        </div>
    </div>

    <!-- History Table -->
    <div class="bg-white rounded-lg shadow-md overflow-hidden">
        <div class="p-4 border-b bg-gray-50">
            <h3 class="font-medium text-gray-700">Salary History</h3>
        </div>
        <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
                <tr>
                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Base Salary</th>
                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Payment Type</th>
                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">From</th>
                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">To</th>
                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Reason</th>
                    <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase">Status</th>
                </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
                @if (!Model.History.Any())
                {
                    <tr>
                        <td colspan="6" class="px-6 py-8 text-center text-gray-500">
                            No salary history records found.
                        </td>
                    </tr>
                }
                @foreach (var h in Model.History)
                {
                    var statusClass = h.IsActive ? "bg-green-100 text-green-800" : "bg-gray-100 text-gray-600";
                    <tr class="hover:bg-gray-50 @(h.IsActive ? "bg-green-50" : "")">
                        <td class="px-4 py-3 text-sm font-bold">Rs. @h.BaseSalary.ToString("N0")</td>
                        <td class="px-4 py-3 text-sm">@h.PaymentType</td>
                        <td class="px-4 py-3 text-sm">@h.EffectiveFromDate.ToString("dd MMM yyyy")</td>
                        <td class="px-4 py-3 text-sm">@(h.EffectiveToDate?.ToString("dd MMM yyyy") ?? "Current")</td>
                        <td class="px-4 py-3 text-sm text-gray-600">@(h.ChangeReason ?? "-")</td>
                        <td class="px-4 py-3 text-center">
                            <span class="px-2 py-1 text-xs font-medium rounded-full @statusClass">
                                @(h.IsActive ? "Active" : "Closed")
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        function updateBaseSalary() {
            const newSalary = parseFloat(document.getElementById('newBaseSalary').value) || 0;
            const reason = document.getElementById('changeReason').value || null;

            if (newSalary <= 0) {
                ActionCard.error('Validation', 'Please enter a valid salary amount.');
                return;
            }

            if (!confirm(`Update base salary to Rs. ${newSalary.toLocaleString()}?`)) return;

            const btn = document.getElementById('updateSalaryBtn');
            btn.disabled = true;
            btn.textContent = 'Updating...';

            const token = document.querySelector('[name="__RequestVerificationToken"]')?.value ||
                          document.querySelector('meta[name="RequestVerificationToken"]')?.content;

            fetch('@Url.Action("UpdateBaseSalary", "Salary")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify({
                    staffId: @Model.Staff.Id,
                    newBaseSalary: newSalary,
                    reason: reason
                })
            }).then(r => r.json()).then(res => {
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-save mr-1"></i> Update';
                if (res.success) {
                    ActionCard.success('Updated', res.message, { autoDismiss: 3000 });
                    setTimeout(() => location.reload(), 2000);
                } else {
                    ActionCard.error('Error', res.message);
                }
            }).catch(() => {
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-save mr-1"></i> Update';
            });
        }
    </script>
}
