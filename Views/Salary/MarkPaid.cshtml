@model Cafe.Models.SalaryRecord
@{
    ViewData["Title"] = "Mark Salary as Paid";
    var monthName = new DateTime(Model.Year, Model.Month, 1).ToString("MMMM yyyy");
}

<div class="max-w-[640px] mx-auto">
    <div style="display:flex; align-items:center; margin-bottom:1.5rem; gap:1rem;">
        <a asp-action="Index" class="btn btn-ghost btn-sm"><i class="fas fa-arrow-left"></i></a>
        <h1 class="page-title" style="margin:0;">Mark as Paid</h1>
    </div>

    <!-- Summary card -->
    <div class="card card-accent mb-6">
        <div class="card-body">
            <div style="display:flex; justify-content:space-between; flex-wrap:wrap; gap:0.5rem;">
                <div>
                    <p style="font-weight:700; font-size:1rem; margin:0;">@(Model.Staff?.User?.Name ?? $"Staff #{Model.StaffId}")</p>
                    <p class="caption" style="margin:0;">@(Model.Staff?.StaffRole?.RoleName) &bull; @(Model.Branch?.Name) &bull; @monthName</p>
                </div>
                <div style="text-align:right;">
                    <p style="font-size:1.5rem; font-weight:700; color:var(--accent); margin:0;">Rs. @Model.FinalSalary.ToString("N0")</p>
                    <p class="caption" style="margin:0;">Net Payable</p>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <form asp-action="MarkPaid" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />

                <div class="form-group">
                    <label class="form-label">Payment Method *</label>
                    <div style="display:grid; grid-template-columns:repeat(2,1fr); gap:0.75rem;">
                        @foreach (var method in new[] { ("Cash", "fa-money-bill-wave"), ("Bank Transfer", "fa-university"), ("Mobile Wallet", "fa-mobile-alt"), ("Cheque", "fa-file-alt") })
                        {
                            <label style="cursor:pointer; border:2px solid var(--border-light); border-radius:0.5rem; padding:0.75rem; display:flex; align-items:center; gap:0.75rem; transition:border-color 0.2s;" class="payment-method-option">
                                <input type="radio" name="paymentMethod" value="@method.Item1" required style="accent-color:var(--accent);" onchange="highlightMethod(this)" />
                                <i class="fas @method.Item2" style="color:var(--accent); font-size:1rem;"></i>
                                <span style="font-weight:500; font-size:0.875rem;">@method.Item1</span>
                            </label>
                        }
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label">Payment Reference</label>
                    <input type="text" name="paymentReference" class="form-control" placeholder="Transaction ID / Cheque No. / Account" />
                    <p class="caption" style="margin-top:0.3rem;">Optional — for bank transfers, cheque numbers, mobile wallet transaction IDs</p>
                </div>

                <div class="form-group">
                    <label class="form-label">Notes</label>
                    <textarea name="paymentNotes" rows="2" class="form-control" placeholder="Additional notes about this payment..."></textarea>
                </div>

                <div class="divider"></div>
                <div style="display:flex; justify-content:flex-end; gap:0.75rem;">
                    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary"><i class="fas fa-check" style="margin-right:0.5rem;"></i> Confirm Payment</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function highlightMethod(radio) {
        document.querySelectorAll('.payment-method-option').forEach(el => {
            el.style.borderColor = 'var(--border-light)';
            el.style.background = '';
        });
        radio.closest('.payment-method-option').style.borderColor = 'var(--accent)';
        radio.closest('.payment-method-option').style.background = 'rgba(212,175,55,0.05)';
    }
</script>
