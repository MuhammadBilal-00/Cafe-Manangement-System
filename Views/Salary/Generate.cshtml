@model Cafe.Models.ViewModels.SalaryGenerateViewModel
@{
    ViewData["Title"] = "Generate Salaries";
}

<div class="max-w-lg mx-auto">
    <div class="flex items-center mb-6">
        <a asp-action="Index" class="text-gray-500 hover:text-gray-700 mr-4">
            <i class="fas fa-arrow-left text-xl"></i>
        </a>
        <h1 class="text-2xl font-bold text-gray-800">Generate Monthly Salaries</h1>
    </div>

    <div class="bg-white rounded-lg shadow-md p-6">
        <div class="mb-6 p-4 bg-amber-50 rounded-lg border border-amber-200">
            <p class="text-sm text-amber-800">
                <i class="fas fa-info-circle mr-1"></i>
                This will calculate salaries based on attendance records for the selected period.
                Already-generated records will not be overwritten.
            </p>
        </div>

        <form asp-action="Generate" method="post">
            @Html.AntiForgeryToken()

            <div class="space-y-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Year *</label>
                    <select name="Year" class="w-full border rounded-lg px-3 py-2" required>
                        @for (int y = DateTime.Now.Year; y >= DateTime.Now.Year - 3; y--)
                        {
                            <option value="@y" selected="@(y == Model.Year)">@y</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Month *</label>
                    <select name="Month" class="w-full border rounded-lg px-3 py-2" required>
                        @for (int m = 1; m <= 12; m++)
                        {
                            <option value="@m" selected="@(m == Model.Month)">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(m)</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Branch (optional)</label>
                    <select name="BranchId" class="w-full border rounded-lg px-3 py-2">
                        <option value="">All Branches</option>
                        @foreach (var b in Model.Branches)
                        {
                            <option value="@b.Id">@b.Name</option>
                        }
                    </select>
                </div>
            </div>

            <div class="mt-8">
                <button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-lg text-lg font-medium"
                        onclick="return confirm('Generate salary records for the selected period?')">
                    <i class="fas fa-calculator mr-2"></i> Generate Salaries
                </button>
            </div>
        </form>
    </div>
</div>
