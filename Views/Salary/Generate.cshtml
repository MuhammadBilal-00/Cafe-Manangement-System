@model Cafe.Models.ViewModels.SalaryGenerateViewModel
@{
    ViewData["Title"] = "Generate Salaries";
}

<div class="max-w-[960px] mx-auto">
    <!-- Header -->
    <div style="display:flex; align-items:center; margin-bottom:1.5rem; gap:1rem;">
        <a asp-action="Index" class="btn btn-ghost btn-sm"><i class="fas fa-arrow-left"></i></a>
        <h1 class="page-title" style="margin:0;">Generate Monthly Salaries</h1>
    </div>

    <!-- Active Policy Info -->
    @if (Model.ActivePolicy != null)
    {
        <div class="card card-accent mb-6">
            <div class="card-body flex items-center gap-3 card-body-compact">
                <div class="kpi-icon" style="background:var(--accent-light); color:var(--accent); width:36px; height:36px; font-size:0.9rem;"><i class="fas fa-file-contract"></i></div>
                <div>
                    <p class="body-text" style="font-weight:600; margin:0;">Policy: @Model.ActivePolicy.Name</p>
                    <p class="caption" style="margin:0;">
                        OT: @(Model.ActivePolicy.OvertimeMultiplier)x | Absence: @(Model.ActivePolicy.AbsenceDeductionFactor)x |
                        Late: Every @(Model.ActivePolicy.LatePenaltyThreshold) = @(Model.ActivePolicy.LatePenaltyFactor)x |
                        Bonus: @(Model.ActivePolicy.AttendanceBonusPercentage)%
                    </p>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="card card-accent-danger mb-6">
            <div class="card-body card-body-compact">
                <p class="caption" style="margin:0; color:var(--danger);"><i class="fas fa-exclamation-triangle" style="margin-right:0.5rem;"></i> No active salary policy. Salary generation will fail. Please create a policy first.</p>
            </div>
        </div>
    }

    <div class="card">
        <div class="card-body">
            <!-- Info -->
            <div style="background:var(--bg-body); border-radius:var(--radius-card); padding:1rem; margin-bottom:1.5rem;">
                <p class="caption" style="margin:0;">
                    <i class="fas fa-info-circle" style="color:var(--accent); margin-right:0.5rem;"></i>
                    Use <strong>Preview</strong> to see calculated salaries without saving. When satisfied, click <strong>Generate</strong> to commit. Already-generated records will not be overwritten.
                </p>
            </div>

            <form id="salaryForm" method="post">
                @Html.AntiForgeryToken()

                <div style="display:grid; grid-template-columns:repeat(3,1fr); gap:1.25rem;">
                    <div class="form-group">
                        <label class="form-label">Year *</label>
                        <select name="Year" class="form-select" required>
                            @for (int y = DateTime.Now.Year; y >= DateTime.Now.Year - 3; y--)
                            {
                                <option value="@y" selected="@(y == Model.Year)">@y</option>
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Month *</label>
                        <select name="Month" class="form-select" required>
                            @for (int m = 1; m <= 12; m++)
                            {
                                <option value="@m" selected="@(m == Model.Month)">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(m)</option>
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Branch</label>
                        <select name="BranchId" class="form-select">
                            <option value="">All Branches</option>
                            @foreach (var b in Model.Branches)
                            {
                                <option value="@b.Id" selected="@(Model.BranchId == b.Id)">@b.Name</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="divider"></div>

                <div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem;">
                    <button type="submit" formaction="@Url.Action("Preview")" class="btn btn-secondary" style="padding:0.875rem; font-size:1rem;">
                        <i class="fas fa-eye" style="margin-right:0.5rem;"></i> Preview
                    </button>
                    <button type="submit" formaction="@Url.Action("Generate")" class="btn btn-primary" style="padding:0.875rem; font-size:1rem;"
                            onclick="return confirm('Generate and save salary records for the selected period?');">
                        <i class="fas fa-calculator" style="margin-right:0.5rem;"></i> Generate & Save
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Preview Results -->
    @if (Model.IsPreview && Model.PreviewRecords != null && Model.PreviewRecords.Any())
    {
        <div class="card mt-6">
            <div class="card-header bg-[rgba(212,175,55,0.08)]">
                <h3 style="margin:0; font-weight:600; color:var(--accent);">
                    <i class="fas fa-eye" style="margin-right:0.5rem;"></i> Preview: @Model.PreviewRecords.Count salary record(s) for
                    @(new DateTime(Model.Year, Model.Month, 1).ToString("MMMM yyyy"))
                </h3>
                <p class="caption" style="margin:0.25rem 0 0;">These are not yet saved. Click "Generate & Save" above to commit.</p>
            </div>
            <div class="card-body card-body-flush">
                <div style="overflow-x:auto;">
                    <table class="premium-table">
                        <thead>
                            <tr>
                                <th>Staff</th>
                                <th style="text-align:right;">Base</th>
                                <th style="text-align:center;">Days</th>
                                <th style="text-align:center;">Attend%</th>
                                <th style="text-align:right;">OT Pay</th>
                                <th style="text-align:right;">Bonus</th>
                                <th style="text-align:right;">Deductions</th>
                                <th style="text-align:right;">Net Salary</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                decimal totalNet = 0, totalBase = 0;
                            }
                            @foreach (var p in Model.PreviewRecords)
                            {
                                totalNet += p.FinalSalary;
                                totalBase += p.BaseSalary;
                                var pctColor = p.AttendancePercentage >= 90 ? "var(--success)" :
                                               p.AttendancePercentage >= 70 ? "#ca8a04" : "var(--danger)";
                                <tr>
                                    <td style="font-weight:500;">@(p.Staff?.User?.Name ?? "Staff #" + p.StaffId)</td>
                                    <td style="text-align:right;">Rs. @p.BaseSalary.ToString("N0")</td>
                                    <td style="text-align:center;">@p.DaysPresent/@p.TotalWorkingDays</td>
                                    <td style="text-align:center; font-weight:700; color:@pctColor;">@p.AttendancePercentage%</td>
                                    <td style="text-align:right; color:var(--info);">@(p.OvertimePay > 0 ? $"+{p.OvertimePay:N0}" : "-")</td>
                                    <td style="text-align:right; color:var(--success);">@(p.AttendanceBonus > 0 ? $"+{p.AttendanceBonus:N0}" : "-")</td>
                                    <td style="text-align:right; color:var(--danger);">@(p.TotalDeductions > 0 ? $"-{p.TotalDeductions:N0}" : "-")</td>
                                    <td style="text-align:right; font-weight:700;">Rs. @p.FinalSalary.ToString("N0")</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr style="background:var(--bg-body); font-weight:700;">
                                <td>Total (@Model.PreviewRecords.Count staff)</td>
                                <td style="text-align:right;">Rs. @totalBase.ToString("N0")</td>
                                <td colspan="5"></td>
                                <td style="text-align:right; color:#9333ea;">Rs. @totalNet.ToString("N0")</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    }
    else if (Model.IsPreview)
    {
        <div class="card mt-6">
            <div class="card-body">
                <div class="empty-state">
                    <i class="fas fa-info-circle"></i>
                    <h3>No staff found</h3>
                    <p>No staff found for the selected period/branch, or all salaries are already generated.</p>
                </div>
            </div>
        </div>
    }
</div>
