@model IEnumerable<Cafe.Models.MenuItem>
@{
    ViewData["Title"] = "Menu Management";
    var branches = ViewBag.Branches as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> ?? new();
    var categories = ViewBag.Categories as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> ?? new();
    var selectedBranch = ViewBag.SelectedBranch as int?;
    var selectedCategory = ViewBag.SelectedCategory as int?;
    var searchTerm = ViewBag.Search as string ?? "";
    var dietaryFilter = ViewBag.DietaryFilter as string ?? "";
    var showInactive = (bool)(ViewBag.ShowInactive ?? false);

    var totalItems = Model.Count();
    var availableCount = Model.Count(m => m.Availability);
    var unavailableCount = totalItems - availableCount;
    var avgPrice = totalItems > 0 ? Model.Average(m => m.Price) : 0;
    var categoryCount = Model.Select(m => m.CategoryId).Distinct().Count();
}

<!-- Page Header -->
<div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:1rem;margin-bottom:2rem;">
    <div>
        <h1 class="page-title" style="margin:0;">Menu Management</h1>
        <p class="body-text" style="margin-top:0.25rem;">Manage your restaurant's menu items across all branches.</p>
    </div>
    <div style="display:flex;gap:0.5rem;">
        @if (Context.Session.GetString("UserRole") == "Owner")
        {
            <a asp-controller="MenuItem" asp-action="ExportCsv" class="btn btn-secondary btn-sm">
                <i class="fas fa-download"></i> Export
            </a>
        }
        <a asp-controller="Menu" asp-action="Create" class="btn btn-primary btn-sm">
            <i class="fas fa-plus"></i> New Item
        </a>
    </div>
</div>

<!-- KPI Cards -->
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:1rem;margin-bottom:1.5rem;">
    <div class="kpi-card">
        <div class="kpi-icon" style="background:#ede9fe;color:#7c3aed;"><i class="fas fa-utensils"></i></div>
        <div class="kpi-label">Total Items</div>
        <div class="kpi-value">@totalItems</div>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon" style="background:#dcfce7;color:var(--success);"><i class="fas fa-check-circle"></i></div>
        <div class="kpi-label">Available</div>
        <div class="kpi-value">@availableCount</div>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon" style="background:#fee2e2;color:var(--danger);"><i class="fas fa-times-circle"></i></div>
        <div class="kpi-label">Unavailable</div>
        <div class="kpi-value">@unavailableCount</div>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon" style="background:var(--accent-light);color:var(--accent);"><i class="fas fa-dollar-sign"></i></div>
        <div class="kpi-label">Avg. Price</div>
        <div class="kpi-value">$@avgPrice.ToString("F2")</div>
    </div>
</div>

<!-- Filters -->
<form method="get" class="card mb-6">
    <div class="card-body flex flex-wrap gap-4 items-end">
        <div class="form-group" style="flex:1;min-width:180px;margin:0;">
            <label class="form-label">Search</label>
            <input type="text" name="search" value="@searchTerm" placeholder="Name, description, tags..." class="form-control" />
        </div>
        <div class="form-group" style="min-width:150px;margin:0;">
            <label class="form-label">Branch</label>
            <select name="branchId" class="form-select">
                <option value="">All Branches</option>
                @foreach (var b in branches)
                {
                    <option value="@b.Value" selected="@(selectedBranch?.ToString() == b.Value)">@b.Text</option>
                }
            </select>
        </div>
        <div class="form-group" style="min-width:150px;margin:0;">
            <label class="form-label">Category</label>
            <select name="categoryId" class="form-select">
                <option value="">All Categories</option>
                @foreach (var c in categories)
                {
                    <option value="@c.Value" selected="@(selectedCategory?.ToString() == c.Value)">@c.Text</option>
                }
            </select>
        </div>
        <div class="form-group" style="min-width:140px;margin:0;">
            <label class="form-label">Dietary</label>
            <select name="dietaryFilter" class="form-select">
                <option value="">All</option>
                <option value="vegetarian" selected="@(dietaryFilter == "vegetarian")">Vegetarian</option>
                <option value="vegan" selected="@(dietaryFilter == "vegan")">Vegan</option>
                <option value="glutenfree" selected="@(dietaryFilter == "glutenfree")">Gluten-Free</option>
                <option value="dairyfree" selected="@(dietaryFilter == "dairyfree")">Dairy-Free</option>
                <option value="spicy" selected="@(dietaryFilter == "spicy")">Spicy</option>
            </select>
        </div>
        <div style="display:flex;align-items:center;gap:0.5rem;margin-bottom:0.1rem;">
            <label style="display:flex;align-items:center;gap:0.4rem;font-size:0.8rem;color:var(--text-secondary);cursor:pointer;">
                <input type="checkbox" name="showInactive" value="true" @(showInactive ? "checked" : "") style="accent-color:var(--accent);width:16px;height:16px;" />
                Show Inactive
            </label>
        </div>
        <button type="submit" class="btn btn-primary btn-sm"><i class="fas fa-search"></i> Filter</button>
        <a asp-action="Index" class="btn btn-ghost btn-sm">Clear</a>
    </div>
</form>

<!-- View Tabs -->
<div style="display:flex;gap:0.4rem;margin-bottom:1.5rem;">
    <button class="view-tab active" data-view="grid"><i class="fas fa-th-large"></i> Grid</button>
    <button class="view-tab" data-view="list"><i class="fas fa-list"></i> List</button>
</div>

<!-- Grid View -->
<div id="grid-view" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:1rem;margin-bottom:2rem;">
    @foreach (var item in Model)
    {
        <div class="card overflow-hidden transition-all duration-300 ease-out hover:-translate-y-0.5 hover:shadow-[0_8px_24px_rgba(0,0,0,0.1)]">
            <!-- Image Header -->
            <div style="height:140px;overflow:hidden;position:relative;background:linear-gradient(135deg,var(--sidebar-bg),#2d3e50);">
                @if (!string.IsNullOrEmpty(item.ImageUrl))
                {
                    <img src="@item.ImageUrl" alt="@item.Name"
                         style="width:100%;height:100%;object-fit:cover;display:block;" loading="lazy" />
                    @if (item.IsFeatured)
                    {
                        <span style="position:absolute;top:8px;right:8px;background:var(--accent);color:#000;font-size:0.6rem;font-weight:700;padding:2px 7px;border-radius:20px;text-transform:uppercase;letter-spacing:.05em;">Featured</span>
                    }
                }
                else
                {
                    <div style="height:100%;display:flex;align-items:center;justify-content:center;color:var(--accent);font-size:2.5rem;">
                        @if (item.IsSpicy) { <i class="fas fa-pepper-hot"></i> }
                        else if (item.Category?.Name?.Contains("Coffee") == true) { <i class="fas fa-coffee"></i> }
                        else if (item.Category?.Name?.Contains("Tea") == true) { <i class="fas fa-mug-hot"></i> }
                        else if (item.Category?.Name?.Contains("Smoothie") == true) { <i class="fas fa-blender"></i> }
                        else if (item.Category?.Name?.Contains("Dessert") == true) { <i class="fas fa-birthday-cake"></i> }
                        else { <i class="fas fa-utensils"></i> }
                    </div>
                }
            </div>
            <div class="card-body card-body-compact">
                <div style="display:flex;justify-content:space-between;align-items:start;margin-bottom:0.25rem;">
                    <h3 style="font-weight:700;font-size:0.95rem;color:var(--text-primary);margin:0;">@item.Name</h3>
                    <span style="font-weight:700;color:var(--success);font-size:0.95rem;white-space:nowrap;">$@item.Price.ToString("F2")</span>
                </div>
                @if (!string.IsNullOrEmpty(item.Description))
                {
                    <p style="font-size:0.78rem;color:var(--text-tertiary);margin:0.25rem 0 0.5rem;line-height:1.4;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;">@item.Description</p>
                }
                <div style="display:flex;flex-wrap:wrap;gap:0.3rem;margin-bottom:0.5rem;">
                    @if (item.Category != null)
                    {
                        <span class="badge badge-info" style="font-size:0.65rem;">@item.Category.Name</span>
                    }
                    @if (item.Branch != null)
                    {
                        <span class="badge badge-neutral" style="font-size:0.65rem;">@item.Branch.Name</span>
                    }
                    @if (!item.Availability)
                    {
                        <span class="badge badge-danger" style="font-size:0.65rem;">Unavailable</span>
                    }
                </div>
                <!-- Dietary tags -->
                <div style="display:flex;flex-wrap:wrap;gap:0.25rem;margin-bottom:0.75rem;">
                    @if (item.IsVegetarian) { <span style="font-size:0.6rem;padding:0.15rem 0.4rem;border-radius:6px;background:#dcfce7;color:var(--success);font-weight:600;">Veg</span> }
                    @if (item.IsVegan) { <span style="font-size:0.6rem;padding:0.15rem 0.4rem;border-radius:6px;background:#d1fae5;color:#059669;font-weight:600;">Vegan</span> }
                    @if (item.IsGlutenFree) { <span style="font-size:0.6rem;padding:0.15rem 0.4rem;border-radius:6px;background:#fef3c7;color:var(--warning);font-weight:600;">GF</span> }
                    @if (item.IsDairyFree) { <span style="font-size:0.6rem;padding:0.15rem 0.4rem;border-radius:6px;background:#e0e7ff;color:var(--info);font-weight:600;">DF</span> }
                </div>
                <!-- Nutrition mini row -->
                @if (item.Calories > 0)
                {
                    <div style="display:flex;gap:0.75rem;font-size:0.7rem;color:var(--text-tertiary);padding:0.4rem 0;border-top:1px solid var(--border-light);">
                        <span><strong>@item.Calories</strong> cal</span>
                        @if (item.Protein > 0) { <span><strong>@item.Protein.Value.ToString("F0")</strong>g prot</span> }
                        @if (item.Carbohydrates > 0) { <span><strong>@item.Carbohydrates.Value.ToString("F0")</strong>g carb</span> }
                    </div>
                }
                <!-- Actions -->
                <div style="display:flex;gap:0.4rem;margin-top:0.5rem;padding-top:0.5rem;border-top:1px solid var(--border-light);">
                    <a asp-controller="Menu" asp-action="Details" asp-route-id="@item.Id" class="btn btn-ghost btn-sm" style="flex:1;"><i class="fas fa-eye"></i> View</a>
                    <a asp-controller="Menu" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-ghost btn-sm" style="flex:1;"><i class="fas fa-edit"></i> Edit</a>
                    <a asp-controller="Menu" asp-action="Delete" asp-route-id="@item.Id" class="btn btn-ghost btn-sm" style="flex:1;color:var(--danger);"><i class="fas fa-trash"></i></a>
                </div>
            </div>
        </div>
    }
    @if (!Model.Any())
    {
        <div class="card col-span-full p-12 text-center">
            <div style="font-size:2.5rem;color:var(--text-tertiary);margin-bottom:0.75rem;"><i class="fas fa-utensils"></i></div>
            <h3 style="font-weight:600;color:var(--text-secondary);margin-bottom:0.25rem;">No Menu Items Found</h3>
            <p class="body-text">Try adjusting your filters or create a new menu item.</p>
        </div>
    }
</div>

<!-- List View (hidden by default) -->
<div id="list-view" class="card hidden mb-8">
    <div style="overflow-x:auto;">
        <table class="premium-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Category</th>
                    <th>Branch</th>
                    <th>Price</th>
                    <th>Status</th>
                    <th>Dietary</th>
                    <th>Calories</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <div style="font-weight:600;">@item.Name</div>
                            @if (!string.IsNullOrEmpty(item.Description))
                            {
                                <div style="font-size:0.75rem;color:var(--text-tertiary);max-width:200px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">@item.Description</div>
                            }
                        </td>
                        <td><span class="badge badge-info">@(item.Category?.Name ?? "—")</span></td>
                        <td>@(item.Branch?.Name ?? "—")</td>
                        <td style="font-weight:600;color:var(--success);">$@item.Price.ToString("F2")</td>
                        <td>
                            @if (item.Availability)
                            {
                                <span class="badge badge-success">Available</span>
                            }
                            else
                            {
                                <span class="badge badge-danger">Unavailable</span>
                            }
                        </td>
                        <td style="white-space:nowrap;">
                            @if (item.IsVegetarian) { <span style="font-size:0.6rem;padding:0.1rem 0.35rem;border-radius:5px;background:#dcfce7;color:var(--success);font-weight:600;">V</span> }
                            @if (item.IsVegan) { <span style="font-size:0.6rem;padding:0.1rem 0.35rem;border-radius:5px;background:#d1fae5;color:#059669;font-weight:600;">Ve</span> }
                            @if (item.IsGlutenFree) { <span style="font-size:0.6rem;padding:0.1rem 0.35rem;border-radius:5px;background:#fef3c7;color:var(--warning);font-weight:600;">GF</span> }
                            @if (item.IsDairyFree) { <span style="font-size:0.6rem;padding:0.1rem 0.35rem;border-radius:5px;background:#e0e7ff;color:var(--info);font-weight:600;">DF</span> }
                        </td>
                        <td>@(item.Calories > 0 ? item.Calories.ToString() : "—")</td>
                        <td style="white-space:nowrap;">
                            <a asp-controller="Menu" asp-action="Details" asp-route-id="@item.Id" class="btn btn-ghost btn-sm"><i class="fas fa-eye"></i></a>
                            <a asp-controller="Menu" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-ghost btn-sm"><i class="fas fa-edit"></i></a>
                            <a asp-controller="Menu" asp-action="Delete" asp-route-id="@item.Id" class="btn btn-ghost btn-sm" style="color:var(--danger);"><i class="fas fa-trash"></i></a>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="8" style="text-align:center;padding:2rem;color:var(--text-tertiary);">No menu items found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (Context.Session.GetString("UserRole") == "Owner")
{
    <!-- Quick Actions Panel -->
    <div class="card card-dark">
        <div class="card-body">
            <h3 style="font-weight:700;font-size:1rem;margin-bottom:1rem;color:var(--accent);">Quick Actions</h3>
            <div style="display:flex;flex-wrap:wrap;gap:0.75rem;">
                <a asp-controller="Menu" asp-action="Create" class="btn btn-primary btn-sm"><i class="fas fa-plus"></i> Add Menu Item</a>
                <a asp-controller="MenuItem" asp-action="ExportCsv" class="btn btn-sm" style="background:rgba(255,255,255,0.15);color:#fff;border:1px solid rgba(255,255,255,0.2);"><i class="fas fa-download"></i> Export CSV</a>
                <a asp-controller="Reports" asp-action="SalesOverview" class="btn btn-sm" style="background:rgba(255,255,255,0.15);color:#fff;border:1px solid rgba(255,255,255,0.2);"><i class="fas fa-chart-bar"></i> View Reports</a>
            </div>
        </div>
    </div>
}

@section Scripts {
<script>
    document.querySelectorAll('.view-tab').forEach(tab => {
        tab.addEventListener('click', function() {
            document.querySelectorAll('.view-tab').forEach(t => t.classList.remove('active'));
            this.classList.add('active');
            const view = this.dataset.view;
            document.getElementById('grid-view').style.display = view === 'grid' ? 'grid' : 'none';
            document.getElementById('list-view').style.display = view === 'list' ? 'block' : 'none';
        });
    });
</script>
}

@section Styles {
<style>
    .view-tab {
        padding: 0.4rem 0.9rem;
        border-radius: 8px;
        border: 1px solid var(--border-light);
        background: var(--bg-surface);
        color: var(--text-secondary);
        font-size: 0.8rem;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.2s;
    }
    .view-tab:hover { background: var(--bg-body); }
    .view-tab.active {
        background: var(--accent);
        color: #fff;
        border-color: var(--accent);
    }
</style>
}

