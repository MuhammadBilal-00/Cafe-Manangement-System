@model Cafe.Models.ViewModels.InventoryDashboardViewModel
@{
    ViewData["Title"] = "Inventory Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="p-6 space-y-6">
    <!-- Header -->
    <div class="flex justify-between items-center">
        <h2 class="text-2xl font-bold text-gray-800">Inventory Management</h2>
        <div class="flex gap-2">
            @if (ViewBag.IsOwner || ViewBag.IsBranchManager)
            {
                <a href="@Url.Action("Create")" class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700">
                    + Add Item
                </a>
                <a href="@Url.Action("StockIn")" class="bg-green-600 text-white px-4 py-2 rounded hover:bg-green-700">
                    Stock In
                </a>
                <a href="@Url.Action("StockOut")" class="bg-orange-600 text-white px-4 py-2 rounded hover:bg-orange-700">
                    Stock Out
                </a>
            }
            <a href="@Url.Action("Transactions")" class="bg-gray-600 text-white px-4 py-2 rounded hover:bg-gray-700">
                Transactions
            </a>
            @if (ViewBag.IsOwner || ViewBag.IsBranchManager)
            {
                <a href="@Url.Action("RecipeMappings")" class="bg-purple-600 text-white px-4 py-2 rounded hover:bg-purple-700">
                    Recipe Mappings
                </a>
            }
        </div>
    </div>

    <!-- Branch Filter -->
    @if (ViewBag.IsOwner)
    {
        <div class="flex items-center gap-4">
            <label class="font-semibold">Branch:</label>
            <select id="branchFilter" class="border rounded px-3 py-2" onchange="window.location.href='@Url.Action("Index")?branchId=' + this.value">
                <option value="">Select Branch</option>
                @foreach (var branch in ViewBag.Branches as List<Cafe.Models.Branch>)
                {
                    var selected = ViewBag.SelectedBranchId == branch.Id ? "selected" : "";
                    <option value="@branch.Id" selected="@selected">@branch.Name</option>
                }
            </select>
        </div>
    }

    <!-- Statistics Cards -->
    <div class="grid grid-cols-1 md:grid-cols-5 gap-4">
        <div class="bg-white p-4 rounded-lg shadow border-l-4 border-blue-600">
            <h3 class="text-gray-600 text-sm">Total Items</h3>
            <p class="text-2xl font-bold text-gray-800">@Model.TotalItems</p>
        </div>
        <div class="bg-white p-4 rounded-lg shadow border-l-4 border-green-600">
            <h3 class="text-gray-600 text-sm">In Stock</h3>
            <p class="text-2xl font-bold text-green-600">@Model.InStockItems</p>
        </div>
        <div class="bg-white p-4 rounded-lg shadow border-l-4 border-orange-600">
            <h3 class="text-gray-600 text-sm">Low Stock</h3>
            <p class="text-2xl font-bold text-orange-600">@Model.LowStockItems</p>
        </div>
        <div class="bg-white p-4 rounded-lg shadow border-l-4 border-red-600">
            <h3 class="text-gray-600 text-sm">Out of Stock</h3>
            <p class="text-2xl font-bold text-red-600">@Model.OutOfStockItems</p>
        </div>
        <div class="bg-white p-4 rounded-lg shadow border-l-4 border-purple-600">
            <h3 class="text-gray-600 text-sm">Total Value</h3>
            <p class="text-2xl font-bold text-purple-600">$@Model.TotalInventoryValue.ToString("N2")</p>
        </div>
    </div>

    <!-- Low Stock Alerts -->
    @if (Model.LowStockAlerts.Any())
    {
        <div class="bg-red-50 border-l-4 border-red-600 p-4 rounded">
            <h3 class="text-red-800 font-bold mb-2">⚠️ Low Stock Alerts</h3>
            <div class="space-y-1">
                @foreach (var item in Model.LowStockAlerts.Take(5))
                {
                    <div class="flex justify-between items-center text-sm">
                        <span class="text-red-700">@item.Name</span>
                        <span class="text-red-600 font-semibold">@item.Quantity @item.Unit (Reorder: @item.ReorderLevel)</span>
                    </div>
                }
            </div>
        </div>
    }

    <!-- Filters and Search -->
    <div class="flex flex-wrap items-center gap-4">
        <input id="search" type="text" placeholder="Search items..." class="border rounded px-3 py-2 w-64">
        <select id="statusFilter" class="border rounded px-3 py-2">
            <option value="">All Status</option>
            <option value="In Stock">In Stock</option>
            <option value="Low Stock">Low Stock</option>
            <option value="Out of Stock">Out of Stock</option>
        </select>
    </div>

    <!-- Inventory Items Table -->
    <div class="overflow-x-auto border rounded-lg shadow-sm bg-white">
        <table class="min-w-full divide-y divide-gray-200 text-sm">
            <thead class="bg-gray-100">
                <tr>
                    <th class="px-4 py-2 text-left">Name</th>
                    <th class="px-4 py-2 text-right">Quantity</th>
                    <th class="px-4 py-2 text-right">Reorder Level</th>
                    <th class="px-4 py-2 text-right">Unit Price</th>
                    <th class="px-4 py-2 text-right">Total Value</th>
                    <th class="px-4 py-2 text-center">Status</th>
                    <th class="px-4 py-2 text-left">Last Updated</th>
                    <th class="px-4 py-2 text-center">Actions</th>
                </tr>
            </thead>
            <tbody id="inventoryTable" class="divide-y divide-gray-200"></tbody>
        </table>
    </div>

    <!-- Pagination -->
    <div class="flex justify-between items-center mt-4 text-sm text-gray-600">
        <span id="itemCount">Loading...</span>
        <div id="pagination" class="flex gap-1"></div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div id="deleteModal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
    <div class="bg-white p-6 rounded-lg w-96">
        <h3 class="text-lg font-bold mb-4">Confirm Delete</h3>
        <p class="text-gray-700 mb-4">Are you sure you want to delete this inventory item?</p>
        <div class="flex justify-end gap-2">
            <button onclick="closeDeleteModal()" class="bg-gray-300 px-4 py-2 rounded hover:bg-gray-400">Cancel</button>
            <button id="confirmDeleteBtn" class="bg-red-600 text-white px-4 py-2 rounded hover:bg-red-700">Delete</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let currentPage = 1;
        const pageSize = 10;
        const branchId = '@ViewBag.SelectedBranchId';
        let deleteItemId = null;

        // Load inventory items
        function loadInventory(page = 1) {
            if (!branchId) {
                document.getElementById('inventoryTable').innerHTML = '<tr><td colspan="8" class="text-center py-4">Please select a branch</td></tr>';
                return;
            }

            const search = document.getElementById('search').value;
            const status = document.getElementById('statusFilter').value;

            fetch(`/Inventory/GetInventoryItems?branchId=${branchId}&status=${status}&search=${search}&page=${page}&pageSize=${pageSize}`)
                .then(response => response.json())
                .then(data => {
                    const tbody = document.getElementById('inventoryTable');
                    tbody.innerHTML = '';

                    if (data.items && data.items.length > 0) {
                        data.items.forEach(item => {
                            const statusClass = item.status === 'In Stock' ? 'bg-green-100 text-green-800' :
                                              item.status === 'Low Stock' ? 'bg-orange-100 text-orange-800' :
                                              'bg-red-100 text-red-800';
                            
                            const row = `
                                <tr>
                                    <td class="px-4 py-2 font-semibold">${item.name}</td>
                                    <td class="px-4 py-2 text-right">${item.quantity} ${item.unit}</td>
                                    <td class="px-4 py-2 text-right">${item.reorderLevel} ${item.unit}</td>
                                    <td class="px-4 py-2 text-right">$${item.unitPrice.toFixed(2)}</td>
                                    <td class="px-4 py-2 text-right font-semibold">$${item.totalValue.toFixed(2)}</td>
                                    <td class="px-4 py-2 text-center">
                                        <span class="px-2 py-1 rounded text-xs font-semibold ${statusClass}">
                                            ${item.status}
                                        </span>
                                    </td>
                                    <td class="px-4 py-2">${new Date(item.lastUpdated).toLocaleDateString()}</td>
                                    <td class="px-4 py-2 text-center">
                                        <div class="flex justify-center gap-1">
                                            <a href="/Inventory/Details/${item.id}" class="text-blue-600 hover:text-blue-800" title="Details">👁️</a>
                                            @if (ViewBag.IsOwner || ViewBag.IsBranchManager)
                                            {
                                                <text>
                                                    <a href="/Inventory/Edit/${item.id}" class="text-green-600 hover:text-green-800" title="Edit">✏️</a>
                                                    <button onclick="showDeleteModal(${item.id})" class="text-red-600 hover:text-red-800" title="Delete">🗑️</button>
                                                </text>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            `;
                            tbody.innerHTML += row;
                        });

                        document.getElementById('itemCount').textContent = `Showing ${data.items.length} of ${data.totalCount} items`;
                        renderPagination(data.currentPage, data.totalPages);
                    } else {
                        tbody.innerHTML = '<tr><td colspan="8" class="text-center py-4 text-gray-500">No inventory items found</td></tr>';
                        document.getElementById('itemCount').textContent = 'No items found';
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    document.getElementById('inventoryTable').innerHTML = '<tr><td colspan="8" class="text-center py-4 text-red-600">Error loading inventory</td></tr>';
                });
        }

        function renderPagination(currentPage, totalPages) {
            const pagination = document.getElementById('pagination');
            pagination.innerHTML = '';

            if (totalPages <= 1) return;

            for (let i = 1; i <= totalPages; i++) {
                const btn = document.createElement('button');
                btn.textContent = i;
                btn.className = i === currentPage 
                    ? 'px-3 py-1 bg-blue-600 text-white rounded' 
                    : 'px-3 py-1 bg-gray-200 rounded hover:bg-gray-300';
                btn.onclick = () => loadInventory(i);
                pagination.appendChild(btn);
            }
        }

        function showDeleteModal(id) {
            deleteItemId = id;
            document.getElementById('deleteModal').classList.remove('hidden');
        }

        function closeDeleteModal() {
            deleteItemId = null;
            document.getElementById('deleteModal').classList.add('hidden');
        }

        document.getElementById('confirmDeleteBtn').addEventListener('click', async function() {
            if (!deleteItemId) return;

            try {
                const response = await fetch(`/Inventory/Delete/${deleteItemId}`, {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
                    }
                });

                const data = await response.json();
                if (data.success) {
                    closeDeleteModal();
                    loadInventory(currentPage);
                    alert('Inventory item deleted successfully');
                } else {
                    alert(data.message || 'Error deleting item');
                }
            } catch (error) {
                console.error('Error:', error);
                alert('Error deleting item');
            }
        });

        // Event listeners
        document.getElementById('search').addEventListener('input', () => loadInventory(1));
        document.getElementById('statusFilter').addEventListener('change', () => loadInventory(1));

        // Initial load
        loadInventory(1);
    </script>
}
