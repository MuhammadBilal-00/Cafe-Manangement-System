@model Cafe.Models.InventoryItem
@{
    ViewData["Title"] = "Create Inventory Item";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="p-6 max-w-2xl mx-auto">
    <div class="flex justify-between items-center mb-6">
        <h2 class="text-2xl font-bold text-gray-800">Create Inventory Item</h2>
        <a href="@Url.Action("Index")" class="text-blue-600 hover:text-blue-800">← Back to Inventory</a>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="bg-red-100 border-l-4 border-red-600 text-red-800 p-4 mb-4 rounded">
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="bg-white p-6 rounded-lg shadow">
        <form asp-action="Create" method="post" class="space-y-4">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-red-600"></div>

            <div>
                <label asp-for="Name" class="block font-semibold mb-1">Item Name *</label>
                <input asp-for="Name" class="border rounded px-3 py-2 w-full" placeholder="e.g., Milk, Coffee Beans" required />
                <span asp-validation-for="Name" class="text-red-600 text-sm"></span>
            </div>

            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label asp-for="Quantity" class="block font-semibold mb-1">Initial Quantity *</label>
                    <input asp-for="Quantity" type="number" step="0.01" class="border rounded px-3 py-2 w-full" required />
                    <span asp-validation-for="Quantity" class="text-red-600 text-sm"></span>
                </div>

                <div>
                    <label asp-for="Unit" class="block font-semibold mb-1">Unit *</label>
                    <select asp-for="Unit" class="border rounded px-3 py-2 w-full" required>
                        <option value="">Select Unit</option>
                        <option value="kg">Kilogram (kg)</option>
                        <option value="g">Gram (g)</option>
                        <option value="liters">Liters</option>
                        <option value="ml">Milliliters (ml)</option>
                        <option value="pieces">Pieces</option>
                        <option value="packs">Packs</option>
                        <option value="boxes">Boxes</option>
                        <option value="bottles">Bottles</option>
                        <option value="cans">Cans</option>
                    </select>
                    <span asp-validation-for="Unit" class="text-red-600 text-sm"></span>
                </div>
            </div>

            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label asp-for="ReorderLevel" class="block font-semibold mb-1">Reorder Level *</label>
                    <input asp-for="ReorderLevel" type="number" step="0.01" class="border rounded px-3 py-2 w-full" required />
                    <span asp-validation-for="ReorderLevel" class="text-red-600 text-sm"></span>
                    <p class="text-xs text-gray-500 mt-1">Alert when stock falls below this level</p>
                </div>

                <div>
                    <label asp-for="UnitPrice" class="block font-semibold mb-1">Unit Price ($) *</label>
                    <input asp-for="UnitPrice" type="number" step="0.01" class="border rounded px-3 py-2 w-full" required />
                    <span asp-validation-for="UnitPrice" class="text-red-600 text-sm"></span>
                </div>
            </div>

            <div>
                <label asp-for="BranchId" class="block font-semibold mb-1">Branch *</label>
                <select asp-for="BranchId" class="border rounded px-3 py-2 w-full" required>
                    <option value="">Select Branch</option>
                    @foreach (var branch in ViewBag.Branches as List<Cafe.Models.Branch>)
                    {
                        <option value="@branch.Id">@branch.Name - @branch.Location</option>
                    }
                </select>
                <span asp-validation-for="BranchId" class="text-red-600 text-sm"></span>
            </div>

            <div class="flex justify-end gap-2 mt-6">
                <a href="@Url.Action("Index")" class="bg-gray-300 px-4 py-2 rounded hover:bg-gray-400">Cancel</a>
                <button type="submit" class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700">Create Item</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
