@model Cafe.Services.BrandingModel
@{
    ViewData["Title"] = "Branding";
    var customDomain = ViewBag.CustomDomain as string;
}

<div style="max-width:720px;margin:0 auto;">
    <div style="margin-bottom:1.5rem;">
        <h1 class="page-title" style="margin:0;">White-label branding</h1>
        <p class="body-text" style="margin-top:0.25rem;">Make the app yours — logo, colours, receipts and custom domain.</p>
    </div>

    <div class="card">
        <div class="card-body">
            <form asp-action="Branding" method="post">
                @Html.AntiForgeryToken()

                <div class="form-group">
                    <label class="form-label">Business name</label>
                    <input asp-for="BusinessName" class="form-control" />
                </div>

                <div class="form-group">
                    <label class="form-label">Logo URL</label>
                    <input asp-for="LogoUrl" class="form-control" placeholder="https://…/logo.png" />
                    <p class="caption" style="margin-top:0.3rem;">Square image works best. Leave blank to use the default cup icon.</p>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Primary / accent colour</label>
                        <div style="display:flex;gap:0.5rem;align-items:center;">
                            <input asp-for="PrimaryColor" type="color" style="width:48px;height:40px;padding:2px;border-radius:8px;border:1px solid var(--border);" />
                            <input asp-for="PrimaryColor" class="form-control" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Sidebar colour</label>
                        <div style="display:flex;gap:0.5rem;align-items:center;">
                            <input asp-for="SidebarColor" type="color" style="width:48px;height:40px;padding:2px;border-radius:8px;border:1px solid var(--border);" />
                            <input asp-for="SidebarColor" class="form-control" />
                        </div>
                    </div>
                </div>

                <div class="divider" style="margin:1.25rem 0;"></div>

                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Receipt header</label>
                        <input asp-for="ReceiptHeader" class="form-control" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Receipt footer</label>
                        <input asp-for="ReceiptFooter" class="form-control" />
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label">Custom domain (optional)</label>
                    <input name="customDomain" value="@customDomain" class="form-control" placeholder="orders.yourcafe.com" />
                    <p class="caption" style="margin-top:0.3rem;">Point a CNAME at the platform, then enter it here to serve your workspace on your own domain.</p>
                </div>

                <div style="display:flex;gap:0.75rem;margin-top:1rem;">
                    <button type="submit" class="btn btn-primary"><i class="fas fa-save" style="margin-right:0.5rem;"></i> Save branding</button>
                </div>
            </form>
        </div>
    </div>
</div>
