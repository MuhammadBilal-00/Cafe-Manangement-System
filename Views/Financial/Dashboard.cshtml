@model Cafe.Models.ViewModels.FinancialDashboardViewModel
@{
    ViewData["Title"] = "Financial Dashboard";
    var monthName = new DateTime(Model.Year, Model.Month, 1).ToString("MMMM yyyy");
    var profitPositive = Model.NetProfit >= 0;
}

<!-- Header -->
<div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:1.5rem; flex-wrap:wrap; gap:1rem;">
    <h1 class="page-title" style="margin:0;"><i class="fas fa-chart-line" style="color:var(--accent); margin-right:0.5rem;"></i> Financial Dashboard</h1>
    <a asp-action="Expenses" class="btn btn-primary"><i class="fas fa-receipt" style="margin-right:0.5rem;"></i> Manage Expenses</a>
</div>

<!-- Filters -->
<div class="card" style="margin-bottom:1.5rem;">
    <div class="card-body" style="padding:1rem 1.25rem;">
        <form method="get" style="display:flex; flex-wrap:wrap; align-items:flex-end; gap:1rem;">
            <div style="flex:1; min-width:150px;">
                <label class="form-label">Branch</label>
                <select name="branchId" class="form-select">
                    <option value="">All Branches</option>
                    @foreach (var b in Model.Branches)
                    {
                        <option value="@b.Id" selected="@(Model.BranchId == b.Id)">@b.Name</option>
                    }
                </select>
            </div>
            <div style="width:110px;">
                <label class="form-label">Year</label>
                <input type="number" name="year" value="@Model.Year" class="form-control" />
            </div>
            <div style="width:140px;">
                <label class="form-label">Month</label>
                <select name="month" class="form-select">
                    @for (int m = 1; m <= 12; m++)
                    {
                        <option value="@m" selected="@(Model.Month == m)">@(new DateTime(2024, m, 1).ToString("MMMM"))</option>
                    }
                </select>
            </div>
            <button type="submit" class="btn btn-primary btn-sm"><i class="fas fa-filter" style="margin-right:0.25rem;"></i> Apply</button>
        </form>
    </div>
</div>

<!-- KPIs -->
<div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(200px,1fr)); gap:1rem; margin-bottom:1.5rem;">
    <div class="kpi-card">
        <div class="kpi-icon" style="background:rgba(34,197,94,0.1); color:#22c55e;"><i class="fas fa-coins"></i></div>
        <span class="kpi-label">Total Revenue</span>
        <span class="kpi-value" style="color:#22c55e;">Rs. @Model.TotalRevenue.ToString("N0")</span>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon" style="background:rgba(59,130,246,0.1); color:#3b82f6;"><i class="fas fa-users"></i></div>
        <span class="kpi-label">Salary Expense</span>
        <span class="kpi-value" style="color:#3b82f6;">Rs. @Model.TotalSalaryExpense.ToString("N0")</span>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon" style="background:rgba(249,115,22,0.1); color:#f97316;"><i class="fas fa-receipt"></i></div>
        <span class="kpi-label">Other Expenses</span>
        <span class="kpi-value" style="color:#f97316;">Rs. @Model.TotalOtherExpenses.ToString("N0")</span>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon" style="background:@(profitPositive ? "rgba(34,197,94,0.1)" : "rgba(239,68,68,0.1)"); color:@(profitPositive ? "#22c55e" : "#ef4444");"><i class="fas fa-chart-line"></i></div>
        <span class="kpi-label">Net Profit</span>
        <span class="kpi-value" style="color:@(profitPositive ? "#22c55e" : "#ef4444");">Rs. @Model.NetProfit.ToString("N0")</span>
    </div>
</div>

<div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(400px,1fr)); gap:1.5rem; margin-bottom:1.5rem;">
    <!-- Branch Performance -->
    @if (Model.BranchSummaries.Any())
    {
        <div class="card">
            <div class="card-header">
                <h3 style="margin:0; font-weight:600;"><i class="fas fa-store" style="margin-right:0.5rem; color:var(--accent);"></i> Branch Performance — @monthName</h3>
            </div>
            <div class="card-body" style="padding:0;">
                <div style="overflow-x:auto;">
                    <table class="premium-table">
                        <thead>
                            <tr>
                                <th>Branch</th>
                                <th style="text-align:right;">Revenue</th>
                                <th style="text-align:right;">Expenses</th>
                                <th style="text-align:right;">Profit</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var bs in Model.BranchSummaries)
                            {
                                <tr>
                                    <td>
                                        <span style="font-weight:600;">@bs.BranchName</span>
                                        <br /><span class="caption">@bs.TotalOrders orders</span>
                                    </td>
                                    <td style="text-align:right; color:#22c55e; font-weight:600;">Rs. @bs.Revenue.ToString("N0")</td>
                                    <td style="text-align:right; color:#ef4444;">Rs. @((bs.SalaryExpense + bs.OtherExpenses).ToString("N0"))</td>
                                    <td style="text-align:right; font-weight:700; color:@(bs.NetProfit >= 0 ? "#22c55e" : "#ef4444");">
                                        Rs. @bs.NetProfit.ToString("N0")
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    <!-- Expense Category Breakdown -->
    @if (Model.ExpensesByCategory.Any())
    {
        <div class="card">
            <div class="card-header">
                <h3 style="margin:0; font-weight:600;"><i class="fas fa-tags" style="margin-right:0.5rem; color:var(--accent);"></i> Expense Breakdown — @monthName</h3>
            </div>
            <div class="card-body">
                @{
                    var maxAmount = Model.ExpensesByCategory.Max(c => c.Amount);
                    var categoryColors = new Dictionary<string, string>
                    {
                        {"Utilities", "#eab308"},
                        {"Maintenance", "#3b82f6"},
                        {"Supplies", "#22c55e"},
                        {"Rent", "#8b5cf6"},
                        {"Bills", "#ef4444"},
                        {"Marketing", "#ec4899"},
                        {"General", "#6b7280"}
                    };
                }
                @foreach (var c in Model.ExpensesByCategory.OrderByDescending(x => x.Amount))
                {
                    var pct = maxAmount == 0 ? 0 : (int)(c.Amount / maxAmount * 100);
                    var barColor = categoryColors.GetValueOrDefault(c.Category, "#6b7280");
                    <div style="margin-bottom:0.75rem;">
                        <div style="display:flex; justify-content:space-between; margin-bottom:0.25rem;">
                            <span class="body-text" style="font-weight:600;">@c.Category (@c.Count)</span>
                            <span class="caption">Rs. @c.Amount.ToString("N0")</span>
                        </div>
                        <div style="width:100%; background:var(--border-light); border-radius:999px; height:6px;">
                            <div style="width:@(pct)%; background:@barColor; height:6px; border-radius:999px; transition:width 0.3s;"></div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

<!-- Monthly Trends -->
@if (Model.MonthlyTrends.Any())
{
    <div class="card">
        <div class="card-header">
            <h3 style="margin:0; font-weight:600;"><i class="fas fa-chart-bar" style="margin-right:0.5rem; color:var(--accent);"></i> Monthly Trends (Last 12 Months)</h3>
        </div>
        <div class="card-body" style="padding:0;">
            <div style="overflow-x:auto;">
                <table class="premium-table">
                    <thead>
                        <tr>
                            <th>Month</th>
                            <th style="text-align:right;">Revenue</th>
                            <th style="text-align:right;">Expenses</th>
                            <th style="text-align:right;">Profit</th>
                            <th style="text-align:right;">Margin</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in Model.MonthlyTrends)
                        {
                            var margin = t.Revenue != 0 ? (t.Profit / t.Revenue * 100) : 0;
                            <tr>
                                <td style="font-weight:600;">@t.MonthName @t.Year</td>
                                <td style="text-align:right; color:#22c55e;">Rs. @t.Revenue.ToString("N0")</td>
                                <td style="text-align:right; color:#ef4444;">Rs. @t.TotalExpenses.ToString("N0")</td>
                                <td style="text-align:right; font-weight:700; color:@(t.Profit >= 0 ? "#22c55e" : "#ef4444");">
                                    Rs. @t.Profit.ToString("N0")
                                </td>
                                <td style="text-align:right;">
                                    <span class="badge @(margin >= 0 ? "badge-success" : "badge-danger")">
                                        @margin.ToString("F1")%
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
