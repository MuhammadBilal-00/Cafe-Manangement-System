@model Cafe.Models.ViewModels.FinancialDashboardViewModel
@{
    ViewData["Title"] = "Financial Dashboard";
    var monthName = new DateTime(Model.Year, Model.Month, 1).ToString("MMMM yyyy");
    var profitClass = Model.NetProfit >= 0 ? "text-green-600" : "text-red-600";
}

<div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold text-gray-800"><i class="fas fa-chart-line mr-2"></i> Financial Dashboard</h1>
    <a asp-action="Expenses" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg">
        <i class="fas fa-receipt mr-2"></i> Manage Expenses
    </a>
</div>

<!-- Filters -->
<div class="bg-white rounded-lg shadow-md p-4 mb-6">
    <form method="get" class="flex flex-wrap items-end gap-4">
        <div class="flex-1 min-w-[150px]">
            <label class="block text-sm font-medium text-gray-700 mb-1">Branch</label>
            <select name="branchId" class="w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 py-2 px-3 border">
                <option value="">All Branches</option>
                @foreach (var b in Model.Branches)
                {
                    <option value="@b.Id" selected="@(Model.BranchId == b.Id)">@b.Name</option>
                }
            </select>
        </div>
        <div class="w-32">
            <label class="block text-sm font-medium text-gray-700 mb-1">Year</label>
            <input type="number" name="year" value="@Model.Year" class="w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 py-2 px-3 border" />
        </div>
        <div class="w-32">
            <label class="block text-sm font-medium text-gray-700 mb-1">Month</label>
            <select name="month" class="w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 py-2 px-3 border">
                @for (int m = 1; m <= 12; m++)
                {
                    <option value="@m" selected="@(Model.Month == m)">@(new DateTime(2024, m, 1).ToString("MMMM"))</option>
                }
            </select>
        </div>
        <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-2 rounded-lg">
            <i class="fas fa-filter mr-1"></i> Apply
        </button>
    </form>
</div>

<!-- Summary Cards -->
<div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-6">
    <div class="bg-white rounded-lg shadow-md p-6">
        <div class="flex items-center justify-between">
            <div>
                <p class="text-sm text-gray-500">Total Revenue</p>
                <p class="text-2xl font-bold text-green-600">Rs. @Model.TotalRevenue.ToString("N0")</p>
            </div>
            <div class="w-12 h-12 rounded-full bg-green-100 flex items-center justify-center">
                <i class="fas fa-coins text-green-500 text-xl"></i>
            </div>
        </div>
    </div>
    <div class="bg-white rounded-lg shadow-md p-6">
        <div class="flex items-center justify-between">
            <div>
                <p class="text-sm text-gray-500">Salary Expense</p>
                <p class="text-2xl font-bold text-blue-600">Rs. @Model.TotalSalaryExpense.ToString("N0")</p>
            </div>
            <div class="w-12 h-12 rounded-full bg-blue-100 flex items-center justify-center">
                <i class="fas fa-users text-blue-500 text-xl"></i>
            </div>
        </div>
    </div>
    <div class="bg-white rounded-lg shadow-md p-6">
        <div class="flex items-center justify-between">
            <div>
                <p class="text-sm text-gray-500">Other Expenses</p>
                <p class="text-2xl font-bold text-orange-600">Rs. @Model.TotalOtherExpenses.ToString("N0")</p>
            </div>
            <div class="w-12 h-12 rounded-full bg-orange-100 flex items-center justify-center">
                <i class="fas fa-receipt text-orange-500 text-xl"></i>
            </div>
        </div>
    </div>
    <div class="bg-white rounded-lg shadow-md p-6">
        <div class="flex items-center justify-between">
            <div>
                <p class="text-sm text-gray-500">Net Profit</p>
                <p class="text-2xl font-bold @profitClass">Rs. @Model.NetProfit.ToString("N0")</p>
            </div>
            <div class="w-12 h-12 rounded-full @(Model.NetProfit >= 0 ? "bg-green-100" : "bg-red-100") flex items-center justify-center">
                <i class="fas fa-chart-line @(Model.NetProfit >= 0 ? "text-green-500" : "text-red-500") text-xl"></i>
            </div>
        </div>
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
    <!-- Branch Summaries -->
    @if (Model.BranchSummaries.Any())
    {
        <div class="bg-white rounded-lg shadow-md overflow-hidden">
            <div class="p-4 border-b bg-gray-50">
                <h3 class="font-medium text-gray-700"><i class="fas fa-store mr-2"></i> Branch Performance - @monthName</h3>
            </div>
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Branch</th>
                            <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase">Revenue</th>
                            <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase">Expenses</th>
                            <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase">Profit</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-200">
                        @foreach (var bs in Model.BranchSummaries)
                        {
                            <tr>
                                <td class="px-4 py-3 text-sm font-medium text-gray-800">
                                    @bs.BranchName
                                    <span class="text-xs text-gray-400 block">@bs.TotalOrders orders</span>
                                </td>
                                <td class="px-4 py-3 text-sm text-right text-green-600">Rs. @bs.Revenue.ToString("N0")</td>
                                <td class="px-4 py-3 text-sm text-right text-red-600">Rs. @((bs.SalaryExpense + bs.OtherExpenses).ToString("N0"))</td>
                                <td class="px-4 py-3 text-sm text-right font-medium @(bs.NetProfit >= 0 ? "text-green-600" : "text-red-600")">
                                    Rs. @bs.NetProfit.ToString("N0")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <!-- Expense Category Breakdown -->
    @if (Model.ExpensesByCategory.Any())
    {
        <div class="bg-white rounded-lg shadow-md overflow-hidden">
            <div class="p-4 border-b bg-gray-50">
                <h3 class="font-medium text-gray-700"><i class="fas fa-tags mr-2"></i> Expense Breakdown - @monthName</h3>
            </div>
            <div class="p-4 space-y-3">
                @{
                    var maxAmount = Model.ExpensesByCategory.Max(c => c.Amount);
                    var categoryColors = new Dictionary<string, string>
                    {
                        {"Utilities", "bg-yellow-500"},
                        {"Maintenance", "bg-blue-500"},
                        {"Supplies", "bg-green-500"},
                        {"Rent", "bg-purple-500"},
                        {"Bills", "bg-red-500"},
                        {"Marketing", "bg-pink-500"},
                        {"General", "bg-gray-500"}
                    };
                }
                @foreach (var c in Model.ExpensesByCategory.OrderByDescending(x => x.Amount))
                {
                    var pct = maxAmount == 0 ? 0 : (int)(c.Amount / maxAmount * 100);
                    var barColor = categoryColors.GetValueOrDefault(c.Category, "bg-gray-500");
                    <div>
                        <div class="flex justify-between text-sm mb-1">
                            <span class="font-medium text-gray-700">@c.Category (@c.Count)</span>
                            <span class="text-gray-600">Rs. @c.Amount.ToString("N0")</span>
                        </div>
                        <div class="w-full bg-gray-200 rounded-full h-2">
                            <div class="@barColor h-2 rounded-full" style="width: @(pct)%"></div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

<!-- Monthly Trends -->
@if (Model.MonthlyTrends.Any())
{
    <div class="bg-white rounded-lg shadow-md overflow-hidden">
        <div class="p-4 border-b bg-gray-50">
            <h3 class="font-medium text-gray-700"><i class="fas fa-chart-bar mr-2"></i> Monthly Trends (Last 12 Months)</h3>
        </div>
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Month</th>
                        <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase">Revenue</th>
                        <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase">Expenses</th>
                        <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase">Profit</th>
                        <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase">Margin</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200">
                    @foreach (var t in Model.MonthlyTrends)
                    {
                        var margin = t.Revenue != 0 ? (t.Profit / t.Revenue * 100) : 0;
                        <tr>
                            <td class="px-4 py-3 text-sm font-medium text-gray-800">@t.MonthName @t.Year</td>
                            <td class="px-4 py-3 text-sm text-right text-green-600">Rs. @t.Revenue.ToString("N0")</td>
                            <td class="px-4 py-3 text-sm text-right text-red-600">Rs. @t.TotalExpenses.ToString("N0")</td>
                            <td class="px-4 py-3 text-sm text-right font-medium @(t.Profit >= 0 ? "text-green-600" : "text-red-600")">
                                Rs. @t.Profit.ToString("N0")
                            </td>
                            <td class="px-4 py-3 text-sm text-right">
                                <span class="px-2 py-0.5 text-xs rounded-full @(margin >= 0 ? "bg-green-100 text-green-800" : "bg-red-100 text-red-800")">
                                    @margin.ToString("F1")%
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
