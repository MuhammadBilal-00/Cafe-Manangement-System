@model Cafe.Models.Expense
@{
    ViewData["Title"] = "Edit Expense";
    var branches = ViewBag.Branches as List<Cafe.Models.Branch> ?? new List<Cafe.Models.Branch>();
    var categories = new[] { "Utilities", "Maintenance", "Supplies", "Rent", "Bills", "Marketing", "General" };
    var paymentMethods = new[] { "Cash", "Card", "BankTransfer", "Cheque" };
}

<div class="max-w-[720px] mx-auto">
    <!-- Header -->
    <div style="display:flex; align-items:center; margin-bottom:1.5rem; gap:1rem;">
        <a asp-action="Expenses" class="btn btn-ghost btn-sm"><i class="fas fa-arrow-left"></i></a>
        <h1 class="page-title" style="margin:0;"><i class="fas fa-edit"
                                                        style="color:var(--accent); margin-right:0.5rem;"></i> Edit Expense</h1>
        </div>

        <div class="card">
            <div class="card-body">
                <form asp-action="EditExpense" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="CreatedById" />
                    <input type="hidden" asp-for="CreatedAt" />
                    <input type="hidden" asp-for="ApprovedById" />
                    <input type="hidden" asp-for="ApprovedAt" />
                    <div asp-validation-summary="ModelOnly" class="form-error" style="margin-bottom:1rem;"></div>

                    <div class="form-group">
                        <label asp-for="Title" class="form-label">Title *</label>
                        <input asp-for="Title" class="form-control" />
                        <span asp-validation-for="Title" class="form-error"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Description" class="form-label">Description</label>
                        <textarea asp-for="Description" rows="3" class="form-control"></textarea>
                    </div>

                    <div class="form-row">
                        <div class="form-group" style="flex:1;">
                            <label asp-for="BranchId" class="form-label">Branch *</label>
                            <select asp-for="BranchId" class="form-select">
                                <option value="">Select Branch</option>
                                @foreach (var b in branches)
                                {
                                    <option value="@b.Id" selected="@(Model.BranchId == b.Id)">@b.Name</option>
                                }
                            </select>
                        </div>
                        <div class="form-group" style="flex:1;">
                            <label asp-for="Category" class="form-label">Category *</label>
                            <select asp-for="Category" class="form-select">
                                @foreach (var c in categories)
                                {
                                    <option value="@c" selected="@(Model.Category == c)">@c</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group" style="flex:1;">
                            <label asp-for="Amount" class="form-label">Amount (Rs.) *</label>
                            <input asp-for="Amount" type="number" step="0.01" min="0.01" class="form-control" />
                            <span asp-validation-for="Amount" class="form-error"></span>
                        </div>
                        <div class="form-group" style="flex:1;">
                            <label asp-for="ExpenseDate" class="form-label">Date *</label>
                            <input asp-for="ExpenseDate" type="date" class="form-control" />
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group" style="flex:1;">
                            <label asp-for="PaymentMethod" class="form-label">Payment Method</label>
                            <select asp-for="PaymentMethod" class="form-select">
                                @foreach (var pm in paymentMethods)
                                {
                                    <option value="@pm" selected="@(Model.PaymentMethod == pm)">@pm</option>
                                }
                            </select>
                        </div>
                        <div class="form-group" style="flex:1;">
                            <label asp-for="ReferenceNumber" class="form-label">Reference Number</label>
                            <input asp-for="ReferenceNumber" class="form-control" />
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group" style="flex:1;">
                            <label asp-for="ApprovalStatus" class="form-label">Approval Status</label>
                            <select asp-for="ApprovalStatus" class="form-select">
                                <option value="Approved" selected="@(Model.ApprovalStatus == "Approved")">Approved</option>
                                <option value="Pending" selected="@(Model.ApprovalStatus == "Pending")">Pending</option>
                                <option value="Rejected" selected="@(Model.ApprovalStatus == "Rejected")">Rejected</option>
                            </select>
                        </div>
                        <div class="form-group" style="flex:1; display:flex; align-items:center; padding-top:1.5rem;">
                            <label style="display:flex; align-items:center; gap:0.5rem; cursor:pointer;">
                                <input asp-for="IsRecurring" type="checkbox" id="isRecurring"
                                       style="width:1rem; height:1rem; accent-color:var(--accent);" />
                                <span class="form-label" style="margin:0;">Recurring Expense</span>
                            </label>
                        </div>
                    </div>

                    <div id="recurringSection" class="form-group" style="@(Model.IsRecurring ? "" : "display:none")">
                        <label asp-for="RecurringFrequency" class="form-label">Frequency</label>
                        <select asp-for="RecurringFrequency" class="form-select">
                            <option value="">Select Frequency</option>
                            <option value="Monthly" selected="@(Model.RecurringFrequency == "Monthly")">Monthly</option>
                            <option value="Quarterly" selected="@(Model.RecurringFrequency == "Quarterly")">Quarterly
                            </option>
                            <option value="Yearly" selected="@(Model.RecurringFrequency == "Yearly")">Yearly</option>
                        </select>
                    </div>

                    <div class="divider"></div>

                    <div style="display:flex; justify-content:flex-end; gap:0.75rem;">
                        <a asp-action="Expenses" class="btn btn-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save" style="margin-right:0.5rem;"></i> Update Expense
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script>
        document.getElementById('isRecurring')?.addEventListener('change', function () {
            document.getElementById('recurringSection').style.display = this.checked ? 'block' : 'none';
        });
    </script>