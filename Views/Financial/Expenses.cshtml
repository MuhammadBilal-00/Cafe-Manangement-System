@model Cafe.Models.ViewModels.ExpenseIndexViewModel
@{
    ViewData["Title"] = "Expenses";
    var categories = new[] { "Utilities", "Maintenance", "Supplies", "Rent", "Bills", "Marketing", "General" };
}

<!-- Header -->
<div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:1.5rem; flex-wrap:wrap; gap:1rem;">
    <h1 class="page-title" style="margin:0;"><i class="fas fa-receipt" style="color:var(--accent); margin-right:0.5rem;"></i> Expenses</h1>
    <div style="display:flex; gap:0.5rem;">
        <a asp-action="ExportExpensesCsv" asp-route-branchId="@Model.BranchId"
           asp-route-from="@Model.FromDate?.ToString("yyyy-MM-dd")" asp-route-to="@Model.ToDate?.ToString("yyyy-MM-dd")"
           class="btn btn-secondary btn-sm">
            <i class="fas fa-file-csv" style="margin-right:0.25rem;"></i> Export CSV
        </a>
        <a asp-action="CreateExpense" class="btn btn-primary"><i class="fas fa-plus" style="margin-right:0.5rem;"></i> Add Expense</a>
    </div>
</div>

<!-- Filters -->
<div class="card mb-6">
    <div class="card-body card-body-compact">
        <form method="get" style="display:flex; flex-wrap:wrap; align-items:flex-end; gap:1rem;">
            <div style="flex:1; min-width:140px;">
                <label class="form-label">Branch</label>
                <select name="branchId" class="form-select">
                    <option value="">All Branches</option>
                    @foreach (var b in Model.Branches)
                    {
                        <option value="@b.Id" selected="@(Model.BranchId == b.Id)">@b.Name</option>
                    }
                </select>
            </div>
            <div style="flex:1; min-width:140px;">
                <label class="form-label">Category</label>
                <select name="category" class="form-select">
                    <option value="">All Categories</option>
                    @foreach (var c in categories)
                    {
                        <option value="@c" selected="@(Model.Category == c)">@c</option>
                    }
                </select>
            </div>
            <div style="width:150px;">
                <label class="form-label">From</label>
                <input type="date" name="from" value="@Model.FromDate?.ToString("yyyy-MM-dd")" class="form-control" />
            </div>
            <div style="width:150px;">
                <label class="form-label">To</label>
                <input type="date" name="to" value="@Model.ToDate?.ToString("yyyy-MM-dd")" class="form-control" />
            </div>
            <button type="submit" class="btn btn-primary btn-sm"><i class="fas fa-filter" style="margin-right:0.25rem;"></i> Filter</button>
            <a asp-action="Expenses" class="btn btn-ghost btn-sm" title="Clear"><i class="fas fa-times"></i></a>
        </form>
    </div>
</div>

<!-- Summary Cards -->
<div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:1rem; margin-bottom:1.5rem;">
    <div class="kpi-card">
        <div class="kpi-icon" style="background:rgba(249,115,22,0.1); color:#f97316;"><i class="fas fa-money-bill"></i></div>
        <span class="kpi-label">Total Amount</span>
        <span class="kpi-value" style="color:#f97316;">Rs. @Model.TotalAmount.ToString("N2")</span>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon" style="background:rgba(59,130,246,0.1); color:var(--info);"><i class="fas fa-list"></i></div>
        <span class="kpi-label">Total Records</span>
        <span class="kpi-value" style="color:var(--info);">@Model.TotalItems</span>
    </div>
</div>

<!-- Table -->
<div class="card">
    <div class="card-body card-body-flush">
        <div style="overflow-x:auto;">
            <table class="premium-table">
                <thead>
                    <tr>
                        <th>Title</th>
                        <th>Category</th>
                        <th>Branch</th>
                        <th style="text-align:right;">Amount</th>
                        <th>Date</th>
                        <th style="text-align:center;">Status</th>
                        <th style="text-align:center;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Expenses.Any())
                    {
                        <tr>
                            <td colspan="7">
                                <div class="empty-state">
                                    <i class="fas fa-receipt"></i>
                                    <h3>No Expenses</h3>
                                    <p>No expenses found matching filters.</p>
                                </div>
                            </td>
                        </tr>
                    }
                    @foreach (var e in Model.Expenses)
                    {
                        var catBadge = e.Category switch
                        {
                            "Utilities" => "badge-warning",
                            "Maintenance" => "badge-info",
                            "Supplies" => "badge-success",
                            "Rent" => "badge-accent",
                            "Bills" => "badge-danger",
                            "Marketing" => "badge-info",
                            _ => "badge-neutral"
                        };
                        var statusBadge = e.ApprovalStatus switch
                        {
                            "Approved" => "badge-success",
                            "Pending" => "badge-warning",
                            "Rejected" => "badge-danger",
                            _ => "badge-neutral"
                        };
                        <tr>
                            <td>
                                <span style="font-weight:600;">@e.Title</span>
                                @if (!string.IsNullOrEmpty(e.Description))
                                {
                                    <br /><span class="caption">@(e.Description.Length > 50 ? e.Description[..50] + "..." : e.Description)</span>
                                }
                                @if (e.IsRecurring)
                                {
                                    <br /><span class="caption" style="color:#8b5cf6;"><i class="fas fa-sync-alt" style="margin-right:0.25rem;"></i>@e.RecurringFrequency</span>
                                }
                            </td>
                            <td><span class="badge @catBadge">@e.Category</span></td>
                            <td>@e.Branch?.Name</td>
                            <td style="text-align:right; font-weight:700;">Rs. @e.Amount.ToString("N2")</td>
                            <td>@e.ExpenseDate.ToString("dd MMM yyyy")</td>
                            <td style="text-align:center;"><span class="badge @statusBadge">@e.ApprovalStatus</span></td>
                            <td style="text-align:center;">
                                <div style="display:flex; align-items:center; justify-content:center; gap:0.5rem;">
                                    <a asp-action="EditExpense" asp-route-id="@e.Id" class="btn btn-ghost btn-sm" title="Edit">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    @if (ViewBag.UserRole == "Owner" || Context.Session.GetString("UserRole") == "Owner")
                                    {
                                        <form asp-action="DeleteExpense" asp-route-id="@e.Id" method="post" style="display:inline;"
                                              data-confirm="Delete this expense?">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-ghost btn-sm" style="color:var(--danger);" title="Delete">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Pagination -->
@if (Model.TotalPages > 1)
{
    <div style="display:flex; align-items:center; justify-content:space-between; margin-top:1rem; flex-wrap:wrap; gap:0.5rem;">
        <span class="caption">
            Showing @(((Model.CurrentPage - 1) * Model.PageSize) + 1) -
            @Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalItems) of @Model.TotalItems
        </span>
        <div style="display:flex; gap:0.25rem;">
            @if (Model.CurrentPage > 1)
            {
                <a asp-action="Expenses" asp-route-page="@(Model.CurrentPage - 1)" asp-route-branchId="@Model.BranchId"
                   asp-route-category="@Model.Category" asp-route-from="@Model.FromDate?.ToString("yyyy-MM-dd")" asp-route-to="@Model.ToDate?.ToString("yyyy-MM-dd")"
                   class="btn btn-ghost btn-sm"><i class="fas fa-chevron-left"></i></a>
            }
            @for (int p = Math.Max(1, Model.CurrentPage - 2); p <= Math.Min(Model.TotalPages, Model.CurrentPage + 2); p++)
            {
                <a asp-action="Expenses" asp-route-page="@p" asp-route-branchId="@Model.BranchId"
                   asp-route-category="@Model.Category" asp-route-from="@Model.FromDate?.ToString("yyyy-MM-dd")" asp-route-to="@Model.ToDate?.ToString("yyyy-MM-dd")"
                   class="btn btn-sm @(p == Model.CurrentPage ? "btn-primary" : "btn-ghost")">@p</a>
            }
            @if (Model.CurrentPage < Model.TotalPages)
            {
                <a asp-action="Expenses" asp-route-page="@(Model.CurrentPage + 1)" asp-route-branchId="@Model.BranchId"
                   asp-route-category="@Model.Category" asp-route-from="@Model.FromDate?.ToString("yyyy-MM-dd")" asp-route-to="@Model.ToDate?.ToString("yyyy-MM-dd")"
                   class="btn btn-ghost btn-sm"><i class="fas fa-chevron-right"></i></a>
            }
        </div>
    </div>
}

<!-- Back -->
<div style="margin-top:1.5rem;">
    <a asp-action="Dashboard" class="btn btn-ghost btn-sm"><i class="fas fa-arrow-left" style="margin-right:0.5rem;"></i> Back to Dashboard</a>
</div>
