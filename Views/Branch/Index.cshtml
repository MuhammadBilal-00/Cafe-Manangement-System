@model IEnumerable<Cafe.Models.Branch>
@{
    ViewData["Title"] = "Branches";
    var isOwner = Context.Session.GetString("UserRole") == "Owner";
}

<!-- Page Header -->
<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-7">
    <div>
        <h1 class="page-title">Branches</h1>
        <p class="body-text mt-1">Manage all branch locations and their assigned managers.</p>
    </div>
    @if (isOwner)
    {
        <div class="flex items-center gap-3">
            <a asp-controller="Branch" asp-action="ExportCsv" class="btn btn-ghost btn-sm">
                <i class="fas fa-download"></i> Export
            </a>
            <a asp-action="Create" class="btn btn-primary">
                <i class="fas fa-plus"></i> Add Branch
            </a>
        </div>
    }
</div>

<!-- KPI Cards -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 mb-7">
    <div class="kpi-card">
        <div class="kpi-icon" style="background:rgba(212,175,55,0.10);color:#d4af37;">
            <i class="fas fa-store"></i>
        </div>
        <div class="kpi-label">Total Branches</div>
        <div class="kpi-value">@Model.Count()</div>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon" style="background:rgba(34,197,94,0.10);color:#22c55e;">
            <i class="fas fa-check-circle"></i>
        </div>
        <div class="kpi-label">Active</div>
        <div class="kpi-value">@Model.Count(b => b.IsActive)</div>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon" style="background:rgba(99,102,241,0.10);color:#6366f1;">
            <i class="fas fa-user-tie"></i>
        </div>
        <div class="kpi-label">Managed</div>
        <div class="kpi-value">@Model.Count(b => b.ManagerId.HasValue)</div>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon" style="background:rgba(168,85,247,0.10);color:#a855f7;">
            <i class="fas fa-calendar-plus"></i>
        </div>
        <div class="kpi-label">New (30 days)</div>
        <div class="kpi-value">@Model.Count(b => b.CreatedDate >= DateTime.Now.AddDays(-30))</div>
    </div>
</div>

<!-- Branches Table -->
<div class="card">
    <div class="card-header">
        <h3 class="section-title">All Branches</h3>
        <span class="badge badge-neutral">@Model.Count() records</span>
    </div>
    <div class="card-body card-body-flush">
        @if (Model.Any())
        {
            <div class="overflow-x-auto">
                <table class="premium-table">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Location</th>
                            <th>Contact</th>
                            <th>Manager</th>
                            <th>Status</th>
                            <th style="text-align:right;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <span class="font-semibold" style="color:var(--text-primary);">@item.Name</span>
                                </td>
                                <td>@item.Location</td>
                                <td>@item.ContactInfo</td>
                                <td>
                                    @if (item.Manager != null)
                                    {
                                        <span>@item.Manager.Name</span>
                                    }
                                    else
                                    {
                                        <span style="color:var(--text-tertiary);">Not assigned</span>
                                    }
                                </td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge badge-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-neutral">Inactive</span>
                                    }
                                </td>
                                <td style="text-align:right;">
                                    <div class="flex items-center justify-end gap-2">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-ghost btn-sm" title="View">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        @if (isOwner)
                                        {
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-secondary btn-sm" title="Edit">
                                                <i class="fas fa-pen"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm" title="Delete">
                                                <i class="fas fa-trash"></i>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <div class="empty-state-icon"><i class="fas fa-store"></i></div>
                <p class="empty-state-title">No branches found</p>
                <p class="empty-state-text">Get started by adding your first branch location.</p>
                @if (isOwner)
                {
                    <a asp-action="Create" class="btn btn-primary" style="margin-top:16px;">
                        <i class="fas fa-plus"></i> Add First Branch
                    </a>
                }
            </div>
        }
    </div>
</div>
