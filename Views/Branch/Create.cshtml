@model Cafe.Models.Branch
@{
    ViewData["Title"] = "Add Branch";
}

<!-- Page Header -->
<div class="flex items-center gap-3 mb-7">
    <a asp-action="Index" class="btn btn-ghost btn-sm"><i class="fas fa-arrow-left"></i></a>
    <div>
        <h1 class="page-title">Add New Branch</h1>
        <p class="body-text mt-1">Fill in the details below to register a new branch location.</p>
    </div>
</div>

<div class="card" style="max-width:820px;">
    <div class="card-header">
        <h3 class="section-title"><i class="fas fa-store" style="color:var(--accent);margin-right:8px;"></i> Branch Information</h3>
    </div>
    <div class="card-body">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="form-error" style="margin-bottom:20px;"></div>

            <div class="form-row">
                <div class="form-group">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" placeholder="Enter branch name" />
                    <span asp-validation-for="Name" class="form-error"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Location" class="form-label"></label>
                    <input asp-for="Location" class="form-control" placeholder="Enter location" />
                    <span asp-validation-for="Location" class="form-error"></span>
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label asp-for="ContactInfo" class="form-label"></label>
                    <input asp-for="ContactInfo" class="form-control" placeholder="Phone or email" />
                    <span asp-validation-for="ContactInfo" class="form-error"></span>
                </div>
                <div class="form-group">
                    <label asp-for="ManagerId" class="form-label">Manager</label>
                    <select asp-for="ManagerId" asp-items="ViewBag.Managers" class="form-select">
                        <option value="">Select a Manager</option>
                    </select>
                    <span asp-validation-for="ManagerId" class="form-error"></span>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="OpeningHours" class="form-label"></label>
                <textarea asp-for="OpeningHours" class="form-control" rows="3" placeholder="e.g., Mon-Fri: 8AM-10PM, Sat-Sun: 9AM-11PM"></textarea>
                <span asp-validation-for="OpeningHours" class="form-error"></span>
            </div>

            <div class="form-group" style="flex-direction:row;align-items:center;gap:10px;">
                <input asp-for="IsActive" style="width:18px;height:18px;accent-color:var(--accent);" />
                <label asp-for="IsActive" class="form-label" style="margin:0;">Active Branch</label>
            </div>

            <div class="divider"></div>

            <div class="flex justify-end gap-3">
                <a asp-action="Index" class="btn btn-ghost">Cancel</a>
                <button type="submit" class="btn btn-primary"><i class="fas fa-check"></i> Create Branch</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
