@model Cafe.Models.Branch
@{
    ViewData["Title"] = "Branch Details";
}

<!-- Page Header -->
<div class="flex items-center justify-between mb-7">
    <div class="flex items-center gap-3">
        <a asp-action="Index" class="btn btn-ghost btn-sm"><i class="fas fa-arrow-left"></i></a>
        <div>
            <h1 class="page-title">@Model.Name</h1>
            <p class="body-text mt-1">Branch detail overview and quick stats.</p>
        </div>
    </div>
    <div class="flex items-center gap-3">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-secondary btn-sm"><i class="fas fa-pen"></i> Edit</a>
        <a asp-action="Index" class="btn btn-ghost btn-sm">Back to List</a>
    </div>
</div>

<!-- Branch Header Card -->
<div class="card mb-5 overflow-hidden">
    <div class="bg-gradient-to-br from-sidebar to-[#2d3e50] px-8 py-7 text-white">
        <div class="flex items-center justify-between flex-wrap gap-4">
            <div>
                <h2 style="font-size:1.5rem;font-weight:700;">@Model.Name</h2>
                <p style="color:var(--text-tertiary);margin-top:4px;">@Model.Location</p>
            </div>
            <div class="text-right">
                @if (Model.IsActive)
                {
                    <span class="badge badge-success">Active</span>
                }
                else
                {
                    <span class="badge badge-neutral">Inactive</span>
                }
                <p style="color:var(--text-tertiary);font-size:12px;margin-top:6px;">Created @Model.CreatedDate.ToString("MMM dd, yyyy")</p>
            </div>
        </div>
    </div>
</div>

<!-- Detail Grid -->
<div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-5">
    <!-- Contact -->
    <div class="card">
        <div class="card-header">
            <h3 class="section-title"><i class="fas fa-phone" style="color:var(--accent);margin-right:8px;"></i>Contact</h3>
        </div>
        <div class="card-body space-y-3">
            <div>
                <span class="caption">Phone / Email</span>
                <p class="font-medium" style="color:var(--text-primary);">@Model.ContactInfo</p>
            </div>
            <div>
                <span class="caption">Manager</span>
                <p class="font-medium" style="color:var(--text-primary);">
                    @(Model.Manager != null ? Model.Manager.Name : "Not assigned")
                </p>
            </div>
        </div>
    </div>

    <!-- Hours -->
    <div class="card">
        <div class="card-header">
            <h3 class="section-title"><i class="fas fa-clock" style="color:var(--accent);margin-right:8px;"></i>Opening Hours</h3>
        </div>
        <div class="card-body">
            @if (!string.IsNullOrWhiteSpace(Model.OpeningHours))
            {
                <p style="color:var(--text-secondary);white-space:pre-line;">@Model.OpeningHours</p>
            }
            else
            {
                <p style="color:var(--text-tertiary);">Not specified</p>
            }
        </div>
    </div>
</div>

<!-- Actions -->
<div class="card">
    <div class="card-body">
        <div class="flex justify-end gap-3">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-secondary"><i class="fas fa-pen"></i> Edit Branch</a>
            <a asp-action="Index" class="btn btn-ghost">Back to List</a>
        </div>
    </div>
</div>
