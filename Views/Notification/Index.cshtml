@{
    ViewData["Title"] = "Notifications";

    var notifications = (List<Cafe.Services.NotificationDto>)ViewBag.Notifications;
    int page = ViewBag.Page;
    int totalPages = ViewBag.TotalPages;
    int totalCount = ViewBag.TotalCount;
    int unreadCount = ViewBag.UnreadCount;
    int readCount = ViewBag.ReadCount;
    bool? filterRead = ViewBag.FilterIsRead;
    string filterType = ViewBag.FilterType;
    DateTime? filterFrom = ViewBag.FilterFrom;
    DateTime? filterTo = ViewBag.FilterTo;

    string[] typeLabels = ViewBag.TypeLabels ?? Array.Empty<string>();
    int[] typeCounts = ViewBag.TypeCounts ?? Array.Empty<int>();
    int[] readPieData = ViewBag.ReadPieData ?? new[] { 0, 0 };
    string[] trendLabels = ViewBag.TrendLabels ?? Array.Empty<string>();
    int[] trendCounts = ViewBag.TrendCounts ?? Array.Empty<int>();
}

<!-- Page Header -->
<div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:1rem;margin-bottom:1.5rem;">
    <div>
        <h1 class="page-title" style="margin:0;">
            <i class="fas fa-bell" style="color:#d4af37;margin-right:0.5rem;"></i>Notifications
        </h1>
        <p class="body-text" style="margin-top:0.25rem;color:var(--text-secondary);">
            Real-time updates across your workspace
        </p>
    </div>
    <div style="display:flex;gap:0.5rem;align-items:center;">
        <a asp-action="Preferences" class="btn btn-outline" style="font-size:0.8rem;">
            <i class="fas fa-sliders" style="margin-right:0.3rem;"></i> Preferences
        </a>
        <button onclick="markAllRead()" class="btn btn-outline" style="font-size:0.8rem;">
            <i class="fas fa-check-double" style="margin-right:0.3rem;"></i> Mark All Read
        </button>
        @if (ViewBag.UserRole == "Owner")
        {
            <a asp-action="Admin" class="btn btn-primary" style="font-size:0.8rem;">
                <i class="fas fa-bullhorn" style="margin-right:0.3rem;"></i> Admin Panel
            </a>
        }
    </div>
</div>

<!-- KPI Cards -->
<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
    <div class="card p-5 relative overflow-hidden">
        <div class="absolute -top-2 -right-2 w-[52px] h-[52px] rounded-full bg-indigo-500/10 flex items-center justify-center">
            <i class="fas fa-bell text-indigo-500 text-base"></i>
        </div>
        <div class="caption mb-1">Total</div>
        <div class="text-[1.75rem] font-extrabold text-indigo-500 leading-none">@totalCount</div>
        <div class="caption mt-1.5">notifications</div>
    </div>
    <div class="card p-5 relative overflow-hidden">
        <div class="absolute -top-2 -right-2 w-[52px] h-[52px] rounded-full bg-red-500/10 flex items-center justify-center">
            <i class="fas fa-envelope text-red-500 text-base"></i>
        </div>
        <div class="caption mb-1">Unread</div>
        <div class="text-[1.75rem] font-extrabold text-red-500 leading-none">@unreadCount</div>
        <div class="caption mt-1.5">need attention</div>
    </div>
    <div class="card p-5 relative overflow-hidden">
        <div class="absolute -top-2 -right-2 w-[52px] h-[52px] rounded-full bg-green-600/10 flex items-center justify-center">
            <i class="fas fa-check-circle text-green-600 text-base"></i>
        </div>
        <div class="caption mb-1">Read</div>
        <div class="text-[1.75rem] font-extrabold text-green-600 leading-none">@readCount</div>
        <div class="caption mt-1.5">reviewed</div>
    </div>
    <div class="card p-5 relative overflow-hidden">
        <div class="absolute -top-2 -right-2 w-[52px] h-[52px] rounded-full bg-[#d4af37]/10 flex items-center justify-center">
            <i class="fas fa-tags text-[#d4af37] text-base"></i>
        </div>
        <div class="caption mb-1">Types</div>
        <div class="text-[1.75rem] font-extrabold text-[#d4af37] leading-none">@typeLabels.Length</div>
        <div class="caption mt-1.5">categories</div>
    </div>
</div>

<!-- Charts Row -->
<div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:1rem;margin-bottom:1.5rem;">
    <!-- Read vs Unread Pie -->
    <div class="card">
        <div class="card-header">
            <h3 class="section-title" style="font-size:0.85rem;">
                <i class="fas fa-chart-pie" style="color:#6366f1;margin-right:0.4rem;"></i>Read vs Unread
            </h3>
        </div>
        <div class="card-body relative h-[220px]">
            <canvas id="readPieChart"></canvas>
        </div>
    </div>

    <!-- Type Distribution Pie -->
    <div class="card">
        <div class="card-header">
            <h3 class="section-title" style="font-size:0.85rem;">
                <i class="fas fa-chart-pie" style="color:#f59e0b;margin-right:0.4rem;"></i>By Type
            </h3>
        </div>
        <div class="card-body relative h-[220px]">
            <canvas id="typePieChart"></canvas>
        </div>
    </div>

    <!-- 7-Day Trend Line -->
    <div class="card">
        <div class="card-header">
            <h3 class="section-title" style="font-size:0.85rem;">
                <i class="fas fa-chart-line" style="color:#10b981;margin-right:0.4rem;"></i>7-Day Trend
            </h3>
        </div>
        <div class="card-body relative h-[220px]">
            <canvas id="trendChart"></canvas>
        </div>
    </div>
</div>

<!-- Filters -->
<div class="card mb-5">
    <div class="card-body card-body-compact">
        <form method="get" asp-action="Index" style="display:flex;flex-wrap:wrap;gap:0.75rem;align-items:end;">
            <div style="display:flex;flex-direction:column;gap:0.25rem;">
                <label class="caption">Status</label>
                <select name="isRead" class="form-control" style="min-width:130px;">
                    <option value="">All</option>
                    @{ var selUnread = filterRead == false ? "selected" : ""; }
                    <option value="false" selected="@selUnread">Unread</option>
                    @{ var selRead = filterRead == true ? "selected" : ""; }
                    <option value="true" selected="@selRead">Read</option>
                </select>
            </div>
            <div style="display:flex;flex-direction:column;gap:0.25rem;">
                <label class="caption">Type</label>
                <select name="type" class="form-control" style="min-width:130px;">
                    <option value="">All Types</option>
                    @{ var selInfo = filterType == "Info" ? "selected" : ""; }
                    <option value="Info" selected="@selInfo">Info</option>
                    @{ var selSuccess = filterType == "Success" ? "selected" : ""; }
                    <option value="Success" selected="@selSuccess">Success</option>
                    @{ var selWarning = filterType == "Warning" ? "selected" : ""; }
                    <option value="Warning" selected="@selWarning">Warning</option>
                    @{ var selError = filterType == "Error" ? "selected" : ""; }
                    <option value="Error" selected="@selError">Error</option>
                </select>
            </div>
            <div style="display:flex;flex-direction:column;gap:0.25rem;">
                <label class="caption">From</label>
                <input type="date" name="from" class="form-control" value="@(filterFrom?.ToString("yyyy-MM-dd"))" />
            </div>
            <div style="display:flex;flex-direction:column;gap:0.25rem;">
                <label class="caption">To</label>
                <input type="date" name="to" class="form-control" value="@(filterTo?.ToString("yyyy-MM-dd"))" />
            </div>
            <button type="submit" class="btn btn-primary" style="font-size:0.8rem;">
                <i class="fas fa-filter" style="margin-right:0.3rem;"></i> Filter
            </button>
            <a asp-action="Index" class="btn btn-outline" style="font-size:0.8rem;">Clear</a>
        </form>
    </div>
</div>

<!-- Notification List -->
<div class="card">
    <div class="card-header flex items-center justify-between">
        <h3 class="section-title" style="font-size:0.85rem;">
            <i class="fas fa-stream" style="color:#6366f1;margin-right:0.4rem;"></i>Activity Feed
        </h3>
        <span class="caption">Page @(page) of @totalPages</span>
    </div>
    <div class="card-body card-body-flush">
        @if (!notifications.Any())
        {
            <div style="text-align:center;padding:3.5rem 1rem;">
                <div style="width:64px;height:64px;border-radius:16px;background:rgba(99,102,241,0.08);display:flex;align-items:center;justify-content:center;margin:0 auto 1rem;">
                    <i class="fas fa-bell-slash" style="font-size:1.5rem;color:var(--text-tertiary);"></i>
                </div>
                <p style="font-weight:600;font-size:0.9rem;color:var(--text-secondary);margin:0 0 0.25rem;">No notifications found</p>
                <p class="caption">Adjust your filters or check back later</p>
            </div>
        }
        else
        {
            @foreach (var n in notifications)
            {
                string typeColor = n.Type switch
                {
                    "Success" => "#16a34a",
                    "Warning" => "#d97706",
                    "Error" => "#dc2626",
                    _ => "#6366f1"
                };
                string bgColor = n.IsRead ? "transparent" : "rgba(99,102,241,0.04)";
                string borderLeft = n.IsRead ? "3px solid transparent" : $"3px solid {typeColor}";

                <div class="notif-row" data-id="@n.Id"
                     style="display:flex;align-items:flex-start;gap:0.85rem;padding:0.9rem 1.25rem;border-bottom:1px solid var(--border-light);background:@bgColor;border-left:@borderLeft;cursor:pointer;transition:all 0.25s ease;"
                     onclick="openNotification(@n.Id, '@(n.RedirectUrl ?? "")')"
                     onmouseenter="this.style.background='var(--bg-hover)';this.style.paddingLeft='1.5rem'"
                     onmouseleave="this.style.background='@bgColor';this.style.paddingLeft='1.25rem'">

                    <!-- Icon -->
                    <div style="width:38px;height:38px;border-radius:12px;background:@(typeColor)14;color:@typeColor;display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:0.85rem;box-shadow:0 2px 8px @(typeColor)20;">
                        <i class="@(n.Icon ?? "fas fa-info-circle")"></i>
                    </div>

                    <!-- Content -->
                    <div style="flex:1;min-width:0;">
                        <div style="display:flex;align-items:center;gap:0.5rem;margin-bottom:0.15rem;">
                            <span style="font-weight:@(n.IsRead ? "500" : "700");font-size:0.85rem;color:var(--text-primary);">@n.Title</span>
                            @if (!n.IsRead)
                            {
                                <span style="width:7px;height:7px;border-radius:50%;background:@typeColor;flex-shrink:0;animation:pulse 2s infinite;"></span>
                            }
                            <span style="margin-left:auto;background:@(typeColor)14;color:@typeColor;font-size:0.6rem;font-weight:700;padding:0.15rem 0.5rem;border-radius:20px;letter-spacing:0.5px;text-transform:uppercase;">@n.Type</span>
                        </div>
                        <p style="margin:0;font-size:0.78rem;color:var(--text-secondary);line-height:1.45;@(n.IsRead ? "" : "font-weight:500;")">
                            @(n.Message.Length > 140 ? n.Message.Substring(0, 140) + "..." : n.Message)
                        </p>
                        <div style="display:flex;align-items:center;gap:0.75rem;margin-top:0.35rem;">
                            <span class="caption"><i class="far fa-clock" style="margin-right:0.25rem;"></i>@n.TimeAgo</span>
                            @if (!string.IsNullOrEmpty(n.RedirectUrl))
                            {
                                <span class="caption" style="color:#6366f1;"><i class="fas fa-external-link-alt" style="margin-right:0.2rem;font-size:0.55rem;"></i>View</span>
                            }
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

<!-- Pagination -->
@if (totalPages > 1)
{
    <div style="display:flex;justify-content:center;align-items:center;gap:0.4rem;margin-top:1.25rem;">
        @if (page > 1)
        {
            <a asp-action="Index" asp-route-page="@(page - 1)" asp-route-isRead="@filterRead" asp-route-type="@filterType"
               asp-route-from="@(filterFrom?.ToString("yyyy-MM-dd"))" asp-route-to="@(filterTo?.ToString("yyyy-MM-dd"))"
               class="btn btn-outline" style="width:36px;height:36px;padding:0;display:flex;align-items:center;justify-content:center;font-size:0.75rem;">
                <i class="fas fa-chevron-left"></i>
            </a>
        }
        @for (int p = 1; p <= totalPages; p++)
        {
            var isActive = p == page;
            <a asp-action="Index"
               asp-route-page="@p"
               asp-route-isRead="@filterRead"
               asp-route-type="@filterType"
               asp-route-from="@(filterFrom?.ToString("yyyy-MM-dd"))"
               asp-route-to="@(filterTo?.ToString("yyyy-MM-dd"))"
               class="btn @(isActive ? "btn-primary" : "btn-outline")"
               style="width:36px;height:36px;padding:0;display:flex;align-items:center;justify-content:center;font-size:0.8rem;">
                @p
            </a>
        }
        @if (page < totalPages)
        {
            <a asp-action="Index" asp-route-page="@(page + 1)" asp-route-isRead="@filterRead" asp-route-type="@filterType"
               asp-route-from="@(filterFrom?.ToString("yyyy-MM-dd"))" asp-route-to="@(filterTo?.ToString("yyyy-MM-dd"))"
               class="btn btn-outline" style="width:36px;height:36px;padding:0;display:flex;align-items:center;justify-content:center;font-size:0.75rem;">
                <i class="fas fa-chevron-right"></i>
            </a>
        }
    </div>
}

<style>
    @@keyframes pulse {
        0%, 100% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.5; transform: scale(1.3); }
    }
</style>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
        // ── Actions ──
        async function markAllRead() {
            await fetch('/Notification/MarkAllAsRead', { method: 'POST' });
            window.location.reload();
        }

        async function openNotification(id, url) {
            await fetch('/Notification/MarkAsRead?id=' + id, { method: 'POST' });
            if (url && url.length > 0) {
                window.location.href = url;
            } else {
                const row = document.querySelector(`.notif-row[data-id="${id}"]`);
                if (row) {
                    row.style.background = 'transparent';
                    row.style.borderLeft = '3px solid transparent';
                    const dot = row.querySelector('[style*="animation:pulse"]');
                    if (dot) dot.remove();
                }
            }
        }

        // ── Chart Colors ──
        const typeColorMap = { 'Info': '#6366f1', 'Success': '#16a34a', 'Warning': '#d97706', 'Error': '#dc2626' };

        // ── Read vs Unread Doughnut ──
        const readData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(readPieData));
        new Chart(document.getElementById('readPieChart'), {
            type: 'doughnut',
            data: {
                labels: ['Unread', 'Read'],
                datasets: [{
                    data: readData,
                    backgroundColor: ['#ef4444cc', '#16a34acc'],
                    borderColor: ['#ef4444', '#16a34a'],
                    borderWidth: 2,
                    hoverOffset: 6
                }]
            },
            options: {
                responsive: true, maintainAspectRatio: false,
                cutout: '62%',
                plugins: {
                    legend: { position: 'bottom', labels: { boxWidth: 10, padding: 10, font: { size: 11 } } },
                    tooltip: {
                        callbacks: {
                            label: ctx => {
                                const total = ctx.dataset.data.reduce((a, b) => a + b, 0);
                                const pct = total > 0 ? (ctx.raw / total * 100).toFixed(1) : 0;
                                return ` ${ctx.label}: ${ctx.raw} (${pct}%)`;
                            }
                        }
                    }
                }
            }
        });

        // ── Type Distribution Doughnut ──
        const tLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(typeLabels));
        const tCounts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(typeCounts));
        const tColors = tLabels.map(l => typeColorMap[l] || '#8b5cf6');
        new Chart(document.getElementById('typePieChart'), {
            type: 'doughnut',
            data: {
                labels: tLabels,
                datasets: [{
                    data: tCounts,
                    backgroundColor: tColors.map(c => c + 'cc'),
                    borderColor: tColors,
                    borderWidth: 2,
                    hoverOffset: 6
                }]
            },
            options: {
                responsive: true, maintainAspectRatio: false,
                cutout: '62%',
                plugins: {
                    legend: { position: 'bottom', labels: { boxWidth: 10, padding: 10, font: { size: 11 } } },
                    tooltip: {
                        callbacks: {
                            label: ctx => {
                                const total = ctx.dataset.data.reduce((a, b) => a + b, 0);
                                const pct = total > 0 ? (ctx.raw / total * 100).toFixed(1) : 0;
                                return ` ${ctx.label}: ${ctx.raw} (${pct}%)`;
                            }
                        }
                    }
                }
            }
        });

        // ── 7-Day Trend Line ──
        const trLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(trendLabels));
        const trCounts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(trendCounts));
        new Chart(document.getElementById('trendChart'), {
            type: 'line',
            data: {
                labels: trLabels,
                datasets: [{
                    label: 'Notifications',
                    data: trCounts,
                    borderColor: '#6366f1',
                    backgroundColor: 'rgba(99,102,241,0.08)',
                    borderWidth: 2.5,
                    pointBackgroundColor: '#6366f1',
                    pointBorderColor: '#fff',
                    pointBorderWidth: 2,
                    pointRadius: 4,
                    pointHoverRadius: 6,
                    fill: true,
                    tension: 0.35
                }]
            },
            options: {
                responsive: true, maintainAspectRatio: false,
                scales: {
                    y: { beginAtZero: true, ticks: { stepSize: 1, font: { size: 10 } }, grid: { color: 'rgba(0,0,0,0.05)' } },
                    x: { ticks: { font: { size: 10 } }, grid: { display: false } }
                },
                plugins: {
                    legend: { display: false },
                    tooltip: { callbacks: { label: ctx => ` ${ctx.raw} notifications` } }
                }
            }
        });
    </script>
}
