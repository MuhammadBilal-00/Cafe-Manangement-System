@{
    ViewData["Title"] = "Notification Manager";

    var branches = (List<Cafe.Models.Branch>)ViewBag.Branches;
    var users = (List<Cafe.Models.User>)ViewBag.Users;
    var roles = (string[])ViewBag.Roles;

    int emailTotal = ViewBag.EmailTotal;
    int emailSent = ViewBag.EmailSent;
    int emailPending = ViewBag.EmailPending;
    int emailFailed = ViewBag.EmailFailed;

    int notifTotal = ViewBag.NotifTotal;
    int notifRead = ViewBag.NotifRead;
    int notifUnread = ViewBag.NotifUnread;

    string[] notifTypeLabels = ViewBag.NotifTypeLabels ?? Array.Empty<string>();
    int[] notifTypeCounts = ViewBag.NotifTypeCounts ?? Array.Empty<int>();
    string[] targetLabels = ViewBag.TargetLabels ?? Array.Empty<string>();
    int[] targetCounts = ViewBag.TargetCounts ?? Array.Empty<int>();
    string[] emailTrendLabels = ViewBag.EmailTrendLabels ?? Array.Empty<string>();
    int[] emailTrendCounts = ViewBag.EmailTrendCounts ?? Array.Empty<int>();

    var recentEmails = (List<Cafe.Models.EmailQueue>)ViewBag.RecentEmails;
}

<!-- Page Header -->
<div class="flex items-center justify-between flex-wrap gap-4 mb-6">
    <div>
        <h1 class="page-title" style="margin:0;">
            <i class="fas fa-satellite-dish" style="color:var(--accent);margin-right:0.5rem;"></i>Notification Manager
        </h1>
        <p class="body-text" style="margin-top:0.25rem;color:var(--text-secondary);">
            Send notifications, monitor delivery, and view system analytics
        </p>
    </div>
    <a asp-action="Index" class="btn btn-outline" style="font-size:0.8rem;">
        <i class="fas fa-arrow-left" style="margin-right:0.3rem;"></i> All Notifications
    </a>
</div>

<!-- KPI Cards Row 1: Notifications -->
<div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">
    <div class="card card-accent-info p-5 relative overflow-hidden">
        <div style="position:absolute;top:-8px;right:-8px;width:52px;height:52px;border-radius:50%;background:var(--info-light);display:flex;align-items:center;justify-content:center;">
            <i class="fas fa-bell" style="color:var(--info);font-size:1rem;"></i>
        </div>
        <div class="caption" style="margin-bottom:0.3rem;">Total Notifications</div>
        <div style="font-size:1.75rem;font-weight:800;color:var(--info);line-height:1;">@notifTotal</div>
        <div class="caption" style="margin-top:0.35rem;">
            <span style="color:var(--success);">@notifRead read</span> · <span style="color:var(--danger);">@notifUnread unread</span>
        </div>
    </div>
    <div class="card card-accent-success p-5 relative overflow-hidden">
        <div style="position:absolute;top:-8px;right:-8px;width:52px;height:52px;border-radius:50%;background:rgba(22,163,106,0.1);display:flex;align-items:center;justify-content:center;">
            <i class="fas fa-envelope-circle-check" style="color:var(--success);font-size:1rem;"></i>
        </div>
        <div class="caption" style="margin-bottom:0.3rem;">Emails Sent</div>
        <div style="font-size:1.75rem;font-weight:800;color:var(--success);line-height:1;">@emailSent</div>
        <div class="caption" style="margin-top:0.35rem;">of @emailTotal total emails</div>
    </div>
    <div class="card card-accent-warning p-5 relative overflow-hidden">
        <div style="position:absolute;top:-8px;right:-8px;width:52px;height:52px;border-radius:50%;background:rgba(217,119,6,0.1);display:flex;align-items:center;justify-content:center;">
            <i class="fas fa-clock-rotate-left" style="color:var(--warning);font-size:1rem;"></i>
        </div>
        <div class="caption" style="margin-bottom:0.3rem;">Queue Status</div>
        <div style="font-size:1.75rem;font-weight:800;color:var(--warning);line-height:1;">@emailPending</div>
        <div class="caption" style="margin-top:0.35rem;">
            pending · <span style="color:var(--danger);">@emailFailed failed</span>
        </div>
    </div>
</div>

<!-- Charts Row: 4 charts -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
    <!-- Email Delivery Status Pie -->
    <div class="card">
        <div class="card-header">
            <h3 class="section-title" style="font-size:0.8rem;">
                <i class="fas fa-chart-pie" style="color:var(--info);margin-right:0.35rem;"></i>Email Delivery
            </h3>
        </div>
        <div class="card-body relative h-[200px]">
            <canvas id="emailPieChart"></canvas>
        </div>
    </div>

    <!-- Notification Type Pie -->
    <div class="card">
        <div class="card-header">
            <h3 class="section-title" style="font-size:0.8rem;">
                <i class="fas fa-chart-pie" style="color:var(--warning);margin-right:0.35rem;"></i>Notification Types
            </h3>
        </div>
        <div class="card-body relative h-[200px]">
            <canvas id="typePieChart"></canvas>
        </div>
    </div>

    <!-- Target Distribution Pie -->
    <div class="card">
        <div class="card-header">
            <h3 class="section-title" style="font-size:0.8rem;">
                <i class="fas fa-chart-pie" style="color:var(--success);margin-right:0.35rem;"></i>Target Audience
            </h3>
        </div>
        <div class="card-body relative h-[200px]">
            <canvas id="targetPieChart"></canvas>
        </div>
    </div>

    <!-- Email Volume Trend -->
    <div class="card">
        <div class="card-header">
            <h3 class="section-title" style="font-size:0.8rem;">
                <i class="fas fa-chart-area" style="color:#ec4899;margin-right:0.35rem;"></i>Email Volume (7d)
            </h3>
        </div>
        <div class="card-body relative h-[200px]">
            <canvas id="emailTrendChart"></canvas>
        </div>
    </div>
</div>

<!-- Main Content: 2 columns -->
<div class="grid grid-cols-1 lg:grid-cols-2 gap-4 mb-6">
    <!-- Send Notification Form -->
    <div class="card">
        <div class="card-header">
            <h3 class="section-title" style="font-size:0.85rem;">
                <i class="fas fa-bullhorn" style="color:var(--accent);margin-right:0.4rem;"></i>Send Notification
            </h3>
        </div>
        <div class="card-body">
            <form method="post" asp-action="SendNotification" id="sendForm">
                <div style="display:flex;flex-direction:column;gap:0.9rem;">
                    <!-- Title -->
                    <div>
                        <label class="form-label" style="font-size:0.78rem;">Title <span style="color:var(--danger);">*</span></label>
                        <input type="text" name="title" class="form-control" required maxlength="200" placeholder="Notification title..." />
                    </div>

                    <!-- Message -->
                    <div>
                        <label class="form-label" style="font-size:0.78rem;">Message <span style="color:var(--danger);">*</span></label>
                        <textarea name="message" class="form-control" required maxlength="1000" rows="3" placeholder="Notification message..."></textarea>
                    </div>

                    <!-- Type + Target in row -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <div>
                            <label class="form-label" style="font-size:0.78rem;">Type</label>
                            <select name="type" class="form-control">
                                <option value="Info">&#xf05a; Info</option>
                                <option value="Success">&#xf058; Success</option>
                                <option value="Warning">&#xf071; Warning</option>
                                <option value="Error">&#xf057; Error</option>
                            </select>
                        </div>
                        <div>
                            <label class="form-label" style="font-size:0.78rem;">Target</label>
                            <select name="targetType" class="form-control" id="targetType" onchange="toggleTargetFields()">
                                <option value="all">All Users</option>
                                <option value="user">Specific User</option>
                                <option value="role">By Role</option>
                                <option value="branch">By Branch</option>
                            </select>
                        </div>
                    </div>

                    <!-- Dynamic target fields -->
                    <div id="fieldUser" style="display:none;">
                        <label class="form-label" style="font-size:0.78rem;">Select User</label>
                        <select name="targetUserId" class="form-control">
                            <option value="">-- Select --</option>
                            @foreach (var u in users)
                            {
                                <option value="@u.Id">@u.Name (@u.Role)</option>
                            }
                        </select>
                    </div>
                    <div id="fieldRole" style="display:none;">
                        <label class="form-label" style="font-size:0.78rem;">Select Role</label>
                        <select name="targetRole" class="form-control">
                            @foreach (var r in roles)
                            {
                                <option value="@r">@r</option>
                            }
                        </select>
                    </div>
                    <div id="fieldBranch" style="display:none;">
                        <label class="form-label" style="font-size:0.78rem;">Select Branch</label>
                        <select name="targetBranchId" class="form-control">
                            <option value="">-- Select --</option>
                            @foreach (var b in branches)
                            {
                                <option value="@b.Id">@b.Name</option>
                            }
                        </select>
                    </div>

                    <!-- Delivery -->
                    <div>
                        <label class="form-label" style="font-size:0.78rem;">Delivery Method</label>
                        <select name="deliveryMethod" class="form-control">
                            <option value="both">In-App + Email</option>
                            <option value="inapp">In-App Only</option>
                            <option value="email">Email Only</option>
                        </select>
                    </div>

                    <div style="display:flex;gap:0.75rem;margin-top:0.25rem;">
                        <button type="submit" class="btn btn-primary" style="flex:1;">
                            <i class="fas fa-paper-plane" style="margin-right:0.4rem;"></i> Send
                        </button>
                        <button type="reset" class="btn btn-outline">Reset</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Recent Email Queue -->
    <div class="card">
        <div class="card-header">
            <h3 class="section-title" style="font-size:0.85rem;">
                <i class="fas fa-inbox" style="color:var(--info);margin-right:0.4rem;"></i>Recent Email Queue
            </h3>
        </div>
        <div class="card-body card-body-flush">
            @if (!recentEmails.Any())
            {
                <div style="text-align:center;padding:3rem 1rem;">
                    <div style="width:52px;height:52px;border-radius:14px;background:rgba(59,130,246,0.08);display:flex;align-items:center;justify-content:center;margin:0 auto 0.75rem;">
                        <i class="fas fa-envelope-open" style="font-size:1.2rem;color:var(--text-tertiary);"></i>
                    </div>
                    <p class="caption">No emails in queue yet</p>
                </div>
            }
            else
            {
                <div style="overflow-x:auto;">
                    <table style="width:100%;border-collapse:collapse;font-size:0.75rem;">
                        <thead>
                            <tr style="background:var(--bg-secondary);border-bottom:2px solid var(--border-light);">
                                <th style="padding:0.6rem 0.75rem;text-align:left;font-weight:700;color:var(--text-secondary);">To</th>
                                <th style="padding:0.6rem 0.75rem;text-align:left;font-weight:700;color:var(--text-secondary);">Subject</th>
                                <th style="padding:0.6rem 0.5rem;text-align:center;font-weight:700;color:var(--text-secondary);">Status</th>
                                <th style="padding:0.6rem 0.75rem;text-align:right;font-weight:700;color:var(--text-secondary);">Time</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var em in recentEmails)
                            {
                                string statusColor = em.IsSent ? "var(--success)" : (em.RetryCount >= 3 ? "var(--danger)" : "var(--warning)");
                                string statusText = em.IsSent ? "Sent" : (em.RetryCount >= 3 ? "Failed" : "Pending");
                                string statusIcon = em.IsSent ? "fa-check-circle" : (em.RetryCount >= 3 ? "fa-times-circle" : "fa-clock");

                                <tr style="border-bottom:1px solid var(--border-light);">
                                    <td style="padding:0.55rem 0.75rem;max-width:120px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="@em.ToEmail">
                                        @(em.ToName ?? em.ToEmail)
                                    </td>
                                    <td style="padding:0.55rem 0.75rem;max-width:140px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="@em.Subject">
                                        @em.Subject
                                    </td>
                                    <td style="padding:0.55rem 0.5rem;text-align:center;">
                                        <span style="background:@(statusColor)14;color:@statusColor;font-size:0.6rem;font-weight:700;padding:0.15rem 0.45rem;border-radius:20px;">
                                            <i class="fas @statusIcon" style="margin-right:0.2rem;font-size:0.55rem;"></i>@statusText
                                        </span>
                                    </td>
                                    <td style="padding:0.55rem 0.75rem;text-align:right;color:var(--text-tertiary);font-size:0.7rem;">
                                        @em.CreatedAt.ToString("MMM dd HH:mm")
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // ── Target Field Toggle ──
        function toggleTargetFields() {
            const type = document.getElementById('targetType').value;
            document.getElementById('fieldUser').style.display = type === 'user' ? '' : 'none';
            document.getElementById('fieldRole').style.display = type === 'role' ? '' : 'none';
            document.getElementById('fieldBranch').style.display = type === 'branch' ? '' : 'none';
        }

        // ── Shared doughnut recipe over the theme runtime ──
        function makeDoughnut(canvasId, labels, data, colorFn) {
            CafeCharts.make(canvasId, C => {
                const colors = colorFn(C);
                return {
                    type: 'doughnut',
                    data: {
                        labels: labels,
                        datasets: [{
                            data: data,
                            backgroundColor: colors.map(c => C.alpha(c, 0.8)),
                            borderColor: colors,
                            borderWidth: 2,
                            hoverOffset: 6
                        }]
                    },
                    options: {
                        responsive: true, maintainAspectRatio: false,
                        cutout: '60%',
                        plugins: {
                            legend: { position: 'bottom' },
                            tooltip: {
                                callbacks: {
                                    label: ctx => {
                                        const total = ctx.dataset.data.reduce((a, b) => a + b, 0);
                                        const pct = total > 0 ? (ctx.raw / total * 100).toFixed(1) : 0;
                                        return ` ${ctx.label}: ${ctx.raw} (${pct}%)`;
                                    }
                                }
                            }
                        }
                    }
                };
            });
        }

        // ── 1. Email Delivery Status ──
        makeDoughnut('emailPieChart',
            ['Sent', 'Pending', 'Failed'],
            [@emailSent, @emailPending, @emailFailed],
            C => [C.status('success'), C.status('warning'), C.status('danger')]
        );

        // ── 2. Notification Type Distribution ──
        const ntLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(notifTypeLabels));
        const ntCounts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(notifTypeCounts));
        makeDoughnut('typePieChart', ntLabels, ntCounts, C => {
            const typeColorMap = { 'Info': C.status('info'), 'Success': C.status('success'), 'Warning': C.status('warning'), 'Error': C.status('danger') };
            return ntLabels.map(l => typeColorMap[l] || C.color(7));
        });

        // ── 3. Target Audience Distribution ──
        const tgtLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(targetLabels));
        const tgtCounts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(targetCounts));
        makeDoughnut('targetPieChart', tgtLabels, tgtCounts,
            C => tgtLabels.map((_, i) => C.color((i % 8) + 1))
        );

        // ── 4. Email Volume Trend ──
        const etLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(emailTrendLabels));
        const etCounts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(emailTrendCounts));
        CafeCharts.make('emailTrendChart', C => ({
            type: 'bar',
            data: {
                labels: etLabels,
                datasets: [{
                    label: 'Emails',
                    data: etCounts,
                    backgroundColor: C.alpha(C.color(3), 0.65),
                    borderColor: C.color(3),
                    borderWidth: 1.5,
                    borderRadius: 6,
                    borderSkipped: false
                }]
            },
            options: {
                responsive: true, maintainAspectRatio: false,
                scales: C.scales({ maxRotation: 45, precision: 0 }),
                plugins: {
                    legend: { display: false },
                    tooltip: { callbacks: { label: ctx => ` ${ctx.raw} emails` } }
                }
            }
        }));
    </script>
}
