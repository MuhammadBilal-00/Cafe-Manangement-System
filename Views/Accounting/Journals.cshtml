@model List<Cafe.Models.JournalEntry>
@{
    ViewData["Title"] = "Journal Entries";
    var accounts = ViewBag.Accounts as List<Cafe.Models.Account> ?? new();
}
<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1.5rem;flex-wrap:wrap;gap:1rem;">
    <div><h1 class="page-title" style="margin:0;">Journal Entries</h1><p class="body-text" style="margin-top:0.25rem;">Every posting balances — debits must equal credits.</p></div>
    <div style="display:flex;gap:0.5rem;"><a asp-action="Index" class="btn btn-ghost"><i class="fas fa-arrow-left" style="margin-right:0.4rem;"></i> Back</a><button class="btn btn-primary" onclick="jNew()"><i class="fas fa-plus" style="margin-right:0.5rem;"></i> New Journal</button></div>
</div>
<div class="card"><div class="card-body card-body-flush"><div style="overflow-x:auto;">
    <table class="premium-table">
        <thead><tr><th>Date</th><th>Memo</th><th>Source</th><th style="text-align:right;">Debit</th><th style="text-align:right;">Credit</th><th style="text-align:center;">Status</th></tr></thead>
        <tbody>
            @if (!Model.Any()) { <tr><td colspan="6" style="text-align:center;padding:3rem;color:var(--text-secondary);">No journal entries yet. Post one manually or use Auto-post.</td></tr> }
            @foreach (var j in Model)
            {
                <tr>
                    <td>@j.Date.ToString("dd MMM yyyy")</td>
                    <td>@j.Memo<div class="caption">@string.Join(", ", j.Lines.Select(l => l.Account?.Code))</div></td>
                    <td><span class="badge badge-neutral">@j.SourceType</span></td>
                    <td style="text-align:right;">Rs. @j.TotalDebit.ToString("N0")</td>
                    <td style="text-align:right;">Rs. @j.TotalCredit.ToString("N0")</td>
                    <td style="text-align:center;"><span class="badge @(j.Status == "Posted" ? "badge-success" : "badge-warning")">@j.Status</span></td>
                </tr>
            }
        </tbody>
    </table>
</div></div></div>
<div id="jModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:9999;align-items:center;justify-content:center;padding:1rem;"><div class="card" style="max-width:640px;width:100%;max-height:90vh;overflow:auto;"><div class="card-body">
    <h3 style="margin:0 0 1rem;">New Journal Entry</h3>
    <div class="form-row"><div class="form-group"><label class="form-label">Date</label><input id="jDate" type="date" value="@DateTime.Now.ToString("yyyy-MM-dd")" class="form-control" /></div><div class="form-group"><label class="form-label">Memo</label><input id="jMemo" class="form-control" /></div></div>
    <label class="form-label">Lines</label>
    <div style="display:flex;gap:0.4rem;margin-bottom:0.5rem;">
        <select id="jAcc" class="form-select" style="flex:1;">@foreach (var a in accounts){<option value="@a.Id">@a.Code — @a.Name</option>}</select>
        <input id="jDr" type="number" step="0.01" min="0" placeholder="Debit" class="form-control" style="width:100px;">
        <input id="jCr" type="number" step="0.01" min="0" placeholder="Credit" class="form-control" style="width:100px;">
        <button class="btn btn-secondary" onclick="jAdd()">Add</button>
    </div>
    <div id="jLines" style="margin-bottom:0.5rem;"></div>
    <div class="caption" id="jBal" style="margin-bottom:0.75rem;"></div>
    <div style="display:flex;gap:0.5rem;"><button class="btn btn-primary" onclick="jSave()">Post</button><button class="btn btn-secondary" onclick="document.getElementById('jModal').style.display='none'">Cancel</button></div>
</div></div></div>
@section Scripts {
<script>
const _tok = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
const accs = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(accounts.Select(a => new { id = a.Id, label = a.Code + " — " + a.Name })));
const accMap = Object.fromEntries(accs.map(a => [a.id, a.label]));
let lines = [];
const money = v => 'Rs. ' + Math.round(v).toLocaleString();
function render() {
    document.getElementById('jLines').innerHTML = lines.map((l, x) => `<div style="display:flex;justify-content:space-between;padding:0.3rem 0;border-bottom:1px solid var(--border-light);"><span>${accMap[l.accountId]}</span><span>${l.debit ? 'Dr ' + money(l.debit) : 'Cr ' + money(l.credit)} <a href="javascript:void(0)" onclick="jDel(${x})" style="color:#dc2626;">×</a></span></div>`).join('');
    const dr = lines.reduce((s, l) => s + (+l.debit || 0), 0), cr = lines.reduce((s, l) => s + (+l.credit || 0), 0);
    const ok = dr === cr && dr > 0;
    document.getElementById('jBal').innerHTML = `Debits ${money(dr)} · Credits ${money(cr)} — <b style="color:${ok ? '#16a34a' : '#dc2626'}">${ok ? 'balanced' : 'unbalanced'}</b>`;
}
window.jNew = () => { lines = []; render(); document.getElementById('jModal').style.display = 'flex'; };
window.jAdd = () => { const id = parseInt(document.getElementById('jAcc').value); const dr = parseFloat(document.getElementById('jDr').value) || 0; const cr = parseFloat(document.getElementById('jCr').value) || 0; if (!id || (!dr && !cr)) return; lines.push({ accountId: id, debit: dr, credit: cr, description: null }); document.getElementById('jDr').value = ''; document.getElementById('jCr').value = ''; render(); };
window.jDel = i => { lines.splice(i, 1); render(); };
window.jSave = async () => {
    if (lines.length < 2) return;
    const d = await fetch('/Accounting/CreateJournal', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': _tok }, body: `date=${document.getElementById('jDate').value}&memo=${encodeURIComponent(document.getElementById('jMemo').value)}&lines=${encodeURIComponent(JSON.stringify(lines))}` }).then(r => r.json());
    if (d.success) location.reload(); else if (window.ActionCard) ActionCard.error('Journal', d.message);
};
</script>
}
