@model Cafe.Models.Staff

@{
    ViewData["Title"] = "Delete Staff";
}

<div class="max-w-2xl mx-auto">
    <div class="flex items-center mb-6">
        <a asp-action="Index" class="text-blue-600 hover:text-blue-800 mr-3">
            <i class="fas fa-arrow-left"></i>
        </a>
        <h1 class="text-2xl font-bold text-gray-800">Delete Staff</h1>
    </div>

    <div class="bg-white rounded-lg shadow-md overflow-hidden">
        <!-- Warning Header -->
        <div class="bg-red-600 p-6 text-white">
            <div class="flex items-center">
                <div class="bg-red-700 p-3 rounded-full mr-4">
                    <i class="fas fa-exclamation-triangle text-xl"></i>
                </div>
                <div>
                    <h2 class="text-xl font-bold">Confirm Deletion</h2>
                    <p class="text-red-100">This action cannot be undone</p>
                </div>
            </div>
        </div>

        <!-- Staff Details -->
        <div class="p-6">
            <div class="bg-red-50 border border-red-200 rounded-lg p-4 mb-6">
                <h3 class="text-lg font-semibold text-red-800 mb-2">Are you sure you want to delete this staff member?</h3>
                <p class="text-red-700">This will remove the staff member from the system. Associated schedules and salary records will be preserved.</p>
            </div>

            <div class="space-y-4">
                <div class="flex items-center">
                    <div class="h-12 w-12 rounded-full bg-indigo-600 flex items-center justify-center text-white font-semibold mr-4">
                        @Model.User.Name.Substring(0, 1).ToUpper()
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700">Staff Member</label>
                        <p class="text-gray-900 font-semibold">@Model.User.Name</p>
                    </div>
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700">Role</label>
                    <p class="mt-1 text-gray-900">@Model.StaffRole.RoleName</p>
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700">Branch</label>
                    <p class="mt-1 text-gray-900">@Model.Branch.Name</p>
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700">Status</label>
                    <p class="mt-1">
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium @(Model.IsActive ? "bg-green-100 text-green-800" : "bg-gray-100 text-gray-800")">
                            @(Model.IsActive ? "Active" : "Inactive")
                        </span>
                    </p>
                </div>
            </div>

            <!-- Impact Warning -->
            <div class="mt-6 bg-yellow-50 border border-yellow-200 rounded-lg p-4">
                <h4 class="text-sm font-medium text-yellow-800 mb-2 flex items-center">
                    <i class="fas fa-exclamation-circle mr-2"></i> Potential Impact
                </h4>
                <ul class="text-yellow-700 text-sm list-disc list-inside space-y-1">
                    <li>Staff member will be removed from all schedules</li>
                    <li>Historical records will be preserved</li>
                    <li>User account will remain active for other roles</li>
                </ul>
            </div>
        </div>

        <!-- Form Actions -->
        <div class="bg-gray-50 px-6 py-4 border-t border-gray-200">
            <form asp-action="Delete" class="flex justify-end space-x-3" data-confirm="Are you sure you want to delete this staff member? This action cannot be undone.">
                <input type="hidden" asp-for="Id" />
                <a asp-action="Index" class="px-6 py-2 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 transition duration-150">
                    Cancel
                </a>
                <button type="submit" class="px-6 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-red-500 transition duration-150 flex items-center">
                    <i class="fas fa-trash mr-2"></i> Delete Staff
                </button>
            </form>
        </div>
    </div>
</div>