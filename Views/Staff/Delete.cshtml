@model Cafe.Models.Staff
@{
    ViewData["Title"] = "Delete Staff";
}

<!-- Page Header -->
<div class="flex items-center gap-3 mb-7">
    <a asp-action="Index" class="btn btn-ghost btn-sm"><i class="fas fa-arrow-left"></i></a>
    <div>
        <h1 class="page-title">Delete Staff Member</h1>
        <p class="body-text mt-1">Review and confirm deletion.</p>
    </div>
</div>

<div class="card" style="max-width:640px;overflow:hidden;">
    <!-- Danger Banner -->
    <div style="background:linear-gradient(135deg,#dc2626,#b91c1c);padding:24px 28px;color:#fff;">
        <div class="flex items-center gap-4">
            <div style="width:48px;height:48px;border-radius:12px;background:rgba(255,255,255,0.15);display:flex;align-items:center;justify-content:center;">
                <i class="fas fa-triangle-exclamation" style="font-size:20px;"></i>
            </div>
            <div>
                <h2 style="font-size:1.15rem;font-weight:700;">Confirm Deletion</h2>
                <p style="color:rgba(255,255,255,0.75);font-size:13px;">This action cannot be undone.</p>
            </div>
        </div>
    </div>

    <div class="card-body">
        <div style="background:rgba(239,68,68,0.06);border:1px solid rgba(239,68,68,0.15);border-radius:var(--radius-card);padding:16px;margin-bottom:20px;">
            <p style="color:#991b1b;font-weight:600;margin-bottom:4px;">Are you sure you want to delete this staff member?</p>
            <p style="color:#b91c1c;font-size:13px;">Schedules and salary records will be preserved but the profile will be removed.</p>
        </div>

        <div class="flex items-center gap-4 mb-5">
            <div style="width:48px;height:48px;border-radius:50%;background:var(--accent);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:20px;">
                @Model.User.Name.Substring(0, 1).ToUpper()
            </div>
            <div>
                <span class="font-semibold" style="color:var(--text-primary);font-size:16px;">@Model.User.Name</span>
                <span class="block text-xs" style="color:var(--text-tertiary);">@Model.EmployeeId</span>
            </div>
        </div>

        <div class="space-y-4">
            <div><span class="caption">Role</span><p style="color:var(--text-secondary);">@Model.StaffRole?.RoleName</p></div>
            <div><span class="caption">Branch</span><p style="color:var(--text-secondary);">@Model.Branch?.Name</p></div>
            <div>
                <span class="caption">Status</span>
                <p>
                    @if (Model.IsActive)
                    {
                        <span class="badge badge-success">Active</span>
                    }
                    else
                    {
                        <span class="badge badge-neutral">Inactive</span>
                    }
                </p>
            </div>
        </div>

        <!-- Impact -->
        <div style="background:rgba(245,158,11,0.06);border:1px solid rgba(245,158,11,0.18);border-radius:var(--radius-card);padding:16px;margin-top:20px;">
            <h4 style="font-size:13px;font-weight:600;color:#92400e;margin-bottom:8px;">
                <i class="fas fa-info-circle" style="margin-right:6px;"></i>Potential Impact
            </h4>
            <ul style="font-size:13px;color:#a16207;list-style:disc;padding-left:20px;line-height:1.8;">
                <li>Removed from all schedules</li>
                <li>Historical records preserved</li>
                <li>User account remains for other roles</li>
            </ul>
        </div>

        <div class="divider"></div>

        <form asp-action="Delete">
            <input type="hidden" asp-for="Id" />
            <div class="flex justify-end gap-3">
                <a asp-action="Index" class="btn btn-ghost">Cancel</a>
                <button type="submit" class="btn btn-danger"><i class="fas fa-trash"></i> Delete Staff</button>
            </div>
        </form>
    </div>
</div>
