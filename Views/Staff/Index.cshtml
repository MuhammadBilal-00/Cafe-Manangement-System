@model IEnumerable<Cafe.Models.Staff>

@{
    ViewData["Title"] = "Staff";
}

<div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-bold text-gray-800">Staff Management</h1>
    <a asp-action="Create" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg transition duration-200 flex items-center">
        <i class="fas fa-user-plus mr-2"></i> Add New Staff
    </a>
</div>

<!-- Stats Cards -->
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
    <div class="bg-white rounded-lg shadow-md p-6 border-l-4 border-blue-500">
        <div class="flex items-center">
            <div class="p-3 rounded-lg bg-blue-100 text-blue-600 mr-4">
                <i class="fas fa-users text-xl"></i>
            </div>
            <div>
                <p class="text-sm text-gray-600">Total Staff</p>
                <p class="text-2xl font-bold text-gray-800">@Model.Count()</p>
            </div>
        </div>
    </div>

    <div class="bg-white rounded-lg shadow-md p-6 border-l-4 border-green-500">
        <div class="flex items-center">
            <div class="p-3 rounded-lg bg-green-100 text-green-600 mr-4">
                <i class="fas fa-check-circle text-xl"></i>
            </div>
            <div>
                <p class="text-sm text-gray-600">Active Staff</p>
                <p class="text-2xl font-bold text-gray-800">@Model.Count(s => s.IsActive)</p>
            </div>
        </div>
    </div>

    <div class="bg-white rounded-lg shadow-md p-6 border-l-4 border-yellow-500">
        <div class="flex items-center">
            <div class="p-3 rounded-lg bg-yellow-100 text-yellow-600 mr-4">
                <i class="fas fa-user-tie text-xl"></i>
            </div>
            <div>
                <p class="text-sm text-gray-600">Managers</p>
                <p class="text-2xl font-bold text-gray-800">@Model.Count(s => s.StaffRole.RoleName.Contains("Manager"))</p>
            </div>
        </div>
    </div>

    <div class="bg-white rounded-lg shadow-md p-6 border-l-4 border-purple-500">
        <div class="flex items-center">
            <div class="p-3 rounded-lg bg-purple-100 text-purple-600 mr-4">
                <i class="fas fa-clock text-xl"></i>
            </div>
            <div>
                <p class="text-sm text-gray-600">New This Month</p>
                <p class="text-2xl font-bold text-gray-800">@Model.Count(s => s.HireDate >= DateTime.Now.AddDays(-30))</p>
            </div>
        </div>
    </div>
</div>

<!-- Staff Table -->
<div class="bg-white rounded-lg shadow-md overflow-hidden">
    <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
                <tr>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Employee</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Role</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Branch</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Employment Type</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Hire Date</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
                @foreach (var item in Model)
                {
                    <tr class="hover:bg-gray-50 transition duration-150">
                        <td class="px-6 py-4 whitespace-nowrap">
                            <div class="flex items-center">
                                <div class="h-10 w-10 rounded-full bg-indigo-600 flex items-center justify-center text-white font-semibold mr-3">
                                    @item.User.Name.Substring(0, 1).ToUpper()
                                </div>
                                <div>
                                    <div class="text-sm font-medium text-gray-900">@item.User.Name</div>
                                    <div class="text-sm text-gray-500">@item.EmployeeId</div>
                                </div>
                            </div>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap">
                            <div class="text-sm text-gray-600">@item.StaffRole.RoleName</div>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap">
                            <div class="text-sm text-gray-600">@item.Branch.Name</div>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap">
                            <span class="px-2 py-1 text-xs font-semibold bg-blue-100 text-blue-800 rounded-full">
                                @item.EmploymentType
                            </span>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap">
                            @if (item.IsActive)
                            {
                                <span class="px-2 py-1 text-xs font-semibold bg-green-100 text-green-800 rounded-full">Active</span>
                            }
                            else
                            {
                                <span class="px-2 py-1 text-xs font-semibold bg-gray-100 text-gray-800 rounded-full">Inactive</span>
                            }
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap">
                            <div class="text-sm text-gray-600">@item.HireDate.ToString("MMM dd, yyyy")</div>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                            @if (Context.Session.GetString("UserRole") == "Owner")
                            {
                                <a asp-action="Details" asp-route-id="@item.Id" class="text-blue-600 hover:text-blue-900 mr-3">
                                    <i class="fas fa-eye"></i> View
                                </a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="text-yellow-600 hover:text-yellow-900 mr-3">
                                    <i class="fas fa-edit"></i> Edit
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="text-red-600 hover:text-red-900">
                                    <i class="fas fa-trash"></i> Delete
                                </a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-12">
            <div class="text-gray-400 text-5xl mb-4">
                <i class="fas fa-user-slash"></i>
            </div>
            <h3 class="text-lg font-medium text-gray-600">No staff members found</h3>
            <p class="text-gray-500 mt-1">Get started by adding your first staff member.</p>
            <div class="mt-6">
                @if (Context.Session.GetString("UserRole") == "Owner")
                {
                    <a asp-action="Create" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg transition duration-200 inline-flex items-center">
                        <i class="fas fa-user-plus mr-2"></i> Add First Staff
                </a>
                }
            </div>
        </div>
    }
</div>

<!-- Quick Actions -->
@if (Context.Session.GetString("UserRole") == "Owner")
{
    <div class="mt-8 bg-blue-50 rounded-lg p-6">
        <h3 class="text-lg font-medium text-blue-800 mb-4">Quick Actions</h3>
        <div class="flex flex-wrap gap-4">
            <a asp-action="Create" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg transition duration-200 flex items-center">
                <i class="fas fa-user-plus mr-2"></i> Add New Staff
            </a>
            <a asp-controller="Staff" asp-action="ExportCsv" class="bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded-lg transition duration-200 flex items-center">
                <i class="fas fa-download mr-2"></i> Export Data
            </a>
            <a asp-controller="Reports" asp-action="SalesOverview" class="bg-purple-600 hover:bg-purple-700 text-white px-4 py-2 rounded-lg transition duration-200 flex items-center">
                <i class="fas fa-chart-bar mr-2"></i> View Reports
            </a>
        </div>
    </div>
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const tableRows = document.querySelectorAll('tbody tr');
            tableRows.forEach(row => {
                row.addEventListener('mouseenter', function() {
                    this.classList.add('bg-blue-50');
                });
                row.addEventListener('mouseleave', function() {
                    this.classList.remove('bg-blue-50');
                });
            });

            // const deleteLinks = document.querySelectorAll('a[href*="Delete"]');
            // deleteLinks.forEach(link => {
            //     link.addEventListener('click', function(e) {
            //         if (!confirm('Are you sure you want to delete this staff member?')) {
            //             e.preventDefault();
            //         }
            //     });
            // });
        });
    </script>
}