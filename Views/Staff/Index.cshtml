@model IEnumerable<Cafe.Models.Staff>
@{
    ViewData["Title"] = "Staff";
    var isOwner = Context.Session.GetString("UserRole") == "Owner";
}

<!-- Page Header -->
<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-7">
    <div>
        <h1 class="page-title">Staff Management</h1>
        <p class="body-text mt-1">View and manage all team members across branches.</p>
    </div>
    <div class="flex items-center gap-3">
        @if (isOwner)
        {
            <a asp-controller="Staff" asp-action="ExportCsv" class="btn btn-ghost btn-sm">
                <i class="fas fa-download"></i> Export
            </a>
        }
        @if (isOwner)
        {
            <a asp-action="Create" class="btn btn-primary">
                <i class="fas fa-user-plus"></i> Add Staff
            </a>
        }
    </div>
</div>

<!-- KPI Cards -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 mb-7">
    <div class="kpi-card">
        <div class="kpi-icon" style="background:rgba(212,175,55,0.10);color:#d4af37;">
            <i class="fas fa-users"></i>
        </div>
        <div class="kpi-label">Total Staff</div>
        <div class="kpi-value">@Model.Count()</div>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon" style="background:rgba(34,197,94,0.10);color:#22c55e;">
            <i class="fas fa-user-check"></i>
        </div>
        <div class="kpi-label">Active</div>
        <div class="kpi-value">@Model.Count(s => s.IsActive)</div>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon" style="background:rgba(99,102,241,0.10);color:#6366f1;">
            <i class="fas fa-user-tie"></i>
        </div>
        <div class="kpi-label">Managers</div>
        <div class="kpi-value">@Model.Count(s => s.StaffRole != null && s.StaffRole.RoleName.Contains("Manager"))</div>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon" style="background:rgba(168,85,247,0.10);color:#a855f7;">
            <i class="fas fa-calendar-plus"></i>
        </div>
        <div class="kpi-label">New (30 days)</div>
        <div class="kpi-value">@Model.Count(s => s.HireDate >= DateTime.Now.AddDays(-30))</div>
    </div>
</div>

<!-- Staff Table -->
<div class="card">
    <div class="card-header">
        <h3 class="section-title">All Staff Members</h3>
        <span class="badge badge-neutral">@Model.Count() records</span>
    </div>
    <div class="card-body card-body-flush">
        @if (Model.Any())
        {
            <div class="overflow-x-auto">
                <table class="premium-table">
                    <thead>
                        <tr>
                            <th>Employee</th>
                            <th>Role</th>
                            <th>Branch</th>
                            <th>Type</th>
                            <th>Status</th>
                            <th>Hire Date</th>
                            <th style="text-align:right;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <div class="flex items-center gap-3">
                                        <div style="width:36px;height:36px;border-radius:50%;background:var(--accent);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:600;font-size:14px;flex-shrink:0;">
                                            @item.User.Name.Substring(0, 1).ToUpper()
                                        </div>
                                        <div>
                                            <span class="font-semibold" style="color:var(--text-primary);">@item.User.Name</span>
                                            <span class="block text-xs" style="color:var(--text-tertiary);">@item.EmployeeId</span>
                                        </div>
                                    </div>
                                </td>
                                <td>@item.StaffRole?.RoleName</td>
                                <td>@item.Branch?.Name</td>
                                <td><span class="badge badge-info">@item.EmploymentType</span></td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge badge-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-neutral">Inactive</span>
                                    }
                                </td>
                                <td style="color:var(--text-secondary);font-size:13px;">@item.HireDate.ToString("MMM dd, yyyy")</td>
                                <td style="text-align:right;">
                                    <div class="flex items-center justify-end gap-2">
                                        @if (isOwner)
                                        {
                                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-ghost btn-sm" title="View">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-secondary btn-sm" title="Edit">
                                                <i class="fas fa-pen"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm" title="Delete">
                                                <i class="fas fa-trash"></i>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <div class="empty-state-icon"><i class="fas fa-users"></i></div>
                <p class="empty-state-title">No staff members found</p>
                <p class="empty-state-text">Get started by adding your first team member.</p>
                @if (isOwner)
                {
                    <a asp-action="Create" class="btn btn-primary" style="margin-top:16px;">
                        <i class="fas fa-user-plus"></i> Add First Staff
                    </a>
                }
            </div>
        }
    </div>
</div>
