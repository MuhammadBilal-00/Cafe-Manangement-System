@model Cafe.Models.ViewModels.StaffCreateViewModel
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Add Staff";
}

<!-- Page Header -->
<div class="flex items-center gap-3 mb-7">
    <a asp-action="Index" class="btn btn-ghost btn-sm"><i class="fas fa-arrow-left"></i></a>
    <div>
        <h1 class="page-title">Add New Staff Member</h1>
        <p class="body-text mt-1">Register a new team member in the system.</p>
    </div>
</div>

<div class="card" style="max-width:820px;">
    <div class="card-body">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="form-error" style="margin-bottom:20px;"></div>

            <!-- Personal Info Section -->
            <h3 class="section-title mb-4"><i class="fas fa-user-circle" style="color:var(--accent);margin-right:8px;"></i>Personal Information</h3>

            <div class="form-row">
                <div class="form-group">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" placeholder="Full name" />
                    <span asp-validation-for="Name" class="form-error"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" placeholder="email@example.com" />
                    <span asp-validation-for="Email" class="form-error"></span>
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label asp-for="Phone" class="form-label"></label>
                    <input asp-for="Phone" class="form-control" placeholder="Phone number" />
                    <span asp-validation-for="Phone" class="form-error"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password" type="password" class="form-control" placeholder="Password" />
                    <span asp-validation-for="Password" class="form-error"></span>
                </div>
            </div>

            <div class="divider"></div>

            <!-- Employment Section -->
            <h3 class="section-title mb-4"><i class="fas fa-briefcase" style="color:var(--accent);margin-right:8px;"></i>Employment Details</h3>

            <div class="form-row">
                <div class="form-group">
                    <label asp-for="StaffRoleId" class="form-label">Role *</label>
                    <select asp-for="StaffRoleId" asp-items="ViewBag.StaffRoles" class="form-select">
                        <option value="">-- Select a Role --</option>
                    </select>
                    <span asp-validation-for="StaffRoleId" class="form-error"></span>
                </div>
                <div class="form-group">
                    <label asp-for="BranchId" class="form-label">Branch *</label>
                    @if (ViewBag.LockedBranchId != null)
                    {
                        <input type="hidden" asp-for="BranchId" value="@ViewBag.LockedBranchId" />
                        <select disabled class="form-select" style="background:var(--bg-body);">
                            @foreach (SelectListItem item in ViewBag.Branches)
                            {
                                if (item.Value == ViewBag.LockedBranchId.ToString())
                                {
                                    <option selected>@item.Text</option>
                                }
                            }
                        </select>
                        <span class="caption"><i class="fas fa-lock" style="margin-right:4px;"></i>Locked to your branch</span>
                    }
                    else
                    {
                        <select asp-for="BranchId" asp-items="ViewBag.Branches" class="form-select">
                            <option value="">-- Select a Branch --</option>
                        </select>
                    }
                    <span asp-validation-for="BranchId" class="form-error"></span>
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label asp-for="EmploymentType" class="form-label">Employment Type *</label>
                    <select asp-for="EmploymentType" class="form-select">
                        <option value="">-- Select --</option>
                        <option value="Full-time">Full-time</option>
                        <option value="Part-time">Part-time</option>
                        <option value="Contract">Contract</option>
                    </select>
                    <span asp-validation-for="EmploymentType" class="form-error"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Department" class="form-label">Department</label>
                    <input asp-for="Department" class="form-control" placeholder="e.g., Kitchen, Service" />
                    <span asp-validation-for="Department" class="form-error"></span>
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label asp-for="EmployeeId" class="form-label">Employee ID</label>
                    <input asp-for="EmployeeId" class="form-control" placeholder="EMP001" />
                    <span asp-validation-for="EmployeeId" class="form-error"></span>
                </div>
                <div class="form-group" style="flex-direction:row;align-items:center;gap:10px;padding-top:28px;">
                    <input asp-for="IsActive" style="width:18px;height:18px;accent-color:var(--accent);" checked />
                    <label asp-for="IsActive" class="form-label" style="margin:0;">Active Staff Member</label>
                </div>
            </div>

            <div class="divider"></div>

            <div class="flex justify-end gap-3">
                <a asp-action="Index" class="btn btn-ghost">Cancel</a>
                <button type="submit" class="btn btn-primary"><i class="fas fa-check"></i> Create Staff</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
