@model Cafe.Models.ViewModels.StaffCreateViewModel

@{
    ViewData["Title"] = "Add New Staff";
}

<div class="max-w-4xl mx-auto">
    <div class="flex items-center mb-6">
        <a asp-action="Index" class="text-blue-600 hover:text-blue-800 mr-3">
            <i class="fas fa-arrow-left"></i>
        </a>
        <h1 class="text-2xl font-bold text-gray-800">Add New Staff Member</h1>
    </div>

    <div class="bg-white rounded-lg shadow-md p-6">
        <form asp-action="Create" class="space-y-6">
            <div asp-validation-summary="ModelOnly" class="text-red-600 bg-red-50 p-3 rounded-lg"></div>

            <!-- User Information Section -->
            <div class="border-b border-gray-200 pb-6">
                <h3 class="text-lg font-semibold text-gray-800 mb-4 flex items-center">
                    <i class="fas fa-user-circle mr-2 text-blue-600"></i> Personal Information
                </h3>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <!-- Name -->
                    <div>
                        <label asp-for="Name" class="block text-sm font-medium text-gray-700 mb-2"></label>
                        <input asp-for="Name" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition duration-150" placeholder="Full name" />
                        <span asp-validation-for="Name" class="text-red-600 text-sm mt-1"></span>
                    </div>

                    <!-- Email -->
                    <div>
                        <label asp-for="Email" class="block text-sm font-medium text-gray-700 mb-2"></label>
                        <input asp-for="Email" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition duration-150" placeholder="email@example.com" />
                        <span asp-validation-for="Email" class="text-red-600 text-sm mt-1"></span>
                    </div>

                    <!-- Phone -->
                    <div>
                        <label asp-for="Phone" class="block text-sm font-medium text-gray-700 mb-2"></label>
                        <input asp-for="Phone" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition duration-150" placeholder="Phone number" />
                        <span asp-validation-for="Phone" class="text-red-600 text-sm mt-1"></span>
                    </div>

                    <!-- Password -->
                    <div>
                        <label asp-for="Password" class="block text-sm font-medium text-gray-700 mb-2"></label>
                        <input asp-for="Password" type="password" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition duration-150" placeholder="Password" />
                        <span asp-validation-for="Password" class="text-red-600 text-sm mt-1"></span>
                    </div>
                </div>
            </div>

            <!-- Employment Information Section -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Staff Role -->
                <div>
                    <label asp-for="StaffRoleId" class="block text-sm font-medium text-gray-700 mb-2">Role *</label>
                    <select asp-for="StaffRoleId" asp-items="ViewBag.StaffRoles" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition duration-150">
                        <option value="">-- Select a Role --</option>
                    </select>
                    <span asp-validation-for="StaffRoleId" class="text-red-600 text-sm mt-1"></span>
                </div>

                <!-- Branch -->
                <div>
                    <label asp-for="BranchId" class="block text-sm font-medium text-gray-700 mb-2">Branch *</label>
                    <select asp-for="BranchId" asp-items="ViewBag.Branches" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition duration-150">
                        <option value="">-- Select a Branch --</option>
                    </select>
                    <span asp-validation-for="BranchId" class="text-red-600 text-sm mt-1"></span>
                </div>

                <!-- Employment Type -->
                <div>
                    <label asp-for="EmploymentType" class="block text-sm font-medium text-gray-700 mb-2">Employment Type *</label>
                    <select asp-for="EmploymentType" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition duration-150">
                        <option value="">-- Select Type --</option>
                        <option value="Full-time">Full-time</option>
                        <option value="Part-time">Part-time</option>
                        <option value="Contract">Contract</option>
                    </select>
                    <span asp-validation-for="EmploymentType" class="text-red-600 text-sm mt-1"></span>
                </div>

                <!-- Department -->
                <div>
                    <label asp-for="Department" class="block text-sm font-medium text-gray-700 mb-2">Department</label>
                    <input asp-for="Department" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition duration-150" placeholder="e.g., Kitchen, Service, Barista" />
                    <span asp-validation-for="Department" class="text-red-600 text-sm mt-1"></span>
                </div>

                <!-- Employee ID -->
                <div>
                    <label asp-for="EmployeeId" class="block text-sm font-medium text-gray-700 mb-2">Employee ID</label>
                    <input asp-for="EmployeeId" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition duration-150" placeholder="EMP001" />
                    <span asp-validation-for="EmployeeId" class="text-red-600 text-sm mt-1"></span>
                </div>
            </div>

            <!-- Status -->
            <div class="flex items-center">
                <input asp-for="IsActive" class="h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 rounded" checked />
                <label asp-for="IsActive" class="ml-2 block text-sm text-gray-700">Active Staff Member</label>
            </div>

            <!-- Form Actions -->
            <div class="flex justify-end space-x-4 pt-6 border-t border-gray-200">
                <a asp-action="Index" class="px-6 py-2 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50 transition duration-150">
                    Cancel
                </a>
                <button type="submit" class="px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 transition duration-150">
                    Create Staff Member
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}