@model Cafe.Models.Staff
@{
    ViewData["Title"] = "Staff Details";
}

<!-- Page Header -->
<div class="flex items-center justify-between mb-7">
    <div class="flex items-center gap-3">
        <a asp-action="Index" class="btn btn-ghost btn-sm"><i class="fas fa-arrow-left"></i></a>
        <div>
            <h1 class="page-title">@Model.User.Name</h1>
            <p class="body-text mt-1">Employee profile and performance overview.</p>
        </div>
    </div>
    <div class="flex items-center gap-3">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-secondary btn-sm"><i class="fas fa-pen"></i> Edit</a>
        <a asp-action="Index" class="btn btn-ghost btn-sm">Back to List</a>
    </div>
</div>

<!-- Header Card -->
<div class="card mb-5" style="overflow:hidden;">
    <div style="background:linear-gradient(135deg,var(--sidebar-bg),#2d3e50);padding:28px 32px;color:#fff;">
        <div class="flex items-center justify-between flex-wrap gap-4">
            <div class="flex items-center gap-4">
                <div style="width:56px;height:56px;border-radius:50%;background:var(--accent);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:22px;">
                    @Model.User.Name.Substring(0, 1).ToUpper()
                </div>
                <div>
                    <h2 style="font-size:1.4rem;font-weight:700;">@Model.User.Name</h2>
                    <p style="color:#94a3b8;margin-top:2px;">@Model.StaffRole?.RoleName &middot; @Model.EmployeeId</p>
                </div>
            </div>
            <div class="text-right">
                @if (Model.IsActive)
                {
                    <span class="badge badge-success">Active</span>
                }
                else
                {
                    <span class="badge badge-neutral">Inactive</span>
                }
                <p style="color:#94a3b8;font-size:12px;margin-top:6px;">Hired @Model.HireDate.ToString("MMM dd, yyyy")</p>
            </div>
        </div>
    </div>
</div>

<!-- Detail Grid -->
<div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-5">
    <!-- Personal Info -->
    <div class="card">
        <div class="card-header">
            <h3 class="section-title"><i class="fas fa-user" style="color:var(--accent);margin-right:8px;"></i>Personal</h3>
        </div>
        <div class="card-body space-y-3">
            <div><span class="caption">Name</span><p class="font-medium" style="color:var(--text-primary);">@Model.User.Name</p></div>
            <div><span class="caption">Email</span><p style="color:var(--text-secondary);">@Model.User.Email</p></div>
            <div><span class="caption">Phone</span><p style="color:var(--text-secondary);">@Model.User.Phone</p></div>
        </div>
    </div>

    <!-- Employment Info -->
    <div class="card">
        <div class="card-header">
            <h3 class="section-title"><i class="fas fa-briefcase" style="color:var(--accent);margin-right:8px;"></i>Employment</h3>
        </div>
        <div class="card-body space-y-3">
            <div><span class="caption">Role</span><p class="font-medium" style="color:var(--text-primary);">@Model.StaffRole?.RoleName</p></div>
            <div><span class="caption">Branch</span><p style="color:var(--text-secondary);">@Model.Branch?.Name</p></div>
            <div><span class="caption">Department</span><p style="color:var(--text-secondary);">@(Model.Department ?? "—")</p></div>
            <div><span class="caption">Type</span><p><span class="badge badge-info">@Model.EmploymentType</span></p></div>
        </div>
    </div>
</div>

<!-- Performance Stats -->
<div class="card mb-5">
    <div class="card-header">
        <h3 class="section-title"><i class="fas fa-chart-line" style="color:var(--accent);margin-right:8px;"></i>Performance</h3>
    </div>
    <div class="card-body">
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
            <div class="kpi-card">
                <div class="kpi-icon" style="background:rgba(212,175,55,0.10);color:#d4af37;">
                    <i class="fas fa-star"></i>
                </div>
                <div class="kpi-label">Rating</div>
                <div class="kpi-value">@(Model.PerformanceRating?.ToString("0.0") ?? "N/A")<span style="font-size:14px;color:var(--text-tertiary);">/5</span></div>
            </div>
            <div class="kpi-card">
                <div class="kpi-icon" style="background:rgba(34,197,94,0.10);color:#22c55e;">
                    <i class="fas fa-calendar-days"></i>
                </div>
                <div class="kpi-label">Scheduled Shifts</div>
                <div class="kpi-value">@Model.Schedules.Count</div>
            </div>
            <div class="kpi-card">
                <div class="kpi-icon" style="background:rgba(99,102,241,0.10);color:#6366f1;">
                    <i class="fas fa-wallet"></i>
                </div>
                <div class="kpi-label">Salary Records</div>
                <div class="kpi-value">@Model.SalaryHistory.Count</div>
            </div>
        </div>
    </div>
</div>

<!-- Actions -->
<div class="card">
    <div class="card-body">
        <div class="flex justify-end gap-3">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-secondary"><i class="fas fa-pen"></i> Edit Staff</a>
            <a asp-action="Index" class="btn btn-ghost">Back to List</a>
        </div>
    </div>
</div>
