@model Cafe.Models.Staff

@{
    ViewData["Title"] = "Staff Details";
}

<div class="max-w-4xl mx-auto">
    <div class="flex items-center justify-between mb-6">
        <div class="flex items-center">
            <a asp-action="Index" class="text-blue-600 hover:text-blue-800 mr-3">
                <i class="fas fa-arrow-left"></i>
            </a>
            <h1 class="text-2xl font-bold text-gray-800">Staff Details</h1>
        </div>

        <div class="flex space-x-2">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="px-4 py-2 bg-yellow-600 text-white rounded-lg hover:bg-yellow-700 transition duration-150">
                <i class="fas fa-edit mr-2"></i> Edit
            </a>
            <a asp-action="Index" class="px-4 py-2 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 transition duration-150">
                Back to List
            </a>
        </div>
    </div>

    <div class="bg-white rounded-lg shadow-md overflow-hidden">
        <!-- Header -->
        <div class="bg-gradient-to-r from-blue-600 to-blue-800 p-6 text-white">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-2xl font-bold">@Model.User.Name</h2>
                    <p class="text-blue-100">@Model.StaffRole.RoleName</p>
                </div>
                <div class="text-right">
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium @(Model.IsActive ? "bg-green-100 text-green-800" : "bg-gray-100 text-gray-800")">
                        @(Model.IsActive ? "Active" : "Inactive")
                    </span>
                    <p class="text-blue-100 text-sm mt-1">Employee ID: @Model.EmployeeId</p>
                </div>
            </div>
        </div>

        <!-- Details -->
        <div class="p-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Personal Information -->
                <div class="bg-gray-50 rounded-lg p-4">
                    <h3 class="text-lg font-semibold text-gray-800 mb-3 flex items-center">
                        <i class="fas fa-user mr-2 text-blue-600"></i> Personal Information
                    </h3>
                    <div class="space-y-2">
                        <p><span class="font-medium text-gray-700">Name:</span> @Model.User.Name</p>
                        <p><span class="font-medium text-gray-700">Email:</span> @Model.User.Email</p>
                        <p><span class="font-medium text-gray-700">Phone:</span> @Model.User.Phone</p>
                    </div>
                </div>

                <!-- Employment Details -->
                <div class="bg-gray-50 rounded-lg p-4">
                    <h3 class="text-lg font-semibold text-gray-800 mb-3 flex items-center">
                        <i class="fas fa-briefcase mr-2 text-blue-600"></i> Employment Details
                    </h3>
                    <div class="space-y-2">
                        <p><span class="font-medium text-gray-700">Role:</span> @Model.StaffRole.RoleName</p>
                        <p><span class="font-medium text-gray-700">Branch:</span> @Model.Branch.Name</p>
                        <p><span class="font-medium text-gray-700">Department:</span> @Model.Department</p>
                        <p><span class="font-medium text-gray-700">Type:</span> @Model.EmploymentType</p>
                        <p><span class="font-medium text-gray-700">Employee ID:</span> @Model.EmployeeId</p>
                        <p><span class="font-medium text-gray-700">Hire Date:</span> @Model.HireDate.ToString("MMM dd, yyyy")</p>
                        @if (Model.PerformanceRating.HasValue)
                        {
                            <p>
                                <span class="font-medium text-gray-700">Performance Rating:</span>
                                <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                                    @Model.PerformanceRating/5
                                </span>
                            </p>
                        }
                    </div>
                </div>
            </div>

            <!-- Performance Section -->
            <div class="mt-6 bg-yellow-50 rounded-lg p-4">
                <h3 class="text-lg font-semibold text-gray-800 mb-3 flex items-center">
                    <i class="fas fa-chart-line mr-2 text-blue-600"></i> Performance
                </h3>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div class="text-center">
                        <div class="text-2xl font-bold text-blue-600">@(Model.PerformanceRating?.ToString() ?? "N/A")</div>
                        <div class="text-sm text-gray-600">Performance Rating</div>
                    </div>
                    <div class="text-center">
                        <div class="text-2xl font-bold text-green-600">@Model.Schedules.Count</div>
                        <div class="text-sm text-gray-600">Scheduled Shifts</div>
                    </div>
                    <div class="text-center">
                        <div class="text-2xl font-bold text-purple-600">@Model.SalaryHistory.Count</div>
                        <div class="text-sm text-gray-600">Salary Records</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Action Buttons -->
        <div class="bg-gray-50 px-6 py-4 border-t border-gray-200">
            <div class="flex justify-end space-x-3">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="px-4 py-2 bg-yellow-600 text-white rounded-lg hover:bg-yellow-700 transition duration-150 flex items-center">
                    <i class="fas fa-edit mr-2"></i> Edit Staff
                </a>
                <a asp-action="Index" class="px-4 py-2 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 transition duration-150">
                    Back to List
                </a>
            </div>
        </div>
    </div>
</div>