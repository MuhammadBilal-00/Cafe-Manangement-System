@model IEnumerable<Cafe.Models.Invoice>
@{
    ViewData["Title"] = "Bill History";
    var branches = ViewBag.Branches as List<Cafe.Models.Branch> ?? new List<Cafe.Models.Branch>();
    var selectedBranchId = ViewBag.SelectedBranchId as int?;
    var isOwner = Context.Session.GetString("UserRole") == "Owner";
    var status = ViewBag.Status as string;
    var search = ViewBag.Search as string;
    var fromDate = ViewBag.FromDate as string;
    var toDate = ViewBag.ToDate as string;
    var page = (int)(ViewBag.Page ?? 1);
    var totalPages = (int)(ViewBag.TotalPages ?? 1);

    string PayBadge(string s) => s switch
    {
        "Paid" => "badge-success",
        "Pending" => "badge-warning",
        "Failed" => "badge-danger",
        _ => "badge-neutral"
    };
}

<!-- Page Header -->
<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:2rem; flex-wrap:wrap; gap:1rem;">
    <div>
        <h1 class="page-title" style="margin:0;">Bill History</h1>
        <p class="body-text" style="margin-top:0.25rem;">Browse, download and reconcile past invoices.</p>
    </div>
</div>

<!-- KPI Cards -->
<div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(180px,1fr)); gap:1rem; margin-bottom:2rem;">
    <div class="kpi-card">
        <div class="kpi-icon" style="background:rgba(99,102,241,0.1); color:#6366f1;"><i class="fas fa-file-invoice"></i></div>
        <div class="kpi-label">Total Bills</div>
        <div class="kpi-value">@ViewBag.TotalBills</div>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon" style="background:rgba(34,197,94,0.1); color:#16a34a;"><i class="fas fa-coins"></i></div>
        <div class="kpi-label">Collected</div>
        <div class="kpi-value" style="color:#16a34a;">Rs. @(((decimal)ViewBag.Collected).ToString("N0"))</div>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon" style="background:rgba(34,197,94,0.1); color:#16a34a;"><i class="fas fa-circle-check"></i></div>
        <div class="kpi-label">Paid</div>
        <div class="kpi-value">@ViewBag.PaidCount</div>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon" style="background:rgba(217,119,6,0.12); color:#d97706;"><i class="fas fa-hourglass-half"></i></div>
        <div class="kpi-label">Pending</div>
        <div class="kpi-value" style="color:#d97706;">@ViewBag.PendingCount</div>
    </div>
</div>

<!-- Filters -->
<div class="card mb-6">
    <div class="card-body">
        <form method="get" style="display:flex; gap:1rem; align-items:flex-end; flex-wrap:wrap;">
            @if (isOwner && branches.Count > 1)
            {
                <div class="form-group" style="margin-bottom:0;">
                    <label class="form-label">Branch</label>
                    <select name="branchId" class="form-select">
                        <option value="">All Branches</option>
                        @foreach (var b in branches)
                        {
                            <option value="@b.Id" selected="@(selectedBranchId == b.Id)">@b.Name</option>
                        }
                    </select>
                </div>
            }
            <div class="form-group" style="margin-bottom:0;">
                <label class="form-label">Status</label>
                <select name="status" class="form-select">
                    <option value="">All</option>
                    <option value="Paid" selected="@(status == "Paid")">Paid</option>
                    <option value="Pending" selected="@(status == "Pending")">Pending</option>
                    <option value="Failed" selected="@(status == "Failed")">Failed</option>
                </select>
            </div>
            <div class="form-group" style="margin-bottom:0;">
                <label class="form-label">From</label>
                <input type="date" name="fromDate" value="@fromDate" class="form-control" />
            </div>
            <div class="form-group" style="margin-bottom:0;">
                <label class="form-label">To</label>
                <input type="date" name="toDate" value="@toDate" class="form-control" />
            </div>
            <div class="form-group" style="margin-bottom:0; flex:1; min-width:180px;">
                <label class="form-label">Search</label>
                <input type="text" name="search" value="@search" class="form-control" placeholder="Invoice or order #" />
            </div>
            <button type="submit" class="btn btn-primary"><i class="fas fa-filter" style="margin-right:0.5rem;"></i> Filter</button>
            <a asp-action="Index" class="btn btn-secondary">Reset</a>
        </form>
    </div>
</div>

<!-- Table -->
<div class="card">
    <div class="card-body card-body-flush">
        <div style="overflow-x:auto;">
            <table class="premium-table">
                <thead>
                    <tr>
                        <th>Invoice #</th>
                        <th>Order / Customer</th>
                        <th>Branch</th>
                        <th>Date</th>
                        <th style="text-align:right;">Discount</th>
                        <th style="text-align:right;">Total</th>
                        <th style="text-align:center;">Payment</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8" style="text-align:center; padding:3rem 1rem;">
                                <i class="fas fa-file-invoice" style="font-size:2.5rem; color:var(--border-light); margin-bottom:1rem; display:block;"></i>
                                <p style="font-weight:600; margin:0 0 0.25rem; color:var(--text-secondary);">No bills found</p>
                                <p class="caption" style="margin:0;">Bills appear here as orders are placed at checkout.</p>
                            </td>
                        </tr>
                    }
                    @foreach (var inv in Model)
                    {
                        <tr>
                            <td><span style="font-family:ui-monospace,monospace; font-weight:600; font-size:0.82rem;">@inv.InvoiceNumber</span></td>
                            <td>
                                <div style="font-weight:600;">@inv.Order?.OrderNumber</div>
                                <div class="caption">@(inv.Order?.Customer?.Name ?? "Walk-in")</div>
                            </td>
                            <td class="caption">@inv.Branch?.Name</td>
                            <td>
                                <div style="font-size:0.82rem;">@inv.CreatedAt.ToString("dd MMM yyyy")</div>
                                <div class="caption">@inv.CreatedAt.ToString("HH:mm")</div>
                            </td>
                            <td style="text-align:right;">
                                @if (inv.TotalDiscount > 0)
                                {
                                    <span style="color:#16a34a; font-weight:600;">− Rs. @inv.TotalDiscount.ToString("N0")</span>
                                }
                                else
                                {
                                    <span class="caption">—</span>
                                }
                            </td>
                            <td style="text-align:right; font-weight:700;">Rs. @inv.TotalAmount.ToString("N2")</td>
                            <td style="text-align:center;">
                                <span class="badge @PayBadge(inv.PaymentStatus)">@inv.PaymentStatus</span>
                                @if (!string.IsNullOrEmpty(inv.PaymentMethod))
                                {
                                    <div class="caption" style="margin-top:2px;">@inv.PaymentMethod</div>
                                }
                            </td>
                            <td>
                                <div style="display:flex; gap:0.4rem; align-items:center;">
                                    @if (!string.IsNullOrEmpty(inv.PdfPath))
                                    {
                                        <a href="@inv.PdfPath" target="_blank" class="btn btn-ghost btn-sm" title="Download PDF"><i class="fas fa-file-pdf"></i></a>
                                    }
                                    else
                                    {
                                        <form asp-action="Regenerate" asp-route-id="@inv.Id" method="post" style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-ghost btn-sm" title="Generate PDF"><i class="fas fa-rotate"></i></button>
                                        </form>
                                    }
                                    @if (inv.PaymentStatus == "Pending" || inv.PaymentStatus == "Failed")
                                    {
                                        <form asp-action="MarkPaid" asp-route-id="@inv.Id" method="post" style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm" style="background:#dcfce7;color:#16a34a;border:1px solid #bbf7d0;" title="Confirm payment">
                                                <i class="fas fa-check"></i> Mark Paid
                                            </button>
                                        </form>
                                    }
                                    @if (inv.PaymentStatus == "Pending")
                                    {
                                        <form asp-action="MarkFailed" asp-route-id="@inv.Id" method="post" style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-ghost btn-sm" style="color:#dc2626;" title="Mark failed"><i class="fas fa-xmark"></i></button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (totalPages > 1)
        {
            <div style="padding:1rem 1.5rem; border-top:1px solid var(--border-light); display:flex; justify-content:flex-end; gap:0.25rem;">
                @for (int i = 1; i <= totalPages; i++)
                {
                    <a asp-action="Index"
                       asp-route-branchId="@selectedBranchId" asp-route-status="@status" asp-route-search="@search"
                       asp-route-fromDate="@fromDate" asp-route-toDate="@toDate" asp-route-page="@i"
                       class="btn btn-sm @(i == page ? "btn-primary" : "btn-ghost")" style="min-width:2rem;">@i</a>
                }
            </div>
        }
    </div>
</div>
