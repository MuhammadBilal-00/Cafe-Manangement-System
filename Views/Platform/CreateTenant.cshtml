@model Cafe.Services.ProvisionTenantRequest
@{
    ViewData["Title"] = "New Tenant";
}

<div style="max-width:640px;margin:0 auto;">
    <div style="margin-bottom:1.5rem;">
        <a asp-action="Tenants" class="btn btn-ghost btn-sm"><i class="fas fa-arrow-left" style="margin-right:0.4rem;"></i> Back</a>
        <h1 class="page-title" style="margin:0.75rem 0 0;">Create a Tenant</h1>
        <p class="body-text" style="margin-top:0.25rem;">Provisions a branch, roles, a starter menu and the admin user.</p>
    </div>

    <div class="card">
        <div class="card-body">
            <form asp-action="CreateTenant" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="All" class="text-danger" style="margin-bottom:1rem;"></div>

                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Business name</label>
                        <input name="BusinessName" value="@Model.BusinessName" class="form-control" required />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Workspace address (slug)</label>
                        <input name="Slug" value="@Model.Slug" class="form-control" placeholder="e.g. acme-cafe" />
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Admin name</label>
                        <input name="AdminName" value="@Model.AdminName" class="form-control" required />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Admin email</label>
                        <input name="AdminEmail" type="email" value="@Model.AdminEmail" class="form-control" required />
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Admin phone</label>
                        <input name="AdminPhone" value="@Model.AdminPhone" class="form-control" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Temporary password</label>
                        <input name="AdminPassword" type="text" class="form-control" required minlength="6" />
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label">Starter template</label>
                    <select name="Template" class="form-select">
                        <option value="cafe">Cafe</option>
                        <option value="restaurant">Restaurant</option>
                        <option value="bakery">Bakery</option>
                    </select>
                </div>

                <div style="display:flex;gap:0.75rem;margin-top:1.5rem;">
                    <button type="submit" class="btn btn-primary"><i class="fas fa-rocket" style="margin-right:0.5rem;"></i> Provision tenant</button>
                    <a asp-action="Tenants" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
