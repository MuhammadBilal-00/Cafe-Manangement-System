@model Cafe.Models.Plan
@{
    ViewData["Title"] = Model.Id == 0 ? "New Plan" : "Edit Plan";
    var allFeatures = ViewBag.AllFeatures as string[] ?? Array.Empty<string>();
    var current = (Model.Features ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries).ToHashSet(StringComparer.OrdinalIgnoreCase);
    var allOn = Model.Features == "*";
}

<div style="max-width:680px;margin:0 auto;">
    <div style="margin-bottom:1.5rem;">
        <a asp-action="Plans" class="btn btn-ghost btn-sm"><i class="fas fa-arrow-left" style="margin-right:0.4rem;"></i> Back</a>
        <h1 class="page-title" style="margin:0.75rem 0 0;">@ViewData["Title"]</h1>
    </div>

    <div class="card">
        <div class="card-body">
            <form asp-action="PlanForm" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="All" class="text-danger" style="margin-bottom:1rem;"></div>

                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Name</label>
                        <input asp-for="Name" class="form-control" required />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Monthly price (Rs.)</label>
                        <input asp-for="PriceMonthly" type="number" step="0.01" min="0" class="form-control" />
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label">Description</label>
                    <input asp-for="Description" class="form-control" />
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Max branches</label>
                        <input asp-for="MaxBranches" type="number" min="1" class="form-control" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Max users</label>
                        <input asp-for="MaxUsers" type="number" min="1" class="form-control" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Sort order</label>
                        <input asp-for="SortOrder" type="number" class="form-control" />
                    </div>
                </div>

                <div class="form-group">
                    <label style="display:flex;align-items:center;gap:0.5rem;font-weight:600;">
                        <input type="checkbox" name="allFeatures" value="true" id="allFeatures" @(allOn ? "checked" : "") onchange="document.getElementById('featureList').style.opacity=this.checked?0.4:1;document.getElementById('featureList').style.pointerEvents=this.checked?'none':'auto';" />
                        Unlock <b>all</b> features (master plan)
                    </label>
                </div>

                <div class="form-group" id="featureList" style="@(allOn ? "opacity:0.4;pointer-events:none;" : "")">
                    <label class="form-label">Included features</label>
                    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:0.5rem;">
                        @foreach (var f in allFeatures)
                        {
                            <label style="display:flex;align-items:center;gap:0.5rem;padding:0.5rem 0.75rem;border:1px solid var(--border);border-radius:8px;cursor:pointer;">
                                <input type="checkbox" name="features" value="@f" @(current.Contains(f) ? "checked" : "") />
                                @f
                            </label>
                        }
                    </div>
                    <p class="caption" style="margin-top:0.5rem;">Core POS (Menu, Orders, Branches, Staff, Attendance) is always included.</p>
                </div>

                <div class="form-group">
                    <label style="display:flex;align-items:center;gap:0.5rem;font-weight:600;">
                        <input type="checkbox" asp-for="IsActive" /> Visible / selectable
                    </label>
                </div>

                <div style="display:flex;gap:0.75rem;margin-top:1rem;">
                    <button type="submit" class="btn btn-primary"><i class="fas fa-save" style="margin-right:0.5rem;"></i> Save plan</button>
                    <a asp-action="Plans" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
