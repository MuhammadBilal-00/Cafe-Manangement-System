@{
    ViewData["Title"] = "Platform Console";
    var recent = ViewBag.Recent as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    (string,string) StatusBadge(string s) => s switch
    {
        "Active" => ("badge-success", s),
        "Trial" => ("badge-info", s),
        "Suspended" => ("badge-danger", s),
        _ => ("badge-neutral", s)
    };
}

<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:2rem; flex-wrap:wrap; gap:1rem;">
    <div>
        <h1 class="page-title" style="margin:0;">Platform Console</h1>
        <p class="body-text" style="margin-top:0.25rem;">Operate the SaaS — tenants, plans, usage.</p>
    </div>
    <a asp-action="CreateTenant" class="btn btn-primary"><i class="fas fa-plus" style="margin-right:0.5rem;"></i> New Tenant</a>
</div>

<div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(180px,1fr)); gap:1rem; margin-bottom:2rem;">
    <div class="kpi-card">
        <div class="kpi-icon" style="background:rgba(99,102,241,0.1); color:#6366f1;"><i class="fas fa-building"></i></div>
        <div class="kpi-label">Tenants</div>
        <div class="kpi-value">@ViewBag.TenantCount</div>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon" style="background:rgba(34,197,94,0.1); color:#16a34a;"><i class="fas fa-circle-check"></i></div>
        <div class="kpi-label">Active</div>
        <div class="kpi-value" style="color:#16a34a;">@ViewBag.ActiveCount</div>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon" style="background:rgba(59,130,246,0.1); color:#3b82f6;"><i class="fas fa-hourglass-half"></i></div>
        <div class="kpi-label">On Trial</div>
        <div class="kpi-value" style="color:#3b82f6;">@ViewBag.TrialCount</div>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon" style="background:rgba(239,68,68,0.1); color:#dc2626;"><i class="fas fa-ban"></i></div>
        <div class="kpi-label">Suspended</div>
        <div class="kpi-value" style="color:#dc2626;">@ViewBag.SuspendedCount</div>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon" style="background:rgba(212,175,55,0.12); color:var(--accent);"><i class="fas fa-users"></i></div>
        <div class="kpi-label">Total Users</div>
        <div class="kpi-value">@ViewBag.UserCount</div>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon" style="background:rgba(16,185,129,0.12); color:#059669;"><i class="fas fa-receipt"></i></div>
        <div class="kpi-label">Total Orders</div>
        <div class="kpi-value">@ViewBag.OrderCount</div>
    </div>
</div>

<div class="card">
    <div class="card-body" style="display:flex;align-items:center;justify-content:space-between;">
        <h2 style="margin:0;font-size:1.05rem;">Newest Tenants</h2>
        <a asp-action="Tenants" class="btn btn-ghost btn-sm">View all <i class="fas fa-arrow-right" style="margin-left:0.3rem;"></i></a>
    </div>
    <div class="card-body card-body-flush">
        <div style="overflow-x:auto;">
            <table class="premium-table">
                <thead><tr><th>Name</th><th>Workspace</th><th style="text-align:center;">Status</th><th>Created</th></tr></thead>
                <tbody>
                    @if (!recent.Any())
                    {
                        <tr><td colspan="4" style="text-align:center;padding:2.5rem;color:var(--text-secondary);">No tenants yet.</td></tr>
                    }
                    @foreach (var t in recent)
                    {
                        var sb = StatusBadge((string)t.Status);
                        <tr>
                            <td style="font-weight:600;">@t.Name</td>
                            <td><span class="caption">@t.Slug</span></td>
                            <td style="text-align:center;"><span class="badge @sb.Item1">@sb.Item2</span></td>
                            <td><span class="caption">@(((DateTime)t.CreatedAt).ToString("dd MMM yyyy"))</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
