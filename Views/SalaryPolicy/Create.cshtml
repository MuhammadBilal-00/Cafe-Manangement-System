@model Cafe.Models.SalaryPolicy
@{
    ViewData["Title"] = "Create Salary Policy";
}

<div class="max-w-[720px] mx-auto">
    <!-- Header -->
    <div style="display:flex; align-items:center; margin-bottom:1.5rem; gap:1rem;">
        <a asp-action="Index" class="btn btn-ghost btn-sm"><i class="fas fa-arrow-left"></i></a>
        <h1 class="page-title" style="margin:0;">Create Salary Policy</h1>
    </div>

    <div class="card">
        <div class="card-body">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="form-error" style="margin-bottom:1rem;"></div>

                <!-- Basic Info -->
                <h3 class="section-title" style="padding-bottom:0.5rem; border-bottom:1px solid var(--border-light); margin-bottom:1rem;">Basic Information</h3>
                <div class="form-group">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" placeholder="e.g., Standard Policy 2026" />
                    <span asp-validation-for="Name" class="form-error"></span>
                </div>
                <div class="form-row" style="margin-bottom:1rem;">
                    <div class="form-group" style="flex:1;">
                        <label asp-for="EffectiveFrom" class="form-label"></label>
                        <input asp-for="EffectiveFrom" type="date" class="form-control" />
                    </div>
                    <div class="form-group" style="flex:1;">
                        <label asp-for="EffectiveTo" class="form-label">Effective To (optional)</label>
                        <input asp-for="EffectiveTo" type="date" class="form-control" />
                    </div>
                </div>
                <div class="form-group" style="margin-bottom:1.5rem;">
                    <label style="display:flex; align-items:center; gap:0.5rem; cursor:pointer;">
                        <input asp-for="IsActive" type="checkbox" style="width:1rem; height:1rem; accent-color:var(--accent);" />
                        <span class="form-label" style="margin:0;">Activate immediately</span>
                    </label>
                </div>

                <div class="divider"></div>

                <!-- Deduction Factors -->
                <h3 class="section-title" style="padding-bottom:0.5rem; border-bottom:1px solid var(--border-light); margin-bottom:1rem;">Deduction Factors</h3>
                <div class="form-row">
                    <div class="form-group" style="flex:1;">
                        <label asp-for="AbsenceDeductionFactor" class="form-label">Absence Deduction Factor</label>
                        <input asp-for="AbsenceDeductionFactor" type="number" step="0.1" min="0" class="form-control" />
                        <span class="caption">Multiplied by daily rate per absent day (default: 1.0)</span>
                    </div>
                    <div class="form-group" style="flex:1;">
                        <label asp-for="HalfDayDeductionFactor" class="form-label">Half-Day Deduction Factor</label>
                        <input asp-for="HalfDayDeductionFactor" type="number" step="0.1" min="0" class="form-control" />
                        <span class="caption">Multiplied by daily rate per half-day (default: 0.5)</span>
                    </div>
                </div>
                <div class="form-row" style="margin-bottom:1.5rem;">
                    <div class="form-group" style="flex:1;">
                        <label asp-for="LatePenaltyThreshold" class="form-label">Late Penalty Threshold</label>
                        <input asp-for="LatePenaltyThreshold" type="number" min="1" class="form-control" />
                        <span class="caption">Number of lates before penalty triggers (default: 3)</span>
                    </div>
                    <div class="form-group" style="flex:1;">
                        <label asp-for="LatePenaltyFactor" class="form-label">Late Penalty Factor</label>
                        <input asp-for="LatePenaltyFactor" type="number" step="0.1" min="0" class="form-control" />
                        <span class="caption">Multiplied by daily rate per penalty unit (default: 0.5)</span>
                    </div>
                </div>

                <div class="divider"></div>

                <!-- Earnings Factors -->
                <h3 class="section-title" style="padding-bottom:0.5rem; border-bottom:1px solid var(--border-light); margin-bottom:1rem;">Earnings Factors</h3>
                <div class="form-row">
                    <div class="form-group" style="flex:1;">
                        <label asp-for="OvertimeMultiplier" class="form-label">Overtime Multiplier</label>
                        <input asp-for="OvertimeMultiplier" type="number" step="0.1" min="1" class="form-control" />
                        <span class="caption">Applied to hourly rate for OT hours (default: 1.5x)</span>
                    </div>
                    <div class="form-group" style="flex:1;">
                        <label asp-for="AttendanceBonusPercentage" class="form-label">Attendance Bonus %</label>
                        <input asp-for="AttendanceBonusPercentage" type="number" step="0.5" min="0" class="form-control" />
                        <span class="caption">% of base salary as bonus for good attendance (default: 5%)</span>
                    </div>
                </div>
                <div class="form-row" style="margin-bottom:1.5rem;">
                    <div class="form-group" style="flex:1;">
                        <label asp-for="MaxLateForBonus" class="form-label">Max Lates for Bonus</label>
                        <input asp-for="MaxLateForBonus" type="number" min="0" class="form-control" />
                        <span class="caption">Max late days to still qualify for bonus (default: 2)</span>
                    </div>
                    <div class="form-group" style="flex:1;">
                        <label asp-for="MaxAbsentForBonus" class="form-label">Max Absents for Bonus</label>
                        <input asp-for="MaxAbsentForBonus" type="number" min="0" class="form-control" />
                        <span class="caption">Max absent days to still qualify for bonus (default: 0)</span>
                    </div>
                </div>

                <div class="divider"></div>

                <!-- Work Standards -->
                <h3 class="section-title" style="padding-bottom:0.5rem; border-bottom:1px solid var(--border-light); margin-bottom:1rem;">Work Standards</h3>
                <div class="form-row" style="margin-bottom:1.5rem;">
                    <div class="form-group" style="flex:1;">
                        <label asp-for="StandardDailyHours" class="form-label">Standard Daily Hours</label>
                        <input asp-for="StandardDailyHours" type="number" step="0.5" min="1" class="form-control" />
                        <span class="caption">Used to compute hourly rate (default: 8h)</span>
                    </div>
                    <div class="form-group" style="flex:1;">
                        <label asp-for="LateThresholdMinutes" class="form-label">Late Threshold (minutes)</label>
                        <input asp-for="LateThresholdMinutes" type="number" min="0" class="form-control" />
                        <span class="caption">Minutes after shift start to consider late (default: 15)</span>
                    </div>
                </div>

                <div class="divider"></div>

                <!-- Notes -->
                <div class="form-group" style="margin-bottom:1.5rem;">
                    <label asp-for="Notes" class="form-label">Notes (optional)</label>
                    <textarea asp-for="Notes" rows="2" class="form-control" placeholder="Internal notes about this policy..."></textarea>
                </div>

                <!-- Actions -->
                <div style="display:flex; gap:0.75rem;">
                    <button type="submit" class="btn btn-primary" style="flex:1;">
                        <i class="fas fa-save" style="margin-right:0.5rem;"></i> Create Policy
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
