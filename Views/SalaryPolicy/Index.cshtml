@model Cafe.Models.ViewModels.SalaryPolicyViewModel
@{
    ViewData["Title"] = "Salary Policies";
}

<!-- Header -->
<div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:1.5rem; flex-wrap:wrap; gap:1rem;">
    <h1 class="page-title" style="margin:0;"><i class="fas fa-file-contract" style="color:var(--accent); margin-right:0.5rem;"></i> Salary Policies</h1>
    <a asp-action="Create" class="btn btn-primary"><i class="fas fa-plus" style="margin-right:0.5rem;"></i> New Policy</a>
</div>

<!-- Active Policy Highlight -->
@if (Model.ActivePolicy != null)
{
    <div class="card card-accent mb-6">
        <div class="card-body">
            <div style="display:flex; align-items:center; gap:0.75rem; margin-bottom:0.75rem;">
                <i class="fas fa-check-circle" style="color:#22c55e; font-size:1.25rem;"></i>
                <h3 style="margin:0; font-weight:700; color:var(--text-primary);">Active: @Model.ActivePolicy.Name</h3>
                <span class="badge badge-success">Active</span>
            </div>
            <p class="caption" style="margin-bottom:0.75rem;">
                Effective from @Model.ActivePolicy.EffectiveFrom.ToString("dd MMM yyyy")
                @(Model.ActivePolicy.EffectiveTo.HasValue ? $"to {Model.ActivePolicy.EffectiveTo.Value:dd MMM yyyy}" : "(ongoing)")
            </p>
            <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(160px,1fr)); gap:1rem;">
                <div class="kpi-card" style="padding:0.75rem;">
                    <span class="kpi-label">OT Multiplier</span>
                    <span class="kpi-value" style="font-size:1.1rem;">@(Model.ActivePolicy.OvertimeMultiplier)x</span>
                </div>
                <div class="kpi-card" style="padding:0.75rem;">
                    <span class="kpi-label">Absence Factor</span>
                    <span class="kpi-value" style="font-size:1.1rem;">@(Model.ActivePolicy.AbsenceDeductionFactor)x</span>
                </div>
                <div class="kpi-card" style="padding:0.75rem;">
                    <span class="kpi-label">Late Penalty</span>
                    <span class="kpi-value" style="font-size:1.1rem;">Every @(Model.ActivePolicy.LatePenaltyThreshold) = @(Model.ActivePolicy.LatePenaltyFactor)x</span>
                </div>
                <div class="kpi-card" style="padding:0.75rem;">
                    <span class="kpi-label">Attendance Bonus</span>
                    <span class="kpi-value" style="font-size:1.1rem;">@(Model.ActivePolicy.AttendanceBonusPercentage)%</span>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="card card-accent-warning mb-6 bg-[rgba(245,158,11,0.04)]">
        <div class="card-body card-body-compact">
            <p class="body-text" style="margin:0; color:#92400e;">
                <i class="fas fa-exclamation-triangle" style="margin-right:0.5rem;"></i>
                No active policy. Create and activate one before generating salaries.
            </p>
        </div>
    </div>
}

<!-- Policies Table -->
<div class="card">
    <div class="card-body card-body-flush">
        <div style="overflow-x:auto;">
            <table class="premium-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th style="text-align:center;">Status</th>
                        <th style="text-align:center;">Effective</th>
                        <th style="text-align:center;">OT</th>
                        <th style="text-align:center;">Absence</th>
                        <th style="text-align:center;">Late Pen.</th>
                        <th style="text-align:center;">Attend. Bonus</th>
                        <th style="text-align:center;">Created</th>
                        <th style="text-align:center;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Policies.Any())
                    {
                        <tr>
                            <td colspan="9">
                                <div class="empty-state">
                                    <i class="fas fa-file-contract"></i>
                                    <h3>No Policies</h3>
                                    <p>Create a salary policy to get started.</p>
                                </div>
                            </td>
                        </tr>
                    }
                    @foreach (var p in Model.Policies)
                    {
                        <tr style="@(p.IsActive ? "background:rgba(34,197,94,0.04);" : "")">
                            <td>
                                <span style="font-weight:600;">@p.Name</span>
                                @if (!string.IsNullOrEmpty(p.Notes))
                                {
                                    <br /><span class="caption">@p.Notes</span>
                                }
                            </td>
                            <td style="text-align:center;">
                                <span class="badge @(p.IsActive ? "badge-success" : "badge-neutral")">
                                    @(p.IsActive ? "Active" : "Inactive")
                                </span>
                            </td>
                            <td style="text-align:center;">
                                @p.EffectiveFrom.ToString("dd MMM yy")
                                @(p.EffectiveTo.HasValue ? $"- {p.EffectiveTo.Value:dd MMM yy}" : " - ongoing")
                            </td>
                            <td style="text-align:center;">@(p.OvertimeMultiplier)x</td>
                            <td style="text-align:center;">@(p.AbsenceDeductionFactor)x</td>
                            <td style="text-align:center;">@(p.LatePenaltyThreshold)/@(p.LatePenaltyFactor)x</td>
                            <td style="text-align:center;">@(p.AttendanceBonusPercentage)%</td>
                            <td style="text-align:center;">
                                @p.CreatedAt.ToString("dd MMM yy")
                                <br /><span class="caption">@(p.CreatedBy?.Name ?? "")</span>
                            </td>
                            <td style="text-align:center;">
                                <div style="display:flex; align-items:center; justify-content:center; gap:0.5rem;">
                                    <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-ghost btn-sm" title="Edit">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    @if (!p.IsActive)
                                    {
                                        <form asp-action="Activate" asp-route-id="@p.Id" method="post" style="display:inline;"
                                              data-confirm="Activate this policy? Overlapping policies will be deactivated.">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm" style="color:#22c55e; background:none; border:none; padding:0.25rem 0.5rem;" title="Activate">
                                                <i class="fas fa-toggle-on"></i>
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="Deactivate" asp-route-id="@p.Id" method="post" style="display:inline;"
                                              data-confirm="Deactivate this policy?">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm" style="color:#ef4444; background:none; border:none; padding:0.25rem 0.5rem;" title="Deactivate">
                                                <i class="fas fa-toggle-off"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Back Link -->
<div style="margin-top:1.5rem;">
    <a asp-controller="Salary" asp-action="Index" class="btn btn-ghost btn-sm">
        <i class="fas fa-arrow-left" style="margin-right:0.5rem;"></i> Back to Salary Management
    </a>
</div>
