@model Cafe.Models.ViewModels.SalaryPolicyViewModel
@{
    ViewData["Title"] = "Salary Policies";
}

<div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-bold text-gray-800">Salary Policies</h1>
    <a asp-action="Create" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg transition duration-200">
        <i class="fas fa-plus mr-2"></i> New Policy
    </a>
</div>

<!-- Active Policy Highlight -->
@if (Model.ActivePolicy != null)
{
    <div class="bg-green-50 border border-green-200 rounded-lg p-5 mb-6">
        <div class="flex items-center justify-between">
            <div>
                <h3 class="text-lg font-bold text-green-800"><i class="fas fa-check-circle mr-2"></i> Active: @Model.ActivePolicy.Name</h3>
                <p class="text-sm text-green-600 mt-1">
                    Effective from @Model.ActivePolicy.EffectiveFrom.ToString("dd MMM yyyy")
                    @(Model.ActivePolicy.EffectiveTo.HasValue ? $"to {Model.ActivePolicy.EffectiveTo.Value:dd MMM yyyy}" : "(ongoing)")
                </p>
                <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-3 text-sm">
                    <div><span class="text-gray-500">OT Multiplier:</span> <strong>@(Model.ActivePolicy.OvertimeMultiplier)x</strong></div>
                    <div><span class="text-gray-500">Absence Factor:</span> <strong>@(Model.ActivePolicy.AbsenceDeductionFactor)x</strong></div>
                    <div><span class="text-gray-500">Late Penalty:</span> <strong>Every @(Model.ActivePolicy.LatePenaltyThreshold) = @(Model.ActivePolicy.LatePenaltyFactor)x</strong></div>
                    <div><span class="text-gray-500">Attendance Bonus:</span> <strong>@(Model.ActivePolicy.AttendanceBonusPercentage)%</strong></div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="bg-amber-50 border border-amber-200 rounded-lg p-4 mb-6">
        <p class="text-sm text-amber-800">
            <i class="fas fa-exclamation-triangle mr-1"></i>
            No active policy. Create and activate one before generating salaries.
        </p>
    </div>
}

<!-- Policies Table -->
<div class="bg-white rounded-lg shadow-md overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
            <tr>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Name</th>
                <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase">Status</th>
                <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase">Effective</th>
                <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase">OT</th>
                <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase">Absence</th>
                <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase">Late Pen.</th>
                <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase">Attend. Bonus</th>
                <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase">Created</th>
                <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase">Actions</th>
            </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
            @if (!Model.Policies.Any())
            {
                <tr>
                    <td colspan="9" class="px-6 py-12 text-center text-gray-500">
                        <i class="fas fa-file-contract text-4xl mb-3 block"></i>
                        No salary policies found. Create one to get started.
                    </td>
                </tr>
            }
            @foreach (var p in Model.Policies)
            {
                var statusClass = p.IsActive ? "bg-green-100 text-green-800" : "bg-gray-100 text-gray-600";
                <tr class="hover:bg-gray-50 @(p.IsActive ? "bg-green-50" : "")">
                    <td class="px-4 py-4 text-sm font-medium text-gray-800">
                        @p.Name
                        @if (!string.IsNullOrEmpty(p.Notes))
                        {
                            <p class="text-xs text-gray-400 mt-1">@p.Notes</p>
                        }
                    </td>
                    <td class="px-4 py-4 text-center">
                        <span class="px-2 py-1 text-xs font-medium rounded-full @statusClass">
                            @(p.IsActive ? "Active" : "Inactive")
                        </span>
                    </td>
                    <td class="px-4 py-4 text-sm text-center">
                        @p.EffectiveFrom.ToString("dd MMM yy")
                        @(p.EffectiveTo.HasValue ? $"- {p.EffectiveTo.Value:dd MMM yy}" : " - ongoing")
                    </td>
                    <td class="px-4 py-4 text-sm text-center">@(p.OvertimeMultiplier)x</td>
                    <td class="px-4 py-4 text-sm text-center">@(p.AbsenceDeductionFactor)x</td>
                    <td class="px-4 py-4 text-sm text-center">@(p.LatePenaltyThreshold)/@(p.LatePenaltyFactor)x</td>
                    <td class="px-4 py-4 text-sm text-center">@(p.AttendanceBonusPercentage)%</td>
                    <td class="px-4 py-4 text-sm text-center text-gray-500">
                        @p.CreatedAt.ToString("dd MMM yy")
                        <br /><span class="text-xs">@(p.CreatedBy?.Name ?? "")</span>
                    </td>
                    <td class="px-4 py-4 text-center text-sm">
                        <a asp-action="Edit" asp-route-id="@p.Id" class="text-blue-600 hover:text-blue-800 mr-2" title="Edit">
                            <i class="fas fa-edit"></i>
                        </a>
                        @if (!p.IsActive)
                        {
                            <form asp-action="Activate" asp-route-id="@p.Id" method="post" class="inline"
                                  data-confirm="Activate this policy? Overlapping policies will be deactivated.">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="text-green-600 hover:text-green-800 mr-2" title="Activate">
                                    <i class="fas fa-toggle-on"></i>
                                </button>
                            </form>
                        }
                        else
                        {
                            <form asp-action="Deactivate" asp-route-id="@p.Id" method="post" class="inline"
                                  data-confirm="Deactivate this policy?">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="text-red-600 hover:text-red-800 mr-2" title="Deactivate">
                                    <i class="fas fa-toggle-off"></i>
                                </button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="mt-6">
    <a asp-controller="Salary" asp-action="Index" class="text-gray-500 hover:text-gray-700">
        <i class="fas fa-arrow-left mr-1"></i> Back to Salary Management
    </a>
</div>
