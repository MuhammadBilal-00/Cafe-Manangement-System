@model Cafe.Models.ViewModels.BranchPerformanceViewModel

@{
    ViewData["Title"] = "Branch Performance";

    DateTime from = Model.FromDate;
    DateTime to = Model.ToDate;

    var branches = Model.Branches;
    decimal maxRevenue = branches.Any() ? branches.Max(b => b.Revenue) : 1m;
    if (maxRevenue <= 0) maxRevenue = 1;
    int maxOrders = branches.Any() ? branches.Max(b => b.TotalOrders) : 1;
    if (maxOrders <= 0) maxOrders = 1;

    string FormatCurrency(decimal value) => "$" + value.ToString("N2");

    double overallAvgFeedback = branches.Any() ? branches.Average(b => b.AvgFeedbackRating) : 0.0;
    int totalOpenFeedback = branches.Sum(b => b.OpenFeedbackCount);
}

<!-- Page Header -->
<div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:1rem;margin-bottom:2rem;">
    <div>
        <h1 class="page-title" style="margin:0;">Branch Performance</h1>
        <p class="body-text" style="margin-top:0.25rem;">Compare revenue, orders and feedback across branches.</p>
    </div>
    <a asp-action="Index" asp-controller="Reports" class="btn btn-secondary btn-sm"><i class="fas fa-arrow-left"></i>
        Reports</a>
    </div>

    <!-- Filters -->
    <form method="get" class="card mb-6">
        <div class="card-body flex flex-wrap gap-4 items-end">
            <div class="form-group" style="min-width:140px;margin:0;">
                <label class="form-label">From</label>
                <input type="date" name="from" value="@from.ToString("yyyy-MM-dd")" class="form-control" />
            </div>
            <div class="form-group" style="min-width:140px;margin:0;">
                <label class="form-label">To</label>
                <input type="date" name="to" value="@to.ToString("yyyy-MM-dd")" class="form-control" />
            </div>
            <button type="submit" class="btn btn-primary btn-sm"><i class="fas fa-search"></i> Apply</button>
            <a asp-action="BranchPerformance" class="btn btn-ghost btn-sm">Reset</a>
        </div>
    </form>

    <!-- Summary Strip -->
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:1rem;margin-bottom:1.5rem;">
        <div class="kpi-card">
            <div class="kpi-icon" style="background:#dbeafe;color:#2563eb;"><i class="fas fa-building"></i></div>
            <div class="kpi-label">Branches</div>
            <div class="kpi-value">@branches.Count</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-icon" style="background:#dcfce7;color:#16a34a;"><i class="fas fa-dollar-sign"></i></div>
            <div class="kpi-label">Top Revenue</div>
            <div class="kpi-value">@(branches.Any() ? FormatCurrency(branches.Max(b => b.Revenue)) : "$0.00")</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-icon" style="background:#fef3c7;color:#d97706;"><i class="fas fa-star"></i></div>
            <div class="kpi-label">Avg Feedback</div>
            <div class="kpi-value">@overallAvgFeedback.ToString("0.0")/5</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-icon" style="background:#fee2e2;color:#dc2626;"><i class="fas fa-comment-dots"></i></div>
            <div class="kpi-label">Open Feedback</div>
            <div class="kpi-value">@totalOpenFeedback</div>
        </div>
    </div>

    @if (branches.Any())
    {
        <!-- Charts Row -->
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:1.25rem;margin-bottom:1.5rem;">
            <!-- Revenue Bar Chart -->
            <div class="card min-w-0">
                <div class="card-header">
                    <h3 class="section-title"><i class="fas fa-chart-bar" style="color:var(--accent);margin-right:0.5rem;"></i>Revenue by Branch</h3>
                </div>
                <div class="card-body relative h-[340px]">
                    <canvas id="branchRevenueChart"></canvas>
                </div>
            </div>
            <!-- Orders Doughnut Chart -->
            <div class="card min-w-0">
                <div class="card-header">
                    <h3 class="section-title"><i class="fas fa-chart-pie" style="color:var(--accent);margin-right:0.5rem;"></i>Orders Distribution</h3>
                </div>
                <div class="card-body relative h-[340px]">
                    <canvas id="branchOrdersChart"></canvas>
                </div>
            </div>
        </div>

        <!-- Completion & Feedback Row -->
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:1.25rem;margin-bottom:1.5rem;">
            <!-- Completion Rate Chart -->
            <div class="card min-w-0">
                <div class="card-header">
                    <h3 class="section-title"><i class="fas fa-bullseye" style="color:#10b981;margin-right:0.5rem;"></i>Completion Rate by Branch</h3>
                </div>
                <div class="card-body relative h-[300px]">
                    <canvas id="branchCompletionChart"></canvas>
                </div>
            </div>
            <!-- Feedback Rating Chart -->
            <div class="card min-w-0">
                <div class="card-header">
                    <h3 class="section-title"><i class="fas fa-star" style="color:#f59e0b;margin-right:0.5rem;"></i>Feedback Ratings</h3>
                </div>
                <div class="card-body relative h-[300px]">
                    <canvas id="branchFeedbackChart"></canvas>
                </div>
            </div>
        </div>
    }

    <!-- Branch Cards Grid -->
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:1.25rem;">
        @if (branches.Any())
        {
            @foreach (var b in branches)
            {
                int revPct = (int)Math.Round(b.Revenue / maxRevenue * 100m);
                int ordersPct = (int)Math.Round((decimal)b.TotalOrders / maxOrders * 100m);
                int completion = (int)Math.Round(b.CompletionRate);

                <div class="card">
                    <div class="card-body">
                        <div style="display:flex;justify-content:space-between;align-items:start;margin-bottom:0.75rem;">
                            <div>
                                <span class="badge badge-info" style="font-size:0.6rem;margin-bottom:0.4rem;">Branch</span>
                                <h3 style="font-weight:700;font-size:0.95rem;margin:0;">@b.BranchName</h3>
                                @if (!string.IsNullOrWhiteSpace(b.Location))
                                {
                                    <span class="caption">@b.Location</span>
                                }
                            </div>
                            <div
                                style="width:36px;height:36px;border-radius:10px;background:#e0f2fe;color:#0284c7;display:flex;align-items:center;justify-content:center;">
                                <i class="fas fa-building"></i>
                            </div>
                        </div>

                        <!-- Metrics Grid -->
                        <div style="display:grid;grid-template-columns:1fr 1fr;gap:0.5rem;margin-bottom:0.75rem;">
                            <div
                                style="padding:0.5rem;background:var(--bg-body);border-radius:10px;border:1px solid var(--border-light);">
                                <div class="caption">Revenue</div>
                                <div style="font-weight:700;font-size:0.85rem;">@FormatCurrency(b.Revenue)</div>
                            </div>
                            <div
                                style="padding:0.5rem;background:var(--bg-body);border-radius:10px;border:1px solid var(--border-light);">
                                <div class="caption">Avg Ticket</div>
                                <div style="font-weight:700;font-size:0.85rem;">@FormatCurrency(b.AverageOrderValue)</div>
                            </div>
                            <div
                                style="padding:0.5rem;background:var(--bg-body);border-radius:10px;border:1px solid var(--border-light);">
                                <div class="caption">Avg Feedback</div>
                                <div style="font-weight:700;font-size:0.85rem;">@b.AvgFeedbackRating.ToString("0.0")/5</div>
                            </div>
                            <div
                                style="padding:0.5rem;background:var(--bg-body);border-radius:10px;border:1px solid var(--border-light);">
                                <div class="caption">Open Feedback</div>
                                <div style="font-weight:700;font-size:0.85rem;">@b.OpenFeedbackCount</div>
                            </div>
                        </div>

                        <!-- Progress Bars -->
                        <div style="display:flex;flex-direction:column;gap:0.5rem;">
                            <div>
                                <div style="display:flex;justify-content:space-between;font-size:0.7rem;margin-bottom:0.15rem;">
                                    <span style="color:var(--text-tertiary);">Orders</span>
                                    <span style="font-weight:600;">@b.TotalOrders</span>
                                </div>
                                <div style="height:6px;background:var(--bg-body);border-radius:3px;overflow:hidden;">
                                    <div
                                        style="height:100%;width:@(ordersPct)%;background:linear-gradient(90deg,#0ea5e9,#8b5cf6);border-radius:3px;">
                                    </div>
                                </div>
                            </div>
                            <div>
                                <div style="display:flex;justify-content:space-between;font-size:0.7rem;margin-bottom:0.15rem;">
                                    <span style="color:var(--text-tertiary);">Completion</span>
                                    <span style="font-weight:600;">@completion%</span>
                                </div>
                                <div style="height:6px;background:var(--bg-body);border-radius:3px;overflow:hidden;">
                                    <div
                                        style="height:100%;width:@(completion)%;background:linear-gradient(90deg,#10b981,#06b6d4);border-radius:3px;">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="card col-span-full p-12 text-center">
                <div style="font-size:2.5rem;color:var(--text-tertiary);margin-bottom:0.5rem;"><i class="fas fa-building"></i>
                </div>
                <p class="body-text">No orders found for this date range.</p>
            </div>
        }
    </div>

@section Scripts {
<script>
@if (branches.Any())
{
    <text>
    (function() {
        const branchNames = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(branches.Select(b => b.BranchName).ToArray()));
        const revenues = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(branches.Select(b => Math.Round(b.Revenue, 2)).ToArray()));
        const orders = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(branches.Select(b => b.TotalOrders).ToArray()));
        const completions = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(branches.Select(b => Math.Round(b.CompletionRate, 1)).ToArray()));
        const feedbacks = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(branches.Select(b => Math.Round(b.AvgFeedbackRating, 1)).ToArray()));
        const branchColors = C => branchNames.map((_, i) => C.color((i % 8) + 1));

        // Revenue Bar Chart
        CafeCharts.make('branchRevenueChart', C => {
            const colors = branchColors(C);
            return {
                type: 'bar',
                data: {
                    labels: branchNames,
                    datasets: [{
                        label: 'Revenue ($)',
                        data: revenues,
                        backgroundColor: colors.map(c => C.alpha(c, 0.8)),
                        borderColor: colors,
                        borderWidth: 1,
                        borderRadius: 6
                    }]
                },
                options: {
                    responsive: true, maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: { callbacks: { label: ctx => '$' + ctx.raw.toLocaleString() } }
                    },
                    scales: C.scales({ maxRotation: 45, yTicks: v => '$' + v.toLocaleString() })
                }
            };
        });

        // Orders Doughnut Chart
        CafeCharts.make('branchOrdersChart', C => {
            const colors = branchColors(C);
            return {
                type: 'doughnut',
                data: {
                    labels: branchNames,
                    datasets: [{
                        data: orders,
                        backgroundColor: colors.map(c => C.alpha(c, 0.8)),
                        borderColor: colors,
                        borderWidth: 2,
                        hoverOffset: 8
                    }]
                },
                options: {
                    responsive: true, maintainAspectRatio: false,
                    cutout: '55%',
                    plugins: {
                        legend: { position: 'right' },
                        tooltip: { callbacks: { label: ctx => ctx.label + ': ' + ctx.raw + ' orders' } }
                    }
                }
            };
        });

        // Completion Rate Horizontal Bar — thresholds map to semantic tokens
        CafeCharts.make('branchCompletionChart', C => ({
            type: 'bar',
            data: {
                labels: branchNames,
                datasets: [{
                    label: 'Completion %',
                    data: completions,
                    backgroundColor: completions.map(v => C.alpha(v >= 80 ? C.status('success') : v >= 50 ? C.status('warning') : C.status('danger'), 0.7)),
                    borderColor: completions.map(v => v >= 80 ? C.status('success') : v >= 50 ? C.status('warning') : C.status('danger')),
                    borderWidth: 1,
                    borderRadius: 6
                }]
            },
            options: {
                indexAxis: 'y', responsive: true, maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: { callbacks: { label: ctx => ctx.raw + '%' } }
                },
                scales: {
                    x: { max: 100, ticks: { callback: v => v + '%', color: C.ink().tick }, grid: { color: C.ink().grid }, border: { display: false } },
                    y: { ticks: { color: C.ink().tick }, grid: { display: false }, border: { color: C.ink().axis } }
                }
            }
        }));

        // Feedback Rating Polar Area
        CafeCharts.make('branchFeedbackChart', C => {
            const colors = branchColors(C);
            return {
                type: 'polarArea',
                data: {
                    labels: branchNames,
                    datasets: [{
                        data: feedbacks,
                        backgroundColor: colors.map(c => C.alpha(c, 0.5)),
                        borderColor: colors,
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true, maintainAspectRatio: false,
                    scales: {
                        r: { max: 5, beginAtZero: true, ticks: { stepSize: 1, color: C.ink().tick, backdropColor: 'transparent' }, grid: { color: C.ink().grid } }
                    },
                    plugins: {
                        legend: { position: 'right' },
                        tooltip: { callbacks: { label: ctx => ctx.label + ': ' + ctx.raw + '/5' } }
                    }
                }
            };
        });
    })();
    </text>
}
</script>
}