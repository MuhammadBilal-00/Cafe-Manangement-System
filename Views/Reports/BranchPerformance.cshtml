@model Cafe.Models.ViewModels.BranchPerformanceViewModel

@{
    ViewData["Title"] = "Branch Performance";

    DateTime from = Model.FromDate;
    DateTime to = Model.ToDate;

    var branches = Model.Branches;
    decimal maxRevenue = branches.Any() ? branches.Max(b => b.Revenue) : 1m;
    if (maxRevenue <= 0) maxRevenue = 1;

    int maxOrders = branches.Any() ? branches.Max(b => b.TotalOrders) : 1;
    if (maxOrders <= 0) maxOrders = 1;

    string FormatCurrency(decimal value) => "$" + value.ToString("N2");

    // NEW: simple overall feedback stats (optional)
    double overallAvgFeedback = branches.Any()
        ? branches.Average(b => b.AvgFeedbackRating)
        : 0.0;
    int totalOpenFeedback = branches.Sum(b => b.OpenFeedbackCount);
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Cafe OS</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    animation: {
                        'float': 'float 6s ease-in-out infinite',
                        'pulse-slow': 'pulse 3s cubic-bezier(0.4, 0, 0.6, 1) infinite',
                    },
                    keyframes: {
                        float: {
                            '0%, 100%': { transform: 'translateY(0px)' },
                            '50%': { transform: 'translateY(-10px)' },
                        },
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-slate-100 text-slate-900 min-h-screen antialiased">

    <!-- Top bar -->
    <header class="sticky top-0 z-40 bg-white/80 backdrop-blur-xl border-b border-slate-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="relative w-10 h-10">
                    <div class="absolute inset-0 rounded-2xl bg-gradient-to-tr from-sky-500 via-violet-500 to-cyan-400 blur-sm opacity-80"></div>
                    <div class="relative w-full h-full rounded-2xl bg-white flex items-center justify-center text-2xl shadow-sm">
                        🏬
                    </div>
                </div>
                <div>
                    <p class="text-[11px] uppercase tracking-[0.25em] text-slate-400">
                        Cafe OS
                    </p>
                    <h1 class="text-sm sm:text-base font-semibold tracking-wide text-slate-900">
                        Branch Performance
                    </h1>
                </div>
            </div>

            <div class="flex items-center gap-2 sm:gap-3">
                <a href="@Url.Action("Index", "Reports")"
                   class="inline-flex items-center gap-1.5 rounded-full bg-slate-900 text-slate-50 text-xs sm:text-[13px] font-medium px-3 py-1.5 shadow-sm hover:bg-slate-800 transition">
                    ⬅ Reports
                </a>
            </div>
        </div>
    </header>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-10 space-y-8">

        <!-- Filters (date only, branch is implied by role) -->
        <!-- (unchanged) -->
        <section class="rounded-3xl bg-white/95 border border-slate-200 shadow-[0_16px_40px_rgba(15,23,42,0.12)] p-4 sm:p-6 lg:p-7 space-y-4">
            <!-- ... existing filter code ... -->
            <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
                <div class="space-y-1">
                    <p class="text-xs font-semibold tracking-[0.2em] uppercase text-slate-500">
                        Filters
                    </p>
                </div>

                <form method="get" class="w-full lg:w-auto flex flex-col sm:flex-row gap-3 sm:items-end">
                    <div class="flex gap-3 w-full sm:w-auto">
                        <div>
                            <label class="block text-[11px] font-medium text-slate-500 mb-1 uppercase tracking-[0.16em]">
                                From
                            </label>
                            <input type="date"
                                   name="from"
                                   value="@from.ToString("yyyy-MM-dd")"
                                   class="w-full sm:w-44 px-3 py-2 rounded-xl bg-slate-50 border border-slate-200 text-sm text-slate-900 focus:outline-none focus:ring-2 focus:ring-sky-500/60 focus:border-sky-400/60" />
                        </div>
                        <div>
                            <label class="block text-[11px] font-medium text-slate-500 mb-1 uppercase tracking-[0.16em]">
                                To
                            </label>
                            <input type="date"
                                   name="to"
                                   value="@to.ToString("yyyy-MM-dd")"
                                   class="w-full sm:w-44 px-3 py-2 rounded-xl bg-slate-50 border border-slate-200 text-sm text-slate-900 focus:outline-none focus:ring-2 focus:ring-sky-500/60 focus:border-sky-400/60" />
                        </div>
                    </div>

                    <div class="flex gap-2 sm:gap-3">
                        <button type="submit"
                                class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-gradient-to-r from-sky-500 to-violet-500 text-white text-xs sm:text-sm font-semibold shadow-md shadow-sky-400/40 hover:-translate-y-0.5 hover:shadow-lg transition">
                            🔍 Apply
                        </button>
                        <a href="@Url.Action("BranchPerformance", "Reports")"
                           class="inline-flex items-center gap-1.5 px-3 py-2 rounded-xl bg-slate-100 text-slate-600 text-xs sm:text-sm font-medium border border-slate-200 hover:bg-slate-200 transition">
                            Reset
                        </a>
                    </div>
                </form>
            </div>
        </section>

        <!-- Summary strip -->
        <section class="rounded-3xl bg-white border border-slate-200 shadow-sm p-4 sm:p-5 flex flex-wrap gap-4 items-center justify-between">
            <div>
                <p class="text-[11px] text-slate-500 uppercase tracking-[0.2em]">
                    Range
                </p>
                <p class="text-sm font-semibold text-slate-900">
                    @from.ToString("dd MMM yyyy") – @to.ToString("dd MMM yyyy")
                </p>
            </div>

            <div class="flex gap-4 text-[11px]">
                <div class="rounded-2xl bg-slate-50 border border-slate-200 px-3 py-2 min-w-[120px]">
                    <p class="text-slate-500 uppercase tracking-[0.16em] mb-0.5">Branches</p>
                    <p class="font-semibold text-slate-900">@branches.Count</p>
                </div>
                <div class="rounded-2xl bg-slate-50 border border-slate-200 px-3 py-2 min-w-[120px]">
                    <p class="text-slate-500 uppercase tracking-[0.16em] mb-0.5">Top revenue</p>
                    <p class="font-semibold text-slate-900">
                        @(branches.Any() ? branches.Max(b => FormatCurrency(b.Revenue)) : "$0.00")
                    </p>
                </div>

                <!-- NEW: overall feedback summary -->
                <div class="rounded-2xl bg-slate-50 border border-slate-200 px-3 py-2 min-w-[140px]">
                    <p class="text-slate-500 uppercase tracking-[0.16em] mb-0.5">Avg feedback</p>
                    <p class="font-semibold text-slate-900">
                        @overallAvgFeedback.ToString("0.0") / 5
                    </p>
                </div>
                <div class="rounded-2xl bg-slate-50 border border-slate-200 px-3 py-2 min-w-[140px]">
                    <p class="text-slate-500 uppercase tracking-[0.16em] mb-0.5">Open feedback</p>
                    <p class="font-semibold text-slate-900">
                        @totalOpenFeedback
                    </p>
                </div>
            </div>
        </section>

        <!-- Branch cards grid -->
        <section class="grid md:grid-cols-2 xl:grid-cols-3 gap-5">
            @if (branches.Any())
            {
                @foreach (var b in branches)
                {
                    int revPct = (int)Math.Round(b.Revenue / maxRevenue * 100m);
                    int ordersPct = (int)Math.Round((decimal)b.TotalOrders / maxOrders * 100m);
                    int completion = (int)Math.Round(b.CompletionRate);

                    <div class="rounded-3xl bg-white border border-slate-200 shadow-sm p-4 sm:p-5 flex flex-col gap-3">
                        <div class="flex items-start justify-between gap-2">
                            <div>
                                <p class="text-[11px] uppercase tracking-[0.18em] text-sky-600 mb-0.5">
                                    Branch
                                </p>
                                <h3 class="text-sm font-semibold text-slate-900">
                                    @b.BranchName
                                </h3>
                                @if (!string.IsNullOrWhiteSpace(b.Location))
                                {
                                    <p class="text-[11px] text-slate-500">
                                        @b.Location
                                    </p>
                                }
                            </div>
                            <div class="flex h-9 w-9 items-center justify-center rounded-2xl bg-sky-50 text-sky-600 text-base">
                                🏬
                            </div>
                        </div>

                        <div class="grid grid-cols-2 gap-2 text-[11px]">
                            <div class="rounded-2xl bg-slate-50 border border-slate-200 px-3 py-2">
                                <p class="text-slate-500 uppercase tracking-[0.16em] mb-0.5">Revenue</p>
                                <p class="font-semibold text-slate-900">
                                    @FormatCurrency(b.Revenue)
                                </p>
                            </div>
                            <div class="rounded-2xl bg-slate-50 border border-slate-200 px-3 py-2">
                                <p class="text-slate-500 uppercase tracking-[0.16em] mb-0.5">Avg ticket</p>
                                <p class="font-semibold text-slate-900">
                                    @FormatCurrency(b.AverageOrderValue)
                                </p>
                            </div>
                        </div>

                        <!-- NEW: per-branch feedback stats -->
                        <div class="grid grid-cols-2 gap-2 text-[11px]">
                            <div class="rounded-2xl bg-slate-50 border border-slate-200 px-3 py-2">
                                <p class="text-slate-500 uppercase tracking-[0.16em] mb-0.5">Avg feedback</p>
                                <p class="font-semibold text-slate-900">
                                    @b.AvgFeedbackRating.ToString("0.0") / 5
                                </p>
                            </div>
                            <div class="rounded-2xl bg-slate-50 border border-slate-200 px-3 py-2">
                                <p class="text-slate-500 uppercase tracking-[0.16em] mb-0.5">Open feedback</p>
                                <p class="font-semibold text-slate-900">
                                    @b.OpenFeedbackCount
                                </p>
                            </div>
                        </div>

                        <div class="space-y-2 text-[11px]">
                            <div>
                                <div class="flex items-center justify-between mb-0.5">
                                    <span class="text-slate-500">Orders</span>
                                    <span class="text-slate-600">@b.TotalOrders</span>
                                </div>
                                <div class="h-1.5 rounded-full bg-slate-100 overflow-hidden">
                                    <div class="h-full rounded-full bg-gradient-to-r from-sky-400 to-violet-500"
                                         style="width:@ordersPct%;"></div>
                                </div>
                            </div>
                            <div>
                                <div class="flex items-center justify-between mb-0.5">
                                    <span class="text-slate-500">Completion</span>
                                    <span class="text-slate-600">@completion%</span>
                                </div>
                                <div class="h-1.5 rounded-full bg-slate-100 overflow-hidden">
                                    <div class="h-full rounded-full bg-gradient-to-r from-emerald-400 to-cyan-400"
                                         style="width:@completion%;"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="md:col-span-2 xl:col-span-3 rounded-3xl bg-white border border-slate-200 shadow-sm p-6 text-sm text-slate-500">
                    No orders found for this date range (or you do not have access to any branches).
                </div>
            }
        </section>
    </main>
</body>
</html>