@model Cafe.Models.ViewModels.InventoryOverviewViewModel

@{
    ViewData["Title"] = "Inventory Overview";

    var branches = ViewBag.Branches as List<Cafe.Models.Branch> ?? new List<Cafe.Models.Branch>();
    int? selectedBranchId = Model.SelectedBranchId;

    var branchRows = Model.Branches;
    decimal maxValue = branchRows.Any() ? branchRows.Max(b => b.TotalValue) : 1m;
    if (maxValue <= 0) maxValue = 1;
    int maxItems = branchRows.Any() ? branchRows.Max(b => b.ItemCount) : 1;
    if (maxItems <= 0) maxItems = 1;

    string FormatCurrency(decimal value) => "$" + value.ToString("N2");
}

<!-- Page Header -->
<div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:1rem;margin-bottom:2rem;">
    <div>
        <h1 class="page-title" style="margin:0;">Inventory Overview</h1>
        <p class="body-text" style="margin-top:0.25rem;">Stock levels, values and health across all branches.</p>
    </div>
    <a asp-action="Index" asp-controller="Reports" class="btn btn-secondary btn-sm"><i class="fas fa-arrow-left"></i>
        Reports</a>
    </div>

    <!-- Filter -->
    <form method="get" class="card mb-6">
        <div class="card-body flex flex-wrap gap-4 items-end">
            <div class="form-group" style="min-width:180px;margin:0;">
                <label class="form-label">Branch</label>
                <select name="branchId" class="form-select">
                    <option value="">All branches</option>
                    @foreach (var b in branches)
                    {
                        <option value="@b.Id" selected="@(selectedBranchId == b.Id)">@b.Name</option>
                    }
                </select>
            </div>
            <button type="submit" class="btn btn-primary btn-sm"><i class="fas fa-search"></i> Apply</button>
            <a asp-action="InventoryOverview" class="btn btn-ghost btn-sm">Reset</a>
        </div>
    </form>

    <!-- KPI Cards -->
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:1rem;margin-bottom:1.5rem;">
        <div class="kpi-card">
            <div class="kpi-icon" style="background:#dcfce7;color:var(--success);"><i class="fas fa-dollar-sign"></i></div>
            <div class="kpi-label">Inventory Value</div>
            <div class="kpi-value">@FormatCurrency(Model.TotalInventoryValue)</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-icon" style="background:#dbeafe;color:#2563eb;"><i class="fas fa-boxes"></i></div>
            <div class="kpi-label">Total Items</div>
            <div class="kpi-value">@Model.TotalItems</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-icon" style="background:#fef3c7;color:var(--warning);"><i class="fas fa-exclamation-triangle"></i>
            </div>
            <div class="kpi-label">Low Stock</div>
            <div class="kpi-value" style="color:var(--warning);">@Model.LowStockItems</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-icon" style="background:#fee2e2;color:var(--danger);"><i class="fas fa-ban"></i></div>
            <div class="kpi-label">Out of Stock</div>
            <div class="kpi-value" style="color:var(--danger);">@Model.OutOfStockItems</div>
        </div>
    </div>

    @if (branchRows.Any())
    {
        <!-- Charts Row -->
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:1.25rem;margin-bottom:1.5rem;">
            <!-- Value Distribution Bar Chart -->
            <div class="card min-w-0">
                <div class="card-header">
                    <h3 class="section-title"><i class="fas fa-chart-bar" style="color:var(--accent);margin-right:0.5rem;"></i>Inventory Value by Branch</h3>
                </div>
                <div class="card-body relative h-[340px]">
                    <canvas id="invValueChart"></canvas>
                </div>
            </div>
            <!-- Stock Health Doughnut -->
            <div class="card min-w-0">
                <div class="card-header">
                    <h3 class="section-title"><i class="fas fa-chart-pie" style="color:var(--accent);margin-right:0.5rem;"></i>Overall Stock Health</h3>
                </div>
                <div class="card-body relative h-[340px]">
                    <canvas id="stockHealthChart"></canvas>
                </div>
            </div>
        </div>

        <!-- Stock Alerts Row -->
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:1.25rem;margin-bottom:1.5rem;">
            <!-- Items per Branch -->
            <div class="card min-w-0">
                <div class="card-header">
                    <h3 class="section-title"><i class="fas fa-boxes-stacked" style="color:#2563eb;margin-right:0.5rem;"></i>Items per Branch</h3>
                </div>
                <div class="card-body relative h-[300px]">
                    <canvas id="invItemsChart"></canvas>
                </div>
            </div>
            <!-- Low/Out of Stock by Branch -->
            <div class="card min-w-0">
                <div class="card-header">
                    <h3 class="section-title"><i class="fas fa-triangle-exclamation" style="color:var(--danger);margin-right:0.5rem;"></i>Stock Alerts by Branch</h3>
                </div>
                <div class="card-body relative h-[300px]">
                    <canvas id="stockAlertsChart"></canvas>
                </div>
            </div>
        </div>
    }

    <!-- Branch Inventory Cards -->
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:1.25rem;">
        @if (branchRows.Any())
        {
            @foreach (var b in branchRows)
            {
                int valuePct = (int)Math.Round(b.TotalValue / maxValue * 100m);
                int lowPct = (int)Math.Round(b.LowStockRate);
                int outPct = (int)Math.Round(b.OutOfStockRate);

                <div class="card">
                    <div class="card-body">
                        <div style="display:flex;justify-content:space-between;align-items:start;margin-bottom:0.75rem;">
                            <div>
                                <span class="badge badge-success" style="font-size:0.6rem;margin-bottom:0.4rem;">Branch</span>
                                <h3 style="font-weight:700;font-size:0.95rem;margin:0;">@b.BranchName</h3>
                                @if (!string.IsNullOrWhiteSpace(b.Location))
                                {
                                    <span class="caption">@b.Location</span>
                                }
                            </div>
                            <div
                                style="width:36px;height:36px;border-radius:10px;background:#dcfce7;color:var(--success);display:flex;align-items:center;justify-content:center;">
                                <i class="fas fa-warehouse"></i>
                            </div>
                        </div>

                        <div style="display:grid;grid-template-columns:1fr 1fr;gap:0.5rem;margin-bottom:0.75rem;">
                            <div
                                style="padding:0.5rem;background:var(--bg-body);border-radius:10px;border:1px solid var(--border-light);">
                                <div class="caption">Value</div>
                                <div style="font-weight:700;font-size:0.85rem;">@FormatCurrency(b.TotalValue)</div>
                            </div>
                            <div
                                style="padding:0.5rem;background:var(--bg-body);border-radius:10px;border:1px solid var(--border-light);">
                                <div class="caption">Items</div>
                                <div style="font-weight:700;font-size:0.85rem;">@b.ItemCount</div>
                            </div>
                        </div>

                        <div style="display:flex;flex-direction:column;gap:0.5rem;">
                            <div>
                                <div style="display:flex;justify-content:space-between;font-size:0.7rem;margin-bottom:0.15rem;">
                                    <span style="color:var(--text-tertiary);">Value share</span>
                                    <span style="font-weight:600;">@valuePct%</span>
                                </div>
                                <div style="height:6px;background:var(--bg-body);border-radius:3px;overflow:hidden;">
                                    <div
                                        style="height:100%;width:@(valuePct)%;background:linear-gradient(90deg,var(--success),#06b6d4);border-radius:3px;">
                                    </div>
                                </div>
                            </div>
                            <div>
                                <div style="display:flex;justify-content:space-between;font-size:0.7rem;margin-bottom:0.15rem;">
                                    <span style="color:var(--text-tertiary);">Low stock</span>
                                    <span style="font-weight:600;color:var(--warning);">@b.LowStockCount (@lowPct%)</span>
                                </div>
                                <div style="height:6px;background:var(--bg-body);border-radius:3px;overflow:hidden;">
                                    <div style="height:100%;width:@(lowPct)%;background:var(--warning);border-radius:3px;"></div>
                                </div>
                            </div>
                            <div>
                                <div style="display:flex;justify-content:space-between;font-size:0.7rem;margin-bottom:0.15rem;">
                                    <span style="color:var(--text-tertiary);">Out of stock</span>
                                    <span style="font-weight:600;color:var(--danger);">@b.OutOfStockCount (@outPct%)</span>
                                </div>
                                <div style="height:6px;background:var(--bg-body);border-radius:3px;overflow:hidden;">
                                    <div style="height:100%;width:@(outPct)%;background:var(--danger);border-radius:3px;"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="card col-span-full p-12 text-center">
                <div style="font-size:2.5rem;color:var(--text-tertiary);margin-bottom:0.5rem;"><i class="fas fa-boxes"></i>
                </div>
                <p class="body-text">No inventory items found.</p>
            </div>
        }
    </div>

@section Scripts {
<script>
@if (branchRows.Any())
{
    <text>
    (function() {
        const branchNames = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(branchRows.Select(b => b.BranchName).ToArray()));
        const values = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(branchRows.Select(b => Math.Round(b.TotalValue, 2)).ToArray()));
        const itemCounts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(branchRows.Select(b => b.ItemCount).ToArray()));
        const lowStocks = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(branchRows.Select(b => b.LowStockCount).ToArray()));
        const outStocks = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(branchRows.Select(b => b.OutOfStockCount).ToArray()));
        const branchColors = C => branchNames.map((_, i) => C.color((i % 8) + 1));

        // Global stock health totals
        const totalItems = @Model.TotalItems;
        const totalLow = @Model.LowStockItems;
        const totalOut = @Model.OutOfStockItems;
        const totalHealthy = totalItems - totalLow - totalOut;

        // Inventory Value Bar Chart
        CafeCharts.make('invValueChart', C => {
            const colors = branchColors(C);
            return {
                type: 'bar',
                data: {
                    labels: branchNames,
                    datasets: [{
                        label: 'Value ($)',
                        data: values,
                        backgroundColor: colors.map(c => C.alpha(c, 0.8)),
                        borderColor: colors,
                        borderWidth: 1,
                        borderRadius: 6
                    }]
                },
                options: {
                    responsive: true, maintainAspectRatio: false,
                    plugins: { legend: { display: false }, tooltip: { callbacks: { label: ctx => '$' + ctx.raw.toLocaleString() } } },
                    scales: C.scales({ maxRotation: 45, yTicks: v => '$' + v.toLocaleString() })
                }
            };
        });

        // Stock Health Doughnut — semantic status colors
        CafeCharts.make('stockHealthChart', C => ({
            type: 'doughnut',
            data: {
                labels: ['Healthy', 'Low Stock', 'Out of Stock'],
                datasets: [{
                    data: [totalHealthy, totalLow, totalOut],
                    backgroundColor: [C.alpha(C.status('success'), 0.75), C.alpha(C.status('warning'), 0.75), C.alpha(C.status('danger'), 0.75)],
                    borderColor: [C.status('success'), C.status('warning'), C.status('danger')],
                    borderWidth: 2,
                    hoverOffset: 8
                }]
            },
            options: {
                responsive: true, maintainAspectRatio: false,
                cutout: '55%',
                plugins: {
                    legend: { position: 'right' },
                    tooltip: { callbacks: { label: ctx => ctx.label + ': ' + ctx.raw + ' items' } }
                }
            }
        }));

        // Items per Branch Pie
        CafeCharts.make('invItemsChart', C => {
            const colors = branchColors(C);
            return {
                type: 'pie',
                data: {
                    labels: branchNames,
                    datasets: [{
                        data: itemCounts,
                        backgroundColor: colors.map(c => C.alpha(c, 0.73)),
                        borderColor: colors,
                        borderWidth: 2,
                        hoverOffset: 6
                    }]
                },
                options: {
                    responsive: true, maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'right' },
                        tooltip: { callbacks: { label: ctx => ctx.label + ': ' + ctx.raw + ' items' } }
                    }
                }
            };
        });

        // Stock Alerts Grouped Bar — semantic status colors
        CafeCharts.make('stockAlertsChart', C => ({
            type: 'bar',
            data: {
                labels: branchNames,
                datasets: [
                    { label: 'Low Stock', data: lowStocks, backgroundColor: C.alpha(C.status('warning'), 0.7), borderColor: C.status('warning'), borderWidth: 1, borderRadius: 4 },
                    { label: 'Out of Stock', data: outStocks, backgroundColor: C.alpha(C.status('danger'), 0.7), borderColor: C.status('danger'), borderWidth: 1, borderRadius: 4 }
                ]
            },
            options: {
                responsive: true, maintainAspectRatio: false,
                plugins: { legend: { position: 'top' } },
                scales: C.scales({ maxRotation: 45, precision: 0 })
            }
        }));
    })();
    </text>
}
</script>
}