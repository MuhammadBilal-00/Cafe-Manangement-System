@model Cafe.Models.ViewModels.SalesReportViewModel

@{
    ViewData["Title"] = "Sales Overview";

    var branches = ViewBag.Branches as List<Cafe.Models.Branch> ?? new List<Cafe.Models.Branch>();
    int? selectedBranchId = Model.BranchId;
    DateTime from = Model.FromDate;
    DateTime to = Model.ToDate;

    var daily = ViewBag.DailyRevenue as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    var statusBreakdown = ViewBag.StatusBreakdown as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    var topItems = ViewBag.TopItems as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    var branchRevenue = ViewBag.BranchRevenue as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();

    string FormatCurrency(decimal value) => "$" + value.ToString("N2");
}

<!-- Page Header -->
<div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:1rem;margin-bottom:2rem;">
    <div>
        <h1 class="page-title" style="margin:0;">Sales Overview</h1>
        <p class="body-text" style="margin-top:0.25rem;">Revenue, orders and performance analytics.</p>
    </div>
    <a asp-action="Index" asp-controller="Reports" class="btn btn-secondary btn-sm"><i class="fas fa-arrow-left"></i> Reports</a>
</div>

<!-- Filters -->
<form method="get" class="card mb-6">
    <div class="card-body flex flex-wrap gap-4 items-end">
        <div class="form-group" style="min-width:140px;margin:0;">
            <label class="form-label">From</label>
            <input type="date" name="from" value="@from.ToString("yyyy-MM-dd")" class="form-control" />
        </div>
        <div class="form-group" style="min-width:140px;margin:0;">
            <label class="form-label">To</label>
            <input type="date" name="to" value="@to.ToString("yyyy-MM-dd")" class="form-control" />
        </div>
        <div class="form-group" style="min-width:160px;margin:0;">
            <label class="form-label">Branch</label>
            <select name="branchId" class="form-select">
                <option value="">All branches</option>
                @foreach (var b in branches)
                {
                    <option value="@b.Id" selected="@(selectedBranchId == b.Id)">@b.Name</option>
                }
            </select>
        </div>
        <button type="submit" class="btn btn-primary btn-sm"><i class="fas fa-search"></i> Apply</button>
        <a asp-action="SalesOverview" class="btn btn-ghost btn-sm">Reset</a>
        <a asp-action="ExportSalesCsv" asp-controller="Reports"
           asp-route-from="@from.ToString("yyyy-MM-dd")" asp-route-to="@to.ToString("yyyy-MM-dd")" asp-route-branchId="@selectedBranchId"
           class="btn btn-secondary btn-sm"><i class="fas fa-download"></i> CSV</a>
    </div>
</form>

<!-- KPI Cards -->
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:1rem;margin-bottom:1.5rem;">
    <div class="kpi-card">
        <div class="kpi-icon" style="background:#dcfce7;color:#16a34a;"><i class="fas fa-dollar-sign"></i></div>
        <div class="kpi-label">Revenue</div>
        <div class="kpi-value">@FormatCurrency(Model.TotalRevenue)</div>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon" style="background:#dbeafe;color:#2563eb;"><i class="fas fa-receipt"></i></div>
        <div class="kpi-label">Orders</div>
        <div class="kpi-value">@Model.TotalOrders</div>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon" style="background:#e0e7ff;color:#4f46e5;"><i class="fas fa-chart-line"></i></div>
        <div class="kpi-label">Avg Ticket</div>
        <div class="kpi-value">@FormatCurrency(Model.AverageOrderValue)</div>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon" style="background:var(--accent-light);color:var(--accent);"><i class="fas fa-calendar"></i></div>
        <div class="kpi-label">Period</div>
        <div class="kpi-value" style="font-size:0.85rem;">@from.ToString("dd MMM") – @to.ToString("dd MMM")</div>
        <div class="caption">@Model.BranchName</div>
    </div>
</div>

<!-- Charts Row -->
<div style="display:grid;grid-template-columns:1fr 1fr;gap:1.25rem;margin-bottom:1.5rem;">
    <!-- Daily Revenue Line Chart -->
    <div class="card min-w-0">
        <div class="card-header">
            <h3 class="section-title"><i class="fas fa-chart-line" style="color:var(--accent);margin-right:0.5rem;"></i>Revenue Trend</h3>
        </div>
        <div class="card-body relative h-[340px]">
            <canvas id="dailyRevenueChart"></canvas>
        </div>
    </div>

    <!-- Branch Revenue Bar Chart -->
    <div class="card min-w-0">
        <div class="card-header">
            <h3 class="section-title"><i class="fas fa-chart-bar" style="color:var(--accent);margin-right:0.5rem;"></i>Revenue by Branch</h3>
        </div>
        <div class="card-body relative h-[340px]">
            <canvas id="branchRevenueBarChart"></canvas>
        </div>
    </div>
</div>

<!-- Status + Top Items Row -->
<div style="display:grid;grid-template-columns:1fr 2fr;gap:1.25rem;margin-bottom:1.5rem;">
    <!-- Status Breakdown Doughnut -->
    <div class="card min-w-0">
        <div class="card-header">
            <h3 class="section-title"><i class="fas fa-chart-pie" style="color:var(--accent);margin-right:0.5rem;"></i>Orders by Status</h3>
        </div>
        <div class="card-body relative h-[320px]">
            <canvas id="statusDoughnutChart"></canvas>
        </div>
    </div>

    <!-- Top Items -->
    <div class="card">
        <div class="card-header">Top Items by Revenue</div>
        <div class="card-body">
            @if (topItems.Any())
            {
                decimal maxIR = topItems.Max(t => (decimal)t.Rev);
                if (maxIR <= 0) { maxIR = 1; }
                int rank = 1;
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:0.75rem;">
                    @foreach (var item in topItems)
                    {
                        decimal r = (decimal)item.Rev;
                        int pct = (int)Math.Round(r / maxIR * 100m);
                        <div style="padding:0.75rem;border:1px solid var(--border-light);border-radius:12px;background:var(--bg-body);">
                            <div style="display:flex;align-items:center;justify-content:space-between;">
                                <div style="display:flex;align-items:center;gap:0.5rem;">
                                    <span style="width:24px;height:24px;border-radius:50%;background:var(--sidebar-bg);color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.65rem;font-weight:700;">@rank</span>
                                    <div>
                                        <div style="font-size:0.78rem;font-weight:600;">@item.ItemName</div>
                                        <div style="font-size:0.68rem;color:var(--text-tertiary);">@item.Category</div>
                                    </div>
                                </div>
                                <div style="text-align:right;">
                                    <div style="font-size:0.78rem;font-weight:700;">@FormatCurrency(r)</div>
                                    <div style="font-size:0.68rem;color:var(--text-tertiary);">@item.Qty sold</div>
                                </div>
                            </div>
                            <div style="margin-top:0.5rem;height:5px;background:#fff;border-radius:3px;overflow:hidden;">
                                <div style="height:100%;width:@(pct)%;background:linear-gradient(90deg,#10b981,#06b6d4);border-radius:3px;"></div>
                            </div>
                        </div>
                        rank++;
                    }
                </div>
            }
            else
            {
                <p class="caption">No items for this range.</p>
            }
        </div>
    </div>
</div>

<!-- Orders Detail Table -->
<div class="card">
    <div class="card-header flex justify-between items-center">
        <span>Orders Detail</span>
        <span class="caption">@Model.Orders.Count order(s)</span>
    </div>
    <div style="overflow-x:auto;">
        <table class="premium-table">
            <thead>
                <tr>
                    <th>Order #</th>
                    <th>Date</th>
                    <th>Customer</th>
                    <th>Branch</th>
                    <th style="text-align:right;">Total</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Orders.Any())
                {
                    @foreach (var o in Model.Orders)
                    {
                        string badgeCls = o.Status switch
                        {
                            "Completed" => "badge-success",
                            "Pending" => "badge-warning",
                            "Preparing" => "badge-info",
                            "Ready" => "badge-accent",
                            "Cancelled" => "badge-danger",
                            _ => "badge-neutral"
                        };
                        <tr>
                            <td style="font-weight:600;">@o.OrderNumber</td>
                            <td>@o.OrderDate.ToString("dd MMM yyyy HH:mm")</td>
                            <td>@o.Customer?.Name</td>
                            <td>@o.Branch?.Name</td>
                            <td style="text-align:right;font-weight:600;">@FormatCurrency(o.TotalAmount)</td>
                            <td><span class="badge @badgeCls">@o.Status</span></td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="6" style="text-align:center;padding:2rem;color:var(--text-tertiary);">No orders found for this range.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
<script>
(function() {
    const palette = ['#6366f1','#f59e0b','#10b981','#ef4444','#3b82f6','#ec4899','#8b5cf6','#14b8a6','#f97316','#06b6d4'];

    // Daily Revenue Line Chart
    @if (daily.Any())
    {
        <text>
        const dailyLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(daily.Select(d => ((DateTime)d.Date).ToString("dd MMM")).ToArray()));
        const dailyData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(daily.Select(d => Math.Round((decimal)d.Revenue, 2)).ToArray()));

        const dailyCtx = document.getElementById('dailyRevenueChart')?.getContext('2d');
        if (dailyCtx) {
            new Chart(dailyCtx, {
                type: 'line',
                data: {
                    labels: dailyLabels,
                    datasets: [{
                        label: 'Revenue ($)',
                        data: dailyData,
                        borderColor: '#10b981',
                        backgroundColor: 'rgba(16,185,129,0.08)',
                        borderWidth: 2.5,
                        fill: true,
                        tension: 0.4,
                        pointRadius: 4,
                        pointBackgroundColor: '#10b981',
                        pointBorderColor: '#fff',
                        pointBorderWidth: 2,
                        pointHoverRadius: 6
                    }]
                },
                options: {
                    responsive: true, maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: { callbacks: { label: ctx => '$' + ctx.raw.toLocaleString() } }
                    },
                    scales: {
                        x: { ticks: { maxRotation: 45, font: { size: 10 } }, grid: { display: false } },
                        y: { ticks: { callback: v => '$' + v.toLocaleString() }, grid: { color: 'rgba(0,0,0,0.04)' } }
                    }
                }
            });
        }
        </text>
    }

    // Branch Revenue Bar Chart
    @if (branchRevenue.Any())
    {
        <text>
        const brNames = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(branchRevenue.Select(b => ((Cafe.Models.Branch)b.Branch).Name).ToArray()));
        const brRevs = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(branchRevenue.Select(b => Math.Round((decimal)b.Revenue, 2)).ToArray()));
        const brColors = brNames.map((_, i) => palette[i % palette.length]);

        const brCtx = document.getElementById('branchRevenueBarChart')?.getContext('2d');
        if (brCtx) {
            new Chart(brCtx, {
                type: 'bar',
                data: {
                    labels: brNames,
                    datasets: [{
                        label: 'Revenue ($)',
                        data: brRevs,
                        backgroundColor: brColors.map(c => c + 'cc'),
                        borderColor: brColors,
                        borderWidth: 1,
                        borderRadius: 6
                    }]
                },
                options: {
                    responsive: true, maintainAspectRatio: false,
                    plugins: { legend: { display: false }, tooltip: { callbacks: { label: ctx => '$' + ctx.raw.toLocaleString() } } },
                    scales: {
                        x: { ticks: { maxRotation: 45, font: { size: 10 } }, grid: { display: false } },
                        y: { ticks: { callback: v => '$' + v.toLocaleString() }, grid: { color: 'rgba(0,0,0,0.04)' } }
                    }
                }
            });
        }
        </text>
    }

    // Status Breakdown Doughnut
    @if (statusBreakdown.Any())
    {
        <text>
        const statusLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(statusBreakdown.Select(s => (string)s.Status).ToArray()));
        const statusCounts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(statusBreakdown.Select(s => (int)s.Count).ToArray()));
        const statusColorMap = { 'Completed': '#22c55e', 'Pending': '#f59e0b', 'Preparing': '#6366f1', 'Ready': '#d4af37', 'Cancelled': '#ef4444' };
        const sColors = statusLabels.map(s => statusColorMap[s] || '#9ca3af');

        const stCtx = document.getElementById('statusDoughnutChart')?.getContext('2d');
        if (stCtx) {
            new Chart(stCtx, {
                type: 'doughnut',
                data: {
                    labels: statusLabels,
                    datasets: [{
                        data: statusCounts,
                        backgroundColor: sColors.map(c => c + 'cc'),
                        borderColor: sColors,
                        borderWidth: 2,
                        hoverOffset: 8
                    }]
                },
                options: {
                    responsive: true, maintainAspectRatio: false,
                    cutout: '55%',
                    plugins: {
                        legend: { position: 'bottom', labels: { boxWidth: 12, font: { size: 11 }, padding: 10 } },
                        tooltip: { callbacks: { label: ctx => ctx.label + ': ' + ctx.raw + ' orders' } }
                    }
                }
            });
        }
        </text>
    }
})();
</script>
}