@model Cafe.Models.ViewModels.SalesReportViewModel

@{
    ViewData["Title"] = "Sales Overview";

    var branches = ViewBag.Branches as List<Cafe.Models.Branch> ?? new List<Cafe.Models.Branch>();
    int? selectedBranchId = Model.BranchId;
    DateTime from = Model.FromDate;
    DateTime to = Model.ToDate;

    var daily = ViewBag.DailyRevenue as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    var statusBreakdown = ViewBag.StatusBreakdown as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    var topItems = ViewBag.TopItems as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    var branchRevenue = ViewBag.BranchRevenue as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();

    string FormatCurrency(decimal value) => "$" + value.ToString("N2");
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Cafe OS</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    animation: {
                        'float': 'float 6s ease-in-out infinite',
                        'pulse-slow': 'pulse 3s cubic-bezier(0.4, 0, 0.6, 1) infinite',
                        'shimmer': 'shimmer 1.8s linear infinite',
                    },
                    keyframes: {
                        float: {
                            '0%, 100%': { transform: 'translateY(0px)' },
                            '50%': { transform: 'translateY(-10px)' },
                        },
                        shimmer: {
                            '0%': { transform: 'translateX(-100%)' },
                            '100%': { transform: 'translateX(100%)' },
                        }
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-slate-100 text-slate-900 min-h-screen antialiased">

    <!-- Top bar -->
    <header class="sticky top-0 z-40 bg-white/80 backdrop-blur-xl border-b border-slate-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="relative w-10 h-10">
                    <div class="absolute inset-0 rounded-2xl bg-gradient-to-tr from-pink-500 via-violet-500 to-cyan-400 blur-sm opacity-80"></div>
                    <div class="relative w-full h-full rounded-2xl bg-white flex items-center justify-center text-2xl shadow-sm">
                        📊
                    </div>
                </div>
                <div>
                    <p class="text-[11px] uppercase tracking-[0.25em] text-slate-400">
                        Cafe OS
                    </p>
                    <h1 class="text-sm sm:text-base font-semibold tracking-wide text-slate-900">
                        Sales Overview
                    </h1>
                </div>
            </div>

            <a href="@Url.Action("Index", "Reports")"
               class="inline-flex items-center gap-1.5 rounded-full bg-slate-900 text-slate-50 text-xs sm:text-[13px] font-medium px-3 py-1.5 shadow-sm hover:bg-slate-800 transition">
                ⬅ Reports
            </a>
        </div>
    </header>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-10 space-y-8">

        <!-- Filters -->
        <section class="rounded-3xl bg-white/95 border border-slate-200 shadow-[0_16px_40px_rgba(15,23,42,0.12)] p-4 sm:p-6 lg:p-7 space-y-4">
            <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
                <div class="space-y-1">
                    <p class="text-xs font-semibold tracking-[0.2em] uppercase text-slate-500">
                        Filters
                    </p>
                </div>

                <form method="get" class="w-full lg:w-auto flex flex-col sm:flex-row gap-3 sm:items-end">
                    <!-- Date range -->
                    <div class="flex gap-3 w-full sm:w-auto">
                        <div>
                            <label class="block text-[11px] font-medium text-slate-500 mb-1 uppercase tracking-[0.16em]">
                                From
                            </label>
                            <input type="date"
                                   name="from"
                                   value="@from.ToString("yyyy-MM-dd")"
                                   class="w-full sm:w-44 px-3 py-2 rounded-xl bg-slate-50 border border-slate-200 text-sm text-slate-900 focus:outline-none focus:ring-2 focus:ring-pink-500/60 focus:border-pink-400/60" />
                        </div>
                        <div>
                            <label class="block text-[11px] font-medium text-slate-500 mb-1 uppercase tracking-[0.16em]">
                                To
                            </label>
                            <input type="date"
                                   name="to"
                                   value="@to.ToString("yyyy-MM-dd")"
                                   class="w-full sm:w-44 px-3 py-2 rounded-xl bg-slate-50 border border-slate-200 text-sm text-slate-900 focus:outline-none focus:ring-2 focus:ring-pink-500/60 focus:border-pink-400/60" />
                        </div>
                    </div>

                    <!-- Branch -->
                    <div class="sm:w-52">
                        <label class="block text-[11px] font-medium text-slate-500 mb-1 uppercase tracking-[0.16em]">
                            Branch
                        </label>
                        <select name="branchId"
                                class="w-full px-3 py-2 rounded-xl bg-slate-50 border border-slate-200 text-sm text-slate-900 focus:outline-none focus:ring-2 focus:ring-pink-500/60 focus:border-pink-400/60">
                            <option value="">All branches</option>
                            @foreach (var b in branches)
                            {
                                var isSelected = selectedBranchId == b.Id;
                                <option value="@b.Id" selected="@(isSelected ? "selected" : null)">
                                    @b.Name
                                </option>
                            }
                        </select>
                    </div>

                    <div class="flex gap-2 sm:gap-3">
                        <button type="submit"
                                class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-gradient-to-r from-pink-500 to-violet-500 text-white text-xs sm:text-sm font-semibold shadow-md shadow-pink-400/40 hover:-translate-y-0.5 hover:shadow-lg transition">
                            🔍 Apply
                        </button>
                        <a href="@Url.Action("SalesOverview", "Reports")"
                           class="inline-flex items-center gap-1.5 px-3 py-2 rounded-xl bg-slate-100 text-slate-600 text-xs sm:text-sm font-medium border border-slate-200 hover:bg-slate-200 transition">
                            Reset
                        </a>
                    </div>
                </form>
            </div>
        </section>

        <!-- Summary cards -->
        <section class="grid md:grid-cols-4 gap-4 sm:gap-5">
            <div class="rounded-3xl bg-white border border-slate-200 shadow-sm p-4 flex flex-col justify-between">
                <div class="flex items-center justify-between mb-3">
                    <p class="text-[11px] text-slate-500 uppercase tracking-[0.2em]">Revenue</p>
                    <span class="inline-flex items-center justify-center h-7 w-7 rounded-full bg-emerald-50 text-emerald-600 text-sm">
                        💰
                    </span>
                </div>
                <p class="text-2xl sm:text-3xl font-bold text-slate-900 leading-none">
                    @FormatCurrency(Model.TotalRevenue)
                </p>
            </div>

            <div class="rounded-3xl bg-white border border-slate-200 shadow-sm p-4 flex flex-col justify-between">
                <div class="flex items-center justify-between mb-3">
                    <p class="text-[11px] text-slate-500 uppercase tracking-[0.2em]">Completed orders</p>
                    <span class="inline-flex items-center justify-center h-7 w-7 rounded-full bg-blue-50 text-blue-600 text-sm">
                        🧾
                    </span>
                </div>
                <p class="text-2xl sm:text-3xl font-bold text-slate-900 leading-none">
                    @Model.TotalOrders
                </p>
            </div>

            <div class="rounded-3xl bg-white border border-slate-200 shadow-sm p-4 flex flex-col justify-between">
                <div class="flex items-center justify-between mb-3">
                    <p class="text-[11px] text-slate-500 uppercase tracking-[0.2em]">Avg ticket</p>
                    <span class="inline-flex items-center justify-center h-7 w-7 rounded-full bg-sky-50 text-sky-600 text-sm">
                        📈
                    </span>
                </div>
                <p class="text-2xl sm:text-3xl font-bold text-slate-900 leading-none">
                    @FormatCurrency(Model.AverageOrderValue)
                </p>
            </div>

            <div class="rounded-3xl bg-white border border-slate-200 shadow-sm p-4 flex flex-col justify-between">
                <div class="flex items-center justify-between mb-3">
                    <p class="text-[11px] text-slate-500 uppercase tracking-[0.2em]">Scope</p>
                    <span class="inline-flex items-center justify-center h-7 w-7 rounded-full bg-violet-50 text-violet-600 text-sm">
                        📅
                    </span>
                </div>
                <p class="text-sm font-semibold text-slate-900 leading-snug">
                    @from.ToString("dd MMM yyyy") – @to.ToString("dd MMM yyyy")
                </p>
                <p class="mt-1 text-[11px] text-slate-500">
                    Branch: <span class="font-medium">@Model.BranchName</span>
                </p>
            </div>
        </section>

        <!-- Analytics: daily + branch -->
        <section class="grid lg:grid-cols-2 gap-6">
            <!-- Daily revenue -->
            <div class="rounded-3xl bg-white border border-slate-200 shadow-sm p-4 sm:p-5">
                <div class="flex items-center justify-between mb-3">
                    <h2 class="text-sm font-semibold text-slate-900">
                        Revenue by day
                    </h2>
                </div>

                @if (daily.Any())
                {
                    decimal maxRevenue = daily.Max(d => (decimal)d.Revenue);
                    if (maxRevenue <= 0) maxRevenue = 1;

                    <div class="space-y-2 mt-2">
                        @foreach (var d in daily)
                        {
                            decimal r = (decimal)d.Revenue;
                            int pct = (int)Math.Round(r / maxRevenue * 100m);
                            <div class="flex items-center gap-3">
                                <div class="w-24 text-[11px] text-slate-500">
                                    @(((DateTime)d.Date).ToString("dd MMM"))
                                </div>
                                <div class="flex-1 h-2 rounded-full bg-slate-100 overflow-hidden">
                                    <div class="h-full rounded-full bg-gradient-to-r from-emerald-400 to-cyan-400"
                                         style="width:@pct%;"></div>
                                </div>
                                <div class="w-24 text-right text-[11px] text-slate-600">
                                    @FormatCurrency(r)
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-xs text-slate-500 mt-2">No data for this range.</p>
                }
            </div>

            <!-- Revenue by branch -->
            <div class="rounded-3xl bg-white border border-slate-200 shadow-sm p-4 sm:p-5">
                <div class="flex items-center justify-between mb-3">
                    <h2 class="text-sm font-semibold text-slate-900">
                        Revenue by branch
                    </h2>
                </div>

                @if (branchRevenue.Any())
                {
                    decimal maxBranchRev = branchRevenue.Max(b => (decimal)b.Revenue);
                    if (maxBranchRev <= 0) maxBranchRev = 1;

                    <div class="space-y-2 mt-2">
                        @foreach (var b in branchRevenue)
                        {
                            decimal r = (decimal)b.Revenue;
                            int pct = (int)Math.Round(r / maxBranchRev * 100m);
                            <div class="flex items-center gap-3">
                                <div class="w-32 text-[11px] text-slate-600 truncate">
                                    @(((Cafe.Models.Branch)b.Branch).Name)
                                </div>
                                <div class="flex-1 h-2 rounded-full bg-slate-100 overflow-hidden">
                                    <div class="h-full rounded-full bg-gradient-to-r from-pink-400 to-violet-500"
                                         style="width:@pct%;"></div>
                                </div>
                                <div class="w-20 text-right text-[11px] text-slate-600">
                                    @FormatCurrency(r)
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-xs text-slate-500 mt-2">No branch breakdown for this range.</p>
                }
            </div>
        </section>

        <!-- Status + top items -->
        <section class="grid lg:grid-cols-3 gap-6">
            <!-- Status chart -->
            <div class="lg:col-span-1 rounded-3xl bg-white border border-slate-200 shadow-sm p-4 sm:p-5">
                <div class="flex items-center justify-between mb-3">
                    <h2 class="text-sm font-semibold text-slate-900">
                        Orders by status
                    </h2>
                </div>

                @if (statusBreakdown.Any())
                {
                    int totalStatus = statusBreakdown.Sum(s => (int)s.Count);
                    if (totalStatus == 0) totalStatus = 1;

                    <div class="space-y-2 mt-2">
                        @foreach (var s in statusBreakdown)
                        {
                            int count = (int)s.Count;
                            decimal rev = (decimal)s.Revenue;
                            int share = (int)Math.Round(count / (decimal)totalStatus * 100m);

                            string chipColor = ((string)s.Status) switch
                            {
                                "Completed" => "bg-emerald-50 text-emerald-700 border-emerald-200",
                                "Pending" => "bg-amber-50 text-amber-700 border-amber-200",
                                "Preparing" => "bg-sky-50 text-sky-700 border-sky-200",
                                "Ready" => "bg-indigo-50 text-indigo-700 border-indigo-200",
                                "Cancelled" => "bg-rose-50 text-rose-700 border-rose-200",
                                _ => "bg-slate-50 text-slate-700 border-slate-200"
                            };

                            <div class="space-y-1">
                                <div class="flex items-center justify-between">
                                    <span class="inline-flex items-center rounded-full px-2.5 py-1 border text-[11px] font-medium @chipColor">
                                        @s.Status
                                    </span>
                                    <span class="text-[11px] text-slate-500">
                                        @count orders · @share%
                                    </span>
                                </div>
                                <div class="h-1.5 rounded-full bg-slate-100 overflow-hidden">
                                    <div class="h-full rounded-full bg-gradient-to-r from-pink-400 to-violet-400"
                                         style="width:@share%;"></div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-xs text-slate-500 mt-2">No orders for this range.</p>
                }
            </div>

            <!-- Top items -->
            <div class="lg:col-span-2 rounded-3xl bg-white border border-slate-200 shadow-sm p-4 sm:p-5">
                <div class="flex items-center justify-between mb-3">
                    <h2 class="text-sm font-semibold text-slate-900">
                        Top items by revenue
                    </h2>
                </div>

                @if (topItems.Any())
                {
                    decimal maxItemRev = topItems.Max(t => (decimal)t.Rev);
                    if (maxItemRev <= 0) maxItemRev = 1;
                    int rank = 1;

                    <div class="grid sm:grid-cols-2 gap-3 mt-1">
                        @foreach (var item in topItems)
                        {
                            decimal r = (decimal)item.Rev;
                            int pct = (int)Math.Round(r / maxItemRev * 100m);
                            <div class="rounded-2xl border border-slate-200 bg-slate-50/70 p-3 flex flex-col gap-1">
                                <div class="flex items-center justify-between">
                                    <div class="flex items-center gap-2">
                                        <span class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-slate-900 text-white text-[11px]">
                                            @rank
                                        </span>
                                        <div>
                                            <p class="text-xs font-semibold text-slate-900 line-clamp-1">
                                                @item.ItemName
                                            </p>
                                            <p class="text-[11px] text-slate-500">
                                                @item.Category
                                            </p>
                                        </div>
                                    </div>
                                    <div class="text-right text-[11px]">
                                        <p class="font-semibold text-slate-900">@FormatCurrency(r)</p>
                                        <p class="text-slate-500">@item.Qty sold</p>
                                    </div>
                                </div>
                                <div class="mt-1.5 h-1.5 rounded-full bg-white overflow-hidden">
                                    <div class="h-full rounded-full bg-gradient-to-r from-emerald-400 to-cyan-400"
                                         style="width:@pct%;"></div>
                                </div>
                            </div>
                            rank++;
                        }
                    </div>
                }
                else
                {
                    <p class="text-xs text-slate-500 mt-2">No item breakdown for this range.</p>
                }
            </div>
        </section>

        <!-- Orders table (detail) -->
        <section class="rounded-3xl bg-white border border-slate-200 shadow-sm p-4 sm:p-6 space-y-4">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-sm font-semibold text-slate-900">
                        Orders detail
                    </h2>
                    <p class="text-xs text-slate-500">
                        Latest @Model.Orders.Count order(s) in this scope
                    </p>
                </div>
            </div>

            <div class="overflow-x-auto">
                <table class="min-w-full text-xs sm:text-sm">
                    <thead>
                        <tr class="text-left text-[11px] uppercase tracking-[0.16em] text-slate-500 border-b border-slate-200">
                            <th class="py-2 pr-4">Order #</th>
                            <th class="py-2 pr-4">Date</th>
                            <th class="py-2 pr-4">Customer</th>
                            <th class="py-2 pr-4">Branch</th>
                            <th class="py-2 pr-4 text-right">Total</th>
                            <th class="py-2 pr-4">Status</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        @if (Model.Orders.Any())
                        {
                            @foreach (var o in Model.Orders)
                            {
                                string statusColor = o.Status switch
                                {
                                    "Completed" => "bg-emerald-50 text-emerald-700 border-emerald-200",
                                    "Pending" => "bg-amber-50 text-amber-700 border-amber-200",
                                    "Preparing" => "bg-sky-50 text-sky-700 border-sky-200",
                                    "Ready" => "bg-indigo-50 text-indigo-700 border-indigo-200",
                                    "Cancelled" => "bg-rose-50 text-rose-700 border-rose-200",
                                    _ => "bg-slate-50 text-slate-700 border-slate-200"
                                };

                                <tr>
                                    <td class="py-3 pr-4 text-slate-900">
                                        @o.OrderNumber
                                    </td>
                                    <td class="py-3 pr-4 text-slate-600">
                                        @o.OrderDate.ToString("dd MMM yyyy HH:mm")
                                    </td>
                                    <td class="py-3 pr-4 text-slate-700">
                                        @o.Customer?.Name
                                    </td>
                                    <td class="py-3 pr-4 text-slate-700">
                                        @o.Branch?.Name
                                    </td>
                                    <td class="py-3 pr-4 text-right text-slate-900 font-semibold">
                                        @FormatCurrency(o.TotalAmount)
                                    </td>
                                    <td class="py-3 pr-4">
                                        <span class="inline-flex items-center rounded-full px-2.5 py-1 border text-[11px] font-medium @statusColor">
                                            @o.Status
                                        </span>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="py-5 text-xs text-slate-500">
                                    No orders found for this date range / branch.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>

    </main>
</body>
</html>