@{
    ViewData["Title"] = "Menu Performance";
}

<div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:1rem;margin-bottom:2rem;">
    <div>
        <h1 class="page-title" style="margin:0;">Menu Performance</h1>
        <p class="body-text" style="margin-top:0.25rem;">Analyze best sellers, pricing and category trends.</p>
    </div>
    <a asp-action="Index" asp-controller="Reports" class="btn btn-secondary btn-sm"><i class="fas fa-arrow-left"></i> Reports</a>
</div>

<div class="card" style="padding:3rem;text-align:center;">
    <div style="font-size:3rem;color:var(--accent);margin-bottom:1rem;"><i class="fas fa-utensils"></i></div>
    <h2 style="font-weight:700;font-size:1.25rem;margin-bottom:0.5rem;">Coming Soon</h2>
    <p class="body-text" style="max-width:400px;margin:0 auto;">Menu performance analytics are being developed. Check back soon for best-seller rankings, revenue-per-item and category breakdowns.</p>
