@model Cafe.Models.ViewModels.MenuPerformanceViewModel

@{
    ViewData["Title"] = "Menu Performance";

    DateTime from = Model.FromDate;
    DateTime to = Model.ToDate;

    var items = Model.Items;
    var cats = Model.Categories;

    string FormatCurrency(decimal value) => "$" + value.ToString("N2");

    decimal maxRevenue = items.Any() ? items.Max(i => i.Revenue) : 1m;
    if (maxRevenue <= 0) maxRevenue = 1;
    int maxQty = items.Any() ? items.Max(i => i.QuantitySold) : 1;
    if (maxQty <= 0) maxQty = 1;

    var branches = ViewBag.Branches as List<Cafe.Models.Branch> ?? new List<Cafe.Models.Branch>();
}

<!-- Page Header -->
<div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:1rem;margin-bottom:2rem;">
    <div>
        <h1 class="page-title" style="margin:0;">Menu Performance</h1>
        <p class="body-text" style="margin-top:0.25rem;">
            Analyze best sellers, revenue per item, profit margins and category trends
            @if (Model.BranchName != "All Branches") { <text> — <strong>@Model.BranchName</strong></text> }
        </p>
    </div>
    <div style="display:flex;gap:0.5rem;">
        <a asp-action="ExportMenuPerformanceCsv" asp-route-from="@from.ToString("yyyy-MM-dd")" asp-route-to="@to.ToString("yyyy-MM-dd")" asp-route-branchId="@Model.BranchId" class="btn btn-ghost btn-sm"><i class="fas fa-download"></i> CSV</a>
        <a asp-action="Index" asp-controller="Reports" class="btn btn-secondary btn-sm"><i class="fas fa-arrow-left"></i> Reports</a>
    </div>
</div>

<!-- Filters -->
<form method="get" class="card" style="margin-bottom:1.5rem;">
    <div class="card-body" style="display:flex;flex-wrap:wrap;gap:1rem;align-items:end;">
        <div class="form-group" style="min-width:140px;margin:0;">
            <label class="form-label">From</label>
            <input type="date" name="from" value="@from.ToString("yyyy-MM-dd")" class="form-control" />
        </div>
        <div class="form-group" style="min-width:140px;margin:0;">
            <label class="form-label">To</label>
            <input type="date" name="to" value="@to.ToString("yyyy-MM-dd")" class="form-control" />
        </div>
        @if (branches.Count > 1)
        {
            <div class="form-group" style="min-width:160px;margin:0;">
                <label class="form-label">Branch</label>
                <select name="branchId" class="form-select">
                    <option value="">All Branches</option>
                    @foreach (var b in branches)
                    {
                        var isSelected = Model.BranchId == b.Id;
                        <option value="@b.Id" selected="@isSelected">@b.Name</option>
                    }
                </select>
            </div>
        }
        <button type="submit" class="btn btn-primary btn-sm"><i class="fas fa-search"></i> Apply</button>
        <a asp-action="MenuPerformance" class="btn btn-ghost btn-sm">Reset</a>
    </div>
</form>

<!-- Summary KPIs -->
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:1rem;margin-bottom:1.5rem;">
    <div class="kpi-card">
        <div class="kpi-icon" style="background:#dbeafe;color:#2563eb;"><i class="fas fa-utensils"></i></div>
        <div class="kpi-label">Items Sold</div>
        <div class="kpi-value">@Model.TotalItemsSold.ToString("N0")</div>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon" style="background:#dcfce7;color:#16a34a;"><i class="fas fa-dollar-sign"></i></div>
        <div class="kpi-label">Menu Revenue</div>
        <div class="kpi-value">@FormatCurrency(Model.TotalMenuRevenue)</div>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon" style="background:#fef3c7;color:#d97706;"><i class="fas fa-list"></i></div>
        <div class="kpi-label">Unique Items</div>
        <div class="kpi-value">@Model.UniqueItemsOrdered</div>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon" style="background:#ede9fe;color:#7c3aed;"><i class="fas fa-tags"></i></div>
        <div class="kpi-label">Avg Item Price</div>
        <div class="kpi-value">@FormatCurrency(Model.AverageItemPrice)</div>
    </div>
</div>

@if (!items.Any())
{
    <div class="card" style="padding:3rem;text-align:center;">
        <div style="font-size:2.5rem;color:var(--text-tertiary);margin-bottom:0.5rem;"><i class="fas fa-utensils"></i></div>
        <p class="body-text">No completed orders found for this date range.</p>
    </div>
}
else
{
    <!-- Category Breakdown -->
    <div class="card" style="margin-bottom:1.5rem;">
        <div class="card-header">
            <h3 class="section-title"><i class="fas fa-chart-pie" style="color:var(--accent);margin-right:0.5rem;"></i>Category Breakdown</h3>
        </div>
        <div class="card-body">
            <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:1rem;">
                @{
                    decimal catMaxRev = cats.Any() ? cats.Max(c => c.Revenue) : 1m;
                    if (catMaxRev <= 0) catMaxRev = 1;
                }
                @foreach (var cat in cats)
                {
                    int catPct = (int)Math.Round(cat.Revenue / catMaxRev * 100m);
                    string catColor = cat.Color ?? "#6366f1";
                    decimal catSharePct = Model.TotalMenuRevenue > 0 ? cat.Revenue / Model.TotalMenuRevenue * 100 : 0;
                    <div style="padding:1rem;background:var(--bg-body);border-radius:12px;border:1px solid var(--border-light);">
                        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:0.5rem;">
                            <span style="font-weight:700;font-size:0.85rem;">@cat.CategoryName</span>
                            <span class="badge" style="background:@(catColor)22;color:@catColor;font-size:0.65rem;">@catSharePct.ToString("0.0")%</span>
                        </div>
                        <div style="display:grid;grid-template-columns:1fr 1fr;gap:0.4rem;font-size:0.75rem;margin-bottom:0.5rem;">
                            <div><span style="color:var(--text-tertiary);">Revenue</span><br/><strong>@FormatCurrency(cat.Revenue)</strong></div>
                            <div><span style="color:var(--text-tertiary);">Qty Sold</span><br/><strong>@cat.QuantitySold.ToString("N0")</strong></div>
                            <div><span style="color:var(--text-tertiary);">Items</span><br/><strong>@cat.ItemCount</strong></div>
                            <div><span style="color:var(--text-tertiary);">Avg Price</span><br/><strong>@FormatCurrency(cat.AvgItemPrice)</strong></div>
                        </div>
                        <div style="height:6px;background:var(--border-light);border-radius:3px;overflow:hidden;">
                            <div style="height:100%;width:@(catPct)%;background:@catColor;border-radius:3px;"></div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Top 10 Best Sellers -->
    <div class="card" style="margin-bottom:1.5rem;">
        <div class="card-header">
            <h3 class="section-title"><i class="fas fa-trophy" style="color:var(--accent);margin-right:0.5rem;"></i>Top Sellers by Revenue</h3>
        </div>
        <div class="card-body" style="padding:0;">
            @{
                var top10 = items.Take(10).ToList();
            }
            @foreach (var (item, idx) in top10.Select((v, i) => (v, i)))
            {
                int revPct = (int)Math.Round(item.Revenue / maxRevenue * 100m);
                int qtyPct = (int)Math.Round((decimal)item.QuantitySold / maxQty * 100m);
                string catColor = item.CategoryColor ?? "#6366f1";
                string profitColor = item.ProfitMargin >= 40 ? "#16a34a" : item.ProfitMargin >= 20 ? "#d97706" : "#dc2626";
                <div style="display:flex;align-items:center;gap:1rem;padding:0.85rem 1.25rem;border-bottom:1px solid var(--border-light);">
                    <!-- Rank -->
                    <div style="width:28px;height:28px;border-radius:50%;background:@(idx < 3 ? "var(--accent)" : "var(--bg-body)");color:@(idx < 3 ? "#fff" : "var(--text-secondary)");display:flex;align-items:center;justify-content:center;font-weight:700;font-size:0.75rem;flex-shrink:0;border:1px solid var(--border-light);">
                        @(idx + 1)
                    </div>
                    <!-- Info -->
                    <div style="flex:1;min-width:0;">
                        <div style="display:flex;align-items:center;gap:0.5rem;margin-bottom:0.2rem;">
                            <span style="font-weight:700;font-size:0.85rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">@item.ItemName</span>
                            <span class="badge" style="background:@(catColor)18;color:@catColor;font-size:0.6rem;flex-shrink:0;">@item.CategoryName</span>
                            @if (!item.IsAvailable)
                            {
                                <span class="badge badge-danger" style="font-size:0.55rem;">Unavailable</span>
                            }
                        </div>
                        <div style="display:flex;gap:1.5rem;font-size:0.72rem;color:var(--text-tertiary);">
                            <span><strong style="color:var(--text-primary);">@item.QuantitySold</strong> sold</span>
                            <span><strong style="color:var(--text-primary);">@item.OrderCount</strong> orders</span>
                            <span>Price: <strong style="color:var(--text-primary);">@FormatCurrency(item.Price)</strong></span>
                        </div>
                        <!-- Mini bar -->
                        <div style="height:4px;background:var(--border-light);border-radius:2px;overflow:hidden;margin-top:0.35rem;">
                            <div style="height:100%;width:@(revPct)%;background:linear-gradient(90deg,#d4af37,#f59e0b);border-radius:2px;"></div>
                        </div>
                    </div>
                    <!-- Revenue -->
                    <div style="text-align:right;flex-shrink:0;">
                        <div style="font-weight:700;font-size:0.9rem;">@FormatCurrency(item.Revenue)</div>
                        <div style="font-size:0.65rem;color:@profitColor;font-weight:600;">@item.ProfitMargin.ToString("0.0")% margin</div>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Full Item Table -->
    <div class="card">
        <div class="card-header" style="display:flex;justify-content:space-between;align-items:center;">
            <h3 class="section-title"><i class="fas fa-table" style="color:var(--accent);margin-right:0.5rem;"></i>All Menu Items</h3>
            <input type="text" id="itemSearch" class="form-control" placeholder="Search items..." style="max-width:220px;" oninput="filterTable()" />
        </div>
        <div class="card-body" style="overflow-x:auto;">
            <table class="table" id="menuTable">
                <thead>
                    <tr>
                        <th style="cursor:pointer;" onclick="sortTable(0)">Item <i class="fas fa-sort" style="font-size:0.6rem;"></i></th>
                        <th style="cursor:pointer;" onclick="sortTable(1)">Category <i class="fas fa-sort" style="font-size:0.6rem;"></i></th>
                        <th style="cursor:pointer;text-align:right;" onclick="sortTable(2)">Price <i class="fas fa-sort" style="font-size:0.6rem;"></i></th>
                        <th style="cursor:pointer;text-align:right;" onclick="sortTable(3)">Cost <i class="fas fa-sort" style="font-size:0.6rem;"></i></th>
                        <th style="cursor:pointer;text-align:right;" onclick="sortTable(4)">Qty Sold <i class="fas fa-sort" style="font-size:0.6rem;"></i></th>
                        <th style="cursor:pointer;text-align:right;" onclick="sortTable(5)">Revenue <i class="fas fa-sort" style="font-size:0.6rem;"></i></th>
                        <th style="cursor:pointer;text-align:right;" onclick="sortTable(6)">Profit <i class="fas fa-sort" style="font-size:0.6rem;"></i></th>
                        <th style="cursor:pointer;text-align:right;" onclick="sortTable(7)">Margin <i class="fas fa-sort" style="font-size:0.6rem;"></i></th>
                        <th style="cursor:pointer;text-align:right;" onclick="sortTable(8)">Orders <i class="fas fa-sort" style="font-size:0.6rem;"></i></th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in items)
                    {
                        string profitColor = item.ProfitMargin >= 40 ? "#16a34a" : item.ProfitMargin >= 20 ? "#d97706" : "#dc2626";
                        <tr>
                            <td style="font-weight:600;">@item.ItemName</td>
                            <td>
                                <span class="badge" style="background:@(item.CategoryColor ?? "#6366f1")18;color:@(item.CategoryColor ?? "#6366f1");font-size:0.65rem;">@item.CategoryName</span>
                            </td>
                            <td style="text-align:right;">@FormatCurrency(item.Price)</td>
                            <td style="text-align:right;">@FormatCurrency(item.CostPrice)</td>
                            <td style="text-align:right;font-weight:600;">@item.QuantitySold.ToString("N0")</td>
                            <td style="text-align:right;font-weight:700;">@FormatCurrency(item.Revenue)</td>
                            <td style="text-align:right;color:@profitColor;font-weight:600;">@FormatCurrency(item.Profit)</td>
                            <td style="text-align:right;color:@profitColor;font-weight:600;">@item.ProfitMargin.ToString("0.0")%</td>
                            <td style="text-align:right;">@item.OrderCount</td>
                            <td>
                                @if (item.IsAvailable)
                                {
                                    <span class="badge badge-success" style="font-size:0.6rem;">Active</span>
                                }
                                else
                                {
                                    <span class="badge badge-danger" style="font-size:0.6rem;">Off</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@section Scripts {
<script>
    // Simple client-side search filter
    function filterTable() {
        const query = document.getElementById('itemSearch').value.toLowerCase();
        const rows = document.querySelectorAll('#menuTable tbody tr');
        rows.forEach(row => {
            const text = row.textContent.toLowerCase();
            row.style.display = text.includes(query) ? '' : 'none';
        });
    }

    // Simple client-side sort
    let sortDir = {};
    function sortTable(colIdx) {
        const table = document.getElementById('menuTable');
        const tbody = table.querySelector('tbody');
        const rows = Array.from(tbody.querySelectorAll('tr'));
        const dir = sortDir[colIdx] = !(sortDir[colIdx] ?? false);

        rows.sort((a, b) => {
            let aText = a.cells[colIdx]?.textContent.trim() ?? '';
            let bText = b.cells[colIdx]?.textContent.trim() ?? '';
            // Try numeric
            let aNum = parseFloat(aText.replace(/[$,%]/g, '').replace(/,/g, ''));
            let bNum = parseFloat(bText.replace(/[$,%]/g, '').replace(/,/g, ''));
            if (!isNaN(aNum) && !isNaN(bNum)) {
                return dir ? aNum - bNum : bNum - aNum;
            }
            return dir ? aText.localeCompare(bText) : bText.localeCompare(aText);
        });

        rows.forEach(r => tbody.appendChild(r));
    }
</script>
}
