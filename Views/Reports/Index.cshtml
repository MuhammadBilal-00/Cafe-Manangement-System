@{
    ViewData["Title"] = "Reports";
    var branches = ViewBag.Branches as List<Cafe.Models.Branch> ?? new List<Cafe.Models.Branch>();
}

<!-- Page Header -->
<div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:1rem;margin-bottom:2rem;">
    <div>
        <h1 class="page-title" style="margin:0;">Reporting Hub</h1>
        <p class="body-text" style="margin-top:0.25rem;">Access all analytics and performance reports across @branches.Count branch@(branches.Count == 1 ? "" : "es").</p>
    </div>
</div>

<!-- Report Cards -->
<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:1.25rem;">

    <!-- Sales Overview -->
    <a asp-action="SalesOverview" asp-controller="Reports" class="card" style="text-decoration:none;color:inherit;overflow:hidden;transition:transform 0.2s,box-shadow 0.2s;" onmouseover="this.style.transform='translateY(-3px)';this.style.boxShadow='0 12px 32px rgba(0,0,0,0.12)'" onmouseout="this.style.transform='';this.style.boxShadow=''">
        <div style="height:6px;background:linear-gradient(90deg,#ec4899,#8b5cf6);"></div>
        <div class="card-body" style="padding:1.5rem;">
            <div style="display:flex;justify-content:space-between;align-items:start;">
                <div>
                    <span class="badge badge-accent" style="margin-bottom:0.5rem;">Sales</span>
                    <h3 style="font-weight:700;font-size:1.05rem;margin:0.25rem 0;">Sales Overview</h3>
                    <p style="font-size:0.8rem;color:var(--text-tertiary);line-height:1.5;">Revenue trends, order analytics, top items and daily breakdowns by branch.</p>
                </div>
                <div style="width:48px;height:48px;border-radius:14px;background:linear-gradient(135deg,#ec4899,#8b5cf6);display:flex;align-items:center;justify-content:center;color:#fff;font-size:1.25rem;flex-shrink:0;">
                    <i class="fas fa-chart-line"></i>
                </div>
            </div>
            <div style="display:flex;gap:0.5rem;margin-top:1rem;">
                <span style="font-size:0.7rem;padding:0.2rem 0.5rem;border-radius:6px;background:#f8f8f6;color:var(--text-tertiary);">Revenue & Orders</span>
                <span style="font-size:0.7rem;padding:0.2rem 0.5rem;border-radius:6px;background:#f8f8f6;color:var(--text-tertiary);">Date + Branch filters</span>
            </div>
            <div style="display:flex;justify-content:space-between;align-items:center;margin-top:1rem;padding-top:0.75rem;border-top:1px solid var(--border-light);">
                <span style="font-size:0.78rem;color:var(--text-tertiary);">Open report</span>
                <span style="width:28px;height:28px;border-radius:50%;background:var(--sidebar-bg);color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.75rem;">→</span>
            </div>
        </div>
    </a>

    <!-- Branch Performance -->
    <a asp-action="BranchPerformance" asp-controller="Reports" class="card" style="text-decoration:none;color:inherit;overflow:hidden;transition:transform 0.2s,box-shadow 0.2s;" onmouseover="this.style.transform='translateY(-3px)';this.style.boxShadow='0 12px 32px rgba(0,0,0,0.12)'" onmouseout="this.style.transform='';this.style.boxShadow=''">
        <div style="height:6px;background:linear-gradient(90deg,#0ea5e9,#06b6d4);"></div>
        <div class="card-body" style="padding:1.5rem;">
            <div style="display:flex;justify-content:space-between;align-items:start;">
                <div>
                    <span class="badge badge-info" style="margin-bottom:0.5rem;">Branch</span>
                    <h3 style="font-weight:700;font-size:1.05rem;margin:0.25rem 0;">Branch Performance</h3>
                    <p style="font-size:0.8rem;color:var(--text-tertiary);line-height:1.5;">Compare revenue, orders and customer feedback across all branches.</p>
                </div>
                <div style="width:48px;height:48px;border-radius:14px;background:linear-gradient(135deg,#0ea5e9,#06b6d4);display:flex;align-items:center;justify-content:center;color:#fff;font-size:1.25rem;flex-shrink:0;">
                    <i class="fas fa-building"></i>
                </div>
            </div>
            <div style="display:flex;gap:0.5rem;margin-top:1rem;">
                <span style="font-size:0.7rem;padding:0.2rem 0.5rem;border-radius:6px;background:#f8f8f6;color:var(--text-tertiary);">Compare Branches</span>
                <span style="font-size:0.7rem;padding:0.2rem 0.5rem;border-radius:6px;background:#f8f8f6;color:var(--text-tertiary);">Feedback scores</span>
            </div>
            <div style="display:flex;justify-content:space-between;align-items:center;margin-top:1rem;padding-top:0.75rem;border-top:1px solid var(--border-light);">
                <span style="font-size:0.78rem;color:var(--text-tertiary);">Open report</span>
                <span style="width:28px;height:28px;border-radius:50%;background:var(--sidebar-bg);color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.75rem;">→</span>
            </div>
        </div>
    </a>

    <!-- Inventory Overview -->
    <a asp-action="InventoryOverview" asp-controller="Reports" class="card" style="text-decoration:none;color:inherit;overflow:hidden;transition:transform 0.2s,box-shadow 0.2s;" onmouseover="this.style.transform='translateY(-3px)';this.style.boxShadow='0 12px 32px rgba(0,0,0,0.12)'" onmouseout="this.style.transform='';this.style.boxShadow=''">
        <div style="height:6px;background:linear-gradient(90deg,#10b981,#059669);"></div>
        <div class="card-body" style="padding:1.5rem;">
            <div style="display:flex;justify-content:space-between;align-items:start;">
                <div>
                    <span class="badge badge-success" style="margin-bottom:0.5rem;">Inventory</span>
                    <h3 style="font-weight:700;font-size:1.05rem;margin:0.25rem 0;">Inventory Overview</h3>
                    <p style="font-size:0.8rem;color:var(--text-tertiary);line-height:1.5;">Stock levels, values, low stock alerts and inventory health across branches.</p>
                </div>
                <div style="width:48px;height:48px;border-radius:14px;background:linear-gradient(135deg,#10b981,#059669);display:flex;align-items:center;justify-content:center;color:#fff;font-size:1.25rem;flex-shrink:0;">
                    <i class="fas fa-boxes"></i>
                </div>
            </div>
            <div style="display:flex;gap:0.5rem;margin-top:1rem;">
                <span style="font-size:0.7rem;padding:0.2rem 0.5rem;border-radius:6px;background:#f8f8f6;color:var(--text-tertiary);">Stock & Value</span>
                <span style="font-size:0.7rem;padding:0.2rem 0.5rem;border-radius:6px;background:#f8f8f6;color:var(--text-tertiary);">Low stock alerts</span>
            </div>
            <div style="display:flex;justify-content:space-between;align-items:center;margin-top:1rem;padding-top:0.75rem;border-top:1px solid var(--border-light);">
                <span style="font-size:0.78rem;color:var(--text-tertiary);">Open report</span>
                <span style="width:28px;height:28px;border-radius:50%;background:var(--sidebar-bg);color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.75rem;">→</span>
            </div>
        </div>
    </a>

    <!-- Menu Performance -->
    <a asp-action="MenuPerformance" asp-controller="Reports" class="card" style="text-decoration:none;color:inherit;overflow:hidden;transition:transform 0.2s,box-shadow 0.2s;opacity:0.7;" onmouseover="this.style.transform='translateY(-3px)';this.style.boxShadow='0 12px 32px rgba(0,0,0,0.12)'" onmouseout="this.style.transform='';this.style.boxShadow=''">
        <div style="height:6px;background:linear-gradient(90deg,#f59e0b,#d97706);"></div>
        <div class="card-body" style="padding:1.5rem;">
            <div style="display:flex;justify-content:space-between;align-items:start;">
                <div>
                    <span class="badge badge-warning" style="margin-bottom:0.5rem;">Menu</span>
                    <h3 style="font-weight:700;font-size:1.05rem;margin:0.25rem 0;">Menu Performance</h3>
                    <p style="font-size:0.8rem;color:var(--text-tertiary);line-height:1.5;">Analyze best sellers, pricing trends and category performance.</p>
                </div>
                <div style="width:48px;height:48px;border-radius:14px;background:linear-gradient(135deg,#f59e0b,#d97706);display:flex;align-items:center;justify-content:center;color:#fff;font-size:1.25rem;flex-shrink:0;">
                    <i class="fas fa-utensils"></i>
                </div>
            </div>
            <div style="display:flex;gap:0.5rem;margin-top:1rem;">
                <span style="font-size:0.7rem;padding:0.2rem 0.5rem;border-radius:6px;background:#fef3c7;color:#92400e;">Coming Soon</span>
            </div>
            <div style="display:flex;justify-content:space-between;align-items:center;margin-top:1rem;padding-top:0.75rem;border-top:1px solid var(--border-light);">
                <span style="font-size:0.78rem;color:var(--text-tertiary);">Preview</span>
                <span style="width:28px;height:28px;border-radius:50%;background:var(--sidebar-bg);color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.75rem;">→</span>
            </div>
        </div>
    </a>
</div>
