@{
    ViewData["Title"] = "Reports";
    var branches = ViewBag.Branches as List<Cafe.Models.Branch> ?? new List<Cafe.Models.Branch>();

    var reports = new[]
    {
        new { Action = "SalesOverview", Badge = "Sales", BadgeClass = "badge-accent", Title = "Sales Overview",
              Text = "Revenue trends, order analytics, top items and daily breakdowns by branch.",
              Icon = "fa-chart-line", Chip1 = "Revenue & Orders", Chip2 = "Date + Branch filters", TintVar = "--accent" },
        new { Action = "BranchPerformance", Badge = "Branch", BadgeClass = "badge-info", Title = "Branch Performance",
              Text = "Compare revenue, orders and customer feedback across all branches.",
              Icon = "fa-building", Chip1 = "Compare Branches", Chip2 = "Feedback scores", TintVar = "--info" },
        new { Action = "InventoryOverview", Badge = "Inventory", BadgeClass = "badge-success", Title = "Inventory Overview",
              Text = "Stock levels, values, low stock alerts and inventory health across branches.",
              Icon = "fa-boxes-stacked", Chip1 = "Stock & Value", Chip2 = "Low stock alerts", TintVar = "--success" },
        new { Action = "MenuPerformance", Badge = "Menu", BadgeClass = "badge-warning", Title = "Menu Performance",
              Text = "Analyze best sellers, pricing trends and category performance.",
              Icon = "fa-utensils", Chip1 = "Best sellers", Chip2 = "Category mix", TintVar = "--warning" }
    };
}

<!-- Page Header -->
<div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:1rem;margin-bottom:2rem;">
    <div>
        <h1 class="page-title" style="margin:0;">Reporting Hub</h1>
        <p class="body-text" style="margin-top:0.25rem;">Access all analytics and performance reports across
            @branches.Count branch@(branches.Count == 1 ? "" : "es").</p>
    </div>
</div>

<!-- Report Tiles -->
<div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-5">
    @foreach (var r in reports)
    {
        <a asp-action="@r.Action" asp-controller="Reports"
           class="card card-interactive group no-underline text-inherit overflow-hidden">
            <div class="p-6 flex flex-col h-full">
                <div class="flex justify-between items-start gap-3">
                    <div>
                        <span class="badge @r.BadgeClass mb-2">@r.Badge</span>
                        <h3 class="font-bold text-[1.05rem] my-1 text-[var(--text-primary)]">@r.Title</h3>
                        <p class="text-[0.8rem] text-[var(--text-tertiary)] leading-relaxed">@r.Text</p>
                    </div>
                    <div class="w-12 h-12 rounded-[14px] flex items-center justify-center text-xl shrink-0 transition-transform duration-300 group-hover:scale-110"
                         style="background:color-mix(in srgb, var(@r.TintVar) 14%, transparent);color:var(@r.TintVar);">
                        <i class="fas @r.Icon"></i>
                    </div>
                </div>
                <div class="flex gap-2 mt-4 flex-wrap">
                    <span class="text-[0.7rem] py-0.5 px-2 rounded-md bg-[var(--bg-inset)] text-[var(--text-tertiary)]">@r.Chip1</span>
                    <span class="text-[0.7rem] py-0.5 px-2 rounded-md bg-[var(--bg-inset)] text-[var(--text-tertiary)]">@r.Chip2</span>
                </div>
                <div class="flex justify-between items-center mt-auto pt-3 border-t border-[var(--border-light)]" style="margin-top:auto;">
                    <span class="text-[0.78rem] text-[var(--text-tertiary)] group-hover:text-accent transition-colors duration-300">Open report</span>
                    <span class="w-7 h-7 rounded-full flex items-center justify-center text-xs transition-transform duration-300 group-hover:translate-x-0.5"
                          style="background:var(--surface-contrast);color:var(--surface-contrast-text);">→</span>
                </div>
            </div>
        </a>
    }
</div>
