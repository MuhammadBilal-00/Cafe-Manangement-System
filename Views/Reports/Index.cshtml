@{
    ViewData["Title"] = "Reports";
    var branches = ViewBag.Branches as List<Cafe.Models.Branch> ?? new List<Cafe.Models.Branch>();
}

<!-- Page Header -->
<div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:1rem;margin-bottom:2rem;">
    <div>
        <h1 class="page-title" style="margin:0;">Reporting Hub</h1>
        <p class="body-text" style="margin-top:0.25rem;">Access all analytics and performance reports across
            @branches.Count branch@(branches.Count == 1 ? "" : "es").</p>
        </div>
    </div>

    <!-- Report Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-2 xl:grid-cols-4 gap-5">

        <!-- Sales Overview -->
        <a asp-action="SalesOverview" asp-controller="Reports"
               class="card card-interactive group no-underline text-inherit overflow-hidden">
            <div class="h-1.5 bg-gradient-to-r from-pink-500 to-violet-500"></div>
            <div class="p-6">
                <div class="flex justify-between items-start">
                    <div>
                        <span class="badge badge-accent mb-2">Sales</span>
                        <h3 class="font-bold text-[1.05rem] my-1 text-[var(--text-primary)]">Sales Overview</h3>
                        <p class="text-[0.8rem] text-[var(--text-tertiary)] leading-relaxed">Revenue trends, order
                            analytics, top items and daily breakdowns by branch.</p>
                        </div>
                        <div
                            class="w-12 h-12 rounded-[14px] bg-gradient-to-br from-pink-500 to-violet-500 flex items-center justify-center text-white text-xl shrink-0 transition-transform duration-300 group-hover:scale-110">
                            <i class="fas fa-chart-line"></i>
                        </div>
                    </div>
                    <div class="flex gap-2 mt-4">
                        <span class="text-[0.7rem] py-0.5 px-2 rounded-md bg-[#f8f8f6] text-[var(--text-tertiary)]">Revenue &
                            Orders</span>
                            <span class="text-[0.7rem] py-0.5 px-2 rounded-md bg-[#f8f8f6] text-[var(--text-tertiary)]">Date +
                                Branch filters</span>
                            </div>
                            <div class="flex justify-between items-center mt-4 pt-3 border-t border-[var(--border-light)]">
                                <span
                                    class="text-[0.78rem] text-[var(--text-tertiary)] group-hover:text-accent transition-colors duration-300">Open
                                    report</span>
                                    <span
                                    class="w-7 h-7 rounded-full bg-sidebar text-white flex items-center justify-center text-xs transition-transform duration-300 group-hover:translate-x-0.5">→</span>
                                </div>
                            </div>
                        </a>

                        <!-- Branch Performance -->
                        <a asp-action="BranchPerformance" asp-controller="Reports"
                               class="card card-interactive group no-underline text-inherit overflow-hidden">
                            <div class="h-1.5 bg-gradient-to-r from-sky-500 to-cyan-500"></div>
                            <div class="p-6">
                                <div class="flex justify-between items-start">
                                    <div>
                                        <span class="badge badge-info mb-2">Branch</span>
                                        <h3 class="font-bold text-[1.05rem] my-1 text-[var(--text-primary)]">Branch Performance</h3>
                                        <p class="text-[0.8rem] text-[var(--text-tertiary)] leading-relaxed">Compare revenue, orders and
                                            customer feedback across all branches.</p>
                                        </div>
                                        <div
                                            class="w-12 h-12 rounded-[14px] bg-gradient-to-br from-sky-500 to-cyan-500 flex items-center justify-center text-white text-xl shrink-0 transition-transform duration-300 group-hover:scale-110">
                                            <i class="fas fa-building"></i>
                                        </div>
                                    </div>
                                    <div class="flex gap-2 mt-4">
                                        <span class="text-[0.7rem] py-0.5 px-2 rounded-md bg-[#f8f8f6] text-[var(--text-tertiary)]">Compare
                                            Branches</span>
                                            <span class="text-[0.7rem] py-0.5 px-2 rounded-md bg-[#f8f8f6] text-[var(--text-tertiary)]">Feedback
                                                scores</span>
                                            </div>
                                            <div class="flex justify-between items-center mt-4 pt-3 border-t border-[var(--border-light)]">
                                                <span
                                                    class="text-[0.78rem] text-[var(--text-tertiary)] group-hover:text-accent transition-colors duration-300">Open
                                                    report</span>
                                                    <span
                                                    class="w-7 h-7 rounded-full bg-sidebar text-white flex items-center justify-center text-xs transition-transform duration-300 group-hover:translate-x-0.5">→</span>
                                                </div>
                                            </div>
                                        </a>

                                        <!-- Inventory Overview -->
                                        <a asp-action="InventoryOverview" asp-controller="Reports"
                                               class="card card-interactive group no-underline text-inherit overflow-hidden">
                                            <div class="h-1.5 bg-gradient-to-r from-emerald-500 to-green-600"></div>
                                            <div class="p-6">
                                                <div class="flex justify-between items-start">
                                                    <div>
                                                        <span class="badge badge-success mb-2">Inventory</span>
                                                        <h3 class="font-bold text-[1.05rem] my-1 text-[var(--text-primary)]">Inventory Overview</h3>
                                                        <p class="text-[0.8rem] text-[var(--text-tertiary)] leading-relaxed">Stock levels, values, low stock
                                                            alerts and inventory health across branches.</p>
                                                        </div>
                                                        <div
                                                            class="w-12 h-12 rounded-[14px] bg-gradient-to-br from-emerald-500 to-green-600 flex items-center justify-center text-white text-xl shrink-0 transition-transform duration-300 group-hover:scale-110">
                                                            <i class="fas fa-boxes"></i>
                                                        </div>
                                                    </div>
                                                    <div class="flex gap-2 mt-4">
                                                        <span class="text-[0.7rem] py-0.5 px-2 rounded-md bg-[#f8f8f6] text-[var(--text-tertiary)]">Stock &
                                                            Value</span>
                                                            <span class="text-[0.7rem] py-0.5 px-2 rounded-md bg-[#f8f8f6] text-[var(--text-tertiary)]">Low stock
                                                                alerts</span>
                                                            </div>
                                                            <div class="flex justify-between items-center mt-4 pt-3 border-t border-[var(--border-light)]">
                                                                <span
                                                                    class="text-[0.78rem] text-[var(--text-tertiary)] group-hover:text-accent transition-colors duration-300">Open
                                                                    report</span>
                                                                    <span
                                                                    class="w-7 h-7 rounded-full bg-sidebar text-white flex items-center justify-center text-xs transition-transform duration-300 group-hover:translate-x-0.5">→</span>
                                                                </div>
                                                            </div>
                                                        </a>

                                                        <!-- Menu Performance -->
                                                        <a asp-action="MenuPerformance" asp-controller="Reports"
                                                               class="card card-interactive group no-underline text-inherit overflow-hidden">
                                                            <div class="h-1.5 bg-gradient-to-r from-amber-500 to-amber-600"></div>
                                                            <div class="p-6">
                                                                <div class="flex justify-between items-start">
                                                                    <div>
                                                                        <span class="badge badge-warning mb-2">Menu</span>
                                                                        <h3 class="font-bold text-[1.05rem] my-1 text-[var(--text-primary)]">Menu Performance</h3>
                                                                        <p class="text-[0.8rem] text-[var(--text-tertiary)] leading-relaxed">Analyze best sellers, pricing
                                                                            trends and category performance.</p>
                                                                        </div>
                                                                        <div
                                                                            class="w-12 h-12 rounded-[14px] bg-gradient-to-br from-amber-500 to-amber-600 flex items-center justify-center text-white text-xl shrink-0 transition-transform duration-300 group-hover:scale-110">
                                                                            <i class="fas fa-utensils"></i>
                                                                        </div>
                                                                    </div>
                                                                    <div class="flex justify-between items-center mt-4 pt-3 border-t border-[var(--border-light)]">
                                                                        <span
                                                                            class="text-[0.78rem] text-[var(--text-tertiary)] group-hover:text-accent transition-colors duration-300">Open
                                                                            report</span>
                                                                            <span
                                                                            class="w-7 h-7 rounded-full bg-sidebar text-white flex items-center justify-center text-xs transition-transform duration-300 group-hover:translate-x-0.5">→</span>
                                                                        </div>
                                                                    </div>
                                                                </a>
                                                            </div>