@model Cafe.Models.ViewModels.AttendanceMarkViewModel
@{
    ViewData["Title"] = "Mark My Attendance";
}

<div class="max-w-lg mx-auto">
    <div class="flex items-center mb-6">
        <a asp-action="Index" class="text-gray-500 hover:text-gray-700 mr-4">
            <i class="fas fa-arrow-left text-xl"></i>
        </a>
        <h1 class="text-2xl font-bold text-gray-800">Mark My Attendance</h1>
    </div>

    <div class="bg-white rounded-lg shadow-md p-6">
        <div class="text-center mb-6">
            <div class="text-4xl text-blue-600 mb-2">
                <i class="fas fa-user-check"></i>
            </div>
            <p class="text-gray-600">Today: @DateTime.Today.ToString("dddd, dd MMMM yyyy")</p>
        </div>

        <form asp-action="MarkSelf" method="post">
            @Html.AntiForgeryToken()

            <div class="space-y-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Status *</label>
                    <select name="Status" id="statusSelect" class="w-full border rounded-lg px-3 py-2" required onchange="toggleLateMinutes()">
                        <option value="Present">Present</option>
                        <option value="Late">Late</option>
                        <option value="Half-Day">Half-Day</option>
                    </select>
                </div>
                <div id="lateMinutesDiv" style="display:none;">
                    <label class="block text-sm font-medium text-gray-700 mb-2">Late Minutes</label>
                    <input type="number" name="LateMinutes" value="0" min="0" max="1440" class="w-full border rounded-lg px-3 py-2" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Check In Time</label>
                    <input type="time" name="CheckInTime" value="@DateTime.Now.ToString("HH:mm")" class="w-full border rounded-lg px-3 py-2" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Notes</label>
                    <textarea name="Notes" rows="2" class="w-full border rounded-lg px-3 py-2" placeholder="Optional notes..."></textarea>
                </div>
            </div>

            <div class="mt-6">
                <button type="submit" class="w-full bg-green-600 hover:bg-green-700 text-white px-6 py-3 rounded-lg text-lg font-medium">
                    <i class="fas fa-check-circle mr-2"></i> Confirm Attendance
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
    function toggleLateMinutes() {
        var status = document.getElementById('statusSelect').value;
        document.getElementById('lateMinutesDiv').style.display = status === 'Late' ? 'block' : 'none';
    }
    toggleLateMinutes();
</script>
}
