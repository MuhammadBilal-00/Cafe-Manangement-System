@model Cafe.Models.ViewModels.AttendanceMarkViewModel
@{
    ViewData["Title"] = "Clock In";
}

<div class="max-w-[520px] mx-auto">
    <!-- Header -->
    <div style="display:flex; align-items:center; margin-bottom:1.5rem; gap:1rem;">
        <a asp-action="Index" class="btn btn-ghost btn-sm"><i class="fas fa-arrow-left"></i></a>
        <h1 class="page-title" style="margin:0;">Clock In</h1>
    </div>

    <div class="card">
        <div class="card-body text-center">
            <!-- Clock Icon -->
            <div style="width:72px; height:72px; border-radius:50%; background:rgba(34,197,94,0.1); display:flex; align-items:center; justify-content:center; margin:0 auto 1rem;">
                <i class="fas fa-sign-in-alt" style="font-size:1.75rem; color:#16a34a;"></i>
            </div>
            <p class="body-text" style="margin-bottom:1.5rem;">@DateTime.Today.ToString("dddd, dd MMMM yyyy")</p>

            <!-- Info -->
            <div style="background:var(--bg-body); border-radius:var(--radius-card); padding:1rem; margin-bottom:1.5rem; text-align:left;">
                <p class="caption" style="margin:0;">
                    <i class="fas fa-info-circle" style="color:var(--accent); margin-right:0.5rem;"></i>
                    Your status will be <strong>automatically calculated</strong> when you clock out.
                    Late is detected if you clock in more than 15 minutes after your shift starts.
                </p>
            </div>

            <form asp-action="MarkSelf" method="post" style="text-align:left;">
                @Html.AntiForgeryToken()

                <div class="form-group">
                    <label class="form-label">Check In Time</label>
                    <input type="time" name="CheckInTime" value="@DateTime.Now.ToString("HH:mm")" class="form-control" />
                </div>

                <div class="form-group">
                    <label class="form-label">Notes</label>
                    <textarea name="Notes" rows="2" class="form-control" placeholder="Optional notes..."></textarea>
                </div>

                <button type="submit" class="btn btn-primary" style="width:100%; padding:0.875rem; font-size:1.1rem; margin-top:0.5rem;">
                    <i class="fas fa-sign-in-alt" style="margin-right:0.5rem;"></i> Clock In
                </button>

                <p class="caption" style="text-align:center; margin-top:1rem;">
                    Remember to <a asp-action="ClockOut" style="color:var(--accent); text-decoration:underline;">Clock Out</a> when your shift ends.
                </p>
            </form>
        </div>
    </div>
</div>
