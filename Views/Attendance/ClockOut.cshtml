@{
    ViewData["Title"] = "Clock Out";
    var clockInTime = (TimeSpan?)ViewBag.ClockInTime;
    var staffName = (string)ViewBag.StaffName;
}

<div style="max-width:520px; margin:0 auto;">
    <!-- Header -->
    <div style="display:flex; align-items:center; margin-bottom:1.5rem; gap:1rem;">
        <a asp-action="Index" class="btn btn-ghost btn-sm"><i class="fas fa-arrow-left"></i></a>
        <h1 class="page-title" style="margin:0;">Clock Out</h1>
    </div>

    <div class="card">
        <div class="card-body" style="text-align:center;">
            <!-- Clock Icon -->
            <div style="width:72px; height:72px; border-radius:50%; background:rgba(249,115,22,0.1); display:flex; align-items:center; justify-content:center; margin:0 auto 1rem;">
                <i class="fas fa-sign-out-alt" style="font-size:1.75rem; color:#ea580c;"></i>
            </div>
            <p class="body-text">@DateTime.Today.ToString("dddd, dd MMMM yyyy")</p>
            <p class="caption">@staffName</p>

            <!-- Clock In Info -->
            <div style="background:var(--bg-body); border-radius:var(--radius-card); padding:1rem; margin:1.5rem 0; text-align:center;">
                <p class="body-text" style="margin:0;"><strong>Clocked In At:</strong> @(clockInTime?.ToString(@"hh\:mm") ?? "N/A")</p>
                @if (clockInTime.HasValue)
                {
                    var elapsed = DateTime.Now.TimeOfDay - clockInTime.Value;
                    <p class="caption" style="margin:0.5rem 0 0; color:var(--accent);">Time elapsed: @($"{(int)elapsed.TotalHours}h {elapsed.Minutes}m")</p>
                }
            </div>

            <form asp-action="ClockOut" method="post" style="text-align:left;">
                @Html.AntiForgeryToken()

                <div class="form-group">
                    <label class="form-label">Check Out Time</label>
                    <input type="time" name="checkOutTime" value="@DateTime.Now.ToString("HH:mm")" class="form-control" />
                </div>

                <!-- Status Guide -->
                <div style="background:var(--bg-body); border-radius:var(--radius-card); padding:1rem; margin-bottom:1.5rem;">
                    <p class="caption" style="margin-bottom:0.5rem;"><i class="fas fa-info-circle" style="color:var(--accent); margin-right:0.25rem;"></i> Status auto-calculated based on hours:</p>
                    <ul style="margin:0; padding-left:1.25rem; list-style:disc;">
                        <li class="caption"><span style="color:#16a34a; font-weight:600;">Present</span> — 8+ hours</li>
                        <li class="caption"><span style="color:#ea580c; font-weight:600;">Half-Day</span> — 4-8 hours</li>
                        <li class="caption"><span style="color:#dc2626; font-weight:600;">Absent</span> — Less than 4 hours</li>
                    </ul>
                </div>

                <button type="submit" class="btn btn-primary" style="width:100%; padding:0.875rem; font-size:1.1rem; background:#ea580c; border-color:#ea580c;">
                    <i class="fas fa-sign-out-alt" style="margin-right:0.5rem;"></i> Confirm Clock Out
                </button>
            </form>
        </div>
    </div>
</div>
