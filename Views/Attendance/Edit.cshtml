@model Cafe.Models.ViewModels.AttendanceMarkViewModel
@{
    ViewData["Title"] = "Edit Attendance";
    var attendanceId = (int)ViewBag.AttendanceId;
    var staffName = (string)ViewBag.StaffName;
    var totalHours = (decimal)ViewBag.TotalHours;
    var overtimeHours = (decimal)ViewBag.OvertimeHours;
}

<div class="max-w-2xl mx-auto">
    <div class="flex items-center mb-6">
        <a asp-action="Index" class="text-gray-500 hover:text-gray-700 mr-4">
            <i class="fas fa-arrow-left text-xl"></i>
        </a>
        <h1 class="text-2xl font-bold text-gray-800">Edit Attendance</h1>
    </div>

    <div class="bg-white rounded-lg shadow-md p-6">
        <div class="mb-6 p-4 bg-blue-50 rounded-lg">
            <div class="grid grid-cols-2 gap-2 text-sm text-blue-800">
                <p><strong>Staff:</strong> @staffName</p>
                <p><strong>Date:</strong> @Model.Date.ToString("dd MMM yyyy")</p>
                <p><strong>Current Status:</strong> <span class="font-bold">@Model.Status</span></p>
                <p><strong>Hours:</strong> @totalHours.ToString("F1")h @(overtimeHours > 0 ? $"(OT: {overtimeHours:F1}h)" : "")</p>
            </div>
        </div>

        <div class="mb-6 p-4 bg-amber-50 rounded-lg border border-amber-200">
            <p class="text-sm text-amber-800">
                <i class="fas fa-info-circle mr-1"></i>
                Status will be <strong>auto-recalculated</strong> when you save.
                Change check-in/check-out times and the system will determine the correct status.
            </p>
        </div>

        <form asp-action="Edit" asp-route-id="@attendanceId" method="post">
            @Html.AntiForgeryToken()

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Check In Time</label>
                    <input type="time" name="CheckInTime" value="@Model.CheckInTime?.ToString(@"hh\:mm")" class="w-full border rounded-lg px-3 py-2" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Check Out Time</label>
                    <input type="time" name="CheckOutTime" value="@Model.CheckOutTime?.ToString(@"hh\:mm")" class="w-full border rounded-lg px-3 py-2" />
                </div>
            </div>

            <div class="mt-6">
                <label class="block text-sm font-medium text-gray-700 mb-2">Notes</label>
                <textarea name="Notes" rows="3" class="w-full border rounded-lg px-3 py-2">@Model.Notes</textarea>
            </div>

            <div class="mt-2 text-xs text-gray-500">
                <p><i class="fas fa-lightbulb mr-1"></i> Clear both times to mark as Absent.</p>
            </div>

            <div class="mt-6 flex justify-end gap-3">
                <a asp-action="Index" class="px-4 py-2 border rounded-lg text-gray-700 hover:bg-gray-50">Cancel</a>
                <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-2 rounded-lg">
                    <i class="fas fa-save mr-2"></i> Update Attendance
                </button>
            </div>
        </form>
    </div>
</div>
