@model Cafe.Models.ViewModels.AttendanceMarkViewModel
@{
    ViewData["Title"] = "Edit Attendance";
    var attendanceId = (int)ViewBag.AttendanceId;
    var staffName = (string)ViewBag.StaffName;
    var totalHours = (decimal)ViewBag.TotalHours;
    var overtimeHours = (decimal)ViewBag.OvertimeHours;

    var leaveStatuses = new[] { "Paid Leave", "Sick Leave", "Casual Leave", "Holiday", "Work From Home" };
    var isManualMode = leaveStatuses.Contains(Model.Status);
    var noTimes = !Model.CheckInTime.HasValue && !Model.CheckOutTime.HasValue;
}

<div class="max-w-[720px] mx-auto">
    <!-- Header -->
    <div style="display:flex; align-items:center; margin-bottom:1.5rem; gap:1rem;">
        <a asp-action="Index" class="btn btn-ghost btn-sm"><i class="fas fa-arrow-left"></i></a>
        <h1 class="page-title" style="margin:0;">Edit Attendance</h1>
    </div>

    <!-- Current Info -->
    <div class="card card-accent mb-6">
        <div class="card-body">
            <div style="display:grid; grid-template-columns:1fr 1fr; gap:0.75rem;">
                <div>
                    <span class="caption">Staff</span>
                    <p class="body-text" style="font-weight:600; margin:0.25rem 0 0;">@staffName</p>
                </div>
                <div>
                    <span class="caption">Date</span>
                    <p class="body-text" style="font-weight:600; margin:0.25rem 0 0;">@Model.Date.ToString("dd MMM yyyy")</p>
                </div>
                <div>
                    <span class="caption">Current Status</span>
                    <p style="margin:0.25rem 0 0;">
                        @{
                            var sBadge = Model.Status switch
                            {
                                "Present"        => "badge badge-success",
                                "Absent"         => "badge badge-danger",
                                "Late"           => "badge badge-warning",
                                "Half-Day"       => "badge badge-info",
                                "Paid Leave"     => "badge badge-paid-leave",
                                "Sick Leave"     => "badge badge-warning",
                                "Casual Leave"   => "badge badge-warning",
                                "Holiday"        => "badge badge-success",
                                "Work From Home" => "badge badge-info",
                                "Overtime"       => "badge badge-success",
                                _                => "badge badge-neutral"
                            };
                        }
                        <span class="@sBadge">@Model.Status</span>
                    </p>
                </div>
                <div>
                    <span class="caption">Hours</span>
                    <p class="body-text" style="font-weight:600; margin:0.25rem 0 0;">@totalHours.ToString("F1")h @(overtimeHours > 0 ? $"(OT: {overtimeHours:F1}h)" : "")</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Info Message -->
    <div class="card card-accent-warning mb-6">
        <div class="card-body card-body-compact">
            <p class="caption" style="margin:0;">
                <i class="fas fa-info-circle" style="color:var(--warning); margin-right:0.5rem;"></i>
                In Auto mode, status is <strong>recalculated from times</strong>. In Manual mode, your <strong>selected status is saved directly</strong>.
            </p>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <form asp-action="Edit" asp-route-id="@attendanceId" method="post">
                @Html.AntiForgeryToken()

                <!-- Hidden input for manual status — set by JS -->
                <input type="hidden" name="ManualStatus" id="manualStatusHidden" value="@(isManualMode ? Model.Status : "")" />

                <!-- Mode Toggle -->
                <div class="form-group">
                    <label class="form-label">Attendance Type</label>
                    <div style="display:grid; grid-template-columns:1fr 1fr; gap:0.75rem;">
                        <label id="lbl-auto" style="cursor:pointer; border:2px solid @(isManualMode ? "var(--border-light)" : "var(--accent)"); border-radius:0.5rem; padding:0.75rem 1rem; display:flex; align-items:flex-start; gap:0.75rem; background:@(isManualMode ? "" : "rgba(212,175,55,0.05)");">
                            <input type="radio" name="_statusMode" value="auto" @(isManualMode ? "" : "checked") onchange="toggleEditMode(this)" style="margin-top:0.2rem; accent-color:var(--accent);" />
                            <span>
                                <i class="fas fa-magic" style="color:var(--accent);"></i>
                                <strong style="display:block; font-size:0.85rem; margin-bottom:0.15rem;">Auto-Calculate</strong>
                                <span class="caption">Status derived from clock-in/out times</span>
                            </span>
                        </label>
                        <label id="lbl-manual" style="cursor:pointer; border:2px solid @(isManualMode ? "var(--accent)" : "var(--border-light)"); border-radius:0.5rem; padding:0.75rem 1rem; display:flex; align-items:flex-start; gap:0.75rem; background:@(isManualMode ? "rgba(147,51,234,0.05)" : "");">
                            <input type="radio" name="_statusMode" value="manual" @(isManualMode ? "checked" : "") onchange="toggleEditMode(this)" style="margin-top:0.2rem; accent-color:var(--accent);" />
                            <span>
                                <i class="fas fa-hand-pointer" style="color:#9333ea;"></i>
                                <strong style="display:block; font-size:0.85rem; margin-bottom:0.15rem;">Manual Override</strong>
                                <span class="caption">Leave, Holiday, WFH etc.</span>
                            </span>
                        </label>
                    </div>
                </div>

                <!-- Auto-calculate panel -->
                <div id="panel-auto" style="display:@(isManualMode ? "none" : "");">
                    <div class="card card-accent mb-4">
                        <div class="card-body card-body-compact">
                            <p class="caption" style="margin:0;">
                                <i class="fas fa-info-circle" style="color:var(--accent); margin-right:0.5rem;"></i>
                                <strong>Present</strong> (8+h) &bull; <strong>Late</strong> (check-in &gt;15 min after shift) &bull;
                                <strong>Half-Day</strong> (4–8h) &bull; <strong>Absent</strong> (&lt;4h or no times)
                                @if (!isManualMode && noTimes)
                                {
                                    <br /><span style="color:var(--warning);"><i class="fas fa-exclamation-triangle" style="margin-right:0.25rem;"></i>No times recorded yet — add times or switch to manual.</span>
                                }
                            </p>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label">Check-In Time</label>
                            <input type="time" name="CheckInTime" id="autoCheckIn" value="@Model.CheckInTime?.ToString(@"hh\:mm")" class="form-control" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Check-Out Time</label>
                            <input type="time" name="CheckOutTime" id="autoCheckOut" value="@Model.CheckOutTime?.ToString(@"hh\:mm")" class="form-control" />
                        </div>
                    </div>
                </div>

                <!-- Manual status panel -->
                <div id="panel-manual" style="display:@(isManualMode ? "" : "none");">
                    <div class="form-group">
                        <label class="form-label">Select Status *</label>
                        <select id="manualStatusSelect" class="form-select" onchange="onManualStatusChange(this)">
                            <option value="">-- Choose a status --</option>
                            <optgroup label="Leave (Paid - no salary deduction)">
                                <option value="Paid Leave"    selected="@(Model.Status == "Paid Leave"                  ? "selected" : null)">Paid Leave</option>
                                <option value="Holiday"       selected="@(Model.Status == "Holiday"                    ? "selected" : null)">Holiday (public / company)</option>
                            </optgroup>
                            <optgroup label="Leave (Unpaid - deducted from salary)">
                                <option value="Sick Leave"    selected="@(Model.Status == "Sick Leave"                  ? "selected" : null)">Sick Leave</option>
                                <option value="Casual Leave"  selected="@(Model.Status == "Casual Leave"                ? "selected" : null)">Casual Leave</option>
                            </optgroup>
                            <optgroup label="Remote / Extended">
                                <option value="Work From Home" selected="@(Model.Status == "Work From Home"             ? "selected" : null)">Work From Home</option>
                            </optgroup>
                            <optgroup label="Clock-based (prefer Auto-Calculate mode)">
                                <option value="Present"   selected="@(Model.Status == "Present"  && isManualMode ? "selected" : null)">Present</option>
                                <option value="Late"      selected="@(Model.Status == "Late"     && isManualMode ? "selected" : null)">Late</option>
                                <option value="Half-Day"  selected="@(Model.Status == "Half-Day" && isManualMode ? "selected" : null)">Half-Day</option>
                                <option value="Absent"    selected="@(Model.Status == "Absent"   && isManualMode ? "selected" : null)">Absent</option>
                                <option value="Overtime"  selected="@(Model.Status == "Overtime" && isManualMode ? "selected" : null)">Overtime</option>
                            </optgroup>
                        </select>
                        <p class="caption" style="margin-top:0.4rem; color:var(--text-tertiary);">
                            For clock-based statuses (Present/Late etc), prefer Auto-Calculate mode.
                        </p>
                    </div>
                    <div id="wfhTimes" style="display:@(Model.Status == "Work From Home" ? "" : "none");">
                        <div class="form-row">
                            <div class="form-group">
                                <label class="form-label">Check-In Time (WFH)</label>
                                <input type="time" name="CheckInTime" id="wfhCheckIn" value="@Model.CheckInTime?.ToString(@"hh\:mm")" class="form-control" />
                            </div>
                            <div class="form-group">
                                <label class="form-label">Check-Out Time (WFH)</label>
                                <input type="time" name="CheckOutTime" id="wfhCheckOut" value="@Model.CheckOutTime?.ToString(@"hh\:mm")" class="form-control" />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label">Notes</label>
                    <textarea name="Notes" rows="3" class="form-control" placeholder="Optional remarks or reason...">@Model.Notes</textarea>
                </div>

                <div class="divider"></div>

                <div style="display:flex; justify-content:flex-end; gap:0.75rem;">
                    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary"><i class="fas fa-save" style="margin-right:0.5rem;"></i> Update Attendance</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function toggleEditMode(radio) {
        const isManual = radio.value === 'manual';
        document.getElementById('panel-auto').style.display   = isManual ? 'none' : '';
        document.getElementById('panel-manual').style.display = isManual ? ''     : 'none';
        document.getElementById('lbl-auto').style.borderColor   = isManual ? 'var(--border-light)' : 'var(--accent)';
        document.getElementById('lbl-manual').style.borderColor = isManual ? 'var(--accent)'       : 'var(--border-light)';
        document.getElementById('lbl-auto').style.background    = isManual ? '' : 'rgba(212,175,55,0.05)';
        document.getElementById('lbl-manual').style.background  = isManual ? 'rgba(147,51,234,0.05)' : '';

        if (!isManual) {
            // Clear manual status hidden input when switching to auto
            document.getElementById('manualStatusHidden').value = '';
            // Clear WFH times visibility
            document.getElementById('wfhTimes').style.display = 'none';
        } else {
            // Sync hidden input from dropdown when switching to manual
            var sel = document.getElementById('manualStatusSelect').value;
            document.getElementById('manualStatusHidden').value = sel;
        }
    }

    function onManualStatusChange(select) {
        document.getElementById('manualStatusHidden').value = select.value;
        document.getElementById('wfhTimes').style.display = select.value === 'Work From Home' ? '' : 'none';
    }
</script>
