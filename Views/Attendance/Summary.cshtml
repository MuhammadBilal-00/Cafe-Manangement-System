@model Cafe.Models.ViewModels.AttendanceSummaryViewModel
@{
    ViewData["Title"] = "Attendance Summary";
    var monthName = new DateTime(Model.Year, Model.Month, 1).ToString("MMMM yyyy");
}

<div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-bold text-gray-800">Attendance Summary - @monthName</h1>
    <a asp-action="Index" class="text-gray-500 hover:text-gray-700">
        <i class="fas fa-arrow-left mr-2"></i> Back to Records
    </a>
</div>

<!-- Filters -->
<div class="bg-white rounded-lg shadow-md p-6 mb-6">
    <form method="get" class="flex gap-4 items-end flex-wrap">
        <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Branch</label>
            <select name="branchId" class="border rounded-lg px-3 py-2">
                <option value="">All Branches</option>
                @foreach (var b in Model.Branches)
                {
                    <option value="@b.Id" selected="@(Model.BranchId == b.Id)">@b.Name</option>
                }
            </select>
        </div>
        <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Year</label>
            <select name="year" class="border rounded-lg px-3 py-2">
                @for (int y = DateTime.Now.Year; y >= DateTime.Now.Year - 3; y--)
                {
                    <option value="@y" selected="@(y == Model.Year)">@y</option>
                }
            </select>
        </div>
        <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Month</label>
            <select name="month" class="border rounded-lg px-3 py-2">
                @for (int m = 1; m <= 12; m++)
                {
                    <option value="@m" selected="@(m == Model.Month)">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(m)</option>
                }
            </select>
        </div>
        <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg">
            <i class="fas fa-filter mr-1"></i> View
        </button>
    </form>
</div>

<!-- Summary Table -->
<div class="bg-white rounded-lg shadow-md overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
            <tr>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Staff</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Branch</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Role</th>
                <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase">Working Days</th>
                <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase">Present</th>
                <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase">Absent</th>
                <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase">Late</th>
                <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase">Half-Day</th>
                <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase">Attendance %</th>
            </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
            @if (!Model.Summaries.Any())
            {
                <tr>
                    <td colspan="9" class="px-6 py-12 text-center text-gray-500">
                        <i class="fas fa-chart-bar text-4xl mb-3 block"></i>
                        No summary data available for this period.
                    </td>
                </tr>
            }
            @foreach (var s in Model.Summaries)
            {
                var pctClass = s.AttendancePercentage >= 90 ? "text-green-600" :
                               s.AttendancePercentage >= 70 ? "text-yellow-600" : "text-red-600";
                <tr class="hover:bg-gray-50">
                    <td class="px-6 py-4 text-sm font-medium text-gray-800">@s.StaffName</td>
                    <td class="px-6 py-4 text-sm text-gray-600">@s.BranchName</td>
                    <td class="px-6 py-4 text-sm text-gray-600">@s.Role</td>
                    <td class="px-6 py-4 text-sm text-center">@s.TotalWorkingDays</td>
                    <td class="px-6 py-4 text-sm text-center text-green-600 font-medium">@s.DaysPresent</td>
                    <td class="px-6 py-4 text-sm text-center text-red-600 font-medium">@s.DaysAbsent</td>
                    <td class="px-6 py-4 text-sm text-center text-yellow-600 font-medium">@s.DaysLate</td>
                    <td class="px-6 py-4 text-sm text-center text-orange-600 font-medium">@s.DaysHalfDay</td>
                    <td class="px-6 py-4 text-sm text-center font-bold @pctClass">@s.AttendancePercentage%</td>
                </tr>
            }
        </tbody>
    </table>
</div>
