@model Cafe.Models.ViewModels.AttendanceSummaryViewModel
@{
    ViewData["Title"] = "Attendance Summary";
    var monthName = new DateTime(Model.Year, Model.Month, 1).ToString("MMMM yyyy");
}

<!-- Header -->
<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.5rem; flex-wrap:wrap; gap:1rem;">
    <div>
        <h1 class="page-title" style="margin:0;">Attendance Summary</h1>
        <p class="body-text" style="margin-top:0.25rem;">@monthName</p>
    </div>
    <a asp-action="Index" class="btn btn-secondary"><i class="fas fa-arrow-left" style="margin-right:0.5rem;"></i> Back to Records</a>
</div>

<!-- Filters -->
<div class="card mb-6">
    <div class="card-body">
        <form method="get" style="display:flex; gap:1rem; align-items:flex-end; flex-wrap:wrap;">
            <div class="form-group" style="margin-bottom:0;">
                <label class="form-label">Branch</label>
                <select name="branchId" class="form-select">
                    <option value="">All Branches</option>
                    @foreach (var b in Model.Branches)
                    {
                        <option value="@b.Id" selected="@(Model.BranchId == b.Id)">@b.Name</option>
                    }
                </select>
            </div>
            <div class="form-group" style="margin-bottom:0;">
                <label class="form-label">Year</label>
                <select name="year" class="form-select">
                    @for (int y = DateTime.Now.Year; y >= DateTime.Now.Year - 3; y--)
                    {
                        <option value="@y" selected="@(y == Model.Year)">@y</option>
                    }
                </select>
            </div>
            <div class="form-group" style="margin-bottom:0;">
                <label class="form-label">Month</label>
                <select name="month" class="form-select">
                    @for (int m = 1; m <= 12; m++)
                    {
                        <option value="@m" selected="@(m == Model.Month)">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(m)</option>
                    }
                </select>
            </div>
            <button type="submit" class="btn btn-primary"><i class="fas fa-filter" style="margin-right:0.5rem;"></i> View</button>
        </form>
    </div>
</div>

<!-- Summary Table -->
<div class="card">
    <div class="card-body card-body-flush">
        <div style="overflow-x:auto;">
            <table class="premium-table">
                <thead>
                    <tr>
                        <th>Staff</th>
                        <th>Branch</th>
                        <th>Role</th>
                        <th style="text-align:center;">Working Days</th>
                        <th style="text-align:center;">Present</th>
                        <th style="text-align:center;">Absent</th>
                        <th style="text-align:center;">Late</th>
                        <th style="text-align:center;">Half-Day</th>
                        <th style="text-align:center;">Overtime</th>
                        <th style="text-align:center;">Attendance %</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Summaries.Any())
                    {
                        <tr>
                            <td colspan="10">
                                <div class="empty-state">
                                    <i class="fas fa-chart-bar"></i>
                                    <h3>No summary data available</h3>
                                    <p>No data found for this period.</p>
                                </div>
                            </td>
                        </tr>
                    }
                    @foreach (var s in Model.Summaries)
                    {
                        var pctColor = s.AttendancePercentage >= 90 ? "#16a34a" :
                                       s.AttendancePercentage >= 70 ? "#ca8a04" : "#dc2626";
                        <tr>
                            <td style="font-weight:500;">@s.StaffName</td>
                            <td class="caption">@s.BranchName</td>
                            <td class="caption">@s.Role</td>
                            <td style="text-align:center;">@s.TotalWorkingDays</td>
                            <td style="text-align:center; color:#16a34a; font-weight:600;">@s.DaysPresent</td>
                            <td style="text-align:center; color:#dc2626; font-weight:600;">@s.DaysAbsent</td>
                            <td style="text-align:center; color:#ca8a04; font-weight:600;">@s.DaysLate</td>
                            <td style="text-align:center; color:#ea580c; font-weight:600;">@s.DaysHalfDay</td>
                            <td style="text-align:center; @(s.TotalOvertimeHours > 0 ? "color:var(--accent); font-weight:600;" : "color:var(--text-tertiary);")">@(s.TotalOvertimeHours > 0 ? $"{s.TotalOvertimeHours:F1}h" : "-")</td>
                            <td style="text-align:center; font-weight:700; color:@pctColor;">@s.AttendancePercentage%</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
