@model Cafe.Models.ViewModels.BulkAttendanceViewModel
@{
    ViewData["Title"] = "Bulk Mark Attendance";
}

<!-- Header -->
<div style="display:flex; align-items:center; margin-bottom:1.5rem; gap:1rem;">
    <a asp-action="Index" class="btn btn-ghost btn-sm"><i class="fas fa-arrow-left"></i></a>
    <h1 class="page-title" style="margin:0;">Bulk Mark Attendance</h1>
</div>

<!-- Info Banner -->
<div class="card card-accent mb-6">
    <div class="card-body card-body-compact">
        <p class="caption" style="margin:0;">
            <i class="fas fa-info-circle" style="color:var(--accent); margin-right:0.5rem;"></i>
            Enter clock-in/out for auto-calculation, or select a leave/special status. Leave both times empty + select a status for leave types.
        </p>
    </div>
</div>

<!-- Branch/Date Selector -->
<div class="card mb-6">
    <div class="card-body">
        <form method="get" style="display:flex; gap:1rem; align-items:flex-end; flex-wrap:wrap;">
            <div class="form-group" style="margin-bottom:0;">
                <label class="form-label">Branch</label>
                <select name="branchId" class="form-select">
                    @foreach (var b in (List<Cafe.Models.Branch>)ViewBag.Branches)
                    {
                        <option value="@b.Id" selected="@(b.Id == Model.BranchId)">@b.Name</option>
                    }
                </select>
            </div>
            <div class="form-group" style="margin-bottom:0;">
                <label class="form-label">Date</label>
                <input type="date" name="date" value="@Model.Date.ToString("yyyy-MM-dd")" class="form-control" />
            </div>
            <button type="submit" class="btn btn-secondary"><i class="fas fa-sync" style="margin-right:0.5rem;"></i> Load</button>
        </form>
    </div>
</div>

<!-- Bulk Form -->
<form asp-action="BulkMark" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="BranchId" value="@Model.BranchId" />
    <input type="hidden" name="Date" value="@Model.Date.ToString("yyyy-MM-dd")" />

    <div class="card">
        <div class="card-body card-body-flush">
            <div style="overflow-x:auto;">
                <table class="premium-table">
                    <thead>
                        <tr>
                            <th style="min-width:130px;">Staff</th>
                            <th style="min-width:110px;">Check In</th>
                            <th style="min-width:110px;">Check Out</th>
                            <th style="min-width:170px;">Status Override</th>
                            <th style="min-width:140px;">Remarks</th>
                            <th>State</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.Entries.Count; i++)
                        {
                            var entry = Model.Entries[i];
                            <tr style="@(entry.AlreadyMarked ? "opacity:0.55;" : "")">
                                <td style="font-weight:500;">
                                    @entry.StaffName
                                    <input type="hidden" name="Entries[@i].StaffId" value="@entry.StaffId" />
                                    <input type="hidden" name="Entries[@i].StaffName" value="@entry.StaffName" />
                                    <input type="hidden" name="Entries[@i].AlreadyMarked" value="@entry.AlreadyMarked" />
                                </td>
                                <td>
                                    <input type="time" name="Entries[@i].CheckInTime"
                                           value="@entry.CheckInTime?.ToString(@"hh\:mm")"
                                           class="form-control" style="width:110px;"
                                           @(entry.AlreadyMarked ? "disabled" : "") />
                                </td>
                                <td>
                                    <input type="time" name="Entries[@i].CheckOutTime"
                                           value="@entry.CheckOutTime?.ToString(@"hh\:mm")"
                                           class="form-control" style="width:110px;"
                                           @(entry.AlreadyMarked ? "disabled" : "") />
                                </td>
                                <td>
                                    @if (!entry.AlreadyMarked)
                                    {
                                        <select name="Entries[@i].ManualStatus" class="form-select form-select-sm">
                                            <option value="">Auto (from times)</option>
                                            <optgroup label="Leave (Paid)">
                                                <option value="Paid Leave">Paid Leave</option>
                                                <option value="Holiday">Holiday</option>
                                            </optgroup>
                                            <optgroup label="Leave (Unpaid)">
                                                <option value="Sick Leave">Sick Leave</option>
                                                <option value="Casual Leave">Casual Leave</option>
                                            </optgroup>
                                            <optgroup label="Remote">
                                                <option value="Work From Home">Work From Home</option>
                                            </optgroup>
                                        </select>
                                    }
                                    else
                                    {
                                        <span>—</span>
                                    }
                                </td>
                                <td>
                                    <input type="text" name="Entries[@i].Notes"
                                           value="@entry.Notes"
                                           class="form-control" style="width:140px;"
                                           placeholder="Remarks..."
                                           @(entry.AlreadyMarked ? "disabled" : "") />
                                </td>
                                <td>
                                    @if (entry.AlreadyMarked)
                                    {
                                        var badgeClass = entry.ExistingStatus switch
                                        {
                                            "Present"        => "badge badge-success",
                                            "Late"           => "badge badge-warning",
                                            "Absent"         => "badge badge-danger",
                                            "Half-Day"       => "badge badge-info",
                                            "Work From Home" => "badge badge-info",
                                            _                => "badge badge-neutral"
                                        };
                                        <span class="@badgeClass">@(entry.ExistingStatus ?? entry.Status)</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-warning">Pending</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div style="display:flex; justify-content:flex-end; gap:0.75rem; margin-top:1.5rem;">
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        <button type="submit" class="btn btn-primary"><i class="fas fa-save" style="margin-right:0.5rem;"></i> Save All Attendance</button>
    </div>
</form>
