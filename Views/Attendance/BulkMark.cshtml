@model Cafe.Models.ViewModels.BulkAttendanceViewModel
@{
    ViewData["Title"] = "Bulk Mark Attendance";
}

<div class="flex items-center mb-6">
    <a asp-action="Index" class="text-gray-500 hover:text-gray-700 mr-4">
        <i class="fas fa-arrow-left text-xl"></i>
    </a>
    <h1 class="text-2xl font-bold text-gray-800">Bulk Mark Attendance</h1>
</div>

<!-- Branch/Date Selection -->
<div class="bg-white rounded-lg shadow-md p-6 mb-6">
    <form method="get" class="flex gap-4 items-end">
        <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Branch</label>
            <select name="branchId" class="border rounded-lg px-3 py-2">
                @foreach (var b in (List<Cafe.Models.Branch>)ViewBag.Branches)
                {
                    <option value="@b.Id" selected="@(b.Id == Model.BranchId)">@b.Name</option>
                }
            </select>
        </div>
        <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Date</label>
            <input type="date" name="date" value="@Model.Date.ToString("yyyy-MM-dd")" class="border rounded-lg px-3 py-2" />
        </div>
        <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg">
            <i class="fas fa-sync mr-1"></i> Load
        </button>
    </form>
</div>

<!-- Bulk Form -->
<form asp-action="BulkMark" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="BranchId" value="@Model.BranchId" />
    <input type="hidden" name="Date" value="@Model.Date.ToString("yyyy-MM-dd")" />

    <div class="bg-white rounded-lg shadow-md overflow-hidden">
        <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
                <tr>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Staff</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Check In</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Check Out</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Late (min)</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Notes</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">State</th>
                </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
                @for (int i = 0; i < Model.Entries.Count; i++)
                {
                    var entry = Model.Entries[i];
                    <tr class="@(entry.AlreadyMarked ? "bg-gray-50 opacity-60" : "")">
                        <td class="px-6 py-3 text-sm font-medium text-gray-800">
                            @entry.StaffName
                            <input type="hidden" name="Entries[@i].StaffId" value="@entry.StaffId" />
                            <input type="hidden" name="Entries[@i].StaffName" value="@entry.StaffName" />
                            <input type="hidden" name="Entries[@i].AlreadyMarked" value="@entry.AlreadyMarked" />
                        </td>
                        <td class="px-6 py-3">
                            <select name="Entries[@i].Status" class="border rounded px-2 py-1 text-sm" @(entry.AlreadyMarked ? "disabled" : "")>
                                <option value="Present" selected="@(entry.Status == "Present")">Present</option>
                                <option value="Absent" selected="@(entry.Status == "Absent")">Absent</option>
                                <option value="Late" selected="@(entry.Status == "Late")">Late</option>
                                <option value="Half-Day" selected="@(entry.Status == "Half-Day")">Half-Day</option>
                            </select>
                        </td>
                        <td class="px-6 py-3">
                            <input type="time" name="Entries[@i].CheckInTime" value="@entry.CheckInTime?.ToString(@"hh\:mm")" class="border rounded px-2 py-1 text-sm w-24" @(entry.AlreadyMarked ? "disabled" : "") />
                        </td>
                        <td class="px-6 py-3">
                            <input type="time" name="Entries[@i].CheckOutTime" value="@entry.CheckOutTime?.ToString(@"hh\:mm")" class="border rounded px-2 py-1 text-sm w-24" @(entry.AlreadyMarked ? "disabled" : "") />
                        </td>
                        <td class="px-6 py-3">
                            <input type="number" name="Entries[@i].LateMinutes" value="@entry.LateMinutes" min="0" class="border rounded px-2 py-1 text-sm w-20" @(entry.AlreadyMarked ? "disabled" : "") />
                        </td>
                        <td class="px-6 py-3">
                            <input type="text" name="Entries[@i].Notes" value="@entry.Notes" class="border rounded px-2 py-1 text-sm w-32" placeholder="Notes..." @(entry.AlreadyMarked ? "disabled" : "") />
                        </td>
                        <td class="px-6 py-3">
                            @if (entry.AlreadyMarked)
                            {
                                <span class="px-2 py-1 text-xs font-medium rounded-full bg-green-100 text-green-800">Done</span>
                            }
                            else
                            {
                                <span class="px-2 py-1 text-xs font-medium rounded-full bg-yellow-100 text-yellow-800">Pending</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="mt-6 flex justify-end gap-3">
        <a asp-action="Index" class="px-4 py-2 border rounded-lg text-gray-700 hover:bg-gray-50">Cancel</a>
        <button type="submit" class="bg-green-600 hover:bg-green-700 text-white px-6 py-2 rounded-lg">
            <i class="fas fa-save mr-2"></i> Save All Attendance
        </button>
    </div>
</form>
