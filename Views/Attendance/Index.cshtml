@model Cafe.Models.ViewModels.AttendanceIndexViewModel
@{
    ViewData["Title"] = "Attendance";
    var role = Context.Session.GetString("UserRole");

    string StatusBadge(string s) => s switch
    {
        "Present"        => "badge badge-success",
        "Absent"         => "badge badge-danger",
        "Late"           => "badge badge-warning",
        "Half-Day"       => "badge badge-info",
        "Paid Leave"     => "badge badge-neutral",
        "Sick Leave"     => "badge badge-neutral",
        "Casual Leave"   => "badge badge-neutral",
        "Holiday"        => "badge badge-neutral",
        "Work From Home" => "badge badge-info",
        "Overtime"       => "badge badge-success",
        _                => "badge badge-neutral"
    };

    string StatusIcon(string s) => s switch
    {
        "Present"        => "fa-check-circle",
        "Absent"         => "fa-times-circle",
        "Late"           => "fa-clock",
        "Half-Day"       => "fa-adjust",
        "Paid Leave"     => "fa-umbrella-beach",
        "Sick Leave"     => "fa-kit-medical",
        "Casual Leave"   => "fa-calendar-minus",
        "Holiday"        => "fa-star",
        "Work From Home" => "fa-laptop-house",
        "Overtime"       => "fa-bolt",
        _                => "fa-question-circle"
    };
}

<!-- Page Header -->
<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:2rem; flex-wrap:wrap; gap:1rem;">
    <div>
        <h1 class="page-title" style="margin:0;">Attendance</h1>
        <p class="body-text" style="margin-top:0.25rem;">Track daily attendance, leave management &amp; performance</p>
    </div>
    <div style="display:flex; gap:0.75rem; flex-wrap:wrap;">
        @if (role == "Staff")
        {
            <a asp-action="MarkSelf" class="btn btn-primary"><i class="fas fa-sign-in-alt" style="margin-right:0.5rem;"></i> Clock In</a>
            <a asp-action="ClockOut" class="btn btn-secondary"><i class="fas fa-sign-out-alt" style="margin-right:0.5rem;"></i> Clock Out</a>
        }
        else
        {
            <a asp-action="Mark" class="btn btn-primary"><i class="fas fa-user-check" style="margin-right:0.5rem;"></i> Mark Attendance</a>
            <a asp-action="BulkMark" class="btn btn-secondary"><i class="fas fa-users" style="margin-right:0.5rem;"></i> Bulk Mark</a>
            <a asp-action="Summary" class="btn btn-ghost"><i class="fas fa-chart-bar" style="margin-right:0.5rem;"></i> Summary</a>
        }
    </div>
</div>

<!-- Today's Snapshot (dashboard widget) -->
@if (Model.TodayTotalStaff > 0)
{
    <div class="card card-accent mb-6">
        <div class="card-body">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1rem; flex-wrap:wrap; gap:0.5rem;">
                <h3 style="font-weight:600; margin:0; font-size:0.95rem;">Today's Snapshot — @DateTime.Today.ToString("ddd, dd MMM yyyy")</h3>
                <span class="caption" style="color:var(--text-tertiary);">@Model.TodayTotalStaff total active staff</span>
            </div>
            <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(140px,1fr)); gap:0.75rem;">
                <div style="background:rgba(34,197,94,0.08); border:1px solid rgba(34,197,94,0.2); border-radius:0.625rem; padding:0.875rem; text-align:center;">
                    <i class="fas fa-check-circle" style="color:#16a34a; font-size:1.25rem; margin-bottom:0.3rem;"></i>
                    <div style="font-size:1.5rem; font-weight:700; color:#16a34a;">@Model.TodayCheckedIn</div>
                    <div class="caption">Checked In</div>
                </div>
                <div style="background:rgba(239,68,68,0.08); border:1px solid rgba(239,68,68,0.2); border-radius:0.625rem; padding:0.875rem; text-align:center;">
                    <i class="fas fa-times-circle" style="color:#dc2626; font-size:1.25rem; margin-bottom:0.3rem;"></i>
                    <div style="font-size:1.5rem; font-weight:700; color:#dc2626;">@Model.TodayAbsent</div>
                    <div class="caption">Not Marked</div>
                </div>
                <div style="background:rgba(234,179,8,0.08); border:1px solid rgba(234,179,8,0.2); border-radius:0.625rem; padding:0.875rem; text-align:center;">
                    <i class="fas fa-clock" style="color:#ca8a04; font-size:1.25rem; margin-bottom:0.3rem;"></i>
                    <div style="font-size:1.5rem; font-weight:700; color:#ca8a04;">@Model.TodayLate</div>
                    <div class="caption">Late Today</div>
                </div>
                <div style="background:rgba(147,51,234,0.08); border:1px solid rgba(147,51,234,0.2); border-radius:0.625rem; padding:0.875rem; text-align:center;">
                    <i class="fas fa-umbrella-beach" style="color:#9333ea; font-size:1.25rem; margin-bottom:0.3rem;"></i>
                    <div style="font-size:1.5rem; font-weight:700; color:#9333ea;">@Model.TodayOnLeave</div>
                    <div class="caption">On Leave</div>
                </div>
            </div>
        </div>
    </div>
}

<!-- KPI Summary Cards (filtered results) -->
<div class="mb-6" style="display:grid; grid-template-columns:repeat(auto-fit,minmax(150px,1fr)); gap:1rem;">
    <div class="kpi-card">
        <div class="kpi-icon" style="background:rgba(34,197,94,0.1); color:#16a34a;"><i class="fas fa-check-circle"></i></div>
        <div class="kpi-label">Present</div>
        <div class="kpi-value" style="color:#16a34a;">@Model.TotalPresent</div>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon" style="background:rgba(239,68,68,0.1); color:#dc2626;"><i class="fas fa-times-circle"></i></div>
        <div class="kpi-label">Absent</div>
        <div class="kpi-value" style="color:#dc2626;">@Model.TotalAbsent</div>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon" style="background:rgba(234,179,8,0.1); color:#ca8a04;"><i class="fas fa-clock"></i></div>
        <div class="kpi-label">Late</div>
        <div class="kpi-value" style="color:#ca8a04;">@Model.TotalLate</div>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon" style="background:rgba(249,115,22,0.1); color:#ea580c;"><i class="fas fa-adjust"></i></div>
        <div class="kpi-label">Half-Day</div>
        <div class="kpi-value" style="color:#ea580c;">@Model.TotalHalfDay</div>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon" style="background:rgba(147,51,234,0.1); color:#9333ea;"><i class="fas fa-umbrella-beach"></i></div>
        <div class="kpi-label">Leave</div>
        <div class="kpi-value" style="color:#9333ea;">@(Model.TotalPaidLeave + Model.TotalSickLeave + Model.TotalCasualLeave)</div>
        <p class="caption" style="margin:0; font-size:0.65rem;">PL:@Model.TotalPaidLeave SL:@Model.TotalSickLeave CL:@Model.TotalCasualLeave</p>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon" style="background:rgba(59,130,246,0.1); color:#3b82f6;"><i class="fas fa-laptop-house"></i></div>
        <div class="kpi-label">WFH</div>
        <div class="kpi-value" style="color:#3b82f6;">@Model.TotalWFH</div>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon" style="background:rgba(212,175,55,0.1); color:var(--accent);"><i class="fas fa-bolt"></i></div>
        <div class="kpi-label">Overtime</div>
        <div class="kpi-value" style="color:var(--accent);">@Model.TotalOvertime</div>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon" style="background:rgba(16,185,129,0.1); color:#10b981;"><i class="fas fa-star"></i></div>
        <div class="kpi-label">Holiday</div>
        <div class="kpi-value" style="color:#10b981;">@Model.TotalHoliday</div>
    </div>
</div>

<!-- Filter Card -->
<div class="card mb-6">
    <div class="card-body">
        <form method="get" class="form-row" style="grid-template-columns:repeat(auto-fit,minmax(140px,1fr));">
            <div class="form-group">
                <label class="form-label">Branch</label>
                <select name="branchId" class="form-select">
                    <option value="">All Branches</option>
                    @foreach (var b in Model.Branches)
                    {
                        <option value="@b.Id" selected="@(Model.BranchId == b.Id)">@b.Name</option>
                    }
                </select>
            </div>
            <div class="form-group">
                <label class="form-label">Staff</label>
                <select name="staffId" class="form-select">
                    <option value="">All Staff</option>
                    @foreach (var s in Model.StaffList)
                    {
                        <option value="@s.Id" selected="@(Model.StaffId == s.Id)">@s.User?.Name</option>
                    }
                </select>
            </div>
            <div class="form-group">
                <label class="form-label">From</label>
                <input type="date" name="from" value="@Model.FromDate?.ToString("yyyy-MM-dd")" class="form-control" />
            </div>
            <div class="form-group">
                <label class="form-label">To</label>
                <input type="date" name="to" value="@Model.ToDate?.ToString("yyyy-MM-dd")" class="form-control" />
            </div>
            <div class="form-group">
                <label class="form-label">Status</label>
                <select name="status" class="form-select">
                    <option value="">All Statuses</option>
                    <optgroup label="Core">
                        <option value="Present"  selected="@(Model.Status == "Present")">Present</option>
                        <option value="Absent"   selected="@(Model.Status == "Absent")">Absent</option>
                        <option value="Late"     selected="@(Model.Status == "Late")">Late</option>
                        <option value="Half-Day" selected="@(Model.Status == "Half-Day")">Half-Day</option>
                        <option value="Overtime" selected="@(Model.Status == "Overtime")">Overtime</option>
                    </optgroup>
                    <optgroup label="Leave">
                        <option value="Paid Leave"   selected="@(Model.Status == "Paid Leave")">Paid Leave</option>
                        <option value="Sick Leave"   selected="@(Model.Status == "Sick Leave")">Sick Leave</option>
                        <option value="Casual Leave" selected="@(Model.Status == "Casual Leave")">Casual Leave</option>
                        <option value="Holiday"      selected="@(Model.Status == "Holiday")">Holiday</option>
                    </optgroup>
                    <optgroup label="Remote">
                        <option value="Work From Home" selected="@(Model.Status == "Work From Home")">Work From Home</option>
                    </optgroup>
                </select>
            </div>
            <div class="form-group" style="display:flex; align-items:flex-end;">
                <button type="submit" class="btn btn-primary" style="width:100%;"><i class="fas fa-filter" style="margin-right:0.5rem;"></i> Filter</button>
            </div>
        </form>
    </div>
</div>

<!-- Attendance Table -->
<div class="card">
    <div class="card-body card-body-flush">
        <div style="overflow-x:auto;">
            <table class="premium-table">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Staff</th>
                        <th>Branch</th>
                        <th>Check In</th>
                        <th>Check Out</th>
                        <th>Status</th>
                        <th>Hours</th>
                        <th>Overtime</th>
                        <th>Late (min)</th>
                        <th>Remarks</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Records.Any())
                    {
                        <tr>
                            <td colspan="11">
                                <div class="empty-state">
                                    <i class="fas fa-calendar-times"></i>
                                    <h3>No attendance records found</h3>
                                    <p>Try adjusting your filters or mark attendance first.</p>
                                </div>
                            </td>
                        </tr>
                    }
                    @foreach (var r in Model.Records)
                    {
                        <tr>
                            <td style="font-weight:500;">@r.Date.ToString("dd MMM yyyy")</td>
                            <td>
                                <div style="font-weight:500;">@r.Staff?.User?.Name</div>
                                <div class="caption">@r.Staff?.StaffRole?.RoleName</div>
                            </td>
                            <td class="caption">@r.Branch?.Name</td>
                            <td>@(r.CheckInTime.HasValue ? r.CheckInTime.Value.ToString(@"hh\:mm") : "—")</td>
                            <td>@(r.CheckOutTime.HasValue ? r.CheckOutTime.Value.ToString(@"hh\:mm") : "—")</td>
                            <td>
                                <span class="@StatusBadge(r.Status)">
                                    <i class="fas @StatusIcon(r.Status)" style="margin-right:0.25rem;"></i>@r.Status
                                </span>
                            </td>
                            <td>@(r.TotalHours > 0 ? $"{r.TotalHours:F1}h" : "—")</td>
                            <td style="@(r.OvertimeHours > 0 ? "color:var(--accent); font-weight:600;" : "")">
                                @(r.OvertimeHours > 0 ? $"{r.OvertimeHours:F1}h" : "—")
                            </td>
                            <td>
                                @if (r.LateMinutes > 0)
                                {
                                    <span style="color:#ca8a04; font-weight:600;">@r.LateMinutes min</span>
                                }
                                else { <span>—</span> }
                            </td>
                            <td class="caption" style="max-width:120px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;" title="@r.Notes">
                                @(r.Notes ?? "—")
                            </td>
                            <td>
                                @if (role != "Staff")
                                {
                                    <a asp-action="Edit" asp-route-id="@r.Id" class="btn btn-ghost btn-sm" title="Edit">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Pagination -->
@{
    var currentPage = (int)(ViewBag.CurrentPage ?? Model.CurrentPage);
    var totalPages = (int)(ViewBag.TotalPages ?? Model.TotalPages);
    var totalRecords = (int)(ViewBag.TotalRecords ?? Model.TotalItems);
    var pageSize = (int)(ViewBag.PageSize ?? Model.PageSize);
}
@if (totalPages > 1)
{
    <div style="display:flex;justify-content:space-between;align-items:center;margin-top:1.5rem;flex-wrap:wrap;gap:0.75rem;">
        <p class="caption">Showing @(Math.Min((currentPage-1)*pageSize+1, totalRecords))–@(Math.Min(currentPage*pageSize, totalRecords)) of @totalRecords records</p>
        <div style="display:flex;gap:0.4rem;flex-wrap:wrap;">
            @if (currentPage > 1)
            {
                <a asp-action="Index" asp-route-page="@(currentPage - 1)" class="btn btn-ghost btn-sm"><i class="fas fa-chevron-left"></i></a>
            }
            @for (int pg = Math.Max(1, currentPage - 2); pg <= Math.Min(totalPages, currentPage + 2); pg++)
            {
                <a asp-action="Index" asp-route-page="@pg" class="btn btn-sm @(pg == currentPage ? "btn-primary" : "btn-ghost")">@pg</a>
            }
            @if (currentPage < totalPages)
            {
                <a asp-action="Index" asp-route-page="@(currentPage + 1)" class="btn btn-ghost btn-sm"><i class="fas fa-chevron-right"></i></a>
            }
        </div>
    </div>
}

<!-- Quick Actions -->
<div class="card card-dark mt-8">
    <div class="card-body">
        <h3 style="color:#fff; font-weight:600; margin-bottom:1rem;">Quick Actions</h3>
        <div style="display:flex; flex-wrap:wrap; gap:0.75rem;">
            <a asp-action="Summary" class="btn btn-primary"><i class="fas fa-chart-bar" style="margin-right:0.5rem;"></i> Monthly Summary</a>
            <a asp-action="ExportCsv"
               asp-route-branchId="@Model.BranchId"
               asp-route-staffId="@Model.StaffId"
               asp-route-from="@Model.FromDate?.ToString("yyyy-MM-dd")"
               asp-route-to="@Model.ToDate?.ToString("yyyy-MM-dd")"
               asp-route-status="@Model.Status"
               class="btn btn-secondary"><i class="fas fa-download" style="margin-right:0.5rem;"></i> Export CSV</a>
        </div>
    </div>
</div>
