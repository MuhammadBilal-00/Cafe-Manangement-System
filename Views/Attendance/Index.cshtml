@model Cafe.Models.ViewModels.AttendanceIndexViewModel
@{
    ViewData["Title"] = "Attendance";
    var role = Context.Session.GetString("UserRole");
}

<!-- Page Header -->
<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:2rem; flex-wrap:wrap; gap:1rem;">
    <div>
        <h1 class="page-title" style="margin:0;">Attendance</h1>
        <p class="body-text" style="margin-top:0.25rem;">Track daily attendance, clock-ins & performance</p>
    </div>
    <div style="display:flex; gap:0.75rem; flex-wrap:wrap;">
        @if (role == "Staff")
        {
            <a asp-action="MarkSelf" class="btn btn-primary"><i class="fas fa-sign-in-alt" style="margin-right:0.5rem;"></i> Clock In</a>
            <a asp-action="ClockOut" class="btn btn-secondary"><i class="fas fa-sign-out-alt" style="margin-right:0.5rem;"></i> Clock Out</a>
        }
        else
        {
            <a asp-action="Mark" class="btn btn-primary"><i class="fas fa-user-check" style="margin-right:0.5rem;"></i> Mark Attendance</a>
            <a asp-action="BulkMark" class="btn btn-secondary"><i class="fas fa-users" style="margin-right:0.5rem;"></i> Bulk Mark</a>
        }
    </div>
</div>

<!-- KPI Cards -->
<div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(200px,1fr)); gap:1.25rem; margin-bottom:2rem;">
    <div class="kpi-card">
        <div class="kpi-icon" style="background:rgba(34,197,94,0.1); color:#16a34a;"><i class="fas fa-check-circle"></i></div>
        <div class="kpi-label">Present</div>
        <div class="kpi-value" style="color:#16a34a;">@Model.TotalPresent</div>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon" style="background:rgba(239,68,68,0.1); color:#dc2626;"><i class="fas fa-times-circle"></i></div>
        <div class="kpi-label">Absent</div>
        <div class="kpi-value" style="color:#dc2626;">@Model.TotalAbsent</div>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon" style="background:rgba(234,179,8,0.1); color:#ca8a04;"><i class="fas fa-clock"></i></div>
        <div class="kpi-label">Late</div>
        <div class="kpi-value" style="color:#ca8a04;">@Model.TotalLate</div>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon" style="background:rgba(249,115,22,0.1); color:#ea580c;"><i class="fas fa-adjust"></i></div>
        <div class="kpi-label">Half-Day</div>
        <div class="kpi-value" style="color:#ea580c;">@Model.TotalHalfDay</div>
    </div>
</div>

<!-- Filter Card -->
<div class="card" style="margin-bottom:1.5rem;">
    <div class="card-body">
        <form method="get" class="form-row" style="grid-template-columns:repeat(auto-fit,minmax(160px,1fr));">
            <div class="form-group">
                <label class="form-label">Branch</label>
                <select name="branchId" class="form-select">
                    <option value="">All Branches</option>
                    @foreach (var b in Model.Branches)
                    {
                        <option value="@b.Id" selected="@(Model.BranchId == b.Id)">@b.Name</option>
                    }
                </select>
            </div>
            <div class="form-group">
                <label class="form-label">Staff</label>
                <select name="staffId" class="form-select">
                    <option value="">All Staff</option>
                    @foreach (var s in Model.StaffList)
                    {
                        <option value="@s.Id" selected="@(Model.StaffId == s.Id)">@s.User?.Name</option>
                    }
                </select>
            </div>
            <div class="form-group">
                <label class="form-label">From</label>
                <input type="date" name="from" value="@Model.FromDate?.ToString("yyyy-MM-dd")" class="form-control" />
            </div>
            <div class="form-group">
                <label class="form-label">To</label>
                <input type="date" name="to" value="@Model.ToDate?.ToString("yyyy-MM-dd")" class="form-control" />
            </div>
            <div class="form-group">
                <label class="form-label">Status</label>
                <select name="status" class="form-select">
                    <option value="">All</option>
                    <option value="Present" selected="@(Model.Status == "Present")">Present</option>
                    <option value="Absent" selected="@(Model.Status == "Absent")">Absent</option>
                    <option value="Late" selected="@(Model.Status == "Late")">Late</option>
                    <option value="Half-Day" selected="@(Model.Status == "Half-Day")">Half-Day</option>
                </select>
            </div>
            <div class="form-group" style="display:flex; align-items:flex-end;">
                <button type="submit" class="btn btn-primary" style="width:100%;"><i class="fas fa-filter" style="margin-right:0.5rem;"></i> Filter</button>
            </div>
        </form>
    </div>
</div>

<!-- Attendance Table -->
<div class="card">
    <div class="card-body" style="padding:0;">
        <div style="overflow-x:auto;">
            <table class="premium-table">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Staff</th>
                        <th>Branch</th>
                        <th>Check In</th>
                        <th>Check Out</th>
                        <th>Status</th>
                        <th>Hours</th>
                        <th>Overtime</th>
                        <th>Late (min)</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Records.Any())
                    {
                        <tr>
                            <td colspan="10">
                                <div class="empty-state">
                                    <i class="fas fa-calendar-times"></i>
                                    <h3>No attendance records found</h3>
                                    <p>Try adjusting your filters or mark attendance first.</p>
                                </div>
                            </td>
                        </tr>
                    }
                    @foreach (var r in Model.Records)
                    {
                        var badgeClass = r.Status switch
                        {
                            "Present" => "badge badge-success",
                            "Absent" => "badge badge-danger",
                            "Late" => "badge badge-warning",
                            "Half-Day" => "badge badge-info",
                            _ => "badge badge-neutral"
                        };
                        <tr>
                            <td style="font-weight:500;">@r.Date.ToString("dd MMM yyyy")</td>
                            <td>@r.Staff?.User?.Name</td>
                            <td class="caption">@r.Branch?.Name</td>
                            <td>@(r.CheckInTime?.ToString(@"hh\:mm") ?? "<span class='caption'>-</span>")</td>
                            <td>@(r.CheckOutTime?.ToString(@"hh\:mm") ?? "<span class='caption'>-</span>")</td>
                            <td><span class="@badgeClass">@r.Status</span></td>
                            <td>@(r.TotalHours > 0 ? $"{r.TotalHours:F1}h" : "-")</td>
                            <td style="@(r.OvertimeHours > 0 ? "color:var(--accent); font-weight:600;" : "")">@(r.OvertimeHours > 0 ? $"{r.OvertimeHours:F1}h" : "-")</td>
                            <td>@(r.LateMinutes > 0 ? r.LateMinutes.ToString() : "-")</td>
                            <td>
                                @if (role != "Staff")
                                {
                                    <a asp-action="Edit" asp-route-id="@r.Id" class="btn btn-ghost btn-sm" title="Edit">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Pagination -->
@if (Model.TotalPages > 1)
{
    <div style="display:flex; justify-content:center; align-items:center; margin-top:1.5rem; gap:0.5rem;">
        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <a asp-action="Index"
               asp-route-page="@i"
               asp-route-branchId="@Model.BranchId"
               asp-route-staffId="@Model.StaffId"
               asp-route-from="@Model.FromDate?.ToString("yyyy-MM-dd")"
               asp-route-to="@Model.ToDate?.ToString("yyyy-MM-dd")"
               asp-route-status="@Model.Status"
               class="btn @(i == Model.CurrentPage ? "btn-primary" : "btn-secondary") btn-sm">
                @i
            </a>
        }
    </div>
}

<!-- Quick Actions -->
<div class="card" style="margin-top:2rem; background:var(--sidebar-bg); border:none;">
    <div class="card-body">
        <h3 style="color:#fff; font-weight:600; margin-bottom:1rem;">Quick Actions</h3>
        <div style="display:flex; flex-wrap:wrap; gap:0.75rem;">
            <a asp-action="Summary" class="btn btn-primary"><i class="fas fa-chart-bar" style="margin-right:0.5rem;"></i> Monthly Summary</a>
            <a asp-action="ExportCsv"
               asp-route-branchId="@Model.BranchId"
               asp-route-staffId="@Model.StaffId"
               asp-route-from="@Model.FromDate?.ToString("yyyy-MM-dd")"
               asp-route-to="@Model.ToDate?.ToString("yyyy-MM-dd")"
               asp-route-status="@Model.Status"
               class="btn btn-secondary"><i class="fas fa-download" style="margin-right:0.5rem;"></i> Export Data</a>
        </div>
    </div>
</div>
