@model Cafe.Models.ViewModels.AttendanceIndexViewModel
@{
    ViewData["Title"] = "Attendance";
}

<div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-bold text-gray-800">Attendance Management</h1>
    <div class="flex gap-2">
        @if (Context.Session.GetString("UserRole") == "Staff")
        {
            <a asp-action="MarkSelf" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg transition duration-200 flex items-center">
                <i class="fas fa-sign-in-alt mr-2"></i> Clock In
            </a>
            <a asp-action="ClockOut" class="bg-orange-600 hover:bg-orange-700 text-white px-4 py-2 rounded-lg transition duration-200 flex items-center">
                <i class="fas fa-sign-out-alt mr-2"></i> Clock Out
            </a>
        }
        @if (Context.Session.GetString("UserRole") != "Staff")
        {
            <a asp-action="Mark" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg transition duration-200 flex items-center">
                <i class="fas fa-plus mr-2"></i> Mark Attendance
            </a>
            <a asp-action="BulkMark" class="bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-lg transition duration-200 flex items-center">
                <i class="fas fa-users mr-2"></i> Bulk Mark
            </a>
        }
    </div>
</div>

<!-- Stats Cards -->
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
    <div class="bg-white rounded-lg shadow-md p-6 border-l-4 border-green-500">
        <div class="flex items-center">
            <div class="p-3 rounded-lg bg-green-100 text-green-600 mr-4">
                <i class="fas fa-check-circle text-xl"></i>
            </div>
            <div>
                <p class="text-sm text-gray-600">Present</p>
                <p class="text-2xl font-bold text-gray-800">@Model.TotalPresent</p>
            </div>
        </div>
    </div>
    <div class="bg-white rounded-lg shadow-md p-6 border-l-4 border-red-500">
        <div class="flex items-center">
            <div class="p-3 rounded-lg bg-red-100 text-red-600 mr-4">
                <i class="fas fa-times-circle text-xl"></i>
            </div>
            <div>
                <p class="text-sm text-gray-600">Absent</p>
                <p class="text-2xl font-bold text-gray-800">@Model.TotalAbsent</p>
            </div>
        </div>
    </div>
    <div class="bg-white rounded-lg shadow-md p-6 border-l-4 border-yellow-500">
        <div class="flex items-center">
            <div class="p-3 rounded-lg bg-yellow-100 text-yellow-600 mr-4">
                <i class="fas fa-clock text-xl"></i>
            </div>
            <div>
                <p class="text-sm text-gray-600">Late</p>
                <p class="text-2xl font-bold text-gray-800">@Model.TotalLate</p>
            </div>
        </div>
    </div>
    <div class="bg-white rounded-lg shadow-md p-6 border-l-4 border-orange-500">
        <div class="flex items-center">
            <div class="p-3 rounded-lg bg-orange-100 text-orange-600 mr-4">
                <i class="fas fa-adjust text-xl"></i>
            </div>
            <div>
                <p class="text-sm text-gray-600">Half-Day</p>
                <p class="text-2xl font-bold text-gray-800">@Model.TotalHalfDay</p>
            </div>
        </div>
    </div>
</div>

<!-- Filters -->
<div class="bg-white rounded-lg shadow-md p-6 mb-6">
    <form method="get" class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-6 gap-4">
        <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Branch</label>
            <select name="branchId" class="w-full border rounded-lg px-3 py-2 text-sm">
                <option value="">All Branches</option>
                @foreach (var b in Model.Branches)
                {
                    <option value="@b.Id" selected="@(Model.BranchId == b.Id)">@b.Name</option>
                }
            </select>
        </div>
        <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Staff</label>
            <select name="staffId" class="w-full border rounded-lg px-3 py-2 text-sm">
                <option value="">All Staff</option>
                @foreach (var s in Model.StaffList)
                {
                    <option value="@s.Id" selected="@(Model.StaffId == s.Id)">@s.User?.Name</option>
                }
            </select>
        </div>
        <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">From</label>
            <input type="date" name="from" value="@Model.FromDate?.ToString("yyyy-MM-dd")" class="w-full border rounded-lg px-3 py-2 text-sm" />
        </div>
        <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">To</label>
            <input type="date" name="to" value="@Model.ToDate?.ToString("yyyy-MM-dd")" class="w-full border rounded-lg px-3 py-2 text-sm" />
        </div>
        <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Status</label>
            <select name="status" class="w-full border rounded-lg px-3 py-2 text-sm">
                <option value="">All</option>
                <option value="Present" selected="@(Model.Status == "Present")">Present</option>
                <option value="Absent" selected="@(Model.Status == "Absent")">Absent</option>
                <option value="Late" selected="@(Model.Status == "Late")">Late</option>
                <option value="Half-Day" selected="@(Model.Status == "Half-Day")">Half-Day</option>
            </select>
        </div>
        <div class="flex items-end">
            <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg w-full text-sm">
                <i class="fas fa-filter mr-1"></i> Filter
            </button>
        </div>
    </form>
</div>

<!-- Attendance Table -->
<div class="bg-white rounded-lg shadow-md overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
            <tr>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Date</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Staff</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Branch</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Check In</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Check Out</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Hours</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Overtime</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Late (min)</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Actions</th>
            </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
            @if (!Model.Records.Any())
            {
                <tr>
                    <td colspan="10" class="px-6 py-12 text-center text-gray-500">
                        <i class="fas fa-calendar-times text-4xl mb-3 block"></i>
                        No attendance records found.
                    </td>
                </tr>
            }
            @foreach (var r in Model.Records)
            {
                <tr class="hover:bg-gray-50">
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-800">@r.Date.ToString("dd MMM yyyy")</td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-800">@r.Staff?.User?.Name</td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600">@r.Branch?.Name</td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600">@(r.CheckInTime?.ToString(@"hh\:mm") ?? "-")</td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600">@(r.CheckOutTime?.ToString(@"hh\:mm") ?? "-")</td>
                    <td class="px-6 py-4 whitespace-nowrap">
                        @{
                            var badgeClass = r.Status switch
                            {
                                "Present" => "bg-green-100 text-green-800",
                                "Absent" => "bg-red-100 text-red-800",
                                "Late" => "bg-yellow-100 text-yellow-800",
                                "Half-Day" => "bg-orange-100 text-orange-800",
                                _ => "bg-gray-100 text-gray-800"
                            };
                        }
                        <span class="px-2 py-1 text-xs font-medium rounded-full @badgeClass">@r.Status</span>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600">@(r.TotalHours > 0 ? $"{r.TotalHours:F1}h" : "-")</td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm @(r.OvertimeHours > 0 ? "text-blue-600 font-medium" : "text-gray-600")">@(r.OvertimeHours > 0 ? $"{r.OvertimeHours:F1}h" : "-")</td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600">@(r.LateMinutes > 0 ? r.LateMinutes.ToString() : "-")</td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm">
                        @if (Context.Session.GetString("UserRole") != "Staff")
                        {
                            <a asp-action="Edit" asp-route-id="@r.Id" class="text-blue-600 hover:text-blue-800 mr-3">
                                <i class="fas fa-edit"></i>
                            </a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Pagination -->
@if (Model.TotalPages > 1)
{
    <div class="flex justify-center items-center mt-6 gap-2">
        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <a asp-action="Index"
               asp-route-page="@i"
               asp-route-branchId="@Model.BranchId"
               asp-route-staffId="@Model.StaffId"
               asp-route-from="@Model.FromDate?.ToString("yyyy-MM-dd")"
               asp-route-to="@Model.ToDate?.ToString("yyyy-MM-dd")"
               asp-route-status="@Model.Status"
               class="px-3 py-1 rounded @(i == Model.CurrentPage ? "bg-blue-600 text-white" : "bg-gray-200 text-gray-700 hover:bg-gray-300")">
                @i
            </a>
        }
    </div>
}

<!-- Quick Actions -->
<div class="mt-8 bg-blue-50 rounded-lg p-6">
    <h3 class="text-lg font-medium text-blue-800 mb-4">Quick Actions</h3>
    <div class="flex flex-wrap gap-4">
        <a asp-action="Summary" class="bg-purple-600 hover:bg-purple-700 text-white px-4 py-2 rounded-lg transition duration-200 flex items-center">
            <i class="fas fa-chart-bar mr-2"></i> Monthly Summary
        </a>
        <a asp-action="ExportCsv"
           asp-route-branchId="@Model.BranchId"
           asp-route-staffId="@Model.StaffId"
           asp-route-from="@Model.FromDate?.ToString("yyyy-MM-dd")"
           asp-route-to="@Model.ToDate?.ToString("yyyy-MM-dd")"
           asp-route-status="@Model.Status"
           class="bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded-lg transition duration-200 flex items-center">
            <i class="fas fa-download mr-2"></i> Export Data
        </a>
    </div>
</div>
