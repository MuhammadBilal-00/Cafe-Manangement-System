@model Cafe.Models.ViewModels.AttendanceMarkViewModel
@{
    ViewData["Title"] = "Mark Attendance";
}

<div class="max-w-[720px] mx-auto">
    <!-- Header -->
    <div style="display:flex; align-items:center; margin-bottom:1.5rem; gap:1rem;">
        <a asp-action="Index" class="btn btn-ghost btn-sm"><i class="fas fa-arrow-left"></i></a>
        <h1 class="page-title" style="margin:0;">Mark Attendance</h1>
    </div>

    <!-- Info Banner -->
    <div class="card card-accent mb-6">
        <div class="card-body card-body-compact">
            <p class="caption" style="margin:0;">
                <i class="fas fa-info-circle" style="color:var(--accent); margin-right:0.5rem;"></i>
                Status is <strong>automatically calculated</strong> from check-in/check-out times:
                <strong>Present</strong> (8+h), <strong>Half-Day</strong> (4-8h), <strong>Absent</strong> (&lt;4h or no times).
                Late if check-in &gt; shift start + 15 min.
            </p>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <form asp-action="Mark" method="post">
                @Html.AntiForgeryToken()

                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Staff Member *</label>
                        <select name="StaffId" class="form-select" required>
                            <option value="">Select Staff</option>
                            @foreach (var s in (List<Cafe.Models.Staff>)ViewBag.StaffList)
                            {
                                <option value="@s.Id" selected="@(s.Id == Model.StaffId)">@s.User?.Name</option>
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Date *</label>
                        <input type="date" name="Date" value="@Model.Date.ToString("yyyy-MM-dd")" class="form-control" required />
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Check In Time</label>
                        <input type="time" name="CheckInTime" value="@Model.CheckInTime?.ToString(@"hh\:mm")" class="form-control" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Check Out Time</label>
                        <input type="time" name="CheckOutTime" value="@Model.CheckOutTime?.ToString(@"hh\:mm")" class="form-control" />
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label">Notes</label>
                    <textarea name="Notes" rows="3" class="form-control" placeholder="Optional notes...">@Model.Notes</textarea>
                </div>

                <p class="caption" style="margin-top:0.5rem;">
                    <i class="fas fa-lightbulb" style="color:var(--accent); margin-right:0.25rem;"></i>
                    Leave both times empty to mark as Absent. Provide only Check In for a clock-in record.
                </p>

                <div class="divider"></div>

                <div style="display:flex; justify-content:flex-end; gap:0.75rem;">
                    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary"><i class="fas fa-check" style="margin-right:0.5rem;"></i> Mark Attendance</button>
                </div>
            </form>
        </div>
    </div>
</div>
