@model Cafe.Models.ViewModels.AttendanceMarkViewModel
@{
    ViewData["Title"] = "Mark Attendance";
}

<div class="max-w-[760px] mx-auto">
    <!-- Header -->
    <div style="display:flex; align-items:center; margin-bottom:1.5rem; gap:1rem;">
        <a asp-action="Index" class="btn btn-ghost btn-sm"><i class="fas fa-arrow-left"></i></a>
        <h1 class="page-title" style="margin:0;">Mark Attendance</h1>
    </div>

    <div class="card">
        <div class="card-body">
            <form asp-action="Mark" method="post" id="markForm">
                @Html.AntiForgeryToken()

                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Staff Member *</label>
                        <select name="StaffId" class="form-select" required>
                            <option value="">Select Staff</option>
                            @foreach (var s in (List<Cafe.Models.Staff>)ViewBag.StaffList)
                            {
                                <option value="@s.Id" selected="@(s.Id == Model.StaffId)">@s.User?.Name</option>
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Date *</label>
                        <input type="date" name="Date" value="@Model.Date.ToString("yyyy-MM-dd")" class="form-control" required />
                    </div>
                </div>

                <!-- Status Mode Toggle -->
                <div class="form-group">
                    <label class="form-label">Attendance Type</label>
                    <div style="display:grid; grid-template-columns:1fr 1fr; gap:0.75rem;">
                        <label id="lbl-auto" style="cursor:pointer; border:2px solid var(--accent); border-radius:0.5rem; padding:0.75rem 1rem; display:flex; align-items:flex-start; gap:0.75rem; background:rgba(212,175,55,0.05);">
                            <input type="radio" name="_statusMode" value="auto" checked onchange="toggleStatusMode(this)" style="margin-top:0.2rem; accent-color:var(--accent);" />
                            <span>
                                <i class="fas fa-magic" style="color:var(--accent);"></i>
                                <strong style="display:block; font-size:0.85rem; margin-bottom:0.15rem;">Auto-Calculate</strong>
                                <span class="caption">Status derived from clock-in/out times</span>
                            </span>
                        </label>
                        <label id="lbl-manual" style="cursor:pointer; border:2px solid var(--border-light); border-radius:0.5rem; padding:0.75rem 1rem; display:flex; align-items:flex-start; gap:0.75rem;">
                            <input type="radio" name="_statusMode" value="manual" onchange="toggleStatusMode(this)" style="margin-top:0.2rem; accent-color:var(--accent);" />
                            <span>
                                <i class="fas fa-hand-pointer" style="color:#9333ea;"></i>
                                <strong style="display:block; font-size:0.85rem; margin-bottom:0.15rem;">Manual Override</strong>
                                <span class="caption">Leave, Holiday, WFH etc.</span>
                            </span>
                        </label>
                    </div>
                </div>

                <!-- Auto-calculate panel -->
                <div id="panel-auto">
                    <div class="card card-accent mb-4">
                        <div class="card-body card-body-compact">
                            <p class="caption" style="margin:0;">
                                <i class="fas fa-info-circle" style="color:var(--accent); margin-right:0.5rem;"></i>
                                <strong>Present</strong> (8+h) &bull; <strong>Late</strong> (check-in &gt;15 min after shift) &bull;
                                <strong>Half-Day</strong> (4-8h) &bull; <strong>Absent</strong> (&lt;4h or no times)
                            </p>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label">Check-In Time</label>
                            <input type="time" name="CheckInTime" id="autoCheckIn" value="@Model.CheckInTime?.ToString(@"hh\:mm")" class="form-control" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Check-Out Time</label>
                            <input type="time" name="CheckOutTime" id="autoCheckOut" value="@Model.CheckOutTime?.ToString(@"hh\:mm")" class="form-control" />
                        </div>
                    </div>
                </div>

                <!-- Manual status panel -->
                <div id="panel-manual" style="display:none;">
                    <div class="form-group">
                        <label class="form-label">Select Status *</label>
                        <select name="ManualStatus" id="manualStatusSelect" class="form-select">
                            <option value="">-- Choose a status --</option>
                            <optgroup label="Leave (Paid - no salary deduction)">
                                <option value="Paid Leave">Paid Leave</option>
                                <option value="Holiday">Holiday (public / company)</option>
                            </optgroup>
                            <optgroup label="Leave (Unpaid - deducted from salary)">
                                <option value="Sick Leave">Sick Leave</option>
                                <option value="Casual Leave">Casual Leave</option>
                            </optgroup>
                            <optgroup label="Remote / Extended">
                                <option value="Work From Home">Work From Home</option>
                            </optgroup>
                        </select>
                        <p class="caption" style="margin-top:0.4rem; color:var(--text-tertiary);">
                            Paid Leave &amp; Holiday are NOT deducted from salary. Sick &amp; Casual Leave are deducted at the absence rate.
                        </p>
                    </div>
                    <div id="wfhTimes" style="display:none;">
                        <div class="form-row">
                            <div class="form-group">
                                <label class="form-label">Check-In Time (WFH)</label>
                                <input type="time" name="CheckInTime" class="form-control" />
                            </div>
                            <div class="form-group">
                                <label class="form-label">Check-Out Time (WFH)</label>
                                <input type="time" name="CheckOutTime" class="form-control" />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label">Remarks</label>
                    <textarea name="Notes" rows="2" class="form-control" placeholder="Optional remarks or reason for leave...">@Model.Notes</textarea>
                </div>

                <div class="divider"></div>

                <div style="display:flex; justify-content:flex-end; gap:0.75rem;">
                    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary"><i class="fas fa-check" style="margin-right:0.5rem;"></i> Mark Attendance</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function toggleStatusMode(radio) {
        const isManual = radio.value === 'manual';
        document.getElementById('panel-auto').style.display   = isManual ? 'none' : '';
        document.getElementById('panel-manual').style.display = isManual ? ''     : 'none';
        document.getElementById('lbl-auto').style.borderColor   = isManual ? 'var(--border-light)' : 'var(--accent)';
        document.getElementById('lbl-manual').style.borderColor = isManual ? 'var(--accent)'       : 'var(--border-light)';
        document.getElementById('lbl-auto').style.background    = isManual ? '' : 'rgba(212,175,55,0.05)';
        document.getElementById('lbl-manual').style.background  = isManual ? 'rgba(147,51,234,0.05)' : '';
        if (isManual) {
            document.getElementById('autoCheckIn').value  = '';
            document.getElementById('autoCheckOut').value = '';
        }
    }

    document.getElementById('manualStatusSelect')?.addEventListener('change', function () {
        document.getElementById('wfhTimes').style.display = this.value === 'Work From Home' ? '' : 'none';
    });
</script>
