@model List<Cafe.Models.SellReturn>
@{
    ViewData["Title"] = "Sell Returns";
    var branches = ViewBag.Branches as List<Cafe.Models.Branch> ?? new();
    (string, string) Badge(string s) => s switch { "Approved" => ("badge-success", s), "Rejected" => ("badge-danger", s), _ => ("badge-warning", s) };
}
<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1.5rem;flex-wrap:wrap;gap:1rem;">
    <div><h1 class="page-title" style="margin:0;">Sell Returns</h1><p class="body-text" style="margin-top:0.25rem;">Customer returns. Approving restocks the goods and credits the customer.</p></div>
    <button class="btn btn-primary" onclick="srNew()"><i class="fas fa-plus" style="margin-right:0.5rem;"></i> New Return</button>
</div>
<div class="card"><div class="card-body card-body-flush"><div style="overflow-x:auto;">
    <table class="premium-table">
        <thead><tr><th>Number</th><th>Branch</th><th style="text-align:center;">Lines</th><th style="text-align:right;">Credit</th><th>Reason</th><th style="text-align:center;">Status</th><th>Actions</th></tr></thead>
        <tbody>
            @if (!Model.Any()) { <tr><td colspan="7" style="text-align:center;padding:3rem;color:var(--text-secondary);">No sell returns yet.</td></tr> }
            @foreach (var r in Model)
            {
                var b = Badge(r.Status);
                <tr>
                    <td style="font-weight:600;">@r.ReturnNumber</td><td>@r.Branch?.Name</td><td style="text-align:center;">@r.Lines.Count</td>
                    <td style="text-align:right;">Rs. @r.TotalAmount.ToString("N0")</td><td><span class="caption">@r.Reason</span></td>
                    <td style="text-align:center;"><span class="badge @b.Item1">@b.Item2</span></td>
                    <td>@if (r.Status == "Pending"){<div style="display:flex;gap:0.4rem;"><button class="btn btn-primary btn-sm" onclick="srApprove(@r.Id)">Approve</button><button class="btn btn-ghost btn-sm" style="color:var(--danger);" onclick="srReject(@r.Id)">Reject</button></div>}</td>
                </tr>
            }
        </tbody>
    </table>
</div></div></div>
<div id="srModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:9999;align-items:center;justify-content:center;padding:1rem;">
    <div class="card" style="max-width:560px;width:100%;max-height:90vh;overflow:auto;"><div class="card-body">
        <h3 style="margin:0 0 1rem;">New Sell Return</h3>
        <div class="form-row">
            <div class="form-group"><label class="form-label">Branch</label><select id="srBranch" class="form-select" onchange="srLoad()">@foreach (var b in branches){<option value="@b.Id">@b.Name</option>}</select></div>
            <div class="form-group"><label class="form-label">Reason</label><input id="srReason" class="form-control" placeholder="e.g. wrong item" /></div>
        </div>
        <label class="form-label">Returned items (restocked)</label>
        <div style="display:flex;gap:0.4rem;margin-bottom:0.5rem;">
            <select id="srItem" class="form-select" style="flex:1;"></select>
            <input id="srQty" type="number" min="0.01" step="0.01" value="1" class="form-control" style="width:80px;" title="qty">
            <input id="srVal" type="number" min="0" step="0.01" value="0" class="form-control" style="width:100px;" title="credit/unit">
            <button class="btn btn-secondary" onclick="srAdd()">Add</button>
        </div>
        <div id="srLines" style="margin-bottom:0.5rem;"></div>
        <div class="caption" id="srTot" style="margin-bottom:0.75rem;"></div>
        <div style="display:flex;gap:0.5rem;"><button class="btn btn-primary" onclick="srSave()">Create</button><button class="btn btn-secondary" onclick="document.getElementById('srModal').style.display='none'">Cancel</button></div>
    </div></div>
</div>
@section Scripts {
<script>
const _tok = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
const post = (u, b) => fetch(u, { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': _tok }, body: b }).then(r => r.json());
let items = [], lines = [];
const money = v => 'Rs. ' + Math.round(v).toLocaleString();
async function srLoad() { items = await fetch('/SellReturn/GetItems?branchId=' + document.getElementById('srBranch').value).then(r => r.json()); document.getElementById('srItem').innerHTML = items.map(i => `<option value="${i.id}" data-cost="${i.cost}">${i.name} (${i.unit})</option>`).join(''); }
document.addEventListener('change', e => { if (e.target.id === 'srItem') document.getElementById('srVal').value = e.target.selectedOptions[0].dataset.cost; });
function render() { const m = Object.fromEntries(items.map(i => [i.id, i])); document.getElementById('srLines').innerHTML = lines.map((l, x) => `<div style="display:flex;justify-content:space-between;padding:0.3rem 0;border-bottom:1px solid var(--border-light);"><span>${l.quantity}× ${m[l.inventoryItemId]?.name} @@ ${money(l.unitValue)}</span><a href="javascript:void(0)" onclick="srDel(${x})" style="color:var(--danger);">×</a></div>`).join(''); document.getElementById('srTot').textContent = 'Credit ' + money(lines.reduce((s, l) => s + l.quantity * l.unitValue, 0)); }
window.srNew = async () => { lines = []; render(); await srLoad(); document.getElementById('srModal').style.display = 'flex'; };
window.srAdd = () => { const id = parseInt(document.getElementById('srItem').value); const q = parseFloat(document.getElementById('srQty').value); const v = parseFloat(document.getElementById('srVal').value) || 0; if (!id || !(q > 0)) return; lines.push({ inventoryItemId: id, quantity: q, unitValue: v }); render(); };
window.srDel = i => { lines.splice(i, 1); render(); };
window.srSave = async () => { if (!lines.length) return; const d = await post('/SellReturn/Create', `branchId=${document.getElementById('srBranch').value}&reason=${encodeURIComponent(document.getElementById('srReason').value)}&lines=${encodeURIComponent(JSON.stringify(lines))}`); if (d.success) location.reload(); else if (window.ActionCard) ActionCard.error('Return', d.message); };
window.srApprove = async id => { const go = async () => { const d = await post('/SellReturn/Approve', 'id=' + id); if (window.ActionCard) d.success ? ActionCard.success('Return', d.message) : ActionCard.error('Return', d.message); if (d.success) location.reload(); }; window.ActionCard ? ActionCard.confirm('Approve return?', 'Restocks goods, credits the customer.', go) : (confirm('Approve?') && go()); };
window.srReject = async id => { const d = await post('/SellReturn/Reject', 'id=' + id); if (d.success) location.reload(); };
</script>
}
