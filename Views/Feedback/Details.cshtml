@model Cafe.Models.Feedback
@using Cafe.Models
@{
    ViewData["Title"] = "Feedback Details";
    string ratingStars = new string('★', Model.Rating) + new string('☆', 5 - Model.Rating);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Cafe</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap"
          rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
        theme: {
        extend: {
        colors: { accent: '#b8912c', sidebar: '#1e2a3a' },
        fontFamily: { sans: ['Inter', 'system-ui', 'sans-serif'] },
        borderRadius: { card: '20px' },
        }
        }
        }
    </script>
</head>
<body class="font-sans bg-[#eef1f4] text-[#1a1a2e] min-h-screen py-8 px-4">
    <div class="max-w-[640px] mx-auto">
        <a href="@Url.Action("Index", "Feedback")"
               class="inline-flex items-center gap-1.5 text-xs text-gray-500 no-underline mb-6 transition-colors duration-200 hover:text-[#1a1a2e]">←
            Back to Feedback</a>

            <div
                class="bg-white rounded-card p-8 shadow-[0_20px_60px_rgba(0,0,0,0.08)] border border-black/5 transition-shadow duration-300 hover:shadow-[0_24px_64px_rgba(0,0,0,0.1)]">
                <div class="flex justify-between items-start gap-4 mb-6">
                    <div>
                        <p class="text-[0.65rem] uppercase tracking-[0.12em] text-gray-500 font-semibold mb-1">Rating</p>
                        <p class="text-2xl text-accent tracking-widest">@ratingStars</p>
                        <p class="text-xs text-gray-500 mt-1">@Model.Date.ToString("dd MMM yyyy HH:mm")</p>
                    </div>
                    <div class="text-right">
                        @if (Model.Branch != null)
                        {
                            <span
                            class="inline-flex px-2.5 py-1 rounded-full text-[0.7rem] font-semibold bg-sidebar text-white">@Model.Branch.Name</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.Category))
                        {
                            <br />
                    
                            <span
                            class="inline-flex px-2.5 py-1 rounded-full text-[0.7rem] font-semibold bg-gray-100 text-gray-700 border border-gray-200 mt-1.5">@Model.Category</span>
                        }
                    </div>
                </div>

                <div class="border-t border-[#e8e5e0] pt-4 mt-4">
                    <p class="text-[0.65rem] uppercase tracking-[0.12em] text-gray-500 font-semibold mb-1">Customer</p>
                    <p class="text-sm font-medium text-[#1a1a2e]">@Model.Customer?.Name</p>
                    <p class="text-xs text-gray-500">@Model.Customer?.Email</p>
                </div>

                @if (Model.Order != null)
                {
                    <div class="border-t border-[#e8e5e0] pt-4 mt-4">
                        <p class="text-[0.65rem] uppercase tracking-[0.12em] text-gray-500 font-semibold mb-1">Order</p>
                        <p class="text-sm font-medium text-[#1a1a2e]">Order #@Model.Order.Id</p>
                    </div>
                }

                <div class="border-t border-[#e8e5e0] pt-4 mt-4">
                    <p class="text-[0.65rem] uppercase tracking-[0.12em] text-gray-500 font-semibold mb-1">Comments</p>
                    <p class="text-sm text-gray-700 whitespace-pre-line leading-relaxed">@Model.Comments</p>
                </div>

                <div class="border-t border-[#e8e5e0] pt-4 mt-4">
                    <form method="post" action="@Url.Action("UpdateStatus", "Feedback")" class="flex flex-col gap-3">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />

                        <div class="flex items-center gap-3">
                            <div class="flex-1">
                                <label
                                class="block text-[0.65rem] font-semibold uppercase tracking-wider text-gray-500 mb-1">Status</label>
                                <select name="status"
                                        class="w-full px-2.5 py-2 rounded-[10px] border border-gray-200 text-xs font-sans bg-[#f6f8fa] transition-all duration-200 focus:outline-none focus:border-accent focus:ring-[3px] focus:ring-accent/15">
                                    <option value="Open"
                                            selected="@(Model.Status == FeedbackStatus.Open ? "selected" : null)">Open</option>
                                    <option value="InProgress"
                                            selected="@(Model.Status == FeedbackStatus.InProgress ? "selected" : null)">In
                                        Progress</option>
                                        <option value="Resolved"
                                                selected="@(Model.Status == FeedbackStatus.Resolved ? "selected" : null)">Resolved
                                        </option>
                                    </select>
                                </div>
                            </div>

                            <div>
                                <label
                                    class="block text-[0.65rem] font-semibold uppercase tracking-wider text-gray-500 mb-1">Staff
                                    Note</label>
                                    <textarea name="staffNote" rows="2"
                                              class="w-full px-2.5 py-2 rounded-[10px] border border-gray-200 text-xs font-sans bg-[#f6f8fa] resize-y transition-all duration-200 focus:outline-none focus:border-accent focus:ring-[3px] focus:ring-accent/15">@Model.StaffNote</textarea>
                                </div>

                                <div class="flex gap-2 items-center">
                                    <button type="submit"
                                            class="inline-flex items-center gap-1 px-4 py-2 rounded-[10px] text-xs font-semibold border-none cursor-pointer bg-sidebar text-white transition-all duration-150 hover:bg-[#2d3f54]">Save</button>
                                    @if (Model.ResolvedAt.HasValue)
                                    {
                                        <p class="text-xs text-gray-500">Resolved on @Model.ResolvedAt.Value.ToString("dd MMM yyyy HH:mm")</p>
                                    }
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </body>

        </html>