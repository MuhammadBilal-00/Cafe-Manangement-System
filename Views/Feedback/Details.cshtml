@model Cafe.Models.Feedback
@using Cafe.Models

@{
    ViewData["Title"] = "Feedback Details";
    string ratingStars = new string('★', Model.Rating) + new string('☆', 5 - Model.Rating);
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Cafe OS</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-100 text-slate-900 min-h-screen antialiased">

    <header class="sticky top-0 z-40 bg-white/80 backdrop-blur-xl border-b border-slate-200">
        <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-3 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="relative w-10 h-10">
                    <div class="absolute inset-0 rounded-2xl bg-gradient-to-tr from-amber-500 via-rose-500 to-violet-500 blur-sm opacity-80"></div>
                    <div class="relative w-full h-full rounded-2xl bg-white flex items-center justify-center text-2xl shadow-sm">
                        💬
                    </div>
                </div>
                <div>
                    <p class="text-[11px] uppercase tracking-[0.25em] text-slate-400">
                        Cafe OS
                    </p>
                    <h1 class="text-sm sm:text-base font-semibold tracking-wide text-slate-900">
                        Feedback Details
                    </h1>
                </div>
            </div>

            <a href="@Url.Action("Index", "Feedback")"
               class="inline-flex items-center gap-1.5 rounded-full bg-slate-900 text-slate-50 text-xs sm:text-[13px] font-medium px-3 py-1.5 shadow-sm hover:bg-slate-800 transition">
                ⬅ Back
            </a>
        </div>
    </header>

    <main class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-10 space-y-6">
        <section class="rounded-3xl bg-white border border-slate-200 shadow-sm p-5 space-y-4">
            <div class="flex items-start justify-between gap-4">
                <div>
                    <p class="text-[11px] text-slate-500 uppercase tracking-[0.18em] mb-1">
                        Rating
                    </p>
                    <p class="text-lg font-semibold text-amber-500">
                        @ratingStars
                    </p>
                    <p class="text-[11px] text-slate-500 mt-1">
                        @Model.Date.ToString("dd MMM yyyy HH:mm")
                    </p>
                </div>
                <div class="text-right text-[11px]">
                    <p class="text-slate-500 uppercase tracking-[0.18em] mb-1">
                        Branch
                    </p>
                    <p class="inline-flex items-center rounded-full bg-slate-900 text-slate-50 px-2 py-0.5">
                        @Model.Branch?.Name
                    </p>
                    @if (!string.IsNullOrWhiteSpace(Model.Category))
                    {
                        <p class="mt-2 text-[11px] text-slate-500">
                            Category: <span class="font-semibold">@Model.Category</span>
                        </p>
                    }
                </div>
            </div>

            <div class="border-t border-slate-200 pt-4">
                <p class="text-[11px] text-slate-500 uppercase tracking-[0.18em] mb-1">
                    Customer
                </p>
                <p class="text-sm font-semibold text-slate-900">
                    @Model.Customer?.Name
                </p>
                <p class="text-[11px] text-slate-500">
                    @Model.Customer?.Email
                </p>
            </div>

            @if (Model.Order != null)
            {
                <div class="border-t border-slate-200 pt-4">
                    <p class="text-[11px] text-slate-500 uppercase tracking-[0.18em] mb-1">
                        Order
                    </p>
                    <p class="text-sm text-slate-800">
                        Order #: @Model.Order.Id
                    </p>
                </div>
            }

            <div class="border-t border-slate-200 pt-4">
                <p class="text-[11px] text-slate-500 uppercase tracking-[0.18em] mb-1">
                    Comments
                </p>
                <p class="text-sm text-slate-800 whitespace-pre-line">
                    @Model.Comments
                </p>
            </div>

            <!-- Status + Staff Note -->
            <section class="border-t border-slate-200 pt-4 space-y-3">
                <form id="status-form"
                      method="post"
                      action="@Url.Action("UpdateStatus", "Feedback")"
                      class="space-y-2">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />

                    <div class="flex items-center gap-2 text-[11px]">
                        <label class="uppercase tracking-[0.18em] text-slate-500">Status</label>
                        <select name="status" class="px-2 py-1 rounded-lg border border-slate-200 text-xs">
                            <option value="Open" selected="@(Model.Status == FeedbackStatus.Open ? "selected" : null)">Open</option>
                            <option value="InProgress" selected="@(Model.Status == FeedbackStatus.InProgress ? "selected" : null)">In progress</option>
                            <option value="Resolved" selected="@(Model.Status == FeedbackStatus.Resolved ? "selected" : null)">Resolved</option>
                        </select>
                    </div>

                    <div class="space-y-1 text-[11px]">
                        <label class="uppercase tracking-[0.18em] text-slate-500">Staff note</label>
                        <textarea name="staffNote"
                                  rows="2"
                                  class="w-full px-2 py-1 rounded-xl bg-slate-50 border border-slate-200 text-xs">@Model.StaffNote</textarea>
                    </div>

                    <button type="submit"
                            class="inline-flex items-center gap-1 rounded-full bg-slate-900 text-slate-50 text-[11px] px-3 py-1.5 hover:bg-slate-800 transition">
                        Save
                    </button>

                    @if (Model.ResolvedAt.HasValue)
                    {
                        <p class="mt-1 text-[11px] text-slate-400">
                            Resolved on @Model.ResolvedAt.Value.ToString("dd MMM yyyy HH:mm")
                        </p>
                    }
                </form>
            </section>
        </section>
    </main>
</body>
</html>