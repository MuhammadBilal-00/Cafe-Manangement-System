@{
    ViewData["Title"] = "Thank You";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Cafe</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap"
          rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
        theme: {
        extend: {
        colors: { accent: '#b8912c', sidebar: '#1e2a3a' },
        fontFamily: { sans: ['Inter', 'system-ui', 'sans-serif'] },
        borderRadius: { card: '20px' },
        }
        }
        }
    </script>
</head>
<body class="font-sans bg-[#eef1f4] text-[#1a1a2e] min-h-screen flex items-center justify-center p-6">
    <div
        class="max-w-[400px] w-full bg-white rounded-card px-8 py-10 shadow-[0_20px_60px_rgba(0,0,0,0.08)] border border-black/5 text-center transition-shadow duration-300 hover:shadow-[0_24px_64px_rgba(0,0,0,0.1)]">
        <div class="w-14 h-14 bg-green-50 rounded-2xl flex items-center justify-center text-3xl mx-auto mb-5">✅</div>
        <h1 class="text-xl font-bold mb-2">Thank You!</h1>
        <p class="text-sm text-gray-500 leading-relaxed mb-6">We've received your feedback and will use it to improve
            our service. Your opinion matters to us.</p>
            <a href="@Url.Action("Index", "Home")"
                   class="inline-flex items-center gap-1.5 px-6 py-2.5 rounded-xl bg-sidebar text-white text-sm font-semibold no-underline transition-all duration-200 hover:bg-[#2d3f54] hover:-translate-y-0.5">Back
                to Home</a>
            </div>
        </body>

    </html>