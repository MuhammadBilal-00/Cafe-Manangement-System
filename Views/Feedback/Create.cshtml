@{
    ViewData["Title"] = "Give Feedback";
    var branches = ViewBag.Branches as List<Cafe.Models.Branch> ?? new List<Cafe.Models.Branch>();
    int? selectedBranchId = ViewBag.BranchId as int?;
    int? orderId = ViewBag.OrderId as int?;
}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Cafe</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap"
          rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
        theme: {
        extend: {
        colors: { accent: '#b8912c', sidebar: '#1e2a3a' },
        fontFamily: { sans: ['Inter', 'system-ui', 'sans-serif'] },
        borderRadius: { card: '20px' },
        }
        }
        }
    </script>
    <style>
        .stars button {
        transition: color 0.15s, transform 0.15s;
        }
        .stars button.active {
        color: #b8912c;
        }
        .stars button:hover {
        transform: scale(1.15);
        }
    </style>
</head>

<body class="font-sans bg-[#eef1f4] text-[#1a1a2e] min-h-screen flex items-center justify-center p-6">
    <div
        class="max-w-[440px] w-full bg-white rounded-card p-8 shadow-[0_20px_60px_rgba(0,0,0,0.08)] border border-black/5 transition-shadow duration-300 hover:shadow-[0_24px_64px_rgba(0,0,0,0.1)]">

        <div
            class="w-12 h-12 bg-gradient-to-br from-accent to-[#b8860b] rounded-[14px] flex items-center justify-center text-2xl mx-auto mb-4">
            💬</div>
            <h1 class="text-xl font-bold text-center mb-1">Share Your Experience</h1>
            <p class="text-xs text-gray-500 text-center mb-6">Your feedback helps us serve you better.</p>

            <form method="post" class="space-y-4">
                @Html.AntiForgeryToken()

                @if (orderId.HasValue)
                {
                    <input type="hidden" name="orderId" value="@orderId.Value" />
                    <input type="hidden" name="source" value="OrderPage" />
                }
                else
                {
                    <input type="hidden" name="source" value="General" />
                }

                <div>
                    <label
                    class="block text-[0.7rem] font-semibold uppercase tracking-wider text-gray-500 mb-1.5">Rating</label>
                    <input type="hidden" id="rating-input" name="rating" value="5" />
                    <div class="stars flex gap-1 text-[1.75rem] cursor-pointer" id="star-container">
                        @for (int i = 1; i <= 5; i++)
                        {
                            <button type="button" data-star="@i"
                                    class="active bg-transparent border-none text-gray-200 cursor-pointer leading-none p-0">★</button>
                        }
                    </div>
                </div>

                <div>
                    <label
                    class="block text-[0.7rem] font-semibold uppercase tracking-wider text-gray-500 mb-1.5">Category</label>
                    <select name="category"
                            class="w-full px-3 py-2.5 rounded-xl border border-gray-200 text-sm font-sans bg-[#f6f8fa] transition-all duration-200 focus:outline-none focus:border-accent focus:ring-[3px] focus:ring-accent/10">
                        <option value="Service">Service</option>
                        <option value="Food">Food</option>
                        <option value="Drinks">Drinks</option>
                        <option value="Environment">Environment</option>
                        <option value="Other">Other</option>
                    </select>
                </div>

                <div>
                    <label
                    class="block text-[0.7rem] font-semibold uppercase tracking-wider text-gray-500 mb-1.5">Branch</label>
                    <select name="branchId"
                            class="w-full px-3 py-2.5 rounded-xl border border-gray-200 text-sm font-sans bg-[#f6f8fa] transition-all duration-200 focus:outline-none focus:border-accent focus:ring-[3px] focus:ring-accent/10">
                        <option value="">Select branch</option>
                        @foreach (var b in branches)
                        {
                            <option value="@b.Id" selected="@(selectedBranchId == b.Id ? "selected" : null)">@b.Name</option>
                        }
                    </select>
                </div>

                <div>
                    <label class="block text-[0.7rem] font-semibold uppercase tracking-wider text-gray-500 mb-1.5">Your
                        Feedback</label>
                        <textarea name="comments" rows="4" placeholder="Tell us what went well or what we can improve..."
                                  class="w-full px-3 py-2.5 rounded-xl border border-gray-200 text-sm font-sans bg-[#f6f8fa] transition-all duration-200 focus:outline-none focus:border-accent focus:ring-[3px] focus:ring-accent/10 resize-y min-h-[80px]"></textarea>
                    </div>

                    <button type="submit"
                            class="w-full py-3 border-none rounded-xl bg-gradient-to-br from-accent to-[#b8860b] text-white font-semibold text-sm cursor-pointer transition-all duration-200 hover:-translate-y-0.5 hover:shadow-[0_6px_20px_rgba(184,145,44,0.3)]">Submit
                        Feedback</button>
                    </form>
                </div>

                <script>
                    document.addEventListener('DOMContentLoaded', function () {
                    const stars = document.querySelectorAll('[data-star]');
                    const ratingInput = document.getElementById('rating-input');
                    stars.forEach(star => {
                    star.addEventListener('click', () => {
                    const value = parseInt(star.getAttribute('data-star'));
                    ratingInput.value = value;
                    stars.forEach(s => {
                    s.classList.toggle('active', parseInt(s.getAttribute('data-star')) <= value);
                    });
                    });
                    });
                    });
                </script>
            </body>

        </html>