@{
    ViewData["Title"] = "Give Feedback";

    var branches = ViewBag.Branches as List<Cafe.Models.Branch> ?? new List<Cafe.Models.Branch>();
    int? selectedBranchId = ViewBag.BranchId as int?;
    int? orderId = ViewBag.OrderId as int?;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Cafe OS</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const stars = document.querySelectorAll("[data-star]");
            const ratingInput = document.getElementById("rating-input");

            stars.forEach(star => {
                star.addEventListener("click", () => {
                    const value = parseInt(star.getAttribute("data-star"));
                    ratingInput.value = value;
                    stars.forEach(s => {
                        const v = parseInt(s.getAttribute("data-star"));
                        if (v <= value) {
                            s.classList.add("text-amber-400");
                            s.classList.remove("text-slate-300");
                        } else {
                            s.classList.add("text-slate-300");
                            s.classList.remove("text-amber-400");
                        }
                    });
                });
            });
        });
    </script>
</head>
<body class="bg-slate-100 text-slate-900 min-h-screen antialiased">

    <main class="max-w-md mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-12">
        <section class="rounded-3xl bg-white border border-slate-200 shadow-[0_16px_40px_rgba(15,23,42,0.12)] p-5 sm:p-7 space-y-5">
            <div class="text-center space-y-2">
                <div class="inline-flex items-center justify-center h-12 w-12 rounded-2xl bg-amber-50 text-2xl">
                    💬
                </div>
                <h1 class="text-lg font-semibold text-slate-900">
                    Share your experience
                </h1>
                <p class="text-xs text-slate-500">
                    Your feedback helps us improve our cafe.
                </p>
            </div>

            <form method="post" class="space-y-4">
                @Html.AntiForgeryToken()

                @if (orderId.HasValue)
                {
                    <input type="hidden" name="orderId" value="@orderId.Value" />
                    <input type="hidden" name="source" value="OrderPage" />
                }
                else
                {
                    <input type="hidden" name="source" value="General" />
                }

                <!-- Rating -->
                <div class="space-y-1">
                    <label class="block text-[11px] font-medium text-slate-500 uppercase tracking-[0.16em]">
                        Rating
                    </label>
                    <input type="hidden" id="rating-input" name="rating" value="5" />
                    <div class="flex items-center gap-1 text-2xl">
                        @for (int i = 1; i <= 5; i++)
                        {
                            <button type="button"
                                    data-star="@i"
                                    class="star-btn text-amber-400 hover:scale-110 transition transform">
                                ★
                            </button>
                        }
                    </div>
                </div>

                <!-- Category -->
                <div class="space-y-1">
                    <label class="block text-[11px] font-medium text-slate-500 uppercase tracking-[0.16em]">
                        What was this about?
                    </label>
                    <select name="category"
                            class="w-full px-3 py-2 rounded-xl bg-slate-50 border border-slate-200 text-sm text-slate-900 focus:outline-none focus:ring-2 focus:ring-amber-500/60 focus:border-amber-400/60">
                        <option value="Service">Service</option>
                        <option value="Food">Food</option>
                        <option value="Drinks">Drinks</option>
                        <option value="Environment">Environment</option>
                        <option value="Other">Other</option>
                    </select>
                </div>

                <!-- Branch -->
                <div class="space-y-1">
                    <label class="block text-[11px] font-medium text-slate-500 uppercase tracking-[0.16em]">
                        Branch
                    </label>
                    <select name="branchId"
                            class="w-full px-3 py-2 rounded-xl bg-slate-50 border border-slate-200 text-sm text-slate-900 focus:outline-none focus:ring-2 focus:ring-amber-500/60 focus:border-amber-400/60">
                        <option value="">Select branch</option>
                        @foreach (var b in branches)
                        {
                            var isSelected = selectedBranchId == b.Id;
                            <option value="@b.Id" selected="@(isSelected ? "selected" : null)">
                                @b.Name
                            </option>
                        }
                    </select>
                </div>

                <!-- Comments -->
                <div class="space-y-1">
                    <label class="block text-[11px] font-medium text-slate-500 uppercase tracking-[0.16em]">
                        Your feedback
                    </label>
                    <textarea name="comments"
                              rows="4"
                              placeholder="Tell us what went well or what we can improve..."
                              class="w-full px-3 py-2 rounded-xl bg-slate-50 border border-slate-200 text-sm text-slate-900 focus:outline-none focus:ring-2 focus:ring-amber-500/60 focus:border-amber-400/60"></textarea>
                </div>

                <button type="submit"
                        class="w-full inline-flex items-center justify-center gap-1.5 px-4 py-2.5 rounded-xl bg-gradient-to-r from-amber-500 to-rose-500 text-white text-sm font-semibold shadow-md shadow-amber-400/40 hover:-translate-y-0.5 hover:shadow-lg transition">
                    Submit feedback
                </button>
            </form>
        </section>
    </main>
</body>
</html>