@model List<Cafe.Models.Feedback>
@using Cafe.Models
@{
    ViewData["Title"] = "Feedback";

    var branches = ViewBag.Branches as List<Cafe.Models.Branch> ?? new List<Cafe.Models.Branch>();
    var ratingDist = ViewBag.RatingDistribution as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    var byCategory = ViewBag.ByCategory as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    var byBranch = ViewBag.ByBranch as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();

    int? rating = ViewBag.SelectedRating as int?;
    string status = ViewBag.SelectedStatus as string;
    int? selectedBranchId = ViewBag.SelectedBranchId as int?;
    string search = ViewBag.SearchQuery as string;

    int page = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalCount = ViewBag.TotalCount ?? Model.Count;

    double avgRating = 0;
    if (Model.Any()) avgRating = Model.Average(f => f.Rating);

    Func<FeedbackStatus, string> StatusLabel = s => s switch
    {
        FeedbackStatus.Open => "Open",
        FeedbackStatus.InProgress => "In Progress",
        FeedbackStatus.Resolved => "Resolved",
        _ => s.ToString()
    };
    Func<FeedbackStatus, string> StatusBadge = s => s switch
    {
        FeedbackStatus.Open => "badge badge-warning",
        FeedbackStatus.InProgress => "badge badge-info",
        FeedbackStatus.Resolved => "badge badge-success",
        _ => "badge badge-neutral"
    };
}

<!-- Page Header -->
<div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:1rem;margin-bottom:2rem;">
    <div>
        <h1 class="page-title" style="margin:0;">Customer Feedback</h1>
        <p class="body-text" style="margin-top:0.25rem;">Monitor satisfaction, ratings and suggestions across branches.</p>
    </div>
    @if (Context.Session.GetString("UserRole") == "Owner")
    {
        <div style="display:flex;gap:0.5rem;">
            <a href="@Url.Action("NeedsAttention", "Feedback")" class="btn btn-primary btn-sm">
                <i class="fas fa-exclamation-circle"></i> Needs Attention
            </a>
            <a href="@Url.Action("ExportCsv", "Feedback")" class="btn btn-secondary btn-sm">
                <i class="fas fa-download"></i> Export
            </a>
        </div>
    }
</div>

<!-- KPI Cards -->
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:1rem;margin-bottom:1.5rem;">
    <div class="kpi-card">
        <div class="kpi-icon" style="background:var(--accent-light);color:var(--accent);">
            <i class="fas fa-comments"></i>
        </div>
        <span class="kpi-label">Total Feedback</span>
        <span class="kpi-value">@totalCount</span>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon" style="background:#fef3c7;color:#d97706;">
            <i class="fas fa-star"></i>
        </div>
        <span class="kpi-label">Avg Rating</span>
        <span class="kpi-value">@avgRating.ToString("0.0") / 5</span>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon" style="background:#fee2e2;color:#dc2626;">
            <i class="fas fa-exclamation-triangle"></i>
        </div>
        <span class="kpi-label">Open</span>
        <span class="kpi-value">@Model.Count(f => f.Status == FeedbackStatus.Open)</span>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon" style="background:#dcfce7;color:#16a34a;">
            <i class="fas fa-check-circle"></i>
        </div>
        <span class="kpi-label">Resolved</span>
        <span class="kpi-value">@Model.Count(f => f.Status == FeedbackStatus.Resolved)</span>
    </div>
</div>

<!-- Analytics Row -->
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:1rem;margin-bottom:1.5rem;">
    <!-- Rating Distribution -->
    <div class="card">
        <div class="card-header"><span style="font-weight:600;font-size:0.85rem;">Rating Distribution</span></div>
        <div class="card-body">
            @if (ratingDist.Any())
            {
                var maxCount = ratingDist.Max(r => (int)r.Count);
                if (maxCount == 0) maxCount = 1;
                foreach (var r in ratingDist.OrderByDescending(x => (int)x.Rating))
                {
                    int count = (int)r.Count;
                    int pct = (int)Math.Round(count / (double)maxCount * 100);
                    <div style="display:flex;align-items:center;gap:0.5rem;margin-bottom:0.4rem;">
                        <span style="width:3rem;font-size:0.8rem;color:var(--text-secondary);">@r.Rating <i class="fas fa-star" style="color:var(--accent);font-size:0.65rem;"></i></span>
                        <div style="flex:1;height:6px;border-radius:3px;background:var(--border-light);overflow:hidden;">
                            <div style="height:100%;border-radius:3px;background:var(--accent);width:@(pct)%;"></div>
                        </div>
                        <span style="width:2rem;text-align:right;font-size:0.75rem;color:var(--text-tertiary);">@count</span>
                    </div>
                }
            }
            else
            {
                <p class="caption">No feedback data yet.</p>
            }
        </div>
    </div>

    <!-- Categories -->
    <div class="card">
        <div class="card-header"><span style="font-weight:600;font-size:0.85rem;">By Category</span></div>
        <div class="card-body">
            @if (byCategory.Any())
            {
                var total = byCategory.Sum(c => (int)c.Count);
                if (total == 0) total = 1;
                foreach (var c in byCategory.OrderByDescending(x => (int)x.Count))
                {
                    int count = (int)c.Count;
                    int pct = (int)Math.Round(count / (double)total * 100);
                    <div style="display:flex;align-items:center;gap:0.5rem;margin-bottom:0.4rem;">
                        <span style="width:5rem;font-size:0.8rem;color:var(--text-secondary);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">@((string)c.Category ?? "Other")</span>
                        <div style="flex:1;height:6px;border-radius:3px;background:var(--border-light);overflow:hidden;">
                            <div style="height:100%;border-radius:3px;background:#6366f1;width:@(pct)%;"></div>
                        </div>
                        <span style="width:2.5rem;text-align:right;font-size:0.75rem;color:var(--text-tertiary);">@pct%</span>
                    </div>
                }
            }
            else
            {
                <p class="caption">No data.</p>
            }
        </div>
    </div>

    <!-- Branches -->
    <div class="card">
        <div class="card-header"><span style="font-weight:600;font-size:0.85rem;">By Branch</span></div>
        <div class="card-body">
            @if (byBranch.Any())
            {
                var maxCountB = byBranch.Max(b => (int)b.Count);
                if (maxCountB == 0) maxCountB = 1;
                foreach (var b in byBranch.OrderByDescending(x => (int)x.Count).Take(4))
                {
                    int count = (int)b.Count;
                    int pct = (int)Math.Round(count / (double)maxCountB * 100);
                    double avgR = (double)b.AvgRating;
                    <div style="display:flex;align-items:center;gap:0.5rem;margin-bottom:0.5rem;">
                        <div style="flex:1;min-width:0;">
                            <div style="display:flex;justify-content:space-between;font-size:0.8rem;">
                                <span style="color:var(--text-secondary);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">@(((Cafe.Models.Branch)b.Branch).Name)</span>
                                <span style="color:var(--accent);font-weight:600;">@avgR.ToString("0.0") <i class="fas fa-star" style="font-size:0.6rem;"></i></span>
                            </div>
                            <div style="height:6px;border-radius:3px;background:var(--border-light);overflow:hidden;margin-top:0.2rem;">
                                <div style="height:100%;border-radius:3px;background:#10b981;width:@(pct)%;"></div>
                            </div>
                        </div>
                        <span style="width:2rem;text-align:right;font-size:0.75rem;color:var(--text-tertiary);">@count</span>
                    </div>
                }
            }
            else
            {
                <p class="caption">No data.</p>
            }
        </div>
    </div>
</div>

<!-- Filters -->
<div class="card" style="margin-bottom:1.5rem;">
    <div class="card-body">
        <form method="get" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:1rem;align-items:end;">
            <div class="form-group">
                <label class="form-label">Rating</label>
                <select name="rating" class="form-select">
                    <option value="">All</option>
                    @for (int r = 5; r >= 1; r--)
                    {
                        <option value="@r" selected="@(rating == r ? "selected" : null)">@r Stars</option>
                    }
                </select>
            </div>
            <div class="form-group">
                <label class="form-label">Status</label>
                <select name="status" class="form-select">
                    <option value="" selected="@(string.IsNullOrEmpty(status) ? "selected" : null)">All</option>
                    <option value="open" selected="@(status == "open" ? "selected" : null)">Open</option>
                    <option value="inprogress" selected="@(status == "inprogress" ? "selected" : null)">In Progress</option>
                    <option value="resolved" selected="@(status == "resolved" ? "selected" : null)">Resolved</option>
                </select>
            </div>
            <div class="form-group">
                <label class="form-label">Branch</label>
                <select name="branchId" class="form-select">
                    <option value="">All Branches</option>
                    @foreach (var b in branches)
                    {
                        <option value="@b.Id" selected="@(selectedBranchId == b.Id ? "selected" : null)">@b.Name</option>
                    }
                </select>
            </div>
            <div class="form-group">
                <label class="form-label">Search</label>
                <input type="text" name="search" value="@search" placeholder="Customer or text..." class="form-control" />
            </div>
            <div class="form-group" style="display:flex;gap:0.5rem;">
                <button type="submit" class="btn btn-primary btn-sm" style="flex:1;">
                    <i class="fas fa-search"></i> Apply
                </button>
                <a href="@Url.Action("Index", "Feedback")" class="btn btn-secondary btn-sm">Reset</a>
            </div>
        </form>
    </div>
</div>

<!-- Feedback List -->
<div class="card">
    <div class="card-header" style="display:flex;justify-content:space-between;align-items:center;">
        <span style="font-weight:600;">Feedback Items</span>
        <span class="caption">Page @(page) of @(totalPages)</span>
    </div>

    @if (Model.Any())
    {
        <div style="padding:1rem 1.5rem;">
            @foreach (var f in Model)
            {
                var ratingStars = new string('★', f.Rating) + new string('☆', 5 - f.Rating);
                <div style="border:1px solid var(--border-light);border-radius:var(--radius-card);padding:1rem;margin-bottom:0.75rem;background:var(--bg-body);transition:box-shadow 0.2s;" onmouseover="this.style.boxShadow='0 4px 12px rgba(0,0,0,0.06)'" onmouseout="this.style.boxShadow='none'">
                    <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:1rem;">
                        <div style="flex:1;min-width:0;">
                            <div style="display:flex;align-items:center;gap:0.5rem;flex-wrap:wrap;margin-bottom:0.4rem;">
                                <span class="@StatusBadge(f.Status)">@StatusLabel(f.Status)</span>
                                <span style="color:var(--accent);font-weight:600;font-size:0.85rem;letter-spacing:0.5px;">@ratingStars</span>
                                <span class="caption">@f.Date.ToString("dd MMM yyyy HH:mm")</span>
                                @if (!string.IsNullOrWhiteSpace(f.Category))
                                {
                                    <span class="badge badge-neutral">@f.Category</span>
                                }
                            </div>
                            <p style="font-weight:600;font-size:0.9rem;color:var(--text-primary);margin:0.25rem 0;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;">
                                @f.Comments
                            </p>
                            <p class="caption" style="margin:0;">@f.Customer?.Name &middot; @f.Customer?.Email</p>
                        </div>
                        <div style="display:flex;flex-direction:column;align-items:flex-end;gap:0.4rem;">
                            @if (f.Branch != null)
                            {
                                <span class="badge badge-accent">@f.Branch.Name</span>
                            }
                            <a href="@Url.Action("Details", "Feedback", new { id = f.Id })" class="btn btn-ghost btn-sm" style="font-size:0.75rem;">
                                View <i class="fas fa-arrow-right" style="font-size:0.6rem;margin-left:0.25rem;"></i>
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-state">
            <i class="fas fa-comments" style="font-size:2.5rem;color:var(--text-tertiary);margin-bottom:0.75rem;"></i>
            <p style="font-weight:600;color:var(--text-primary);">No feedback matching filters</p>
            <p class="caption">Try adjusting your search criteria.</p>
        </div>
    }

    <!-- Pagination -->
    @if (totalPages > 1)
    {
        <div style="padding:1rem 1.5rem;border-top:1px solid var(--border-light);display:flex;justify-content:center;">
            <div style="display:inline-flex;gap:0.25rem;align-items:center;">
                @for (int p = 1; p <= totalPages; p++)
                {
                    if (p == page)
                    {
                        <span class="btn btn-primary btn-sm" style="min-width:2rem;text-align:center;pointer-events:none;">@p</span>
                    }
                    else
                    {
                        <a href="@Url.Action("Index", new { page = p, rating, status, branchId = selectedBranchId, search })"
                           class="btn btn-ghost btn-sm" style="min-width:2rem;text-align:center;">@p</a>
                    }
                }
            </div>
        </div>
    }
</div>
